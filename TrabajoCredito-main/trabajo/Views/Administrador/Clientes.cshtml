@model trabajo.Models.ViewModels.AdminClientesViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
    ViewData["Title"] = "Clientes";
    ViewData["ActivePage"] = "Clientes";
}

<div class="clientes-page">

    <div class="clientes-header">
        <div>
            <h1 class="clientes-title">Clientes</h1>
            <p class="clientes-subtitle">Gestiona y consulta la información de los clientes registrados.</p>
            @if (TempData["ErrorClientes"] != null)
            {
                <div class="alert alert-danger mt-3">
                    <i class="fas fa-triangle-exclamation"></i>
                    @TempData["ErrorClientes"]
                </div>
            }

            @if (TempData["ExitoClientes"] != null)
            {
                <div class="alert alert-success mt-3">
                    <i class="fas fa-check-circle"></i>
                    @TempData["ExitoClientes"]
                </div>
            }

        </div>
    </div>

    <div class="clientes-stats-grid">
        <div class="cliente-stat-card">
            <div class="cliente-stat-icon purple">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <p>Total Clientes</p>
                <h2>@Model.TotalClientes</h2>
            </div>
        </div>

        <div class="cliente-stat-card">
            <div class="cliente-stat-icon green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <p>Clientes Activos</p>
                <h2>@Model.ClientesActivos</h2>
            </div>
        </div>

        <div class="cliente-stat-card">
            <div class="cliente-stat-icon orange">
                <i class="fas fa-user-plus"></i>
            </div>
            <div>
                <p>Nuevos este mes</p>
                <h2>@Model.NuevosClientesEsteMes</h2>
            </div>
        </div>

        <div class="cliente-stat-card">
            <div class="cliente-stat-icon blue">
                <i class="fas fa-coins"></i>
            </div>
            <div>
                <p>Monto otorgado</p>
                <h2>S/ @Model.MontoTotalOtorgado.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <div class="clientes-card">
        <form method="get" asp-controller="Administrador" asp-action="Clientes" class="clientes-toolbar">
            <div class="clientes-search">
                <i class="fas fa-search"></i>
                <input type="text" name="buscar" value="@Model.Buscar" placeholder="Buscar por nombre, DNI, celular o correo..." />
            </div>

            <select name="estado" onchange="this.form.submit()">
                <option value="Todos" selected="@(Model.Estado == "Todos")">Todos</option>
                <option value="Activo" selected="@(Model.Estado == "Activo")">Activo</option>
                <option value="Inactivo" selected="@(Model.Estado == "Inactivo")">Inactivo</option>
            </select>

            <button type="submit" class="clientes-btn">
                <i class="fas fa-filter"></i> Filtrar
            </button>

            <a class="clientes-btn export" href="@Url.Action("ExportarClientesExcel", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado })">
                <i class="fas fa-file-excel"></i> Excel
            </a>

            <a class="clientes-btn export pdf" href="@Url.Action("ExportarClientesPdf", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado })">
                <i class="fas fa-file-pdf"></i> PDF
            </a>
        </form>

        <div class="clientes-table-wrapper">
            <table class="clientes-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>DNI</th>
                        <th>Celular</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th>Fecha Registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Clientes.Any())
                    {
                        foreach (var cliente in Model.Clientes)
                        {
                            <tr>
                                <td>#@cliente.NumeroFila.ToString("000")</td>
                                <td>
                                    <div class="cliente-info">
                                        <div class="cliente-avatar">@cliente.Iniciales</div>
                                        <div>
                                            <strong>@cliente.NombreCompleto</strong>
                                            <span>Cliente</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@cliente.Dni</td>
                                <td>@cliente.Celular</td>
                                <td>@cliente.Correo</td>
                                <td>
                                    @if (cliente.EstadoActivo)
                                    {
                                        <span class="estado-badge activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="estado-badge inactivo">Inactivo</span>
                                    }
                                </td>
                                <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="clientes-actions">
                                        <button type="button" class="action-btn"
                                                onclick="abrirDetalleCliente('@cliente.NombreCompleto', '@cliente.Dni', '@cliente.Celular', '@cliente.Correo', '@cliente.Genero')">
                                            <i class="far fa-eye"></i>
                                        </button>

                                        <button type="button" class="action-btn edit"
                                                onclick="abrirEditarCliente('@cliente.Id', '@cliente.Nombre', '@cliente.Apellido', '@cliente.Dni', '@cliente.Celular', '@cliente.Correo', '@cliente.Genero', '@cliente.EstadoActivo.ToString().ToLower()')">
                                            <i class="far fa-edit"></i>
                                        </button>

                                        <button type="button" class="action-btn delete"
                                                onclick="abrirEliminarCliente('@cliente.Id', '@cliente.NombreCompleto')">
                                            <i class="far fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="clientes-empty">No se encontraron clientes.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="clientes-footer-table">
            <span>Mostrando @Model.InicioRegistro a @Model.FinRegistro de @Model.TotalFiltrado clientes</span>

            <div class="clientes-pagination">
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <a class="page-btn @(i == Model.PaginaActual ? "active" : "")"
                       href="@Url.Action("Clientes", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado, pagina = i })">
                        @i
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleCliente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content clientes-modal">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p><strong>Cliente:</strong> <span id="detalleNombre"></span></p>
                <p><strong>DNI:</strong> <span id="detalleDni"></span></p>
                <p><strong>Celular:</strong> <span id="detalleCelular"></span></p>
                <p><strong>Correo:</strong> <span id="detalleCorreo"></span></p>
                <p><strong>Género:</strong> <span id="detalleGenero"></span></p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditarCliente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-controller="Administrador" asp-action="EditarClienteAdmin" class="modal-content clientes-modal">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" id="editarId" />

            <div class="modal-header">
                <h5 class="modal-title">Editar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body clientes-form-grid">
                <input name="nombre" id="editarNombre" placeholder="Nombre" required />
                <input name="apellido" id="editarApellido" placeholder="Apellido" required />
                <input name="dni" id="editarDni" placeholder="DNI" maxlength="8" required />
                <input name="celular" id="editarCelular" placeholder="Celular" required />
                <input name="correo" id="editarCorreo" placeholder="Correo" type="email" required />

                <select name="genero" id="editarGenero">
                    <option value="">No especificado</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>
                </select>

                <select name="estadoActivo" id="editarEstadoActivo">
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="clientes-btn" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="clientes-btn primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalEliminarCliente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form id="formEliminarCliente" method="post" asp-controller="Administrador" asp-action="EliminarClienteAdmin" class="modal-content clientes-modal">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" id="eliminarId" />

            <div class="modal-header">
                <h5 class="modal-title">Eliminar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>¿Seguro que deseas eliminar al cliente <strong id="eliminarNombre"></strong>?</p>
                <div class="alert alert-danger mt-3">
                    Esta acción no se podrá deshacer.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="clientes-btn" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="clientes-btn danger">Eliminar</button>
            </div>
        </form>
    </div>
</div>
<div class="modal fade" id="modalMensajeCliente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content clientes-modal text-center p-4">
            <div id="mensajeIcono" style="font-size:48px;"></div>
            <h5 id="mensajeTitulo" class="mt-2"></h5>
            <p id="mensajeTexto" class="text-muted"></p>
            <button type="button" class="clientes-btn primary mx-auto" data-bs-dismiss="modal" onclick="location.reload()">
                Aceptar
            </button>
        </div>
    </div>
</div>
<style>
    .clientes-page {
        padding: 25px;
    }

    .clientes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .clientes-title {
        font-size: 32px;
        font-weight: 800;
        color: #111827;
        margin: 0;
    }

    .clientes-subtitle {
        color: #6b7280;
        margin-top: 6px;
        font-size: 15px;
    }

    .clientes-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .cliente-stat-card {
        background: #fff;
        border-radius: 22px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
        border: 1px solid #f1f5f9;
    }

        .cliente-stat-card p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        .cliente-stat-card h2 {
            margin: 6px 0 0;
            font-size: 26px;
            font-weight: 800;
            color: #111827;
        }

    .cliente-stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #fff;
    }

        .cliente-stat-icon.purple {
            background: linear-gradient(135deg, #6D28D9, #8B5CF6);
        }

        .cliente-stat-icon.green {
            background: linear-gradient(135deg, #16a34a, #22c55e);
        }

        .cliente-stat-icon.orange {
            background: linear-gradient(135deg, #f97316, #fb923c);
        }

        .cliente-stat-icon.blue {
            background: linear-gradient(135deg, #2563eb, #60a5fa);
        }

    .clientes-card {
        background: #fff;
        border-radius: 24px;
        padding: 22px;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
        border: 1px solid #f1f5f9;
    }

    .clientes-toolbar {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .clientes-search {
        flex: 1;
        min-width: 260px;
        height: 46px;
        border: 1px solid #e5e7eb;
        border-radius: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 15px;
        background: #f9fafb;
    }

        .clientes-search i {
            color: #6D28D9;
        }

        .clientes-search input {
            border: none;
            outline: none;
            background: transparent;
            width: 100%;
            font-size: 14px;
        }

    .clientes-toolbar select {
        height: 46px;
        border: 1px solid #e5e7eb;
        border-radius: 15px;
        padding: 0 14px;
        background: #fff;
        color: #374151;
        outline: none;
    }

    .clientes-btn {
        height: 46px;
        border: none;
        border-radius: 15px;
        padding: 0 18px;
        background: #f3f4f6;
        color: #374151;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
    }

        .clientes-btn:hover {
            background: #e5e7eb;
            color: #111827;
        }

        .clientes-btn.primary {
            background: #6D28D9;
            color: #fff;
        }

            .clientes-btn.primary:hover {
                background: #5b21b6;
                color: #fff;
            }

        .clientes-btn.export {
            background: #ecfdf5;
            color: #15803d;
        }

            .clientes-btn.export.pdf {
                background: #fef2f2;
                color: #dc2626;
            }

        .clientes-btn.danger {
            background: #dc2626;
            color: #fff;
        }

            .clientes-btn.danger:hover {
                background: #b91c1c;
                color: #fff;
            }

    .clientes-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .clientes-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

        .clientes-table thead th {
            color: #6b7280;
            font-size: 13px;
            font-weight: 800;
            padding: 0 14px 8px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .clientes-table tbody tr {
            background: #f9fafb;
            border-radius: 18px;
        }

        .clientes-table tbody td {
            padding: 16px 14px;
            color: #374151;
            font-size: 14px;
            vertical-align: middle;
            white-space: nowrap;
        }

            .clientes-table tbody td:first-child {
                border-radius: 18px 0 0 18px;
                font-weight: 800;
                color: #6D28D9;
            }

            .clientes-table tbody td:last-child {
                border-radius: 0 18px 18px 0;
            }

    .cliente-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cliente-avatar {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, #6D28D9, #8B5CF6);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .cliente-info strong {
        display: block;
        color: #111827;
    }

    .cliente-info span {
        display: block;
        color: #6b7280;
        font-size: 13px;
    }

    .estado-badge {
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
    }

        .estado-badge.activo {
            background: #dcfce7;
            color: #15803d;
        }

        .estado-badge.inactivo {
            background: #fee2e2;
            color: #b91c1c;
        }

    .clientes-actions {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 12px;
        background: #ede9fe;
        color: #6D28D9;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .action-btn.edit {
            background: #dbeafe;
            color: #2563eb;
        }

        .action-btn.delete {
            background: #fee2e2;
            color: #dc2626;
        }

        .action-btn:hover {
            transform: translateY(-1px);
        }

    .clientes-empty {
        text-align: center;
        color: #6b7280;
        padding: 30px !important;
        border-radius: 18px !important;
    }

    .clientes-footer-table {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 18px;
        color: #6b7280;
        font-size: 14px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .clientes-pagination {
        display: flex;
        gap: 8px;
    }

    .page-btn {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: #f3f4f6;
        color: #374151;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: 800;
    }

        .page-btn.active,
        .page-btn:hover {
            background: #6D28D9;
            color: #fff;
        }

    .clientes-modal {
        border: none;
        border-radius: 24px;
        overflow: hidden;
    }

        .clientes-modal .modal-header {
            border-bottom: 1px solid #f1f5f9;
            padding: 20px 24px;
        }

        .clientes-modal .modal-title {
            font-weight: 800;
            color: #111827;
        }

        .clientes-modal .modal-body {
            padding: 24px;
        }

    .clientes-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

        .clientes-form-grid input,
        .clientes-form-grid select {
            height: 46px;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 0 14px;
            outline: none;
        }

            .clientes-form-grid input:focus,
            .clientes-form-grid select:focus {
                border-color: #6D28D9;
                box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.12);
            }

    @@media (max-width: 992px) {
        .clientes-stats-grid

    {
        grid-template-columns: repeat(2, 1fr);
    }

    }

    @@media (max-width: 576px) {
        .clientes-page

    {
        padding: 16px;
    }

    .clientes-stats-grid {
        grid-template-columns: 1fr;
    }

    .clientes-form-grid {
        grid-template-columns: 1fr;
    }

    .clientes-toolbar {
        flex-direction: column;
        align-items: stretch;
    }

        .clientes-search,
        .clientes-toolbar select,
        .clientes-btn {
            width: 100%;
        }

    }
</style>

<script>
    function abrirDetalleCliente(nombre, dni, celular, correo, genero) {
        document.getElementById("detalleNombre").innerText = nombre;
        document.getElementById("detalleDni").innerText = dni;
        document.getElementById("detalleCelular").innerText = celular;
        document.getElementById("detalleCorreo").innerText = correo;
        document.getElementById("detalleGenero").innerText = genero || "No especificado";

        new bootstrap.Modal(document.getElementById("modalDetalleCliente")).show();
    }

    function abrirEditarCliente(id, nombre, apellido, dni, celular, correo, genero, estadoActivo) {
        document.getElementById("editarId").value = id;
        document.getElementById("editarNombre").value = nombre;
        document.getElementById("editarApellido").value = apellido;
        document.getElementById("editarDni").value = dni;
        document.getElementById("editarCelular").value = celular;
        document.getElementById("editarCorreo").value = correo;
        document.getElementById("editarGenero").value = genero || "";
        document.getElementById("editarEstadoActivo").value = estadoActivo;

        new bootstrap.Modal(document.getElementById("modalEditarCliente")).show();
    }

    function abrirEliminarCliente(id, nombre) {
        document.getElementById("eliminarId").value = id;
        document.getElementById("eliminarNombre").innerText = nombre;

        new bootstrap.Modal(document.getElementById("modalEliminarCliente")).show();
    }
        document.getElementById("formEliminarCliente").addEventListener("submit", async function (e) {
        e.preventDefault();

        const form = e.target;
        const data = new FormData(form);

        const response = await fetch(form.action, {
            method: "POST",
            body: data
        });

        const result = await response.json();

        bootstrap.Modal.getInstance(document.getElementById("modalEliminarCliente")).hide();

        document.getElementById("mensajeIcono").innerText = result.ok ? "✅" : "⚠️";
        document.getElementById("mensajeTitulo").innerText = result.ok ? "Operación exitosa" : "No se pudo eliminar";
        document.getElementById("mensajeTexto").innerText = result.mensaje;

        new bootstrap.Modal(document.getElementById("modalMensajeCliente")).show();
    });
</script>