@model trabajo.Models.SolicitudCredito
@using trabajo.Models
@{
    Layout = null;
    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Ver Solicitud";
    ViewData["ActivePage"] = "VerSolicitud";

    decimal capacidadPago =
        Model.PERFIL_FINANCIERO.IngresoMensual * 0.30m;

    decimal disponiblePrestamo =
        capacidadPago * 10.5m;
    var historial = ViewBag.Historial as List<HistorialCredito>;
    var ultimoHistorial = historial?.LastOrDefault();
    var resumen = ViewBag.Resumen as ResumenCredito;

    int activas = resumen?.DeudasActivas ?? 0;
    int pagadas = resumen?.DeudasPagadas ?? 0;
    int vencidas = resumen?.DeudasVencidas ?? 0;
    int deudasEncontradas = activas + vencidas;
    bool tieneOtrosCreditos =
    Model.PERFIL_FINANCIERO?.OtrosCreditos ?? false;

    if (Model.PERFIL_FINANCIERO == null)
    {
        <text>No existe perfil financiero</text>
        return;
    }

    var ultimaActualizacion =
historial?.Max(x => x.FechaFin);

    int totalHistorial = activas + pagadas + vencidas;

    string nivelRiesgo = "";
    string claseColor = "";
    string posicionAguja = "";

    if (vencidas > 0)
    {
        nivelRiesgo = "CRÍTICO";
        claseColor = "critico";
        posicionAguja = "70deg";
    }
    else if (activas > 0 && pagadas > 0)
    {
        nivelRiesgo = "ALTO";
        claseColor = "alto";
        posicionAguja = "35deg";
    }
    else if (pagadas > 0)
    {
        nivelRiesgo = "BAJO";
        claseColor = "bajo";
        posicionAguja = "-70deg";
    }
    else
    {
        nivelRiesgo = "MEDIO";
        claseColor = "medio";
        posicionAguja = "-20deg";
    }
    var estadoNormalizado = Model.Estado?.Trim().ToLower();
    var estaEnEvaluacion = estadoNormalizado == "en evaluación";

}

