            height: 340px;
            border-radius: 50%;
            background: conic-gradient( #22c55e 0deg 45deg, /* Verde */
            #facc15 45deg 90deg, /* Amarillo */
            #f97316 90deg 135deg, /* Naranja */
            #ef4444 135deg 180deg /* Rojo */
            );
            transform: rotate(-90deg);
        }


        .medidor::after {
            content: '';
            position: absolute;
            width: 95px;
            height: 95px;
            background: white;
            border-radius: 50%;
