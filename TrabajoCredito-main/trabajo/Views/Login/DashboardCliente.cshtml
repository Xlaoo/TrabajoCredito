@if (ViewBag.MostrarResena == true)
{
    <div id="modalResena" class="modal-resena">
        <div class="resena-box">

            <div class="resena-logo">⭐</div>

            <h1>Califica nuestro servicio</h1>

            <p class="resena-subtitulo">
                Tu opinión nos ayuda a mejorar la atención, el proceso de crédito
                y la experiencia de nuestros clientes.
            </p>

            <div class="estrellas-resena">
                <span class="estrella" onclick="seleccionarEstrella(1)">★</span>
                <span class="estrella" onclick="seleccionarEstrella(2)">★</span>
                <span class="estrella" onclick="seleccionarEstrella(3)">★</span>
                <span class="estrella" onclick="seleccionarEstrella(4)">★</span>
                <span class="estrella" onclick="seleccionarEstrella(5)">★</span>
            </div>

            <textarea id="comentarioResena"
                      class="comentario-resena"
                      placeholder="Escribe tu opinión sobre el servicio..."></textarea>

            <div id="errorResena" class="error-resena">
                Debes seleccionar una calificación y escribir un comentario.
            </div>

            <button type="button"
                    class="btn-enviar-resena"
                    onclick="enviarResena()">
                Enviar reseña
            </button>

        </div>
    </div>
}
<script>

    const clientes = [

    @foreach (var c in Model)
    {
                        <text>
                                    {
                                        nombre: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(c.NombreCompleto))",
                                        comentario: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(c.Comentario))",
                                        estrellas: @c.Calificacion
                                    },
                        </text>
    }

    ];

    let indiceActual = 0;

    function renderClientes() {

        const grid = document.getElementById("clientsGrid");

        if (!grid) return;

        grid.innerHTML = "";

        const visibles = clientes.slice(indiceActual, indiceActual + 3);

        visibles.forEach(c => {

            let estrellas = "";

            for (let i = 0; i < c.estrellas; i++) {
                estrellas += "⭐";
            }

            grid.innerHTML += `
                <div class="client-card">
                    <i class="fas fa-user-circle"></i>
                    <div>
                        <strong>${c.nombre}</strong>
                        <p>${c.comentario}</p>
                        ${estrellas}
                    </div>
                </div>
            `;
        });

        document.getElementById("btnLeft").disabled =
            indiceActual === 0;

        document.getElementById("btnRight").disabled =
            indiceActual + 3 >= clientes.length;
    }

    function moverClientes(direccion) {

        if (direccion === 1 && indiceActual + 3 < clientes.length) {
            indiceActual++;
        }

        if (direccion === -1 && indiceActual > 0) {
            indiceActual--;
        }

        renderClientes();
    }
    let calificacionSeleccionada = 0;

    function seleccionarEstrella(valor) {
        calificacionSeleccionada = valor;

        document.querySelectorAll(".estrella").forEach((estrella, index) => {
            estrella.classList.toggle("activa", index < valor);
        });

        document.getElementById("errorResena").style.display = "none";
    }

    function enviarResena() {
        const comentario = document.getElementById("comentarioResena").value.trim();

        if (calificacionSeleccionada === 0 || comentario === "") {
            document.getElementById("errorResena").style.display = "block";
            return;
        }

        fetch('@Url.Action("GuardarResena", "Login")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body:
                'calificacion=' + encodeURIComponent(calificacionSeleccionada) +
                '&comentario=' + encodeURIComponent(comentario)
        })
        .then(r => r.json())
        .then(data => {
            alert(data.mensaje);

            if (data.ok) {
                document.getElementById("modalResena").style.display = "none";
            }
        })
        .catch(() => {
            alert("Error al guardar la reseña.");
        });
    }

       
    document.addEventListener("DOMContentLoaded", renderClientes);

</script>
<script src="~/js/config-global.js"></script>