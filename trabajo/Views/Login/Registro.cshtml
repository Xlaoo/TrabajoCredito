@model trabajo.Models.Usuario
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Registrarse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/utilidades-ui.css" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #240046, #3c096c, #4361ee, #00b4d8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .main-box {
            width: 1250px;
            min-height: 760px;
            display: flex;
            background: linear-gradient(135deg, #f3e8ff, #e0f2fe);
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,.35);
        }

        .left-panel {
            width: 42%;
            background: linear-gradient(160deg, #4cc9f0, #4361ee, #7209b7);
            color: white;
            padding: 55px 45px;
            position: relative;
            overflow: hidden;
        }

        .left-panel::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
            bottom: -90px;
            left: -90px;
        }

        .left-panel::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            top: 70px;
            right: -80px;
        }

        .logo {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
        }

            .logo img {
                width: 260px;
                height: auto;
                object-fit: contain;
            }

        .welcome {
            margin-top: 120px;
            position: relative;
            z-index: 2;
        }

        .password-rules {
            font-size: 15px;
            color: #64748b;
            padding-left: 22px;
        }

            .password-rules li {
                margin-bottom: 3px;
            }

        .welcome h1 {
            font-size: 48px;
            font-weight: bold;
        }

        .welcome p {
            font-size: 18px;
            opacity: .95;
            line-height: 1.6;
        }

        .credit-icon {
            font-size: 110px;
            margin-top: 45px;
        }

        .right-panel {
            width: 58%;
            padding: 50px 70px;
            background: linear-gradient(180deg, #c7d2fe, #a5b4fc, #bfdbfe);
        }

        .right-panel h2 {
                text-align: center;
                color: #3c096c;
                font-weight: bold;
                margin-bottom: 10px;
                font-size: 42px;
        }

        .subtitle {
            text-align: center;
            color: #6c757d;
            margin-bottom: 28px;
            font-size: 18px;
        }

        .form-control {
            height: 52px;
            border: none;
            background: #f1f5f9;
            border-radius: 12px;
            font-size: 17px;
            padding-left: 18px;
        }

        .form-control:focus {
            box-shadow: 0 0 0 2px rgba(67, 97, 238, .25);
            background: #fff;
        }

        .btn-code {
            background: linear-gradient(135deg, #ffd60a, #ff9f1c);
            border: none;
            color: #111;
            font-weight: bold;
            height: 52px;
            border-radius: 18px;
            font-size: 17px;
        }

        .btn-register {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border: none;
            color: white;
            font-weight: bold;
            height: 56px;
            border-radius: 18px;
            font-size: 18px;
        }

        .btn-register:hover,
        .btn-code:hover {
            opacity: .9;
        }

        .rules small {
            color: #475569;
            font-size: 12px;
        }

        .login-link {
            text-align: center;
            font-size: 18px;
        }

        @@media (max-width: 900px) {
            .main-box {
                width: 95%;
                flex-direction: column;
            }

            .left-panel, .right-panel {
                width: 100%;
            }

            .welcome {
                margin-top: 40px;
            }
        }
        /* ==========================================
           SEGURIDAD POR VOZ
           ========================================== */

        .seguridad-voz-box {
            background: rgba(255,255,255,.65);
            border: 1px solid rgba(67,97,238,.15);
            border-radius: 18px;
            padding: 18px;
        }

        .seguridad-voz-titulo {
            color: #3c096c;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .seguridad-voz-descripcion {
            color: #64748b;
            font-size: 13px;
            margin-bottom: 12px;
        }

        .btn-grabar-voz {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 14px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: white;
            font-weight: bold;
            font-size: 16px;
        }

            .btn-grabar-voz:hover {
                opacity: .9;
                color: white;
            }

            .btn-grabar-voz.grabando {
                background: linear-gradient(135deg, #dc2626, #ef4444);
            }

        .estado-voz {
            margin-top: 10px;
            text-align: center;
            color: #64748b;
            font-size: 13px;
        }
        /* ==========================================
           MODAL CONFIRMACIÓN VOZ
           ========================================== */

        .modal-voz {
            display: none;
            position: fixed;
            z-index: 9999;
            inset: 0;
            background: rgba(15, 23, 42, .65);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-voz-contenido {
            width: 100%;
            max-width: 500px;
            background: white;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 25px 70px rgba(0,0,0,.35);
            animation: aparecerModal .25s ease;
        }

        @@keyframes aparecerModal {
            from

        {
            opacity: 0;
            transform: scale(.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }

        }

        .modal-voz-icono {
            font-size: 60px;
            margin-bottom: 10px;
        }

        .modal-voz-titulo {
            color: #3c096c;
            font-size: 27px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .modal-voz-texto {
            color: #64748b;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .frase-detectada {
            background: #f1f5f9;
            border-radius: 14px;
            padding: 15px;
            margin: 15px 0 22px;
            color: #3c096c;
            font-size: 20px;
            font-weight: bold;
            min-height: 55px;
        }

        .modal-voz-botones {
            display: flex;
            gap: 12px;
        }

        .btn-voz-cancelar,
        .btn-voz-confirmar {
            flex: 1;
            height: 50px;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: bold;
        }

        .btn-voz-cancelar {
            background: #e2e8f0;
            color: #334155;
        }

        .btn-voz-confirmar {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: white;
        }

            .btn-voz-cancelar:hover,
            .btn-voz-confirmar:hover {
                opacity: .9;
            }
    </style>
</head>

<body>
    <div class="main-box">

        <div class="left-panel">
            <div class="logo">
                <img src="~/imagenes/credi.png" alt="CréditoPlus" />
            </div>

            <div class="welcome">
                <h1>Gestiona tus créditos</h1>
                <p>
                    Registra tu cuenta para administrar solicitudes,
                    verificar datos y acceder a tu panel de créditos.
                </p>

                <div class="credit-icon">💰</div>
            </div>
        </div>

        <div class="right-panel">
            <h2>Crear Cuenta</h2>
            <p class="subtitle">Completa tus datos para registrarte</p>

            <form asp-controller="Login"
                  asp-action="Registro"
                  method="post"
                  enctype="multipart/form-data"
                  id="formRegistro">

                <div class="input-util-wrap mb-2">
                    <input id="nombreInput"
                           class="form-control"
                           type="text"
                           placeholder="Nombre"
                           asp-for="Nombre"
                           required />

                    <button type="button" class="btn-clear" onclick="clearInput('nombreInput')">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-2">
                    <input id="apellidoInput"
                           class="form-control"
                           type="text"
                           placeholder="Apellido"
                           asp-for="Apellido"
                           required />

                    <button type="button" class="btn-clear" onclick="clearInput('apellidoInput')">
                        ✕
                    </button>
                </div>
                <select class="form-control mb-2"
                        asp-for="Genero"
                        required>

                    <option value="">Seleccione género</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>

                </select>

                <div class="input-util-wrap mb-2">
                    <input id="dniRegistro"
                           class="form-control"
                           type="text"
                           placeholder="DNI"
                           asp-for="Dni"
                           maxlength="8"
                           required
                           oninput="this.value=this.value.replace(/[^0-9]/g,'')" />

                    <button type="button" class="btn-clear" onclick="clearInput('dniRegistro')">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-2">
                    <input id="celularRegistro"
                           class="form-control"
                           type="text"
                           placeholder="Celular"
                           asp-for="Celular"
                           maxlength="9"
                           required
                           oninput="this.value=this.value.replace(/[^0-9]/g,'')" />

                    <button type="button" class="btn-clear" onclick="clearInput('celularRegistro')">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-2">
                    <input id="correoRegistro"
                           class="form-control"
                           type="email"
                           placeholder="Correo electrónico"
                           asp-for="Correo"
                           required />

                    <button type="button"
                            class="btn-clear"
                            onclick="clearInput('correoRegistro')">
                        ✕
                    </button>
                </div>

                <div class="d-grid gap-2 mb-2">
                    <button class="btn btn-code" type="button" onclick="enviarCodigo()">
                        Obtener código de verificación
                    </button>
                </div>

                <div class="input-util-wrap mb-2">
                    <input id="codigoRegistro"
                           class="form-control"
                           type="text"
                           placeholder="Código de verificación"
                           name="codigoVerificacion"
                           required />

                    <button type="button"
                            class="btn-clear"
                            onclick="clearInput('codigoRegistro')">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-2">

                    <input id="clave"
                           class="form-control"
                           type="password"
                           placeholder="Contraseña"
                           asp-for="clave"
                           required />

                    <button type="button"
                            class="btn-clear"
                            onclick="clearInput('clave')">
                        ✕
                    </button>

                    <button type="button"
                            class="btn-eye"
                            onclick="togglePassword('clave', this)">
                        👁
                    </button>

                </div>

                <ul class="password-rules mb-3">
                    <li id="mayus"> Una letra mayúscula</li>
                    <li id="minus"> Una letra minúscula</li>
                    <li id="numero"> Un número</li>
                    <li id="minimo"> Mínimo 6 caracteres</li>
                </ul>

                <div class="input-util-wrap mb-3">

                    <input id="confirmarClaveRegistro"
                           class="form-control"
                           type="password"
                           placeholder="Confirmar contraseña"
                           name="confirmarClave"
                           required />

                    <button type="button"
                            class="btn-clear"
                            onclick="clearInput('confirmarClaveRegistro')">
                        ✕
                    </button>

                    <button type="button"
                            class="btn-eye"
                            onclick="togglePassword('confirmarClaveRegistro', this)">
                        👁
                    </button>

                </div>
                <!-- ==========================================
                SEGURIDAD POR VOZ
                ========================================== -->

                <div class="seguridad-voz-box mb-3">

                    <div class="seguridad-voz-titulo">
                        🔐 Seguridad por voz
                    </div>

                    <p class="seguridad-voz-descripcion">
                        Graba una palabra o frase que usarás como seguridad.
                    </p>

                    <div class="input-util-wrap mb-2">

                        <input id="fraseVoz"
                               class="form-control"
                               type="text"
                               value="Mi voz protege mi cuenta"
                               asp-for="FraseVoz"
                               readonly />

                        <button type="button"
                                class="btn-clear"
                                onclick="limpiarFraseVoz()">
                            ✕
                        </button>

                    </div>

                    <button type="button"
                            id="btnGrabarVoz"
                            class="btn btn-grabar-voz"
                            onclick="iniciarGrabacionVoz()">

                        🎙️ Grabar mi voz

                    </button>

                    <div id="estadoVoz"
                         class="estado-voz">

                        ⚪ Aún no has grabado tu voz

                    </div>

                </div>
                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-register" type="submit">Registrate</button>
                </div>

                @if (ViewData["mensaje"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewData["mensaje"]
                    </div>
                }

                <div class="login-link">
                    ¿Ya tienes una cuenta?
                    <a href="@Url.Action("IniciarSesion", "Login")">Iniciar Sesión</a>
                </div>

            </form>
        </div>
    </div>
    <!-- ==========================================
     MODAL CONFIRMACIÓN DE VOZ
     ========================================== -->

    <div id="modalConfirmarVoz" class="modal-voz">

        <div class="modal-voz-contenido">

            <div class="modal-voz-icono">
                🎙️
            </div>

            <div class="modal-voz-titulo">
                Voz detectada
            </div>

            <div class="modal-voz-texto">
                Detectamos que dijiste:
            </div>

            <div id="textoDetectado" class="frase-detectada">
                ...
            </div>

            <div class="modal-voz-texto">
                ¿Deseas que esta sea tu voz de seguridad?
            </div>

            <div class="modal-voz-botones">

                <button type="button"
                        class="btn-voz-cancelar"
                        onclick="rechazarVoz()">
                    ❌ No, volver a grabar
                </button>

                <button type="button"
                        class="btn-voz-confirmar"
                        onclick="confirmarVoz()">
                    ✅ Sí, usar esta voz
                </button>

            </div>

        </div>

    </div>
    <script>

        function enviarCodigo() {
            let correo = document.querySelector('[name="Correo"]').value;

            if (correo.trim() === "") {
                alert("Primero escribe tu correo Gmail");
                return;
            }

            fetch('/Login/EnviarCodigo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: 'correo=' + encodeURIComponent(correo)
            })
            .then(res => res.json())
            .then(data => {
                alert(data.mensaje);
            })
            .catch(error => {
                alert("No se pudo enviar el código");
            });
        }
    </script>
    <script>
        const clave = document.getElementById("clave");

        const mayus = document.getElementById("mayus");
        const minus = document.getElementById("minus");
        const numero = document.getElementById("numero");
        const minimo = document.getElementById("minimo");

        clave.addEventListener("input", function () {
            let valor = clave.value;

            if (/[A-Z]/.test(valor)) {
                mayus.innerHTML = "✔ Una letra mayúscula";
                mayus.style.color = "green";
            } else {
                mayus.innerHTML = "❌ Una letra mayúscula";
                mayus.style.color = "#64748b";
            }

            if (/[a-z]/.test(valor)) {
                minus.innerHTML = "✔ Una letra minúscula";
                minus.style.color = "green";
            } else {
                minus.innerHTML = "❌ Una letra minúscula";
                minus.style.color = "#64748b";
            }

            if (/[0-9]/.test(valor)) {
                numero.innerHTML = "✔ Un número";
                numero.style.color = "green";
            } else {
                numero.innerHTML = "❌ Un número";
                numero.style.color = "#64748b";
            }

            if (valor.length >= 6) {
                minimo.innerHTML = "✔ Mínimo 6 caracteres";
                minimo.style.color = "green";
            } else {
                minimo.innerHTML = "❌ Mínimo 6 caracteres";
                minimo.style.color = "#64748b";
            }
        });

                     // ==========================================
        // VARIABLES DE GRABACIÓN
        // ==========================================

        let mediaRecorder = null;
        let audioChunks = [];
        let audioBlob = null;

        let grabando = false;
        let finalizandoGrabacion = false;

        // ==========================================
        // RECONOCIMIENTO DE VOZ
        // ==========================================

        let reconocimientoVoz = null;
        let textoDetectado = "";

        const SpeechRecognition =
            window.SpeechRecognition ||
            window.webkitSpeechRecognition;

        const reconocimientoDisponible = !!SpeechRecognition;


        // ==========================================
        // CONFIGURAR RECONOCIMIENTO
        // ==========================================

        if (reconocimientoDisponible) {

            reconocimientoVoz = new SpeechRecognition();

            reconocimientoVoz.lang = "es-PE";

            // Escuchar continuamente
            reconocimientoVoz.continuous = true;

            // Necesitamos resultados intermedios
            reconocimientoVoz.interimResults = true;

            reconocimientoVoz.onresult = function (event) {

                let textoFinal = "";

                for (
                    let i = event.resultIndex;
                    i < event.results.length;
                    i++
                ) {

                    const resultado = event.results[i];

                    if (resultado.isFinal) {

                        textoFinal +=
                            resultado[0].transcript.trim() + " ";
                    }
                }


                // Si reconoció una palabra o frase
                if (textoFinal.trim() !== "") {

                    textoDetectado += textoFinal;

                    console.log(
                        "Texto reconocido:",
                        textoDetectado
                    );

                    // ==========================================
                    // AQUÍ TERMINAMOS AUTOMÁTICAMENTE
                    // ==========================================

                    finalizarGrabacionAutomaticamente();
                }

            };


            reconocimientoVoz.onerror = function (event) {

                console.log(
                    "Error reconocimiento:",
                    event.error
                );

                /*
                 * Si ocurre "no-speech" no queremos cerrar
                 * la grabación.
                 *
                 * Simplemente seguimos esperando.
                 */

                if (event.error === "no-speech") {

                    return;
                }

                if (event.error === "aborted") {

                    return;
                }

                /*
                 * Otros errores
                 */

                console.error(
                    "Error de reconocimiento:",
                    event.error
                );

            };


            reconocimientoVoz.onend = function () {

                console.log(
                    "Reconocimiento terminado."
                );

            };

        }


        // ==========================================
        // INICIAR GRABACIÓN
        // ==========================================

        async function iniciarGrabacionVoz() {

            const boton =
                document.getElementById("btnGrabarVoz");

            const estado =
                document.getElementById("estadoVoz");


            // Si ya está grabando no hacemos nada
            if (grabando) {

                return;
            }


            // ==========================================
            // VERIFICAR SOPORTE
            // ==========================================

            if (
                !navigator.mediaDevices ||
                !navigator.mediaDevices.getUserMedia
            ) {

                alert(
                    "Tu navegador no permite grabar audio."
                );

                return;
            }


            if (!reconocimientoDisponible) {

                alert(
                    "Tu navegador no permite reconocer voz automáticamente. " +
                    "Usa Google Chrome o Microsoft Edge."
                );

                return;
            }


            try {

                // ==========================================
                // PEDIR MICRÓFONO
                // ==========================================

                const stream =
                    await navigator.mediaDevices.getUserMedia({
                        audio: true
                    });


                // Limpiar grabación anterior
                audioChunks = [];

                audioBlob = null;

                textoDetectado = "";

                finalizandoGrabacion = false;


                // ==========================================
                // CREAR GRABADOR
                // ==========================================

                mediaRecorder =
                    new MediaRecorder(stream);


                mediaRecorder.ondataavailable =
                    function (event) {

                        if (event.data.size > 0) {

                            audioChunks.push(
                                event.data
                            );

                        }

                    };


                // ==========================================
                // CUANDO TERMINE LA GRABACIÓN
                // ==========================================

                mediaRecorder.onstop =
                    function () {

                                audioBlob = new Blob(
            audioChunks,
            {
                type: "audio/webm"
            }
        );


                        // Liberar micrófono
                        stream
                            .getTracks()
                            .forEach(track => {
                                track.stop();
                            });


                        grabando = false;

                        boton.disabled = false;

                        boton.innerHTML =
                            "🎙️ Grabar mi voz";

                        boton.classList.remove(
                            "grabando"
                        );


                        // ==========================================
                        // MOSTRAR MODAL
                        // ==========================================

                        mostrarModalVoz();

                    };


                // ==========================================
                // COMENZAR GRABACIÓN
                // ==========================================

                mediaRecorder.start();

                grabando = true;


                // ==========================================
                // CAMBIAR INTERFAZ
                // ==========================================

                boton.disabled = true;

                boton.innerHTML =
                    "🎙️ Escuchando...";

                boton.classList.add(
                    "grabando"
                );


                estado.innerText =
                    "🟡 Esperando señal de voz... Habla ahora";


                // ==========================================
                // COMENZAR RECONOCIMIENTO
                // ==========================================

                textoDetectado = "";

                try {

                    reconocimientoVoz.start();

                }
                catch (error) {

                    console.log(
                        "El reconocimiento ya estaba iniciado.",
                        error
                    );

                }

            }
            catch (error) {

                console.error(error);

                grabando = false;

                alert(
                    "No se pudo acceder al micrófono. " +
                    "Verifica los permisos del navegador."
                );

            }

        }


        // ==========================================
        // FINALIZAR AUTOMÁTICAMENTE
        // ==========================================

        function finalizarGrabacionAutomaticamente() {

            // Evitar que se ejecute dos veces
            if (finalizandoGrabacion) {

                return;
            }

            if (!grabando) {

                return;
            }


            finalizandoGrabacion = true;


            const estado =
                document.getElementById("estadoVoz");


            estado.innerText =
                "🟢 Voz detectada. Procesando...";


            // ==========================================
            // DETENER RECONOCIMIENTO
            // ==========================================

            if (reconocimientoVoz) {

                try {

                    reconocimientoVoz.stop();

                }
                catch (error) {

                    console.log(error);

                }

            }


            // ==========================================
            // DETENER GRABACIÓN
            // ==========================================

            if (
                mediaRecorder &&
                mediaRecorder.state !== "inactive"
            ) {

                mediaRecorder.stop();

            }

        }


        // ==========================================
        // MOSTRAR MODAL
        // ==========================================

        function mostrarModalVoz() {

            const modal =
                document.getElementById(
                    "modalConfirmarVoz"
                );

            const texto =
                document.getElementById(
                    "textoDetectado"
                );


            let frase =
                textoDetectado.trim();


            // ==========================================
            // SI NO RECONOCIÓ NADA
            // ==========================================

            if (frase === "") {

                audioBlob = null;

                const estado =
                    document.getElementById(
                        "estadoVoz"
                    );

                estado.innerText =
                    "⚪ No pudimos reconocer tu voz. Intenta nuevamente.";

                finalizandoGrabacion = false;

                return;
            }


            // ==========================================
            // MOSTRAR TEXTO RECONOCIDO
            // ==========================================

            texto.innerText =
                frase;


            // ==========================================
            // ABRIR MODAL
            // ==========================================

            modal.style.display =
                "flex";

        }


        // ==========================================
        // CONFIRMAR VOZ
        // ==========================================

        function confirmarVoz() {

            const modal =
                document.getElementById(
                    "modalConfirmarVoz"
                );

            const estado =
                document.getElementById(
                    "estadoVoz"
                );

            const fraseInput =
                document.getElementById(
                    "fraseVoz"
                );


            const frase =
                textoDetectado.trim();


            // ==========================================
            // GUARDAR FRASE RECONOCIDA
            // ==========================================

            if (frase !== "") {

                fraseInput.value =
                    frase;

            }


            // ==========================================
            // CERRAR MODAL
            // ==========================================

            modal.style.display =
                "none";


            finalizandoGrabacion = false;


            estado.innerText =
                "🟢 Voz confirmada. Puedes registrarte.";

        }


        // ==========================================
        // RECHAZAR VOZ
        // ==========================================

        function rechazarVoz() {

            const modal =
                document.getElementById(
                    "modalConfirmarVoz"
                );

            const estado =
                document.getElementById(
                    "estadoVoz"
                );


            // ==========================================
            // ELIMINAR GRABACIÓN
            // ==========================================

            audioBlob = null;

            audioChunks = [];

            textoDetectado = "";

            finalizandoGrabacion = false;


            // ==========================================
            // CERRAR MODAL
            // ==========================================

            modal.style.display =
                "none";


            estado.innerText =
                "⚪ Grabación descartada. Pulsa «Grabar mi voz» para intentarlo nuevamente.";

        }


        // ==========================================
        // LIMPIAR FRASE
        // ==========================================

        function limpiarFraseVoz() {

            const fraseInput =
                document.getElementById(
                    "fraseVoz"
                );

            fraseInput.value = "";

            audioBlob = null;

            audioChunks = [];

            textoDetectado = "";


            const estado =
                document.getElementById(
                    "estadoVoz"
                );

            estado.innerText =
                "⚪ Aún no has grabado tu voz.";

        }


        // ==========================================
        // ENVIAR FORMULARIO
        // ==========================================

        document
            .getElementById("formRegistro")
            .addEventListener(
                "submit",
                function (event) {


                    // ==========================================
                    // VERIFICAR AUDIO
                    // ==========================================

                    if (!audioBlob) {

                        event.preventDefault();

                        alert(
                            "Debes grabar y confirmar tu voz antes de registrarte."
                        );

                        return;
                    }


                    const formulario = this;


                    const formData =
                        new FormData(
                            formulario
                        );


                    formData.delete(
                        "audio"
                    );


                    formData.append(
                        "audio",
                        audioBlob,
                        "audioRegistro.webm"
                    );


                    // ==========================================
                    // ENVIAR REGISTRO
                    // ==========================================

                    fetch(
                        formulario.action,
                        {
                            method: "POST",
                            body: formData
                        }
                    )
                    .then(response => {

                        if (response.redirected) {

                            window.location.href =
                                response.url;

                            return;
                        }

                        return response.text();

                    })
                    .then(html => {

                        if (html) {

                            document.open();

                            document.write(html);

                            document.close();

                        }

                    })
                    .catch(error => {

                        console.error(error);

                        alert(
                            "Ocurrió un error al registrar el usuario."
                        );

                    });

                }
            );


    </script>
    <script src="~/js/utilidades-ui.js"></script>
</body>
</html>