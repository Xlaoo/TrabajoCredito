@model trabajo.Models.Usuario
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Registrarse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/utilidades-ui.css" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #240046, #3c096c, #4361ee, #00b4d8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .main-box {
            width: 1250px;
            min-height: 760px;
            display: flex;
            background: linear-gradient(135deg, #f3e8ff, #e0f2fe);
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,.35);
        }

        .left-panel {
            width: 42%;
            background: linear-gradient(160deg, #4cc9f0, #4361ee, #7209b7);
            color: white;
            padding: 55px 45px;
            position: relative;
            overflow: hidden;
        }

        .left-panel::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
            bottom: -90px;
            left: -90px;
        }

        .left-panel::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            top: 70px;
            right: -80px;
        }

        .logo {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
        }

            .logo img {
                width: 260px;
                height: auto;
                object-fit: contain;
            }

        .welcome {
            margin-top: 120px;
            position: relative;
            z-index: 2;
        }

        .password-rules {
            font-size: 15px;
            color: #64748b;
            padding-left: 22px;
        }

            .password-rules li {
                margin-bottom: 3px;
            }

        .welcome h1 {
            font-size: 48px;
            font-weight: bold;
        }

        .welcome p {
            font-size: 18px;
            opacity: .95;
            line-height: 1.6;
        }

        .credit-icon {
            font-size: 110px;
            margin-top: 45px;
        }

        .right-panel {
            width: 58%;
            padding: 50px 70px;
            background: linear-gradient(180deg, #c7d2fe, #a5b4fc, #bfdbfe);
        }

        .right-panel h2 {
                text-align: center;
                color: #3c096c;
                font-weight: bold;
                margin-bottom: 10px;
                font-size: 42px;
        }

        .subtitle {
            text-align: center;
            color: #6c757d;
            margin-bottom: 28px;
            font-size: 18px;
        }

        .form-control {
            height: 52px;
            border: none;
            background: #f1f5f9;
            border-radius: 12px;
            font-size: 17px;
            padding-left: 18px;
        }

        .form-control:focus {
            box-shadow: 0 0 0 2px rgba(67, 97, 238, .25);
            background: #fff;
        }

        .btn-code {
            background: linear-gradient(135deg, #ffd60a, #ff9f1c);
            border: none;
            color: #111;
            font-weight: bold;
            height: 52px;
            border-radius: 18px;
            font-size: 17px;
        }

        .btn-register {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border: none;
            color: white;
            font-weight: bold;
            height: 56px;
            border-radius: 18px;
            font-size: 18px;
        }

        .btn-register:hover,
        .btn-code:hover {
            opacity: .9;
        }

        .rules small {
            color: #475569;
            font-size: 12px;
        }

        .login-link {
            text-align: center;
            font-size: 18px;
        }

        @@media (max-width: 900px) {
            .main-box {
                width: 95%;
                flex-direction: column;
            }

            .left-panel, .right-panel {
                width: 100%;
            }

            .welcome {
                margin-top: 40px;
            }
        }
        /* ==========================================
           SEGURIDAD POR VOZ
           ========================================== */

        .seguridad-voz-box {
            background: rgba(255,255,255,.65);
            border: 1px solid rgba(67,97,238,.15);
            border-radius: 18px;
            padding: 18px;
        }

        .seguridad-voz-titulo {
            color: #3c096c;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .seguridad-voz-descripcion {
            color: #64748b;
            font-size: 13px;
            margin-bottom: 12px;
        }

        .btn-grabar-voz {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 14px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: white;
            font-weight: bold;
            font-size: 16px;
        }

            .btn-grabar-voz:hover {
                opacity: .9;
                color: white;
            }

            .btn-grabar-voz.grabando {
                background: linear-gradient(135deg, #dc2626, #ef4444);
            }

        .estado-voz {
            margin-top: 10px;
            text-align: center;
            color: #64748b;
            font-size: 13px;
        }
        /* ==========================================
           MODAL CONFIRMACIÓN VOZ
           ========================================== */

        .modal-voz {
            display: none;
            position: fixed;
            z-index: 9999;
            inset: 0;
            background: rgba(15, 23, 42, .65);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-voz-contenido {
            width: 100%;
            max-width: 500px;
            background: white;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 25px 70px rgba(0,0,0,.35);
            animation: aparecerModal .25s ease;
        }

        @@keyframes aparecerModal {
            from

        {
            opacity: 0;
            transform: scale(.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }

        }

        .modal-voz-icono {
            font-size: 60px;
            margin-bottom: 10px;
        }

        .modal-voz-titulo {
            color: #3c096c;
            font-size: 27px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .modal-voz-texto {
            color: #64748b;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .frase-detectada {
            background: #f1f5f9;
            border-radius: 14px;
            padding: 15px;
            margin: 15px 0 22px;
            color: #3c096c;
            font-size: 20px;
            font-weight: bold;
            min-height: 55px;
        }

        .modal-voz-botones {
            display: flex;
            gap: 12px;
        }

        .btn-voz-cancelar,
        .btn-voz-confirmar {
            flex: 1;
            height: 50px;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: bold;
        }

        .btn-voz-cancelar {
            background: #e2e8f0;
            color: #334155;
        }

        .btn-voz-confirmar {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: white;
        }

            .btn-voz-cancelar:hover,
            .btn-voz-confirmar:hover {
                opacity: .9;
            }

        /* ==========================================
           MODAL VERIFICACIÓN CORREO OTP (CREDIPLUS)
           ========================================== */
        .otp-container {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin: 18px 0;
        }

        .otp-box {
            width: 46px;
            height: 54px;
            font-size: 26px;
            font-weight: 800;
            text-align: center;
            border: 2px solid #cbd5e1;
            border-radius: 12px;
            background: #f8fafc;
            color: #1e293b;
            transition: all 0.2s ease;
        }

        .otp-box:focus {
            border-color: #4361ee;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.25);
            outline: none;
        }

        .otp-timer {
            font-size: 14px;
            font-weight: 700;
            margin: 10px 0;
        }

        .otp-timer.activo {
            color: #4361ee;
        }

        .otp-timer.expirado {
            color: #dc2626;
        }

        .badge-verificado {
            display: none;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background: #dcfce7;
            border: 1px solid #86efac;
            color: #166534;
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            animation: aparecerModal 0.25s ease;
        }

        .btn-verificar-correo {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: white;
            border: none;
            font-weight: bold;
            border-radius: 12px;
            padding: 0 16px;
            font-size: 13px;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .btn-verificar-correo:hover:not(:disabled) {
            background: linear-gradient(135deg, #3730a3, #581c87);
            color: white;
            transform: translateY(-1px);
        }

        .btn-verificar-correo:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
    </style>
</head>

<body>
    <div class="main-box">

        <div class="left-panel">
            <div class="logo">
                <img src="~/imagenes/credi.png" alt="CréditoPlus" />
            </div>

            <div class="welcome">
                <h1>Gestiona tus créditos</h1>
                <p>
                    Registra tu cuenta para administrar solicitudes,
                    verificar datos y acceder a tu panel de créditos.
                </p>

                <div class="credit-icon">💰</div>
            </div>
        </div>

        <div class="right-panel">
            <h2>Crear Cuenta</h2>
            <p class="subtitle">Completa tus datos para registrarte</p>

            <form asp-controller="Login"
                  asp-action="Registro"
                  method="post"
                  enctype="multipart/form-data"
                  id="formRegistro">

                <div class="input-util-wrap mb-2">
                    <input id="nombreInput"
                           class="form-control"
                           type="text"
                           placeholder="Nombre"
                           asp-for="Nombre"
                           required />

                    <button type="button" class="btn-clear" onclick="clearInput('nombreInput')">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-2">
                    <input id="apellidoInput"
                           class="form-control"
                           type="text"
                           placeholder="Apellido"
                           asp-for="Apellido"
                           required />

                    <button type="button" class="btn-clear" onclick="clearInput('apellidoInput')">
                        ✕
                    </button>
                </div>
                <select class="form-control mb-2"
                        asp-for="Genero"
                        required>

                    <option value="">Seleccione género</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>

                </select>

                <div class="input-util-wrap mb-2">
                    <input id="dniRegistro"
                           class="form-control"
                           type="text"
                           placeholder="DNI"
                           asp-for="Dni"
                           maxlength="8"
                           required
                           oninput="this.value=this.value.replace(/[^0-9]/g,'')" />

                    <button type="button" class="btn-clear" onclick="clearInput('dniRegistro')">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-2">
                    <input id="celularRegistro"
                           class="form-control"
                           type="text"
                           placeholder="Celular"
                           asp-for="Celular"
                           maxlength="9"
                           required
                           oninput="this.value=this.value.replace(/[^0-9]/g,'')" />

                    <button type="button" class="btn-clear" onclick="clearInput('celularRegistro')">
                        ✕
                    </button>
                </div>

                <div class="mb-2">
                    <div class="d-flex gap-2">
                        <div class="input-util-wrap flex-grow-1">
                            <input id="correoRegistro"
                                   class="form-control"
                                   type="email"
                                   placeholder="Correo (Gmail, Hotmail, Outlook)"
                                   asp-for="Correo"
                                   required />

                            <button type="button"
                                    class="btn-clear"
                                    onclick="clearInput('correoRegistro')">
                                ✕
                            </button>
                        </div>
                        <button id="btnVerificarCorreo"
                                class="btn btn-verificar-correo"
                                type="button"
                                onclick="iniciarVerificacionCorreo()">
                            ✉️ VERIFICAR CORREO
                        </button>
                    </div>

                    <!-- Badge de confirmación visual -->
                    <div id="badgeCorreoVerificado" class="badge-verificado mt-2">
                        <span>✅</span> CORREO VERIFICADO CORRECTAMENTE
                    </div>
                </div>

                <!-- Campo oculto para compatibilidad con el formulario POST -->
                <input type="hidden" id="codigoRegistro" name="codigoVerificacion" value="" />




                <div class="input-util-wrap mb-2">

                    <input id="clave"
                           class="form-control"
                           type="password"
                           placeholder="Contraseña"
                           asp-for="clave"
                           required />

                    <button type="button"
                            class="btn-clear"
                            onclick="clearInput('clave')">
                        ✕
                    </button>

                    <button type="button"
                            class="btn-eye"
                            onclick="togglePassword('clave', this)">
                        👁
                    </button>

                </div>

                <ul class="password-rules mb-3">
                    <li id="minimo"> Mínimo 12 caracteres</li>
                    <li id="mayus"> Una letra mayúscula</li>
                    <li id="minus"> Una letra minúscula</li>
                    <li id="numero"> Un número</li>
                    <li id="simbolo"> Un símbolo o carácter especial (!@@#$%&*?_-+)</li>
                </ul>

                <div class="input-util-wrap mb-3">

                    <input id="confirmarClaveRegistro"
                           class="form-control"
                           type="password"
                           placeholder="Confirmar contraseña"
                           name="confirmarClave"
                           required />

                    <button type="button"
                            class="btn-clear"
                            onclick="clearInput('confirmarClaveRegistro')">
                        ✕
                    </button>

                    <button type="button"
                            class="btn-eye"
                            onclick="togglePassword('confirmarClaveRegistro', this)">
                        👁
                    </button>

                </div>

                @if (!string.IsNullOrEmpty(ViewBag.TurnstileSiteKey as string))
                {
                    <div class="mb-3 d-flex justify-content-center">
                        <div class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey" data-appearance="interaction-only" data-theme="light" data-language="es"></div>
                    </div>
                }

                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-register" type="submit">Registrate</button>
                </div>

                @if (ViewData["mensaje"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewData["mensaje"]
                    </div>
                }

                <div class="login-link">
                    ¿Ya tienes una cuenta?
                    <a href="@Url.Action("IniciarSesion", "Login")">Iniciar Sesión</a>
                </div>

            </form>
        </div>
    </div>
    <div id="modalMensajeRegistro"
         class="modal-voz">

        <div class="modal-voz-contenido"
             style="max-width: 380px;">

            <div id="iconoMensajeRegistro"
                 style="font-size:55px;">
                ✅
            </div>

            <div id="tituloMensajeRegistro"
                 class="modal-voz-titulo">
                CrediPlus
            </div>

            <div id="textoMensajeRegistro"
                 class="modal-voz-texto"
                 style="font-size:17px;">
            </div>

            <button type="button"
                    class="btn btn-primary w-100 mt-3"
                    onclick="cerrarMensajeRegistro()">
                OK
            </button>

        </div>

    </div>

    <!-- ==========================================
         MODAL DE VERIFICACIÓN OTP DE CORREO (6 DÍGITOS - 60s)
         ========================================== -->
    <div id="modalOtpCorreo" class="modal-voz">
        <div class="modal-voz-contenido" style="max-width: 460px;">
            <div class="modal-voz-icono" style="font-size: 50px;">📧</div>
            <div class="modal-voz-titulo" style="font-size: 24px; margin-bottom: 8px;">
                Verificación de Correo
            </div>
            <div class="modal-voz-texto" style="font-size: 14px; margin-bottom: 6px;">
                Ingresa el código numérico de 6 dígitos enviado a:
            </div>
            <div id="modalCorreoDestino" style="font-weight: bold; color: #1e293b; font-size: 15px; margin-bottom: 12px; word-break: break-all;">
                correo@ejemplo.com
            </div>

            <!-- 6 Casillas individuales de OTP con auto-enfoque y soporte para pegar -->
            <div class="otp-container">
                <input type="text" class="otp-box" id="otp-0" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-1" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-2" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-3" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-4" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-5" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
            </div>

            <!-- Temporizador estricto de 60 segundos -->
            <div id="otpTimerDisplay" class="otp-timer activo">
                ⏳ Código válido por: <span id="otpTimerContador">01:00</span>
            </div>

            <!-- Mensaje de estado / error dentro del modal -->
            <div id="otpMensajeModal" style="display: none; font-size: 13px; font-weight: 600; padding: 8px; border-radius: 8px; margin-bottom: 14px;"></div>

            <!-- Botones de acción del modal -->
            <div class="modal-voz-botones">
                <button type="button" class="btn-voz-cancelar" onclick="cerrarModalOtp()">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmarOtp" class="btn-voz-confirmar" style="background: linear-gradient(135deg, #4361ee, #7209b7); color: white;" onclick="confirmarOtpRegistro()">
                    Verificar
                </button>
            </div>

            <!-- Reenviar código -->
            <div class="mt-3">
                <button type="button" id="btnReenviarOtp" class="btn btn-link text-decoration-none" style="font-size: 13px; font-weight: 600; color: #4361ee;" onclick="reenviarOtpRegistro()" disabled>
                    🔄 Reenviar nuevo código
                </button>
            </div>
        </div>
    </div>
    <script>
        // ==========================================
        // VERIFICACIÓN DE CORREO ELECTRÓNICO (OTP 60s)
        // ==========================================

        let correoVerificado = false;
        let correoVerificadoTexto = "";
        let intervaloOtpTimer = null;
        let segundosOtpTimer = 60;
        let enviandoOtp = false;

        const regexDominiosPermitidos = /^[A-Za-z0-9._%+-]+@@(gmail\.com|hotmail\.com|hotmail\.es|outlook\.com|outlook\.es|live\.com)$/i;

        // Invalida verificación si el usuario cambia el correo después de verificarlo
        const inputCorreoReg = document.getElementById("correoRegistro");
        if (inputCorreoReg) {
            inputCorreoReg.addEventListener("input", function () {
                const correoActual = this.value.trim().toLowerCase();
                if (correoVerificado && correoActual !== correoVerificadoTexto) {
                    correoVerificado = false;
                    correoVerificadoTexto = "";
                    const badge = document.getElementById("badgeCorreoVerificado");
                    if (badge) badge.style.display = "none";
                    const cod = document.getElementById("codigoRegistro");
                    if (cod) cod.value = "";
                    const btn = document.getElementById("btnVerificarCorreo");
                    if (btn) {
                        btn.disabled = false;
                        btn.innerText = "✉️ VERIFICAR CORREO";
                    }
                }
            });
        }

        function obtenerCodigoOtpIngresado() {
            let codigo = "";
            for (let i = 0; i < 6; i++) {
                const box = document.getElementById(`otp-${i}`);
                codigo += box ? box.value.trim() : "";
            }
            return codigo;
        }

        function limpiarCasillasOtp() {
            for (let i = 0; i < 6; i++) {
                const box = document.getElementById(`otp-${i}`);
                if (box) {
                    box.value = "";
                    box.disabled = false;
                }
            }
            const msg = document.getElementById("otpMensajeModal");
            if (msg) {
                msg.style.display = "none";
                msg.innerText = "";
            }
        }

        function configurarInputsOtp() {
            for (let i = 0; i < 6; i++) {
                const box = document.getElementById(`otp-${i}`);
                if (!box) continue;

                box.addEventListener("input", function () {
                    this.value = this.value.replace(/[^0-9]/g, "");
                    if (this.value.length >= 1) {
                        this.value = this.value.charAt(0);
                        if (i < 5) {
                            const next = document.getElementById(`otp-${i + 1}`);
                            if (next) next.focus();
                        } else {
                            confirmarOtpRegistro();
                        }
                    }
                });

                box.addEventListener("keydown", function (e) {
                    if (e.key === "Backspace" && this.value === "" && i > 0) {
                        const prev = document.getElementById(`otp-${i - 1}`);
                        if (prev) {
                            prev.focus();
                            prev.value = "";
                        }
                    } else if (e.key === "Enter") {
                        confirmarOtpRegistro();
                    }
                });

                box.addEventListener("paste", function (e) {
                    e.preventDefault();
                    const pegado = (e.clipboardData || window.clipboardData).getData("text").replace(/[^0-9]/g, "");
                    if (pegado.length >= 6) {
                        for (let j = 0; j < 6; j++) {
                            const b = document.getElementById(`otp-${j}`);
                            if (b) b.value = pegado.charAt(j);
                        }
                        const ultimo = document.getElementById("otp-5");
                        if (ultimo) ultimo.focus();
                        confirmarOtpRegistro();
                    }
                });
            }
        }

        async function iniciarVerificacionCorreo() {
            const inputCorreo = document.getElementById("correoRegistro");
            const correo = inputCorreo.value.trim().toLowerCase();

            if (correo === "") {
                mostrarMensajeRegistro("Primero escribe tu correo electrónico.", true);
                inputCorreo.focus();
                return;
            }

            if (!regexDominiosPermitidos.test(correo)) {
                mostrarMensajeRegistro("Ingresa un correo válido (Gmail, Hotmail o Outlook).", true);
                inputCorreo.focus();
                return;
            }

            if (enviandoOtp) return;
            enviandoOtp = true;

            const btn = document.getElementById("btnVerificarCorreo");
            btn.disabled = true;
            btn.innerText = "Enviando...";

            try {
                const respuesta = await fetch("/Login/EnviarCodigo", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: "correo=" + encodeURIComponent(correo)
                });

                const data = await respuesta.json();
                enviandoOtp = false;

                if (!data.ok) {
                    btn.disabled = false;
                    btn.innerText = "✉️ VERIFICAR CORREO";
                    mostrarMensajeRegistro(data.mensaje || "No se pudo enviar el código.", true);
                    return;
                }

                abrirModalOtp(correo);
            } catch (err) {
                enviandoOtp = false;
                btn.disabled = false;
                btn.innerText = "✉️ VERIFICAR CORREO";
                mostrarMensajeRegistro("Error de conexión al enviar el código de verificación.", true);
            }
        }

        function abrirModalOtp(correo) {
            document.getElementById("modalCorreoDestino").innerText = correo;
            limpiarCasillasOtp();
            iniciarCuentaRegresivaOtp();

            const modal = document.getElementById("modalOtpCorreo");
            modal.style.display = "flex";

            setTimeout(() => {
                const primero = document.getElementById("otp-0");
                if (primero) primero.focus();
            }, 150);
        }

        function cerrarModalOtp() {
            detenerCuentaRegresivaOtp();
            const modal = document.getElementById("modalOtpCorreo");
            modal.style.display = "none";

            const btn = document.getElementById("btnVerificarCorreo");
            if (!correoVerificado && btn) {
                btn.disabled = false;
                btn.innerText = "✉️ VERIFICAR CORREO";
            }
        }

        function iniciarCuentaRegresivaOtp() {
            detenerCuentaRegresivaOtp();
            segundosOtpTimer = 60;

            const timerDisplay = document.getElementById("otpTimerDisplay");
            const contadorSpan = document.getElementById("otpTimerContador");
            const btnReenviar = document.getElementById("btnReenviarOtp");
            const btnConfirmar = document.getElementById("btnConfirmarOtp");

            timerDisplay.className = "otp-timer activo";
            contadorSpan.innerText = "01:00";
            btnReenviar.disabled = true;
            btnConfirmar.disabled = false;

            for (let i = 0; i < 6; i++) {
                const box = document.getElementById(`otp-${i}`);
                if (box) box.disabled = false;
            }

            intervaloOtpTimer = setInterval(function () {
                segundosOtpTimer--;

                if (segundosOtpTimer > 0) {
                    const segStr = segundosOtpTimer < 10 ? "0" + segundosOtpTimer : segundosOtpTimer;
                    contadorSpan.innerText = "00:" + segStr;
                } else {
                    detenerCuentaRegresivaOtp();
                    timerDisplay.className = "otp-timer expirado";
                    timerDisplay.innerText = "⏰ El código ha expirado (límite 60s).";
                    btnReenviar.disabled = false;
                    btnConfirmar.disabled = true;

                    for (let i = 0; i < 6; i++) {
                        const box = document.getElementById(`otp-${i}`);
                        if (box) box.disabled = true;
                    }
                }
            }, 1000);
        }

        function detenerCuentaRegresivaOtp() {
            if (intervaloOtpTimer) {
                clearInterval(intervaloOtpTimer);
                intervaloOtpTimer = null;
            }
        }

        async function reenviarOtpRegistro() {
            const inputCorreo = document.getElementById("correoRegistro");
            const correo = inputCorreo.value.trim().toLowerCase();

            const btnReenviar = document.getElementById("btnReenviarOtp");
            btnReenviar.disabled = true;
            btnReenviar.innerText = "Enviando...";

            try {
                const respuesta = await fetch("/Login/EnviarCodigo", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: "correo=" + encodeURIComponent(correo)
                });

                const data = await respuesta.json();
                btnReenviar.innerText = "🔄 Reenviar nuevo código";

                if (!data.ok) {
                    mostrarMensajeModalOtp(data.mensaje || "No se pudo reenviar el código.", true);
                    btnReenviar.disabled = false;
                    return;
                }

                limpiarCasillasOtp();
                iniciarCuentaRegresivaOtp();
                mostrarMensajeModalOtp("Nuevo código de 6 dígitos enviado.", false);

                const primero = document.getElementById("otp-0");
                if (primero) primero.focus();
            } catch (err) {
                btnReenviar.disabled = false;
                btnReenviar.innerText = "🔄 Reenviar nuevo código";
                mostrarMensajeModalOtp("Error de conexión al reenviar.", true);
            }
        }

        function mostrarMensajeModalOtp(mensaje, esError) {
            const msg = document.getElementById("otpMensajeModal");
            if (!msg) return;

            msg.innerText = mensaje;
            msg.style.display = "block";
            msg.style.backgroundColor = esError ? "#fee2e2" : "#dcfce7";
            msg.style.color = esError ? "#991b1b" : "#166534";
            msg.style.border = esError ? "1px solid #fca5a5" : "1px solid #86efac";
        }

        async function confirmarOtpRegistro() {
            const correo = document.getElementById("correoRegistro").value.trim().toLowerCase();
            const codigo = obtenerCodigoOtpIngresado();

            if (codigo.length !== 6) {
                mostrarMensajeModalOtp("Ingresa los 6 dígitos del código.", true);
                return;
            }

            const btnConfirmar = document.getElementById("btnConfirmarOtp");
            btnConfirmar.disabled = true;
            btnConfirmar.innerText = "Verificando...";

            try {
                const respuesta = await fetch("/Login/ConfirmarCodigoRegistro", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: `correo=${encodeURIComponent(correo)}&codigo=${encodeURIComponent(codigo)}`
                });

                const data = await respuesta.json();
                btnConfirmar.disabled = false;
                btnConfirmar.innerText = "Verificar";

                if (!data.ok) {
                    mostrarMensajeModalOtp(data.mensaje || "Código incorrecto.", true);
                    if (data.expirado) {
                        detenerCuentaRegresivaOtp();
                        document.getElementById("btnReenviarOtp").disabled = false;
                        document.getElementById("btnConfirmarOtp").disabled = true;
                    }
                    return;
                }

                // Verificación exitosa
                correoVerificado = true;
                correoVerificadoTexto = correo;
                document.getElementById("codigoRegistro").value = codigo;

                detenerCuentaRegresivaOtp();
                cerrarModalOtp();

                // Actualizar interfaz del formulario
                const badge = document.getElementById("badgeCorreoVerificado");
                if (badge) badge.style.display = "inline-flex";

                const btnVerificar = document.getElementById("btnVerificarCorreo");
                if (btnVerificar) {
                    btnVerificar.innerText = "✅ VERIFICADO";
                    btnVerificar.disabled = true;
                }

                mostrarMensajeRegistro("¡Correo electrónico verificado exitosamente!", false);
            } catch (err) {
                btnConfirmar.disabled = false;
                btnConfirmar.innerText = "Verificar";
                mostrarMensajeModalOtp("Error de conexión al verificar el código.", true);
            }
        }

        // Configurar los listeners en las casillas OTP
        document.addEventListener("DOMContentLoaded", function () {
            configurarInputsOtp();
        });
        configurarInputsOtp();
    </script>
    <script>
        const clave = document.getElementById("clave");

        const mayus = document.getElementById("mayus");
        const minus = document.getElementById("minus");
        const numero = document.getElementById("numero");
        const simbolo = document.getElementById("simbolo");
        const minimo = document.getElementById("minimo");

        clave.addEventListener("input", function () {
            let valor = clave.value;

            if (/[A-Z]/.test(valor)) {
                mayus.innerHTML = "✔ Una letra mayúscula";
                mayus.style.color = "green";
            } else {
                mayus.innerHTML = "❌ Una letra mayúscula";
                mayus.style.color = "#64748b";
            }

            if (/[a-z]/.test(valor)) {
                minus.innerHTML = "✔ Una letra minúscula";
                minus.style.color = "green";
            } else {
                minus.innerHTML = "❌ Una letra minúscula";
                minus.style.color = "#64748b";
            }

            if (/[0-9]/.test(valor)) {
                numero.innerHTML = "✔ Un número";
                numero.style.color = "green";
            } else {
                numero.innerHTML = "❌ Un número";
                numero.style.color = "#64748b";
            }

            if (/[^a-zA-Z0-9\s]/.test(valor)) {
                if (simbolo) {
                    simbolo.innerHTML = "✔ Un símbolo especial (!@@#$%&*...)";
                    simbolo.style.color = "green";
                }
            } else {
                if (simbolo) {
                    simbolo.innerHTML = "❌ Un símbolo especial (!@@#$%&*...)";
                    simbolo.style.color = "#64748b";
                }
            }

            if (valor.length >= 12) {
                minimo.innerHTML = "✔ Mínimo 12 caracteres";
                minimo.style.color = "green";
            } else {
                minimo.innerHTML = "❌ Mínimo 12 caracteres";
                minimo.style.color = "#64748b";
            }
        });

        // ==========================================
        // ENVIAR FORMULARIO
        // ==========================================

        let enviandoRegistro = false;

        document
            .getElementById("formRegistro")
            .addEventListener("submit", async function (event) {

                // ==========================================
                // EVITAR DOBLE CLIC
                // ==========================================

                event.preventDefault();

                if (enviandoRegistro) {
                    return;
                }

                enviandoRegistro = true;

                const formulario = this;
                const botonRegistro = formulario.querySelector(
                    'button[type="submit"]'
                );

                // Bloquear botón inmediatamente
                if (botonRegistro) {
                    botonRegistro.disabled = true;
                    botonRegistro.innerText = "Registrando...";
                }

                // ==========================================
                // VERIFICAR CORREO ELECTRÓNICO
                // ==========================================

                if (!correoVerificado) {
                    mostrarMensajeRegistro(
                        "Debes verificar tu correo electrónico antes de registrarte.",
                        true
                    );

                    enviandoRegistro = false;

                    if (botonRegistro) {
                        botonRegistro.disabled = false;
                        botonRegistro.innerText = "Registrate";
                    }

                    const btnVerificar = document.getElementById("btnVerificarCorreo");
                    if (btnVerificar) btnVerificar.focus();

                    return;
                }

                // ==========================================
                // VERIFICAR TURNSTILE
                // ==========================================

                const turnstileInput = formulario.querySelector('[name="cf-turnstile-response"]');
                const turnstileToken = turnstileInput ? turnstileInput.value : "";
                const turnstileWidget = formulario.querySelector('.cf-turnstile');
                if (turnstileWidget && !turnstileToken) {
                    mostrarMensajeRegistro(
                        "Verificación de seguridad pendiente. Por favor espera un momento...",
                        true
                    );
                    enviandoRegistro = false;
                    if (botonRegistro) {
                        botonRegistro.disabled = false;
                        botonRegistro.innerText = "Registrate";
                    }
                    return;
                }

                // ==========================================
                // CREAR FORMDATA (SIN AUDIO)
                // ==========================================

                const formData = new FormData(formulario);
                formData.delete("audio");

                try {

            const response = await fetch(
                formulario.action,
                {
                    method: "POST",
                    body: formData
                }
            );

            // ==========================================
            // COMPROBAR TIPO DE RESPUESTA
            // ==========================================

            const contentType =
                response.headers.get("content-type") || "";

            // ==========================================
            // RESPUESTA JSON = REGISTRO CORRECTO
            // ==========================================

            if (contentType.includes("application/json")) {

                const resultado =
                    await response.json();

                console.log(
                    "Respuesta registro:",
                    resultado
                );

        if (!resultado.ok) {

            mostrarMensajeRegistro(
                resultado.mensaje ||
                "No se pudo registrar el usuario."
            );

            // Si sabemos qué campo tiene el error,
            // solamente seleccionamos ese campo.
            // NO limpiamos el formulario.
            // NO eliminamos audioBlob.

            if (resultado.campo) {

                const campo =
                    document.getElementById(
                        resultado.campo
                    );

                if (campo) {

                    campo.focus();

                }

            }

            enviandoRegistro = false;

            if (typeof turnstile !== "undefined") {
                try { turnstile.reset(); } catch (e) {}
            }

            if (botonRegistro) {

                botonRegistro.disabled = false;

                botonRegistro.innerText =
                    "Registrate";

            }

            return;
        }

                // ==========================================
                // MOSTRAR ÉXITO EN REGISTRO
                // ==========================================

                const estado =
                    document.getElementById("estadoVoz");

                if (estado) {
                    estado.innerText =
                        "✅ Usuario registrado exitosamente.";

                    estado.style.color =
                        "#16a34a";
                }

                if (botonRegistro) {

                    botonRegistro.innerText =
                        "✅ Registrado correctamente";

                    botonRegistro.disabled = true;
                }

                // ==========================================
                // IR AL LOGIN
                // ==========================================

                setTimeout(function () {

                    window.location.href =
                        resultado.redirectUrl;

                }, 1200);

                return;
            }

        }
        catch (error) {

            console.error(
                "Error al registrar:",
                error
            );

            alert(
                "Ocurrió un error al registrar el usuario."
            );

            enviandoRegistro = false;

            if (botonRegistro) {
                botonRegistro.disabled = false;
                botonRegistro.innerText = "Registrate";
            }
        }

            });

        function mostrarMensajeRegistro(
            mensaje,
            esError = true
        ) {

            const modal =
                document.getElementById(
                    "modalMensajeRegistro"
                );

            const texto =
                document.getElementById(
                    "textoMensajeRegistro"
                );

            const icono =
                document.getElementById(
                    "iconoMensajeRegistro"
                );

            const titulo =
                document.getElementById(
                    "tituloMensajeRegistro"
                );

            texto.innerText =
                mensaje;

            if (esError) {

                icono.innerText = "⚠️";

                titulo.innerText =
                    "Revisa tus datos";

            }
            else {

                icono.innerText = "✅";

                titulo.innerText =
                    "CrediPlus";

            }

            modal.style.display =
                "flex";
        }


        function cerrarMensajeRegistro() {

            const modal =
                document.getElementById(
                    "modalMensajeRegistro"
                );

            modal.style.display =
                "none";
        }
        



    </script>
    <script src="~/js/utilidades-ui.js"></script>
</body>
</html>