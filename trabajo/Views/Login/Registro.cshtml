@model trabajo.Models.Usuario
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Registrarse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/utilidades-ui.css" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #240046, #3c096c, #4361ee, #00b4d8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .main-box {
            width: 1250px;
            min-height: 760px;
            display: flex;
            background: linear-gradient(135deg, #f3e8ff, #e0f2fe);
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,.35);
        }

        .left-panel {
            width: 42%;
            background: linear-gradient(160deg, #4cc9f0, #4361ee, #7209b7);
            color: white;
            padding: 55px 45px;
            position: relative;
            overflow: hidden;
        }

        .left-panel::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
            bottom: -90px;
            left: -90px;
        }

        .left-panel::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            top: 70px;
            right: -80px;
        }

        .logo {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
        }

            .logo img {
                width: 260px;
                height: auto;
                object-fit: contain;
            }

        .welcome {
            margin-top: 120px;
            position: relative;
            z-index: 2;
        }

        .password-rules {
            font-size: 15px;
            color: #64748b;
            padding-left: 22px;
        }

            .password-rules li {
                margin-bottom: 3px;
            }

        .welcome h1 {
            font-size: 48px;
            font-weight: bold;
        }

        .welcome p {
            font-size: 18px;
            opacity: .95;
            line-height: 1.6;
        }

        .credit-icon {
            font-size: 110px;
            margin-top: 45px;
        }

        .right-panel {
            width: 58%;
            padding: 50px 70px;
            background: linear-gradient(180deg, #c7d2fe, #a5b4fc, #bfdbfe);
        }

        .right-panel h2 {
                text-align: center;
                color: #3c096c;
                font-weight: bold;
                margin-bottom: 10px;
                font-size: 42px;
        }

        .subtitle {
            text-align: center;
            color: #6c757d;
            margin-bottom: 28px;
            font-size: 18px;
        }

        .form-control {
            height: 52px;
            border: none;
            background: #f1f5f9;
            border-radius: 12px;
            font-size: 17px;
            padding-left: 18px;
        }

        .form-control:focus {
            box-shadow: 0 0 0 2px rgba(67, 97, 238, .25);
            background: #fff;
        }

        .btn-code {
            background: linear-gradient(135deg, #ffd60a, #ff9f1c);
            border: none;
            color: #111;
            font-weight: bold;
            height: 52px;
            border-radius: 18px;
            font-size: 17px;
        }

        .btn-register {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border: none;
            color: white;
            font-weight: bold;
            height: 56px;
            border-radius: 18px;
            font-size: 18px;
        }

        .btn-register:hover,
        .btn-code:hover {
            opacity: .9;
        }

        .rules small {
            color: #475569;
            font-size: 12px;
        }

        .login-link {
            text-align: center;
            font-size: 18px;
        }

        @@media (max-width: 900px) {
            .main-box {
                width: 95%;
                flex-direction: column;
            }

            .left-panel, .right-panel {
                width: 100%;
            }

            .welcome {
                margin-top: 40px;
            }
        }
        /* ==========================================
           SEGURIDAD POR VOZ
           ========================================== */

        .seguridad-voz-box {
            background: rgba(255,255,255,.65);
            border: 1px solid rgba(67,97,238,.15);
            border-radius: 18px;
            padding: 18px;
        }

        .seguridad-voz-titulo {
            color: #3c096c;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .seguridad-voz-descripcion {
            color: #64748b;
            font-size: 13px;
            margin-bottom: 12px;
        }

        .btn-grabar-voz {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 14px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: white;
            font-weight: bold;
            font-size: 16px;
        }

            .btn-grabar-voz:hover {
                opacity: .9;
                color: white;
            }

            .btn-grabar-voz.grabando {
                background: linear-gradient(135deg, #dc2626, #ef4444);
            }

        .estado-voz {
            margin-top: 10px;
            text-align: center;
            color: #64748b;
            font-size: 13px;
        }
        /* ==========================================
           MODAL CONFIRMACIÓN VOZ
           ========================================== */

        .modal-voz {
            display: none;
            position: fixed;
            z-index: 9999;
            inset: 0;
            background: rgba(15, 23, 42, .65);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-voz-contenido {
            width: 100%;
            max-width: 500px;
            background: white;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 25px 70px rgba(0,0,0,.35);
            animation: aparecerModal .25s ease;
        }

        @@keyframes aparecerModal {
            from

        {
            opacity: 0;
            transform: scale(.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }

        }

        .modal-voz-icono {
            font-size: 60px;
            margin-bottom: 10px;
        }

        .modal-voz-titulo {
            color: #3c096c;
            font-size: 27px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .modal-voz-texto {
            color: #64748b;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .frase-detectada {
            background: #f1f5f9;
            border-radius: 14px;
            padding: 15px;
            margin: 15px 0 22px;
            color: #3c096c;
            font-size: 20px;
            font-weight: bold;
            min-height: 55px;
        }

        .modal-voz-botones {
            display: flex;
            gap: 12px;
        }

        .btn-voz-cancelar,
        .btn-voz-confirmar {
            flex: 1;
            height: 50px;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: bold;
        }

        .btn-voz-cancelar {
            background: #e2e8f0;
            color: #334155;
        }

        .btn-voz-confirmar {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: white;
        }

            .btn-voz-cancelar:hover,
            .btn-voz-confirmar:hover {
                opacity: .9;
            }

        /* ==========================================
           MODAL VERIFICACIÓN CORREO OTP (CREDIPLUS)
           ========================================== */
        .otp-container {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin: 18px 0;
        }

        .otp-box {
            width: 46px;
            height: 54px;
            font-size: 26px;
            font-weight: 800;
            text-align: center;
            border: 2px solid #cbd5e1;
            border-radius: 12px;
            background: #f8fafc;
            color: #1e293b;
            transition: all 0.2s ease;
        }

        .otp-box:focus {
            border-color: #4361ee;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.25);
            outline: none;
        }

        .otp-timer {
            font-size: 14px;
            font-weight: 700;
            margin: 10px 0;
        }

        .otp-timer.activo {
            color: #4361ee;
        }

        .otp-timer.expirado {
            color: #dc2626;
        }

        .badge-verificado {
            display: none;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background: #dcfce7;
            border: 1px solid #86efac;
            color: #166534;
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            animation: aparecerModal 0.25s ease;
        }

        .btn-verificar-correo {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: white;
            border: none;
            font-weight: bold;
            border-radius: 12px;
            padding: 0 16px;
            font-size: 13px;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .btn-verificar-correo:hover:not(:disabled) {
            background: linear-gradient(135deg, #3730a3, #581c87);
            color: white;
            transform: translateY(-1px);
        }

        .btn-verificar-correo:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
    </style>
</head>

<body>
    <div class="main-box">

        <div class="left-panel">
            <div class="logo">
                <img src="~/imagenes/credi.png" alt="CréditoPlus" />
            </div>

            <div class="welcome">
                <h1>Gestiona tus créditos</h1>
                <p>
                    Registra tu cuenta para administrar solicitudes,
                    verificar datos y acceder a tu panel de créditos.
                </p>

                <div class="credit-icon">💰</div>
            </div>
        </div>

        <div class="right-panel">
            <h2>Crear Cuenta</h2>
            <p class="subtitle">Completa tus datos para registrarte</p>

            <form asp-controller="Login"
                  asp-action="Registro"
                  method="post"
                  enctype="multipart/form-data"
                  id="formRegistro">

                <div class="input-util-wrap mb-2">
                    <input id="nombreInput"
                           class="form-control"
                           type="text"
                           placeholder="Nombre"
                           asp-for="Nombre"
                           required />

                    <button type="button" class="btn-clear">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-2">
                    <input id="apellidoInput"
                           class="form-control"
                           type="text"
                           placeholder="Apellido"
                           asp-for="Apellido"
                           required />

                    <button type="button" class="btn-clear">
                        ✕
                    </button>
                </div>
                <select class="form-control mb-2"
                        asp-for="Genero"
                        required>

                    <option value="">Seleccione género</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>

                </select>

                <div class="input-util-wrap mb-2">
                    <input id="dniRegistro"
                           class="form-control"
                           type="text"
                           placeholder="DNI"
                           asp-for="Dni"
                           maxlength="8"
                           required />

                    <button type="button" class="btn-clear">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-2">
                    <input id="celularRegistro"
                           class="form-control"
                           type="text"
                           placeholder="Celular"
                           asp-for="Celular"
                           maxlength="9"
                           required />

                    <button type="button" class="btn-clear">
                        ✕
                    </button>
                </div>

                <div class="mb-2">
                    <div class="d-flex gap-2">
                        <div class="input-util-wrap flex-grow-1">
                            <input id="correoRegistro"
                                   class="form-control"
                                   type="email"
                                   placeholder="Correo (Gmail, Hotmail, Outlook)"
                                   asp-for="Correo"
                                   required />

                            <button type="button"
                                    class="btn-clear">
                                ✕
                            </button>
                        </div>
                        <button id="btnVerificarCorreo"
                                class="btn btn-verificar-correo"
                                type="button">
                            ✉️ VERIFICAR CORREO
                        </button>
                    </div>

                    <!-- Badge de confirmación visual -->
                    <div id="badgeCorreoVerificado" class="badge-verificado mt-2">
                        <span>✅</span> CORREO VERIFICADO CORRECTAMENTE
                    </div>
                </div>

                <!-- Campo oculto para compatibilidad con el formulario POST -->
                <input type="hidden" id="codigoRegistro" name="codigoVerificacion" value="" />




                <div class="input-util-wrap mb-2">

                    <input id="clave"
                           class="form-control"
                           type="password"
                           placeholder="Contraseña"
                           asp-for="clave"
                           required />

                    <button type="button"
                            class="btn-clear">
                        ✕
                    </button>

                    <button type="button"
                            class="btn-eye">
                        👁
                    </button>

                </div>

                <ul class="password-rules mb-3">
                    <li id="minimo"> Mínimo 12 caracteres</li>
                    <li id="mayus"> Una letra mayúscula</li>
                    <li id="minus"> Una letra minúscula</li>
                    <li id="numero"> Un número</li>
                    <li id="simbolo"> Un símbolo o carácter especial (!@@#$%&*?_-+)</li>
                </ul>

                <div class="input-util-wrap mb-3">

                    <input id="confirmarClaveRegistro"
                           class="form-control"
                           type="password"
                           placeholder="Confirmar contraseña"
                           name="confirmarClave"
                           required />

                    <button type="button"
                            class="btn-clear">
                        ✕
                    </button>

                    <button type="button"
                            class="btn-eye">
                        👁
                    </button>

                </div>

                @if (!string.IsNullOrEmpty(ViewBag.TurnstileSiteKey as string))
                {
                    <div class="mb-3 d-flex justify-content-center">
                        <div class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey" data-appearance="interaction-only" data-theme="light" data-language="es"></div>
                    </div>
                }

                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-register" type="submit">Registrate</button>
                </div>

                @if (ViewData["mensaje"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewData["mensaje"]
                    </div>
                }

                <div class="login-link">
                    ¿Ya tienes una cuenta?
                    <a href="@Url.Action("IniciarSesion", "Login")">Iniciar Sesión</a>
                </div>

            </form>
        </div>
    </div>
    <div id="modalMensajeRegistro"
         class="modal-voz">

        <div class="modal-voz-contenido"
             style="max-width: 380px;">

            <div id="iconoMensajeRegistro"
                 style="font-size:55px;">
                ✅
            </div>

            <div id="tituloMensajeRegistro"
                 class="modal-voz-titulo">
                CrediPlus
            </div>

            <div id="textoMensajeRegistro"
                 class="modal-voz-texto"
                 style="font-size:17px;">
            </div>

            <button type="button"
                    id="btnCerrarMensajeRegistro"
                    class="btn btn-primary w-100 mt-3">
                OK
            </button>

        </div>

    </div>

    <!-- ==========================================
         MODAL DE VERIFICACIÓN OTP DE CORREO (6 DÍGITOS - 60s)
         ========================================== -->
    <div id="modalOtpCorreo" class="modal-voz">
        <div class="modal-voz-contenido" style="max-width: 460px;">
            <div class="modal-voz-icono" style="font-size: 50px;">📧</div>
            <div class="modal-voz-titulo" style="font-size: 24px; margin-bottom: 8px;">
                Verificación de Correo
            </div>
            <div class="modal-voz-texto" style="font-size: 14px; margin-bottom: 6px;">
                Ingresa el código numérico de 6 dígitos enviado a:
            </div>
            <div id="modalCorreoDestino" style="font-weight: bold; color: #1e293b; font-size: 15px; margin-bottom: 12px; word-break: break-all;">
                correo@ejemplo.com
            </div>

            <!-- 6 Casillas individuales de OTP con auto-enfoque y soporte para pegar -->
            <div class="otp-container">
                <input type="text" class="otp-box" id="otp-0" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-1" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-2" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-3" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-4" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <input type="text" class="otp-box" id="otp-5" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
            </div>

            <!-- Temporizador estricto de 60 segundos -->
            <div id="otpTimerDisplay" class="otp-timer activo">
                ⏳ Código válido por: <span id="otpTimerContador">01:00</span>
            </div>

            <!-- Mensaje de estado / error dentro del modal -->
            <div id="otpMensajeModal" style="display: none; font-size: 13px; font-weight: 600; padding: 8px; border-radius: 8px; margin-bottom: 14px;"></div>

            <!-- Botones de acción del modal -->
            <div class="modal-voz-botones">
                <button type="button" id="btnCancelarModalOtp" class="btn-voz-cancelar">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmarOtp" class="btn-voz-confirmar" style="background: linear-gradient(135deg, #4361ee, #7209b7); color: white;">
                    Verificar
                </button>
            </div>

            <!-- Reenviar código -->
            <div class="mt-3">
                <button type="button" id="btnReenviarOtp" class="btn btn-link text-decoration-none" style="font-size: 13px; font-weight: 600; color: #4361ee;" disabled>
                    🔄 Reenviar nuevo código
                </button>
            </div>
        </div>
    </div>

    <script src="~/js/utilidades-ui.js" asp-append-version="true"></script>
    <script src="~/js/registro.js" asp-append-version="true"></script>
</body>
</html>