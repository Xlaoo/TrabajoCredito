@model List<prestamoscreditos.Models.ComentarioClienteViewModel>
@{
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "DashboardCliente";
    ViewData["ActivePage"] = "Inicio";

    var solicitud = ViewBag.SolicitudActiva as trabajo.Models.SolicitudCredito;
    var perfil = solicitud != null &&
              (solicitud.Estado == "Aprobado" || solicitud.Estado == "Rechazado")
     ? ViewBag.PerfilFinanciero as trabajo.Models.PerfilFinanciero
     : null;
    decimal ingreso = perfil != null ? perfil.IngresoMensual : 0;
    decimal egreso = perfil != null ? perfil.EgresoMensual : 0;
    decimal capacidad = ingreso * 0.30m;
    decimal disponible = ingreso - egreso;
    string otrosCreditos = perfil != null
    ? (perfil.OtrosCreditos ? "Sí" : "No")
    : "Sin registro";

    string nombre = User.Identity.Name ?? "Cliente";
    string apellido = User.FindFirst("Apellido")?.Value ?? "";
    string dni = User.FindFirst("Dni")?.Value ?? "Sin registro";
    string celular = User.FindFirst("Celular")?.Value ?? "Sin registro";
    string correo = User.FindFirst("Correo")?.Value ?? "Sin registro";
    string nombreCompleto = nombre + " " + apellido;
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-cliente.css" />
}
<div class="content">
    @Html.AntiForgeryToken()
    <div class="top">
        <div>
            <strong class="welcome-text">¡Bienvenido de vuelta!</strong>
            <h1>Listo para solicitar el monto de tu préstamo</h1>
            <p>Gestiona tu crédito personal de forma 100% online, rápida y segura.</p>
        </div>

        <div class="profile-card">
            <div class="avatar">
                <i class="fas fa-user"></i>
            </div>
            <div>
                <h4>@nombreCompleto</h4>
                <span>Cliente registrado</span>
            </div>
        </div>
    </div>

    <div class="cards">
        <div class="card-box">
            <div class="icon purple">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div>
                <h3>Nivel de Confianza</h3>
                <h2>@(perfil != null ? perfil.NivelRiesgo : "Sin registro")</h2>
                <span>@(perfil != null ? "Cliente evaluado" : "-")</span>
            </div>
        </div>

        <div class="card-box">
            <div class="icon blue">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <h3>Capacidad de Pago</h3>
                <h2>@(perfil != null ? "S/ " + capacidad.ToString("N2") : "Sin registro")</h2>
                <span>@(perfil != null ? "30% de ingresos" : "-")</span>
            </div>
        </div>

        <div class="card-box">
            <div class="icon green">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div>
                <h3>Límite Máximo</h3>
                <h2>@(perfil != null ? "S/ 50,000" : "Sin registro")</h2>
                <span>@(perfil != null ? "Monto permitido" : "-")</span>
            </div>
        </div>

        <div class="card-box">
            <div class="icon orange">
                <i class="fas fa-chart-line"></i>
            </div>
            <div>
                <h3>Deuda Actual</h3>
                <h2>@(perfil != null ? (perfil.OtrosCreditos ? "Sí" : "No") : "Sin registro")</h2>
                <span>@(perfil != null ? "Según declaración" : "-")</span>
            </div>
        </div>
    </div>

    <div class="loan-banner">
        <div class="loan-left">
            <div class="loan-image">
                💸
            </div>

            <div class="loan-info">
                <h2>Solicita tu préstamo personal</h2>

                <p>
                    Obtén hasta S/ 50,000 de forma rápida,
                    100% online y segura.
                </p>

                <div class="loan-feature">
                    <i class="fas fa-bolt"></i>
                    <div>
                        <strong>Aprobación inmediata</strong>
                        <span>Respuesta en minutos</span>
                    </div>
                </div>

                <div class="loan-feature">
                    <i class="fas fa-file-alt"></i>
                    <div>
                        <strong>Sin papeles</strong>
                        <span>Todo el proceso es digital</span>
                    </div>
                </div>

                <div class="loan-feature">
                    <i class="fas fa-calendar-alt"></i>
                    <div>
                        <strong>Plazos flexibles</strong>
                        <span>12, 18, 24, 30, 36, 48, 60 y 72 meses</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="loan-right">
            <small>Monto máximo a solicitar</small>
            <h1>S/ 50,000</h1>
            <div class="loan-line"></div>

            @if (ViewBag.SolicitudActiva != null &&
                                ViewBag.SolicitudActiva.Estado == "Aprobado")
            {
                <button type="button" class="loan-btn bloqueado" disabled>
                    Ya tienes un préstamo activo
                </button>
            }
            else if (ViewBag.SolicitudActiva != null)
            {
                <button type="button" class="loan-btn bloqueado" disabled>
                    Solicitud en evaluación
                </button>
            }
            else if (ViewBag.SolicitudRechazada != null)
            {
                <button type="button" class="loan-btn bloqueado" disabled>
                    Solicitud rechazada pendiente
                </button>

                <p class="loan-notice">
                    Primero debes borrar tu solicitud rechazada en "Mis solicitudes".
                </p>
            }
            else
            {
                <a href="@Url.Action("SolicitarCredito", "Login")"
                   class="loan-btn">
                    Solicitar préstamo
                </a>
            }
        </div>
    </div>

    <div class="bottom-cards">
        <div class="info-card">
            <h3>Información de tu perfil</h3>

            <div class="info-item">
                <span>👤 Nombre completo</span>
                <strong>@nombreCompleto</strong>
            </div>

            <div class="info-item">
                <span>🪪 DNI</span>
                <strong>@dni</strong>
            </div>

            <div class="info-item">
                <span>📱 Celular</span>
                <strong>@celular</strong>
            </div>

            <div class="info-item">
                <span>✉ Correo electrónico</span>
                <strong>@correo</strong>
            </div>

            <div class="info-item">
                <span>📅 Fecha de registro</span>
                <strong>20/05/2024</strong>
            </div>

            <div class="info-item">
                <span>🛡 Estado de verificación</span>

                <strong class="status-purple">
                    @(ViewBag.SolicitudActiva != null
                                                ? ViewBag.SolicitudActiva.Estado
                                                : "Sin solicitud")
                </strong>
            </div>
        </div>

        <div class="finance-card">
            <h3>Resumen financiero</h3>

            <div class="finance-item">
                <span>💸 Ingresos mensuales</span>
                <strong>@(perfil != null ? "S/ " + ingreso.ToString("N2") : "Sin registro")</strong>
            </div>

            <div class="finance-item">
                <span>📉 Egresos mensuales</span>
                <strong>@(perfil != null ? "S/ " + egreso.ToString("N2") : "Sin registro")</strong>
            </div>

            <div class="finance-item">
                <span>🏦 Créditos activos</span>
                <strong>@otrosCreditos</strong>
            </div>

            <div class="finance-box purple-box">
                <span>Capacidad de Pago (30%)</span>
                <strong>@(perfil != null ? "S/ " + capacidad.ToString("N2") : "Sin registro")</strong>
            </div>

            <div class="finance-box green-box">
                <span>Disponible para préstamo</span>
                <strong>@(perfil != null ? "S/ " + disponible.ToString("N2") : "Sin registro")</strong>
            </div>
        </div>

        <div class="benefits-card">
            <h3>¿Por qué elegir CrediPlus?</h3>

            <div class="benefit-item">
                <div>
                    <strong>📈 Las mejores tasas del mercado</strong>
                    <p>Tasas competitivas y transparentes</p>
                </div>
            </div>

            <div class="benefit-item">
                <div>
                    <strong>🛡 Seguridad garantizada</strong>
                    <p>Protegemos tu información 24/7</p>
                </div>
            </div>

            <div class="benefit-item">
                <div>
                    <strong>👨‍💼 Atención personalizada</strong>
                    <p>Asesores disponibles para ti</p>
                </div>
            </div>

            <div class="benefit-item">
                <div>
                    <strong>📋 Sin costos ocultos</strong>
                    <p>Sin comisiones adicionales</p>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN CONSERVADA EXACTAMENTE SEGÚN EXCEPCIÓN OBLIGATORIA -->
    <div class="steps-card">
        <h2>Proceso en 4 pasos</h2>

        <div class="steps">
            <div class="step">
                <div class="step-icon">
                    <i class="fas fa-calculator"></i>
                </div>
                <span>Simula</span>
            </div>

            <div class="step-arrow" aria-hidden="true">
                <i class="fas fa-arrow-right"></i>
            </div>

            <div class="step">
                <div class="step-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <span>Regístrate</span>
            </div>

            <div class="step-arrow" aria-hidden="true">
                <i class="fas fa-arrow-right"></i>
            </div>

            <div class="step">
                <div class="step-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <span>Verifica</span>
            </div>

            <div class="step-arrow" aria-hidden="true">
                <i class="fas fa-arrow-right"></i>
            </div>

            <div class="step">
                <div class="step-icon">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <span>Obtén dinero</span>
            </div>
        </div>
    </div>

    <div class="clients-section">
        <h2>Nuestros Clientes Dicen</h2>

        <div class="carousel-container">
            <button id="btnLeft" type="button" class="carousel-btn" aria-label="Anterior">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="clients-grid" id="clientsGrid"></div>

            <button id="btnRight" type="button" class="carousel-btn" aria-label="Siguiente">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </div>

    <div class="learn-section">
        <h2>Aprende Más & Mantente Informado</h2>

        <div class="learn-grid">
            <div class="learn-card">
                <i class="fas fa-book"></i>
                <h3>Educación Financiera</h3>
                <p>Consejos para mejorar tu historial.</p>
            </div>

            <div class="learn-card">
                <i class="fas fa-bell"></i>
                <h3>Nuevas Ofertas</h3>
                <p>Promociones exclusivas.</p>
            </div>

            <div class="learn-card">
                <i class="fas fa-headset"></i>
                <h3>Soporte 24/7</h3>
                <p>Atención inmediata.</p>
            </div>
        </div>
    </div>

    <div class="loan-features">
        <div class="feature-box">
            <i class="fas fa-laptop"></i>
            <div>
                <h4>100% online</h4>
                <p>Todo el proceso es digital</p>
            </div>
        </div>

        <div class="feature-box">
            <i class="fas fa-money-check-alt"></i>
            <div>
                <h4>Hasta S/ 50,000</h4>
                <p>Monto máximo a prestar</p>
            </div>
        </div>

        <div class="feature-box">
            <i class="fas fa-calendar-alt"></i>
            <div>
                <h4>Hasta 72 meses</h4>
                <p>Plazos flexibles disponibles</p>
            </div>
        </div>

        <div class="feature-box">
            <i class="fas fa-check-circle"></i>
            <div>
                <h4>Aprobación rápida</h4>
                <p>Respuesta en minutos</p>
            </div>
        </div>

        <div class="feature-box">
            <i class="fas fa-shield-alt"></i>
            <div>
                <h4>Pagos seguros</h4>
                <p>Plataforma segura y confiable</p>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.MostrarResena == true)
{
    <div id="modalResena" class="modal-resena">
        <div class="resena-box">
            <div class="resena-logo"><i class="fas fa-star text-warning"></i></div>

            <h1>Califica nuestro servicio</h1>

            <p class="resena-subtitulo">
                Tu opinión nos ayuda a mejorar la atención, el proceso de crédito
                y la experiencia de nuestros clientes.
            </p>

            <div class="estrellas-resena">
                <span class="estrella" data-estrella="1">&#9733;</span>
                <span class="estrella" data-estrella="2">&#9733;</span>
                <span class="estrella" data-estrella="3">&#9733;</span>
                <span class="estrella" data-estrella="4">&#9733;</span>
                <span class="estrella" data-estrella="5">&#9733;</span>
            </div>

            <textarea id="comentarioResena"
                      class="comentario-resena"
                      placeholder="Escribe tu opinión sobre el servicio..."></textarea>

            <div id="errorResena" class="error-resena">
                Debes seleccionar una calificación y escribir un comentario.
            </div>

            <button type="button"
                    class="btn-enviar-resena"
                    id="btnEnviarResena">
                Enviar reseña
            </button>
        </div>
    </div>
}

<script type="application/json" id="clientesData">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model ?? new List<prestamoscreditos.Models.ComentarioClienteViewModel>()).Select(c => new {
    nombre = c.NombreCompleto ?? "",
    comentario = c.Comentario ?? "",
    estrellas = c.Calificacion
})))
</script>

@section Scripts {
    <script src="~/js/dashboard-cliente.js"></script>
    <script src="~/js/config-global.js"></script>
}
