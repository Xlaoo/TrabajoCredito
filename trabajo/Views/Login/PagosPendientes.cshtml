@model List<trabajo.Models.Cuota>
@{
    Layout = null;
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "PagosPendientes";
    ViewData["ActivePage"] = "PagosPendientes";
    bool tienePagoPendiente = Model != null && Model.Any();

    var metodosSolicitud = ViewBag.MetodosSolicitud as List<trabajo.Models.MetodoPagoSolicitud>;
}

<style>
    h1 {
        font-size: 38px;
        font-weight: 800;
        color: #1f1235;
    }

    .subtitle {
        font-size: 20px;
        color: #51446b;
        margin-bottom: 35px;
    }

    .payment-card {
        background: white;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        max-width: 1250px;
    }

    .empty-box {
        text-align: center;
        padding: 70px;
    }

        .empty-box i {
            font-size: 70px;
            color: #7c3aed;
            margin-bottom: 20px;
        }

        .empty-box h2 {
            font-size: 34px;
            font-weight: 900;
            color: #3c096c;
        }

    .status {
        background: #fef3c7;
        color: #b45309;
        padding: 14px 30px;
        border-radius: 24px;
        font-weight: bold;
        font-size: 18px;
    }

    .status-paid {
        background: #dcfce7;
        color: #15803d;
    }

    .top-payment {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
    }

    .payment-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
        margin-bottom: 30px;
    }

    .pay-box {
        background: #f8f5ff;
        border: 1px solid #ede9fe;
        border-radius: 18px;
        padding: 25px;
    }

        .pay-box label {
            color: #6b7280;
            font-size: 16px;
        }

        .pay-box h3 {
            color: #4c1d95;
            font-size: 30px;
            font-weight: 900;
            margin-top: 10px;
        }

    .detail-box {
        background: #f8f5ff;
        border-radius: 18px;
        padding: 24px;
        margin-bottom: 28px;
    }

        .detail-box h3 {
            color: #3c096c;
            font-weight: 900;
            margin-bottom: 18px;
        }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #e9ddff;
        font-size: 17px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .btn-pay {
        background: #22c55e;
        color: white;
        border: none;
        padding: 17px 32px;
        border-radius: 14px;
        font-size: 18px;
        font-weight: bold;
    }

    .btn-back {
        background: #6b7280;
        color: white;
        border: none;
        padding: 17px 32px;
        border-radius: 14px;
        font-size: 18px;
        font-weight: bold;
        text-decoration: none;
        display: inline-block;
    }

        .btn-pay:hover,
        .btn-back:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(0,0,0,.20);
        }

    .actions {
        display: flex;
        gap: 15px;
    }

    .modal-pay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.55);
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .modal-content-pay {
        background: white;
        width: 560px;
        border-radius: 24px;
        padding: 35px;
    }

        .modal-content-pay h2 {
            color: #3c096c;
            font-weight: 900;
            margin-bottom: 20px;
        }

        .modal-content-pay label {
            font-weight: bold;
            margin-top: 12px;
            display: block;
        }

        .modal-content-pay input,
        .modal-content-pay select {
            width: 100%;
            padding: 14px;
            border: 2px solid #ddd6fe;
            border-radius: 12px;
            margin-top: 8px;
            font-size: 16px;
        }

    .payment-info {
        background: #f8f5ff;
        border: 1px solid #ddd6fe;
        padding: 18px;
        border-radius: 16px;
        margin-top: 18px;
    }

    .modal-actions {
        display: flex;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-close-modal {
        background: #ef4444;
        color: white;
        border: none;
        padding: 14px 24px;
        border-radius: 12px;
        font-weight: bold;
    }

    .btn-confirm {
        background: #22c55e;
        color: white;
        border: none;
        padding: 14px 24px;
        border-radius: 12px;
        font-weight: bold;
    }

    .message-ok {
        display: none;
        background: #dcfce7;
        color: #166534;
        padding: 18px;
        border-radius: 16px;
        font-weight: bold;
        margin-bottom: 22px;
    }

    .btn-pay:disabled,
    .btn-pay:disabled:hover {
        background: #c9c9c9 !important;
        color: white !important;
        cursor: not-allowed !important;
        transform: none !important;
        box-shadow: none !important;
    }
</style>

<div class="content">
    <h1>Pagos Pendientes</h1>
    <p class="subtitle">Consulta y paga las cuotas pendientes de tu préstamo.</p>

    <div id="mensajePago" class="message-ok">
        Pago registrado correctamente. La cuota queda en proceso de validación.
    </div>

    <div class="payment-card">

        @if (!tienePagoPendiente)
        {
            <div class="payment-card">
                <div class="empty-box">
                    <i class="fas fa-circle-check"></i>
                    <h2>No tienes pagos pendientes</h2>
                    <p>Cuando tengas una cuota por pagar, aparecerá aquí.</p>

                    <a class="btn-back" href="@Url.Action("SolicitarCredito", "Login")">
                        Regresar al inicio
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var cuota in Model)
            {
                var metodoSolicitud = metodosSolicitud?
                .FirstOrDefault(x =>
                x.SOLICITUD_CREDITO_Id_Solicitud ==
                cuota.SOLICITUD_CREDITO_Id_Solicitud);
                decimal montoBase =
                cuota.Capital.GetValueOrDefault()
                + cuota.Interes.GetValueOrDefault()
                + cuota.Comisiones.GetValueOrDefault()
                + cuota.Seguros.GetValueOrDefault();

                int diasAtraso = 0;
                decimal mora = 0;
                decimal totalConMora = montoBase;

                if (DateTime.Now.Date > cuota.FechaVencimiento.Date && cuota.Estado == "Pendiente")
                {
                    diasAtraso = (DateTime.Now.Date - cuota.FechaVencimiento.Date).Days;
                    mora = diasAtraso * 5;
                    totalConMora = montoBase + mora;
                }

                <div class="payment-card" style="margin-bottom:25px;">
                    <div class="top-payment">
                        <h2>Cuota pendiente N.º @cuota.NumeroCuota.ToString("00")</h2>

                        @if (cuota.Estado == "Pendiente aprobación")
                        {
                            <span class="status status-paid">Pendiente aprobación</span>
                        }
                        else
                        {
                            <span class="status">Pendiente</span>
                        }
                    </div>

                    <div class="payment-grid">
                        <div class="pay-box">
                            <label>Préstamo aprobado</label>
                            <h3>S/ @cuota.SOLICITUD_CREDITO.MontoSolicitado.ToString("N0")</h3>
                        </div>

                        <div class="pay-box">
                            <label>Total a pagar</label>
                            <h3>S/ @totalConMora.ToString("N2")</h3>
                        </div>
                    </div>

                    <div class="detail-box">
                        <h3>Detalle del pago</h3>

                        <div class="detail-row">
                            <span>Importe total de cuota</span>
                            <strong>S/ @montoBase.ToString("N2")</strong>
                        </div>

                        @if (diasAtraso > 0)
                        {
                            <div class="detail-row">
                                <span>Días de atraso</span>
                                <strong>@diasAtraso día(s)</strong>
                            </div>

                            <div class="detail-row">
                                <span>Mora diaria</span>
                                <strong>S/ 5.00</strong>
                            </div>

                            <div class="detail-row">
                                <span>Total mora</span>
                                <strong>S/ @mora.ToString("N2")</strong>
                            </div>
                        }

                        <div class="detail-row">
                            <span>Fecha de vencimiento</span>
                            <strong>@cuota.FechaVencimiento.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>

                    <div class="actions">
                        @if (cuota.Estado == "Pendiente aprobación")
                        {
                            <button class="btn-pay" disabled style="background:#c9c9c9;">
                                Pendiente aprobación
                            </button>
                        }
                        else
                        {
                            <button class="btn-pay"
                                    onclick="abrirModalPago(
                                @cuota.Id_Cuota,
                                @totalConMora.ToString(System.Globalization.CultureInfo.InvariantCulture),
                                '@(metodoSolicitud?.MetodoPago ?? "")',
                                '@(metodoSolicitud?.EntidadPago ?? "")',
                                '@(metodoSolicitud?.NumeroCuentaPago ?? "")',
                                '@(metodoSolicitud?.TitularCuenta ?? "")'
                                )">
                                <i class="fas fa-money-bill-wave"></i> Pagar cuota
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<div id="modalPago" class="modal-pay">
    <input type="hidden" id="idCuota" />
    <input type="hidden" id="montoPagado" />
    <div class="modal-content-pay">
        <h2>Pagar cuota pendiente</h2>

        <label>Monto a pagar</label>
        <input id="montoTextoModal" type="text" readonly />

        <label>Método de pago</label>
        <select id="metodoPago" onchange="mostrarDatosPago()">
            <option value="">Seleccione método de pago</option>
            <option value="Transferencia bancaria">Transferencia bancaria</option>
            <option value="Yape">Yape</option>
            <option value="Plin">Plin</option>
        </select>
        <label>Entidad</label>
        <select id="entidadPago" onchange="mostrarDatosPago()">
            <option value="">Seleccione entidad</option>
        </select>
        <div id="datosPago" class="payment-info" style="display:none;"></div>

        <div class="modal-actions">
            <button class="btn-close-modal" onclick="cerrarModalPago()">Volver</button>
            <button class="btn-confirm" onclick="confirmarPago()">Confirmar pago</button>
        </div>
    </div>
</div>

<script>
                                    function abrirModalPago(idCuota, monto, metodo, entidad, numero, titular) {

        metodoRegistrado = metodo || "";
        entidadRegistrada = entidad || "";
        numeroRegistrado = numero || "";
        titularRegistrado = titular || "";

        document.getElementById("idCuota").value = idCuota;
        document.getElementById("montoPagado").value = monto;
        document.getElementById("montoTextoModal").value = "S/ " + Number(monto).toFixed(2);

        document.getElementById("metodoPago").value = "";
        document.getElementById("entidadPago").innerHTML = '<option value="">Seleccione entidad</option>';
        document.getElementById("entidadPago").dataset.metodoActual = "";
        document.getElementById("datosPago").style.display = "none";
        document.getElementById("datosPago").innerHTML = "";

        document.getElementById("modalPago").style.display = "flex";
    }

    function cerrarModalPago() {
        document.getElementById("modalPago").style.display = "none";
    }

                         function mostrarDatosPago() {
        let metodo = document.getElementById("metodoPago").value;
        let entidadSelect = document.getElementById("entidadPago");
        let entidad = entidadSelect.value;
        let datos = document.getElementById("datosPago");

        datos.style.display = "none";
        datos.innerHTML = "";

        if (entidadSelect.dataset.metodoActual !== metodo) {
            entidadSelect.dataset.metodoActual = metodo;
            entidadSelect.innerHTML = '<option value="">Seleccione entidad</option>';

            if (metodo === "Transferencia bancaria") {
                ["BCP", "Interbank", "BBVA", "Scotiabank", "Caja Arequipa"].forEach(x => {
                    entidadSelect.innerHTML += `<option value="${x}">${x}</option>`;
                });
            }

            if (metodo === "Yape") {
                ["Yape", "BCP"].forEach(x => {
                    entidadSelect.innerHTML += `<option value="${x}">${x}</option>`;
                });
            }

            if (metodo === "Plin") {
                ["Plin", "Interbank", "BBVA", "Scotiabank", "Caja Arequipa"].forEach(x => {
                    entidadSelect.innerHTML += `<option value="${x}">${x}</option>`;
                });
            }

            return;
        }

        entidad = entidadSelect.value;

        if (metodo === "" || entidad === "") {
            return;
        }

        let titularPago = "CrediPlus Financiera";
        let numeroPago = "";

        if (metodo === "Yape") {
            titularPago = "CrediPlus Yape";
            numeroPago = "987 654 321";
        }

        if (metodo === "Plin") {
            titularPago = "CrediPlus Plin";
            numeroPago = "912 345 678";
        }

        if (metodo === "Transferencia bancaria") {
            titularPago = "CrediPlus Financiera";

            if (entidad === "BCP")
                numeroPago = "191-23568974-0-11";

            if (entidad === "Interbank")
                numeroPago = "200-300456789123";

            if (entidad === "BBVA")
                numeroPago = "0011-0345-0201234567";

            if (entidad === "Scotiabank")
                numeroPago = "000-8457621";

            if (entidad === "Caja Arequipa")
                numeroPago = "305-789456123";
        }

        datos.style.display = "block";
        datos.innerHTML = `
            <h3>Pago por ${metodo}</h3>
            <p><b>Entidad:</b> ${entidad}</p>
            <p><b>Titular:</b> ${titularPago}</p>
            <p><b>Número para pagar:</b> ${numeroPago}</p>
            <input id="codigoOperacion"
                   maxlength="8"
                   placeholder="Código de operación de 8 dígitos"
                   oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,8)">
        `;
    }
            function confirmarPago() {

        let metodo = document.getElementById("metodoPago").value;
        let codigo = document.getElementById("codigoOperacion");
        let idCuota = document.getElementById("idCuota").value;
        let entidad = document.getElementById("entidadPago").value;


        if (metodo === "") {
            alert("Seleccione un método de pago.");
            return;
        }

    if (entidad === "") {
        alert("Seleccione una entidad.");
        return;
    }

    if (!codigo || !/^\d{8}$/.test(codigo.value)) {
        alert("Ingrese un código de operación de 8 dígitos.");
        return;
    }

        fetch('/Login/RegistrarPagoCuota', {

            method: 'POST',

            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },

    body:
        'idCuota=' + encodeURIComponent(idCuota) +
        '&montoPagado=' + encodeURIComponent(document.getElementById("montoPagado").value) +
        '&metodoPago=' + encodeURIComponent(metodo) +
        '&entidadPago=' + encodeURIComponent(entidad) +
        '&codigoOperacion=' + encodeURIComponent(codigo.value)

        })

        .then(response => response.json())

        .then(data => {

            alert(data.mensaje);

            if (data.ok) {

                location.reload();
            }
        })

        .catch(error => {

            alert("No se pudo registrar el pago.");
        });
    }
</script>

<script src="~/js/config-global.js"></script>