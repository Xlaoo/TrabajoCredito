@model List<prestamoscreditos.Models.ComentarioClienteViewModel>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>CrediPlus</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI', sans-serif;
            }

            html,
            body {
                width: 100%;
                min-height: 100%;
            }

            body {
                background: #faf8ff;
                overflow-x: hidden;
            }

            .container {
                width: 100%;
                max-width: none;
                min-height: 100vh;
                display: flex;
            }

            .content {
                width: 100%;
                flex: 1;
                padding: 34px 42px;
            }

            /* ==========================================
                                   ENCABEZADO
                                   ========================================== */

            .top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
            }

                .top h2 {
                    font-size: 26px;
                    line-height: 1.25;
                }

                .top > div {
                    display: flex;
                    gap: 8px;
                }

            .btn-login,
            .btn-register {
                display: inline-block;
                padding: 12px 30px;
                border: none;
                border-radius: 14px;
                color: white;
                text-decoration: none;
                font-size: 16px;
                font-weight: 600;
                text-align: center;
                transition: .3s;
                white-space: nowrap;
            }

            .btn-login {
                background: #6d28d9;
            }

            .btn-register {
                background: #22c55e;
            }

                .btn-login:hover,
                .btn-register:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 12px 25px rgba(0,0,0,.20);
                    color: white;
                }

            /* ==========================================
                                   BIENVENIDA
                                   ========================================== */

            .welcome {
                margin-top: 20px;
                padding: 30px;
                border-radius: 20px;
                background: white;
                text-align: center;
                box-shadow: 0 5px 15px rgba(0,0,0,.1);
            }

                .welcome h1 {
                    font-size: 50px;
                    line-height: 1.2;
                }

                .welcome span {
                    color: #6d28d9;
                }

                .welcome h2 {
                    margin-top: 8px;
                    font-size: 26px;
                }

            /* ==========================================
                                   BANNER PRINCIPAL
                                   ========================================== */

            .loan-banner {
                margin-top: 35px;
                padding: 40px;
                border-radius: 28px;
                background: linear-gradient(90deg,#2b0050,#5b21b6,#3b82f6);
                color: white;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 35px;
                box-shadow: 0 15px 40px rgba(76,29,149,.25);
            }

            .loan-left {
                min-width: 0;
                display: flex;
                align-items: center;
                gap: 25px;
                flex: 1;
            }

            .loan-image {
                width: 120px;
                height: 120px;
                min-width: 120px;
                border-radius: 24px;
                background: rgba(255,255,255,.12);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 60px;
            }

            .loan-info {
                min-width: 0;
                flex: 1;
            }

                .loan-info h2 {
                    margin-bottom: 10px;
                    color: white;
                    font-size: 34px;
                    font-weight: 800;
                    line-height: 1.2;
                }

                .loan-info > p {
                    margin-bottom: 20px;
                    color: #ddd6fe;
                    font-size: 18px;
                    line-height: 1.45;
                }

            .loan-feature {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 12px;
            }

                .loan-feature i {
                    width: 55px;
                    height: 55px;
                    min-width: 55px;
                    border-radius: 16px;
                    background: rgba(255,255,255,.12);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: white;
                    font-size: 22px;
                }

                .loan-feature strong {
                    display: block;
                    color: white;
                    font-size: 18px;
                }

                .loan-feature span {
                    color: #ddd6fe;
                    font-size: 16px;
                }

            .loan-right {
                width: 100%;
                max-width: 310px;
                min-width: 260px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

                .loan-right small {
                    color: #ddd6fe;
                    font-size: 15px;
                }

                .loan-right h1 {
                    margin: 5px 0 15px;
                    color: white;
                    font-size: 60px;
                    font-weight: 800;
                    line-height: 1.1;
                }

            .loan-line {
                width: 100%;
                height: 2px;
                margin: 25px 0 35px;
                background: rgba(255,255,255,.2);
            }

            .loan-btn {
                display: block;
                width: 100%;
                padding: 18px 30px;
                border: none;
                border-radius: 14px;
                background: #22c55e;
                color: white !important;
                text-decoration: none;
                text-align: center;
                font-size: 22px;
                font-weight: bold;
                transition: .3s;
            }

                .loan-btn:hover {
                    background: #16a34a;
                }

            /* ==========================================
                                   TARJETAS
                                   ========================================== */

            .grid {
                margin-top: 25px;
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 20px;
            }

            .card {
                min-width: 0;
                padding: 25px;
                border-radius: 20px;
                background: white;
                box-shadow: 0 5px 15px rgba(0,0,0,.08);
            }

                .card h2 {
                    margin-bottom: 15px;
                    font-size: 26px;
                }

            .why {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 15px;
            }

            .feature {
                display: flex;
                gap: 10px;
                min-width: 0;
            }

                .feature i {
                    color: #6d28d9;
                    margin-top: 3px;
                }

                .feature p {
                    line-height: 1.35;
                }

            /* ==========================================
                                   PASOS
                                   ========================================== */

            .steps {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 20px;
                text-align: center;
            }

                .steps > div {
                    min-width: 0;
                }

            .step-icon {
                width: 60px;
                height: 60px;
                margin: auto;
                border-radius: 15px;
                background: #efe4ff;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #6d28d9;
                font-size: 25px;
            }

            .steps p {
                margin-top: 8px;
            }

            .step-arrow {
                color: #b7b7b7;
                font-size: 28px;
            }

            /* ==========================================
                                   CLIENTES
                                   ========================================== */

            .clients {
                margin-top: 25px;
                padding: 25px;
                border-radius: 20px;
                background: white;
            }

                .clients h2 {
                    font-size: 26px;
                }

            .carousel-container {
                margin-top: 15px;
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .client-grid {
                min-width: 0;
                flex: 1;
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 15px;
            }

            .client {
                min-width: 0;
                padding: 15px;
                border-radius: 15px;
                background: #f8f5ff;
                display: flex;
                gap: 15px;
                word-break: break-word;
            }

            .client-icon {
                width: 60px;
                height: 60px;
                min-width: 60px;
                border-radius: 50%;
                background: #6d28d9;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
            }

            .carousel-btn {
                width: 50px;
                height: 50px;
                min-width: 50px;
                border: none;
                border-radius: 50%;
                background: #6d28d9;
                color: white;
                font-size: 20px;
                cursor: pointer;
                transition: .3s;
            }

                .carousel-btn:hover {
                    background: #5b21b6;
                    transform: scale(1.08);
                }

                .carousel-btn:disabled {
                    background: #c5c5c5;
                    cursor: not-allowed;
                    transform: none;
                    box-shadow: none;
                }

            /* ==========================================
                                   INFORMACIÓN
                                   ========================================== */

            .learn {
                margin-top: 25px;
                padding: 25px;
                border-radius: 20px;
                background: white;
            }

                .learn h2 {
                    font-size: 26px;
                }

            .learn-grid {
                margin-top: 20px;
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 20px;
            }

            .learn-card {
                min-width: 0;
                padding: 20px;
                border-radius: 15px;
                background: #f8f5ff;
            }

                .learn-card i {
                    margin-bottom: 15px;
                    color: #6d28d9;
                    font-size: 35px;
                }

                .learn-card h3 {
                    line-height: 1.25;
                }

            .footer-features {
                margin-top: 25px;
                padding: 20px;
                border-radius: 20px;
                background: white;
                display: grid;
                grid-template-columns: repeat(5, minmax(0, 1fr));
                gap: 20px;
            }

            .footer-item {
                min-width: 0;
                display: flex;
                gap: 10px;
            }

                .footer-item i {
                    color: #6d28d9;
                    font-size: 24px;
                    margin-top: 3px;
                }

                .footer-item p,
                .footer-item h4 {
                    line-height: 1.35;
                }

            /* ==========================================
                                   LAPTOP / TABLET GRANDE
                                   ========================================== */

            @@media (max-width: 1100px) {
                .content {
                    padding: 28px 24px;
                }

                .top h2 {
                    font-size: 23px;
                }

                .welcome h1 {
                    font-size: 42px;
                }

                .loan-banner {
                    padding: 30px;
                    gap: 28px;
                }

                .loan-image {
                    width: 95px;
                    height: 95px;
                    min-width: 95px;
                    font-size: 48px;
                }

                .loan-info h2 {
                    font-size: 29px;
                }

                .loan-info > p {
                    font-size: 16px;
                }

                .loan-right {
                    min-width: 225px;
                    max-width: 250px;
                }

                    .loan-right h1 {
                        font-size: 48px;
                    }

                .grid {
                    grid-template-columns: 1fr;
                }

                .client-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .learn-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .footer-features {
                    grid-template-columns: repeat(3, minmax(0, 1fr));
                }
            }

            /* ==========================================
                                   TABLET
                                   ========================================== */

            @@media (max-width: 768px) {
                .content {
                    padding: 20px 16px;
                }

                .top {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 15px;
                }

                    .top h2 {
                        text-align: center;
                        font-size: 21px;
                    }

                    .top > div {
                        width: 100%;
                    }

                .btn-login,
                .btn-register {
                    flex: 1;
                    padding: 12px 10px;
                }

                .welcome {
                    padding: 25px 18px;
                    border-radius: 17px;
                }

                    .welcome h1 {
                        font-size: 34px;
                    }

                    .welcome h2 {
                        font-size: 20px;
                    }

                .loan-banner {
                    margin-top: 22px;
                    padding: 28px 22px;
                    flex-direction: column;
                    align-items: stretch;
                    gap: 28px;
                    border-radius: 22px;
                }

                .loan-left {
                    width: 100%;
                    align-items: flex-start;
                }

                .loan-image {
                    width: 85px;
                    height: 85px;
                    min-width: 85px;
                    font-size: 42px;
                }

                .loan-info h2 {
                    font-size: 27px;
                }

                .loan-info > p {
                    font-size: 15px;
                }

                .loan-feature i {
                    width: 48px;
                    height: 48px;
                    min-width: 48px;
                    font-size: 19px;
                }

                .loan-feature strong {
                    font-size: 16px;
                }

                .loan-feature span {
                    font-size: 14px;
                }

                .loan-right {
                    width: 100%;
                    max-width: none;
                    min-width: 0;
                    text-align: center;
                }

                    .loan-right h1 {
                        font-size: 46px;
                    }

                .loan-line {
                    margin: 18px 0 22px;
                }

                .loan-btn {
                    padding: 16px 20px;
                    font-size: 19px;
                }

                .why {
                    grid-template-columns: 1fr;
                }

                .steps {
                    flex-wrap: wrap;
                    gap: 16px 22px;
                }

                .step-arrow {
                    display: none;
                }

                .client-grid {
                    grid-template-columns: 1fr;
                }

                .learn-grid {
                    grid-template-columns: 1fr;
                }

                .footer-features {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }

            /* ==========================================
                                   CELULAR
                                   ========================================== */

            @@media (max-width: 600px) {
                .container {
                    min-height: auto;
                }

                .content {
                    padding: 15px 12px;
                }

                .top {
                    gap: 12px;
                }

                    .top h2 {
                        font-size: 18px;
                        line-height: 1.3;
                    }

                    .top > div {
                        flex-direction: column;
                        gap: 8px;
                    }

                .btn-login,
                .btn-register {
                    width: 100%;
                    padding: 12px;
                    border-radius: 12px;
                    font-size: 15px;
                }

                .welcome {
                    margin-top: 16px;
                    padding: 22px 14px;
                    border-radius: 15px;
                }

                    .welcome h1 {
                        font-size: 28px;
                    }

                    .welcome h2 {
                        font-size: 17px;
                        line-height: 1.3;
                    }

                .loan-banner {
                    padding: 24px 18px;
                    gap: 24px;
                    border-radius: 18px;
                }

                .loan-left {
                    flex-direction: column;
                    align-items: center;
                    text-align: center;
                    gap: 18px;
                }

                .loan-image {
                    width: 80px;
                    height: 80px;
                    min-width: 80px;
                    font-size: 40px;
                }

                .loan-info {
                    width: 100%;
                }

                    .loan-info h2 {
                        font-size: 25px;
                    }

                    .loan-info > p {
                        font-size: 14px;
                    }

                .loan-feature {
                    width: 100%;
                    text-align: left;
                }

                    .loan-feature i {
                        width: 45px;
                        height: 45px;
                        min-width: 45px;
                        font-size: 18px;
                    }

                    .loan-feature strong {
                        font-size: 15px;
                    }

                    .loan-feature span {
                        font-size: 13px;
                    }

                .loan-right small {
                    font-size: 14px;
                }

                .loan-right h1 {
                    margin: 8px 0 10px;
                    font-size: 42px;
                }

                .loan-btn {
                    padding: 15px;
                    border-radius: 12px;
                    font-size: 18px;
                }

                .grid {
                    margin-top: 18px;
                    gap: 16px;
                }

                .card,
                .clients,
                .learn {
                    padding: 18px;
                    border-radius: 16px;
                }

                    .card h2,
                    .clients h2,
                    .learn h2 {
                        font-size: 21px;
                    }

                .steps {
                    flex-direction: column;
                    gap: 18px;
                }

                .step-icon {
                    width: 55px;
                    height: 55px;
                    font-size: 22px;
                }

                .carousel-container {
                    gap: 8px;
                }

                .carousel-btn {
                    width: 42px;
                    height: 42px;
                    min-width: 42px;
                    font-size: 17px;
                }

                .client {
                    padding: 14px;
                    align-items: center;
                }

                .client-icon {
                    width: 50px;
                    height: 50px;
                    min-width: 50px;
                    font-size: 23px;
                }

                .learn-card {
                    padding: 17px;
                }

                    .learn-card i {
                        font-size: 30px;
                    }

                .footer-features {
                    grid-template-columns: 1fr;
                    gap: 15px;
                    padding: 18px;
                    border-radius: 16px;
                }

                .footer-item {
                    align-items: flex-start;
                }
            }

            /* ==========================================
                                   CELULARES PEQUEÑOS
                                   ========================================== */

            @@media (max-width: 400px) {
                .content {
                    padding: 12px 10px;
                }

                .top h2 {
                    font-size: 17px;
                }

                .welcome h1 {
                    font-size: 25px;
                }

                .welcome h2 {
                    font-size: 16px;
                }

                .loan-banner {
                    padding: 20px 15px;
                }

                .loan-info h2 {
                    font-size: 22px;
                }

                .loan-right h1 {
                    font-size: 36px;
                }

                .loan-feature i {
                    width: 42px;
                    height: 42px;
                    min-width: 42px;
                }

                .card,
                .clients,
                .learn {
                    padding: 15px;
                }

                .carousel-btn {
                    width: 38px;
                    height: 38px;
                    min-width: 38px;
                }
            }
    </style>
</head>

<body>

    <div class="container">

        <div class="content">

            <div class="top">
                <h2>Portal CrediPlus - Préstamos Personales</h2>

                <div>
                    <a href="@Url.Action("IniciarSesion", "Login")"
                       class="btn-login">
                        Iniciar Sesión
                    </a>
                    <a href="@Url.Action("Registro", "Login")"
                       class="btn-register">
                        Registrarse
                    </a>
                </div>
            </div>

            <div class="welcome">
                <h1>Bienvenido a <span>CrediPlus</span>.</h1>
                <h2>Fácil, rápido y adaptado a ti.</h2>
            </div>

            <div class="loan-banner">
                <div class="loan-left">

                    <div class="loan-image">
                        💸
                    </div>

                    <div class="loan-info">
                        <h2>Solicita tu préstamo personal</h2>

                        <p>
                            Obtén hasta S/ 50,000 de forma rápida,
                            100% online y segura.
                        </p>

                        <div class="loan-feature">
                            <i class="fas fa-bolt"></i>
                            <div>
                                <strong>Aprobación inmediata</strong>
                                <span>Respuesta en minutos</span>
                            </div>
                        </div>

                        <div class="loan-feature">
                            <i class="fas fa-file-alt"></i>
                            <div>
                                <strong>Sin papeles</strong>
                                <span>Todo el proceso es digital</span>
                            </div>
                        </div>

                        <div class="loan-feature">
                            <i class="fas fa-calendar-alt"></i>
                            <div>
                                <strong>Plazos flexibles</strong>
                                <span>12, 18, 24, 30, 36, 48, 60 y 72 meses</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="loan-right">

                    <small>Monto máximo a solicitar</small>

                    <h1>S/ 50,000</h1>

                    <div class="loan-line"></div>

                    <a class="loan-btn"
                       href="@Url.Action("IniciarSesion", "Login")">
                        Solicitar préstamo →
                    </a>

                </div>
            </div>

            <div class="grid">

                <div class="card">
                    <h2>¿Por qué elegir CrediPlus?</h2>

                    <div class="why">

                        <div class="feature">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <b>Tasas bajas</b>
                                <p>Tasas transparentes</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <b>Seguridad</b>
                                <p>Protección total</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-file-contract"></i>
                            <div>
                                <b>Transparencia</b>
                                <p>Sin costos ocultos</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-headset"></i>
                            <div>
                                <b>Atención</b>
                                <p>Soporte 24/7</p>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card">

                    <h2>Proceso en 4 pasos</h2>

                    <div class="steps">

                        <div>
                            <div class="step-icon"><i class="fas fa-calculator"></i></div>
                            <p>Simula</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                        <div>
                            <div class="step-icon"><i class="fas fa-user-plus"></i></div>
                            <p>Regístrate</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                        <div>
                            <div class="step-icon"><i class="fas fa-shield-alt"></i></div>
                            <p>Verifica</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                        <div>
                            <div class="step-icon"><i class="fas fa-money-bill"></i></div>
                            <p>Obtén dinero</p>
                        </div>

                    </div>
                </div>

            </div>

            <div class="clients">

                <h2>Nuestros Clientes Dicen</h2>

                <div class="carousel-container">

                    <button id="btnLeft"
                            class="carousel-btn"
                            onclick="moverClientes(-1)">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <div class="client-grid" id="clientGrid">
                    </div>

                    <button id="btnRight"
                            class="carousel-btn"
                            onclick="moverClientes(1)">
                        <i class="fas fa-chevron-right"></i>
                    </button>

                </div>

            </div>

            <div class="learn">

                <h2>Aprende Más & Mantente Informado</h2>

                <div class="learn-grid">

                    <div class="learn-card">
                        <i class="fas fa-book"></i>
                        <h3>Educación Financiera</h3>
                        <p>Consejos para mejorar tu historial.</p>
                    </div>

                    <div class="learn-card">
                        <i class="fas fa-bell"></i>
                        <h3>Nuevas Ofertas</h3>
                        <p>Promociones exclusivas.</p>
                    </div>

                    <div class="learn-card">
                        <i class="fas fa-headset"></i>
                        <h3>Soporte 24/7</h3>
                        <p>Atención inmediata.</p>
                    </div>

                </div>

            </div>

            <div class="footer-features">

                <div class="footer-item">
                    <i class="fas fa-laptop"></i>
                    <div>
                        <b>100% online</b>
                        <p>Todo digital</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-money-check-alt"></i>
                    <div>
                        <h4>Hasta S/ 50,000</h4>
                        <p>Monto máximo a prestar</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-calendar-alt"></i>
                    <div>
                        <h4>Hasta 72 meses</h4>
                        <p>Plazos flexibles disponibles</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <b>Aprobación rápida</b>
                        <p>En minutos</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <b>Pagos seguros</b>
                        <p>Protección total</p>
                    </div>
                </div>

            </div>

        </div>
    </div>
    <script>

            const clientes = [

                                    @foreach (var c in Model)
                {
                    <text>
                            {
                                nombre: "@c.NombreCompleto",
                            comentario: "@c.Comentario",
                            estrellas: @c.Calificacion
                                                                    },
                    </text>
                                    }

                                    ];

            let inicio = 0;
            const visibles = 3;

            function renderClientes() {

                let html = "";

                for (let i = inicio; i < inicio + visibles && i < clientes.length; i++) {

                    let estrellas = "";

                    for (let j = 0; j < clientes[i].estrellas; j++) {
                        estrellas += "⭐";
                    }

                    html += `
                                            <div class="client">
                                                <div class="client-icon">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div>
                                                    <b>${clientes[i].nombre}</b>
                                                    <p>${clientes[i].comentario}</p>
                                                    ${estrellas}
                                                </div>
                                            </div>`;
                }

                document.getElementById("clientGrid").innerHTML = html;

                document.getElementById("btnLeft").disabled = (inicio === 0);

                document.getElementById("btnRight").disabled =
                    (inicio >= clientes.length - visibles);
            }

            function moverClientes(direccion) {

                inicio += direccion;

                if (inicio < 0)
                    inicio = 0;

                if (inicio > clientes.length - visibles)
                    inicio = clientes.length - visibles;

                renderClientes();
            }

            window.onload = renderClientes;

    </script>
    <script src="~/js/config-global.js"></script>
</body>
</html>