@model List<prestamoscreditos.Models.ComentarioClienteViewModel>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>CrediPlus</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha384-t1nt8BQoYMLFN5p42tRAtuAAFQaCQODekUVeKKZrEnEyp4H2R0RHFz0KWpmj7i8g"
          crossorigin="anonymous">

    <link rel="stylesheet" href="~/css/pantalla-principal.css" asp-append-version="true" />
</head>

<body>

    <div class="container">

        <div class="content">

            <div class="top">
                <h2>Portal CrediPlus - Préstamos Personales</h2>

                <div>
                    <a href="@Url.Action("IniciarSesion", "Login")"
                       class="btn-login">
                        Iniciar Sesión
                    </a>
                    <a href="@Url.Action("Registro", "Login")"
                       class="btn-register">
                        Registrarse
                    </a>
                </div>
            </div>

            <div class="welcome">
                <h1>Bienvenido a <span>CrediPlus</span>.</h1>
                <h2>Fácil, rápido y adaptado a ti.</h2>
            </div>

            <div class="loan-banner">
                <div class="loan-left">

                    <div class="loan-image">
                        💸
                    </div>

                    <div class="loan-info">
                        <h2>Solicita tu préstamo personal</h2>

                        <p>
                            Obtén hasta S/ 50,000 de forma rápida,
                            100% online y segura.
                        </p>

                        <div class="loan-feature">
                            <i class="fas fa-bolt"></i>
                            <div>
                                <strong>Aprobación inmediata</strong>
                                <span>Respuesta en minutos</span>
                            </div>
                        </div>

                        <div class="loan-feature">
                            <i class="fas fa-file-alt"></i>
                            <div>
                                <strong>Sin papeles</strong>
                                <span>Todo el proceso es digital</span>
                            </div>
                        </div>

                        <div class="loan-feature">
                            <i class="fas fa-calendar-alt"></i>
                            <div>
                                <strong>Plazos flexibles</strong>
                                <span>12, 18, 24, 30, 36, 48, 60 y 72 meses</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="loan-right">

                    <small>Monto máximo a solicitar</small>

                    <h1>S/ 50,000</h1>

                    <div class="loan-line"></div>

                    <a class="loan-btn"
                       href="@Url.Action("IniciarSesion", "Login")">
                        Solicitar préstamo →
                    </a>

                </div>
            </div>

            <div class="grid">

                <div class="card">
                    <h2>¿Por qué elegir CrediPlus?</h2>

                    <div class="why">

                        <div class="feature">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <b>Tasas bajas</b>
                                <p>Tasas transparentes</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <b>Seguridad</b>
                                <p>Protección total</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-file-contract"></i>
                            <div>
                                <b>Transparencia</b>
                                <p>Sin costos ocultos</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-headset"></i>
                            <div>
                                <b>Atención</b>
                                <p>Soporte 24/7</p>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card">

                    <h2>Proceso en 4 pasos</h2>

                    <div class="steps">

                        <div>
                            <div class="step-icon"><i class="fas fa-calculator"></i></div>
                            <p>Simula</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                        <div>
                            <div class="step-icon"><i class="fas fa-user-plus"></i></div>
                            <p>Regístrate</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                        <div>
                            <div class="step-icon"><i class="fas fa-shield-alt"></i></div>
                            <p>Verifica</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                        <div>
                            <div class="step-icon"><i class="fas fa-money-bill"></i></div>
                            <p>Obtén dinero</p>
                        </div>

                    </div>
                </div>

            </div>

            <div class="clients">

                <h2>Nuestros Clientes Dicen</h2>

                <div class="carousel-container">

                    <button id="btnLeft"
                            class="carousel-btn">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <div class="client-grid" id="clientGrid">
                    </div>

                    <button id="btnRight"
                            class="carousel-btn">
                        <i class="fas fa-chevron-right"></i>
                    </button>

                </div>

            </div>

            <div class="learn">

                <h2>Aprende Más & Mantente Informado</h2>

                <div class="learn-grid">

                    <div class="learn-card">
                        <i class="fas fa-book"></i>
                        <h3>Educación Financiera</h3>
                        <p>Consejos para mejorar tu historial.</p>
                    </div>

                    <div class="learn-card">
                        <i class="fas fa-bell"></i>
                        <h3>Nuevas Ofertas</h3>
                        <p>Promociones exclusivas.</p>
                    </div>

                    <div class="learn-card">
                        <i class="fas fa-headset"></i>
                        <h3>Soporte 24/7</h3>
                        <p>Atención inmediata.</p>
                    </div>

                </div>

            </div>

            <div class="footer-features">

                <div class="footer-item">
                    <i class="fas fa-laptop"></i>
                    <div>
                        <b>100% online</b>
                        <p>Todo digital</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-money-check-alt"></i>
                    <div>
                        <h4>Hasta S/ 50,000</h4>
                        <p>Monto máximo a prestar</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-calendar-alt"></i>
                    <div>
                        <h4>Hasta 72 meses</h4>
                        <p>Plazos flexibles disponibles</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <b>Aprobación rápida</b>
                        <p>En minutos</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <b>Pagos seguros</b>
                        <p>Protección total</p>
                    </div>
                </div>

            </div>

        </div>
    </div>
    <script id="clientesData" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model ?? new List<prestamoscreditos.Models.ComentarioClienteViewModel>()).Select(c => new {
            nombre = c.NombreCompleto,
            comentario = c.Comentario,
            estrellas = c.Calificacion
        })))
    </script>
    <script src="~/js/pantalla-principal.js" asp-append-version="true"></script>
</body>
</html>