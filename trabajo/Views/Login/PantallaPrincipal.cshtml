@model List<prestamoscreditos.Models.ComentarioClienteViewModel>
@{

    Layout = null;

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>CrediPlus</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI',sans-serif;
        }

        body {
            background: #faf8ff;
        }

        .container {
            display: flex;
            min-height: 100vh;
        }

        /* MENU */

        .sidebar {
            width: 300px;
            background: linear-gradient(180deg, #240046, #3c096c, #5a189a);
            color: white;
            padding: 28px 22px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 45px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .menu a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 18px 22px;
            border-radius: 16px;
            margin-bottom: 22px;
            font-size: 18px;
            font-weight: 500;
        }

            .menu a:hover,
            .menu .active {
                background: rgba(255,255,255,.18);
            }

        /* CONTENIDO */

        .content {
            flex: 1;
            padding: 34px 42px;
        }
        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-login {
            background: #6d28d9;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
        }

        .btn-register {
            background: #22c55e;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
        }

        .welcome {
            background: white;
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            margin-top: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,.1);
        }

            .welcome h1 {
                font-size: 50px;
            }

            .welcome span {
                color: #6d28d9;
            }

        .banner {
            margin-top: 25px;
            background: linear-gradient(90deg,#2b0050,#5b21b6,#3b82f6);
            color: white;
            border-radius: 20px;
            padding: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .banner-left {
            display: flex;
            gap: 25px;
        }

        .money-box {
            width: 100px;
            height: 100px;
            border-radius: 20px;
            background: rgba(255,255,255,.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
        }

        .banner h2 {
            font-size: 40px;
        }

        .banner ul {
            margin-top: 15px;
            margin-left: 20px;
        }

        .amount {
            text-align: center;
        }

            .amount h1 {
                font-size: 60px;
            }

        .btn-loan {
            margin-top: 20px;
            border: none;
            padding: 15px 25px;
            background: #22c55e;
            color: white;
            border-radius: 12px;
            font-size: 18px;
        }

        .grid {
            margin-top: 25px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
        }

            .card h2 {
                margin-bottom: 15px;
            }

        .why {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .feature {
            display: flex;
            gap: 10px;
        }

            .feature i {
                color: #6d28d9;
            }

        .steps {
            display: flex;
            justify-content: space-around;
            text-align: center;
        }

        .step-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            background: #efe4ff;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6d28d9;
            font-size: 25px;
            margin: auto;
        }

        /* CLIENTES */

        .clients {
            margin-top: 25px;
            background: white;
            padding: 25px;
            border-radius: 20px;
        }

        .client-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 15px;
            margin-top: 15px;
        }

        .client {
            background: #f8f5ff;
            padding: 15px;
            border-radius: 15px;
            display: flex;
            gap: 15px;
        }

        .client-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #6d28d9;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        /* INFORMACION */

        .learn {
            margin-top: 25px;
            background: white;
            border-radius: 20px;
            padding: 25px;
        }

        .learn-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 20px;
            margin-top: 20px;
        }

        .learn-card {
            background: #f8f5ff;
            padding: 20px;
            border-radius: 15px;
        }

            .learn-card i {
                font-size: 35px;
                color: #6d28d9;
                margin-bottom: 15px;
            }

        .footer-features {
            margin-top: 25px;
            background: white;
            padding: 20px;
            border-radius: 20px;
            display: grid;
            grid-template-columns: repeat(5,1fr);
            gap: 20px;
        }

        .footer-item {
            display: flex;
            gap: 10px;
        }

            .footer-item i {
                color: #6d28d9;
                font-size: 24px;
            }

        .steps {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
        }

        .step-arrow {
            color: #b7b7b7;
            font-size: 28px;
        }

        .banner-loan {
            margin-top: 30px;
            background: linear-gradient(90deg,#2f005f,#5b1cb8,#2f80ed);
            border-radius: 25px;
            padding: 25px 45px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
            min-height: 230px;
        }

        .banner-left {
            display: flex;
            align-items: center;
            gap: 18px;
            flex: 1;
        }

        .money-box {
            width: 75px;
            height: 75px;
            background: rgba(255,255,255,.12);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 38px;
        }

        .banner-left h2 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
        }

        .banner-left p {
            margin-top: 8px;
            color: #ececec;
        }

        .banner-left ul {
            margin-top: 15px;
            list-style: none;
            padding: 0;
        }

            .banner-left ul li {
                margin-bottom: 8px;
                font-size: 15px;
            }

                .banner-left ul li::before {
                    content: "✓";
                    margin-right: 10px;
                }

        .banner-right {
            text-align: left;
            min-width: 220px;
        }

            .banner-right small {
                color: #ececec;
            }

            .banner-right h1 {
                margin: 5px 0 15px 0;
                font-size: 48px;
                font-weight: 800;
            }

            .banner-right p {
                margin: 6px 0;
            }

        .btn-loan {
            display: inline-block;
            margin-top: 20px;
            background: #32d26a;
            color: white;
            padding: 14px 35px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 700;
        }

            .btn-loan:hover {
                background: #22c55e;
                color: white;
            }

        .top div {
            display: flex;
            gap: 8px;
        }

        .btn-login,
        .btn-register {
            display: inline-block;
            padding: 12px 30px;
            border-radius: 14px;
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            transition: .3s;
        }

            .btn-login:hover,
            .btn-register:hover {
                transform: translateY(-4px) scale(1.05);
                box-shadow: 0 12px 25px rgba(0,0,0,.20);
            }

        .faq-shortcut {
            width: 100%;
            background: linear-gradient(135deg,#6d28d9,#7c3aed);
            border-radius: 24px;
            padding: 28px;
            display: flex;
            align-items: center;
            gap: 18px;
            text-decoration: none;
            transition: .3s;
            box-shadow: 0 10px 25px rgba(109,40,217,.25);
            margin-top: auto;
            margin-bottom: 25px;
        }

            .faq-shortcut:hover {
                transform: translateY(-5px);
                box-shadow: 0 18px 35px rgba(109,40,217,.35);
            }

        .faq-icon {
            width: 60px;
            height: 60px;
            border-radius: 18px;
            background: rgba(255,255,255,.18);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            color: white;
            font-weight: 900;
        }

        .faq-shortcut h4 {
            color: white;
            margin: 0;
            font-size: 25px;
            font-weight: 800;
        }

        .faq-shortcut p {
            margin-top: 6px;
            color: #e9d5ff;
            font-size: 15px;
        }

        .loan-banner {
            margin-top: 35px;
            background: linear-gradient(90deg,#2b0050,#5b21b6,#3b82f6);
            border-radius: 28px;
            padding: 40px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 15px 40px rgba(76,29,149,.25);
        }

        .loan-left {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .loan-image {
            width: 120px;
            height: 120px;
            border-radius: 24px;
            background: rgba(255,255,255,.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 60px;
        }

        .loan-info h2 {
            font-size: 34px;
            font-weight: 800;
            margin-bottom: 10px;
            color: white;
        }

        .loan-info p {
            color: #ddd6fe;
            font-size: 18px;
            margin-bottom: 20px;
        }

        .loan-feature {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

            .loan-feature i {
                width: 55px;
                height: 55px;
                border-radius: 16px;
                background: rgba(255,255,255,.12);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                color: white;
            }

            .loan-feature strong {
                display: block;
                font-size: 18px;
                color: white;
            }

            .loan-feature span {
                color: #ddd6fe;
                font-size: 16px;
            }

        .loan-right {
            min-width: 300px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .loan-right small {
                color: #ddd6fe;
                font-size: 15px;
            }

            .loan-right h1 {
                font-size: 60px;
                margin: 5px 0 15px;
                font-weight: 800;
                color: white;
            }

        .loan-line {
            width: 100%;
            height: 2px;
            background: rgba(255,255,255,.2);
            margin: 25px 0 35px;
        }

        .loan-btn {
            border: none;
            border-radius: 14px;
            padding: 18px 30px;
            background: #22c55e;
            color: white !important;
            text-decoration: none;
            font-size: 22px;
            font-weight: bold;
            text-align: center;
            transition: .3s;
        }

            .loan-btn:hover {
                background: #16a34a;
            }

        .carousel-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .client-grid {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 15px;
        }

        .carousel-btn {
            width: 50px;
            height: 50px;
            border: none;
            border-radius: 50%;
            background: #6d28d9;
            color: white;
            font-size: 20px;
            cursor: pointer;
            transition: .3s;
        }

            .carousel-btn:hover {
                background: #5b21b6;
                transform: scale(1.1);
            }

            .carousel-btn:disabled {
                background: #c5c5c5;
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }
    </style>
</head>

<body>

    <div class="container">

        <div class="sidebar">
            <div class="logo">
                💳 CrediPlus
            </div>

            <div class="menu">
                <a href="@Url.Action("PantallaPrincipal", "Login")">🏠 Inicio</a>
                <a href="@Url.Action("IniciarSeccion", "Login")">📄 Mis Solicitudes</a>
                <a href="@Url.Action("IniciarSeccion", "Login")">🧮 Simulador de Crédito</a>
                <a href="@Url.Action("IniciarSeccion", "Login")">💳 Pagos Pendientes</a>
                <a href="@Url.Action("IniciarSeccion", "Login")">👤 Perfil Personal</a>
                <a href="@Url.Action("IniciarSeccion", "Login")">⚙ Configuración</a>
            </div>
            <br />
            <br />

            <a href="@Url.Action("PreguntasFrecuentes", "Login")" class="faq-shortcut">

                <div class="faq-icon">
                    ?
                </div>

                <div>
                    <h4>Preguntas frecuentes</h4>
                    <p>Resolvemos tus dudas</p>
                </div>

            </a>

        </div>

        <div class="content">

            <div class="top">
                <h2>Portal CrediPlus - Préstamos Personales</h2>

                <div>
                    <a href="@Url.Action("IniciarSeccion", "Login")"
                       class="btn-login">
                        Iniciar Sesión
                    </a>
                    <a href="@Url.Action("Registro", "Login")"
                       class="btn-register">
                        Registrarse
                    </a>
                </div>
            </div>

            <div class="welcome">
                <h1>Bienvenido a <span>CrediPlus</span>.</h1>
                <h2>Fácil, rápido y adaptado a ti.</h2>
            </div>

            <div class="loan-banner">
                <div class="loan-left">

                    <div class="loan-image">
                        💸
                    </div>

                    <div class="loan-info">
                        <h2>Solicita tu préstamo personal</h2>

                        <p>
                            Obtén hasta S/ 50,000 de forma rápida,
                            100% online y segura.
                        </p>

                        <div class="loan-feature">
                            <i class="fas fa-bolt"></i>
                            <div>
                                <strong>Aprobación inmediata</strong>
                                <span>Respuesta en minutos</span>
                            </div>
                        </div>

                        <div class="loan-feature">
                            <i class="fas fa-file-alt"></i>
                            <div>
                                <strong>Sin papeles</strong>
                                <span>Todo el proceso es digital</span>
                            </div>
                        </div>

                        <div class="loan-feature">
                            <i class="fas fa-calendar-alt"></i>
                            <div>
                                <strong>Plazos flexibles</strong>
                                <span>12, 18, 24, 30, 36, 48, 60 y 72 meses</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="loan-right">

                    <small>Monto máximo a solicitar</small>

                    <h1>S/ 50,000</h1>

                    <div class="loan-line"></div>

                    <a class="loan-btn"
                       href="@Url.Action("IniciarSeccion", "Login")">
                        Solicitar préstamo →
                    </a>

                </div>
            </div>
            
            <div class="grid">

                <div class="card">
                    <h2>¿Por qué elegir CrediPlus?</h2>

                    <div class="why">

                        <div class="feature">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <b>Tasas bajas</b>
                                <p>Tasas transparentes</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <b>Seguridad</b>
                                <p>Protección total</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-file-contract"></i>
                            <div>
                                <b>Transparencia</b>
                                <p>Sin costos ocultos</p>
                            </div>
                        </div>

                        <div class="feature">
                            <i class="fas fa-headset"></i>
                            <div>
                                <b>Atención</b>
                                <p>Soporte 24/7</p>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card">

                    <h2>Proceso en 4 pasos</h2>

                    <div class="steps">

                        <div>
                            <div class="step-icon"><i class="fas fa-calculator"></i></div>
                            <p>Simula</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                        <div>
                            <div class="step-icon"><i class="fas fa-user-plus"></i></div>
                            <p>Regístrate</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                        <div>
                            <div class="step-icon"><i class="fas fa-shield-alt"></i></div>
                            <p>Verifica</p>
                        </div>
                        <div class="step-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                        <div>
                            <div class="step-icon"><i class="fas fa-money-bill"></i></div>
                            <p>Obtén dinero</p>
                        </div>

                    </div>
                </div>

            </div>

            <div class="clients">

                <h2>Nuestros Clientes Dicen</h2>

                <div class="carousel-container">

                    <button id="btnLeft"
                            class="carousel-btn"
                            onclick="moverClientes(-1)">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <div class="client-grid" id="clientGrid">

                    </div>

                    <button id="btnRight"
                            class="carousel-btn"
                            onclick="moverClientes(1)">
                        <i class="fas fa-chevron-right"></i>
                    </button>

                </div>

            </div>

            <div class="learn">

                <h2>Aprende Más & Mantente Informado</h2>

                <div class="learn-grid">

                    <div class="learn-card">
                        <i class="fas fa-book"></i>
                        <h3>Educación Financiera</h3>
                        <p>Consejos para mejorar tu historial.</p>
                    </div>

                    <div class="learn-card">
                        <i class="fas fa-bell"></i>
                        <h3>Nuevas Ofertas</h3>
                        <p>Promociones exclusivas.</p>
                    </div>

                    <div class="learn-card">
                        <i class="fas fa-headset"></i>
                        <h3>Soporte 24/7</h3>
                        <p>Atención inmediata.</p>
                    </div>

                </div>

            </div>

            <div class="footer-features">

                <div class="footer-item">
                    <i class="fas fa-laptop"></i>
                    <div>
                        <b>100% online</b>
                        <p>Todo digital</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-money-check-alt"></i>
                    <div>
                        <h4>Hasta S/ 50,000</h4>
                        <p>Monto máximo a prestar</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-calendar-alt"></i>
                    <div>
                        <h4>Hasta 72 meses</h4>
                        <p>Plazos flexibles disponibles</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <b>Aprobación rápida</b>
                        <p>En minutos</p>
                    </div>
                </div>

                <div class="footer-item">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <b>Pagos seguros</b>
                        <p>Protección total</p>
                    </div>
                </div>

            </div>

        </div>
    </div>
    <script>

        const clientes = [

        @foreach (var c in Model)
        {
                <text>
                {
                    nombre: "@c.NombreCompleto",
                    comentario: "@c.Comentario",
                    estrellas: @c.Calificacion
                },
                </text>
        }

        ];

        let inicio = 0;
        const visibles = 3;

        function renderClientes() {

            let html = "";

            for (let i = inicio; i < inicio + visibles && i < clientes.length; i++) {

                let estrellas = "";

                for (let j = 0; j < clientes[i].estrellas; j++) {
                    estrellas += "⭐";
                }

                html += `
                <div class="client">
                    <div class="client-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <b>${clientes[i].nombre}</b>
                        <p>${clientes[i].comentario}</p>
                        ${estrellas}
                    </div>
                </div>`;
            }

            document.getElementById("clientGrid").innerHTML = html;

            document.getElementById("btnLeft").disabled = (inicio === 0);

            document.getElementById("btnRight").disabled =
                (inicio >= clientes.length - visibles);
        }

        function moverClientes(direccion) {

            inicio += direccion;

            if (inicio < 0)
                inicio = 0;

            if (inicio > clientes.length - visibles)
                inicio = clientes.length - visibles;

            renderClientes();
        }

        window.onload = renderClientes;

    </script>
    <script src="~/js/config-global.js"></script>
</body>
</html>