@{
    Layout = null;
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "Configuracion";
    ViewData["ActivePage"] = "Configuracion";
}

@section Styles {
    <link rel="stylesheet" href="~/css/configuracion.css" />
}

<div class="content">

    <div class="title">
        <h1>Configuración</h1>
        <p>Personaliza tu experiencia, seguridad y preferencias dentro de CrediPlus.</p>
    </div>

    <div class="config-card">

        <div class="tabs">
            <button type="button" class="tab-btn active" data-tab="apariencia">Apariencia</button>
            <button type="button" class="tab-btn" data-tab="accesibilidad">Accesibilidad</button>
            <button type="button" class="tab-btn" data-tab="notificaciones">Notificaciones</button>
        </div>

        <div id="apariencia" class="tab-content active">
            <h2 class="section-title2">Apariencia del sistema</h2>

            <div class="setting-grid">
                <div class="setting-box">
                    <label>Modo visual</label>
                    <p>Cambia entre modo claro y oscuro.</p>
                    <select id="modoVisual">
                        <option value="claro">Claro</option>
                        <option value="oscuro">Oscuro</option>
                    </select>
                </div>

                <div class="setting-box">
                    <label>Color principal</label>
                    <p>Cambia el color de títulos y botones.</p>
                    <select id="colorPrincipal">
                        <option value="morado">Morado</option>
                        <option value="azul">Azul</option>
                        <option value="verde">Verde</option>
                        <option value="rojo">Rojo</option>
                        <option value="negro">Negro</option>
                    </select>
                </div>

                <div class="setting-box">
                    <label>Vista compacta</label>
                    <p>Reduce espacios del formulario.</p>
                    <div id="vistaCompacta" class="switch"></div>
                </div>

                <div class="setting-box">
                    <label>Animaciones</label>
                    <p>Activa o desactiva efectos visuales.</p>
                    <div id="animaciones" class="switch active"></div>
                </div>
                <div class="setting-box">
                    <label>Redondeado de tarjetas</label>
                    <p>Cambia el borde redondo de las tarjetas.</p>
                    <select id="redondeado">
                        <option value="normal">Normal</option>
                        <option value="grande">Grande</option>
                        <option value="cuadrado">Más cuadrado</option>
                    </select>
                </div>

                <div class="setting-box">
                    <label>Separación del contenido</label>
                    <p>Aumenta o reduce los espacios generales.</p>
                    <select id="espaciado">
                        <option value="normal">Normal</option>
                        <option value="amplio">Amplio</option>
                        <option value="compacto">Compacto</option>
                    </select>
                </div>
            </div>
        </div>

        <div id="accesibilidad" class="tab-content">
            <h2 class="section-title2">Accesibilidad</h2>

            <div class="setting-grid">
                <div class="setting-box">
                    <label>Tamaño de texto</label>
                    <p>Aumenta el tamaño de las letras.</p>
                    <select id="tamanoTexto">
                        <option value="normal">Normal</option>
                        <option value="grande">Grande</option>
                        <option value="muyGrande">Muy grande</option>
                    </select>
                </div>

                <div class="setting-box">
                    <label>Alto contraste</label>
                    <p>Marca más los bordes y textos.</p>
                    <div id="altoContraste" class="switch"></div>
                </div>

                <div class="setting-box">
                    <label>Botones grandes</label>
                    <p>Aumenta el tamaño de los botones.</p>
                    <div id="botonesGrandes" class="switch"></div>
                </div>

                <div class="setting-box">
                    <label>Ayuda rápida</label>
                    <p>Muestra ayudas dentro del sistema.</p>
                    <div id="ayudaRapida" class="switch active"></div>
                </div>
            </div>
        </div>

        <div id="notificaciones" class="tab-content">
            <h2 class="section-title2">Notificaciones personales</h2>

            <div class="setting-grid">
                <div class="setting-box">
                    <label>Recordatorios de pago</label>
                    <p>Avisa antes de fechas de pago.</p>
                    <div id="recordatoriosPago" class="switch active"></div>
                </div>

                <div class="setting-box">
                    <label>Alertas de cambios</label>
                    <p>Avisa cuando cambias una solicitud.</p>
                    <div id="alertasCambios" class="switch active"></div>
                </div>

                <div class="setting-box">
                    <label>Sonido de alerta</label>
                    <p>Muestra una alerta al guardar.</p>
                    <div id="sonidoAlertas" class="switch"></div>
                </div>

                <div class="setting-box">
                    <label>Mensaje de bienvenida</label>
                    <p>Muestra saludo al ingresar.</p>
                    <div id="mensajeBienvenida" class="switch active"></div>
                </div>
                <div class="setting-box">
                    <label>Mostrar tarjeta de preguntas frecuentes</label>
                    <p>Muestra u oculta el cuadro de ayuda del menú lateral.</p>
                    <div id="mostrarFaq" class="switch active"></div>
                </div>

                <div class="setting-box">
                    <label>Resaltar botones importantes</label>
                    <p>Agrega sombra a botones principales.</p>
                    <div id="resaltarBotones" class="switch active"></div>
                </div>
            </div>
        </div>

        <div class="actions">
            <button id="btnGuardarConfiguracion" type="button" class="btn-save">
                <i class="fas fa-save"></i> Guardar configuración
            </button>

            <button id="btnRestablecerConfiguracion" type="button" class="btn-reset">
                <i class="fas fa-rotate-left"></i> Restablecer
            </button>
        </div>

        <div id="mensajeOk" class="message">
            Configuración guardada correctamente.
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/config-global.js"></script>
    <script src="~/js/configuracion.js"></script>
}