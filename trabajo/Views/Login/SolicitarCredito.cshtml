@{
    Layout = null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="page">
    <div class="contenedor @(ViewBag.MostrarModalBloqueo == true ? "contenedor-bloqueado" : "")">

        <div class="side">
            <div>
                <h2><i class="fas fa-wallet"></i> CrediPlus</h2>

                <p>Tu crédito,<br>tu mejor opción.</p>

                <div class="side-item"><i class="fas fa-bolt"></i> Aprobación rápida</div>
                <br />
                <div class="side-item"><i class="fas fa-file-alt"></i> Sin papeles</div>
                <br />
                <div class="side-item"><i class="fas fa-calendar"></i> Plazos flexibles<br>   12 a 72 meses</div>
                <br />
                <div class="side-item"><i class="fas fa-shield-alt"></i> 100% seguro</div>
                <br />
                <div class="side-item"><i class="fas fa-money-bill"></i> S/ 1,000 hasta S/ 50,000</div>
            </div>

            <div class="wallet-3d">
                <div class="bills">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <div class="wallet-body">
                    <div class="wallet-line"></div>
                    <div class="wallet-button"></div>
                </div>

                <div class="coin coin1"></div>
                <div class="coin coin2"></div>
                <div class="coin coin3"></div>
            </div>

            <a id="btnVolver" href="@Url.Action("DashboardCliente", "Login")">← Volver</a>
        </div>

        <div class="card">
            <div class="header">
                <i class="fas fa-wallet"></i>
                <h1>CrediPlus</h1>
                <p>Solicitud de préstamo personal</p>
            </div>

            <div class="steps">
                <div class="step active" id="step1">1</div>
                <div class="line"></div>
                <div class="step" id="step2">2</div>
                <div class="line"></div>
                <div class="step" id="step3">3</div>
                <div class="line"></div>
                <div class="step" id="step4">4</div>
            </div>

            <div class="step-text">
                <span>Datos del préstamo</span>
                <span>Información financiera</span>
                <span>Método de pago</span>
                <span>Confirmación</span>
            </div>

            <form method="post" action="@Url.Action("RegistrarSolicitudCredito", "Login")">

                <div id="pantalla1">
                    <h2>Datos del préstamo</h2>

                    <label>Monto solicitado <i class="fas fa-info-circle"></i></label>

                    

                    <div class="monto-box">
                        <h3 id="textoMonto">S/ 15,000</h3>
                    </div>

                    <input type="range"
                           id="rangoMonto"
                           min="1000"
                           max="50000"
                           step="500"
                           value="15000"
                           oninput="actualizarMonto()" />

                    <input type="hidden"
                           name="montoSolicitado"
                           id="montoSolicitadoReal"
                           value="15000">

                    <div class="rango-texto">
                        <span>S/ 1,000</span>
                        <span>S/ 50,000</span>
                    </div>

                    <p class="rango-info">Rango permitido: S/ 1,000 hasta S/ 50,000</p>

                    <label>Plazo en meses <i class="fas fa-info-circle"></i></label>

                    <select name="plazoMeses" required>
                        <option value="">Seleccione el plazo</option>
                        <option value="12">12 meses</option>
                        <option value="18">18 meses</option>
                        <option value="24">24 meses</option>
                        <option value="30">30 meses</option>
                        <option value="36">36 meses</option>
                        <option value="48">48 meses</option>
                        <option value="60">60 meses</option>
                        <option value="72">72 meses</option>
                    </select>

                    <div class="help">
                        <i class="fas fa-lightbulb"></i>
                        Puedes solicitar desde S/ 1,000 hasta S/ 50,000 según tu capacidad de pago.
                    </div>

                    <button type="button" onclick="validarPaso1()" class="btn-main">
                        Continuar →
                    </button>
                </div>

                <div id="pantalla2" class="oculto">
                    <h2>Información financiera</h2>

                    <label>Ingreso mensual <i class="fas fa-info-circle"></i></label>
                    <div class="input-money">
                        <span>S/</span>
                        <input type="text" name="ingresoMensual" id="ingresoMensual" oninput="formatearDinero(this)" required>
                        <i class="fas fa-arrow-up icon-green"></i>
                    </div>

                    <label>Egreso mensual <i class="fas fa-info-circle"></i></label>
                    <div class="input-money">
                        <span>S/</span>
                        <input type="text" name="egresoMensual" id="egresoMensual" oninput="formatearDinero(this)" required>
                        <i class="fas fa-arrow-down icon-red"></i>
                    </div>

                    <label>¿Tienes otros créditos? <i class="fas fa-info-circle"></i></label>
                    <input type="hidden" name="tieneOtrosCreditos" id="tieneOtrosCreditos" required>

                    <div class="opciones-creditos">
                        <div class="opcion-card" onclick="seleccionarCredito('Si', this)">
                            <span>Sí, tengo otros créditos</span>
                        </div>

                        <div class="opcion-card" onclick="seleccionarCredito('No', this)">
                            <span>No, no tengo créditos</span>
                        </div>
                    </div>

                    <label>Motivo del préstamo <i class="fas fa-info-circle"></i></label>
                    <input type="hidden" name="motivoPrestamo" id="motivoPrestamo" required>

                    <div class="motivos">
                        <div class="motivo-card" onclick="seleccionarMotivo('Estudios', this)">
                            <i class="fas fa-graduation-cap"></i> Estudios
                        </div>

                        <div class="motivo-card" onclick="seleccionarMotivo('Negocio', this)">
                            <i class="fas fa-briefcase"></i> Negocio
                        </div>

                        <div class="motivo-card" onclick="seleccionarMotivo('Salud', this)">
                            <i class="fas fa-heartbeat"></i> Salud
                        </div>

                        <div class="motivo-card" onclick="seleccionarMotivo('Vivienda', this)">
                            <i class="fas fa-home"></i> Vivienda
                        </div>

                        <div class="motivo-card" onclick="seleccionarMotivo('Emergencia', this)">
                            <i class="fas fa-exclamation-circle"></i> Emergencia
                        </div>

                        <div class="motivo-card" onclick="seleccionarMotivo('Compra personal', this)">
                            <i class="fas fa-shopping-bag"></i> Compra personal
                        </div>
                    </div>

                    <div class="otros-box">
                        <button type="button" class="motivo-otros" onclick="activarOtroMotivo(this)">
                            <i class="fas fa-pen"></i> Otros
                        </button>

                        <input type="text"
                               name="motivoOtro"
                               id="motivoOtro"
                               placeholder="Escribe tu motivo"
                               maxlength="60"
                               disabled>
                    </div>

                    <label>Ocupación <i class="fas fa-info-circle"></i></label>
                    <div class="input-money">
                        <span><i class="fas fa-user"></i></span>
                        <input type="text"
                               name="ocupacion"
                               id="ocupacion"
                               required>
                    </div>

                    <div class="info-box">
                        <b>¿Qué significa cada campo?</b><br>
                        <p><i class="fas fa-arrow-up icon-green"></i> <b>Ingreso mensual:</b> dinero que recibes cada mes.</p>
                        <p><i class="fas fa-arrow-down icon-red"></i> <b>Egreso mensual:</b> dinero que gastas cada mes.</p>
                        <p><i class="fas fa-credit-card"></i> <b>Otros créditos:</b> indica si tienes préstamos o deudas activas.</p>
                        <p><i class="fas fa-pen"></i> <b>Motivo:</b> razón principal por la que solicitas el préstamo.</p>
                        <p><i class="fas fa-user"></i> <b>Ocupación:</b> actividad que realizas actualmente.</p>
                    </div>

                    <button type="button" onclick="mostrarPaso(1)" class="btn-back">← Atrás</button>
                    <button type="button" onclick="validarPaso2()" class="btn-main btn-right">Solicitar evaluación →</button>
                </div>
                <div id="pantalla3" class="oculto">
                    <h2>Método de pago</h2>

                    <label>¿Dónde deseas recibir el préstamo?</label>

                    <input type="hidden" name="metodoPago" id="metodoPago" required>

                    <div class="motivos">
                        <div class="motivo-card" onclick="seleccionarMetodoPago('Transferencia bancaria', this)">
                            <i class="fas fa-building-columns"></i> Transferencia bancaria
                        </div>

                        <div class="motivo-card" onclick="seleccionarMetodoPago('Yape', this)">
                            <i class="fas fa-mobile-screen"></i> Yape
                        </div>

                        <div class="motivo-card" onclick="seleccionarMetodoPago('Plin', this)">
                            <i class="fas fa-mobile"></i> Plin
                        </div>
                    </div>

                    <label>Entidad</label>
                    <select name="entidadPago" id="entidadPago" required>
                        <option value="">Seleccione entidad</option>
                    </select>

                    <label>Número de cuenta o celular</label>
                    <input type="text"
                           name="numeroCuentaPago"
                           id="numeroCuentaPago"
                           placeholder="Ingrese número"
                           required
                           oninput="this.value=this.value.replace(/[^0-9]/g,'')">

                    <label>Titular</label>
                    <input type="text" name="titularCuenta" id="titularCuenta" placeholder="Nombre del titular">

                    <div class="help">
                        <i class="fas fa-shield-alt"></i>
                        Verifica que los datos sean correctos. El desembolso se realizará al método registrado.
                    </div>

                    <button type="button" onclick="mostrarPaso(2)" class="btn-back">← Atrás</button>
                    <button type="button" onclick="validarPaso3()" class="btn-main btn-right">Finalizar solicitud →</button>
                </div>
                <div id="pantalla4" class="oculto">
                    <div class="confirm-box">
                        <div class="hourglass">⌛</div>

                        <h2>¡Solicitud recibida!</h2>
                        <p>Tu solicitud está en evaluación</p>

                        <div class="warning-box">
                            ⚠ Estamos revisando tu información.<br>
                            Te notificaremos cuando tengamos una respuesta entre 24 horas.
                        </div>

                        <div class="next-box">
                            <b>¿Qué pasa ahora?</b>
                            <p>✔ Nuestro equipo de análisis revisará tu solicitud.</p>
                            <p>✔ Te enviaremos una notificación con la respuesta.</p>
                            <p>✔ Este proceso puede tardar entre 24 horas.</p>
                        </div>

                        <div class="confirmacion-botones">

                            <a href="@Url.Action("DashboardCliente", "Login")" class="btn-salir">
                                <i class="fas fa-sign-out-alt"></i>
                                Salir
                            </a>

                            <a href="@Url.Action("MisSolicitudes", "Login")" class="btn-mis-solicitudes">
                                <i class="fas fa-file-alt"></i>
                                Ver mis solicitudes
                            </a>

                        </div>
                    </div>
                </div>

            </form>
        </div>

    </div>
</div>
@if (ViewBag.MostrarModalBloqueo == true)
{
    <div class="modal-bloqueo">
        <div class="modal-bloqueo-card">
            <div class="modal-bloqueo-icono">
                <i class="fas fa-circle-exclamation"></i>
            </div>

            <h2>@ViewBag.TituloBloqueo</h2>
            <p>@ViewBag.MensajeBloqueo</p>

            <div class="modal-bloqueo-botones">
                <a href="@Url.Action("DashboardCliente", "Login")" class="btn-modal-secundario">
                    Volver al inicio
                </a>

                <a href="@Url.Action("MisSolicitudes", "Login")" class="btn-modal-principal">
                    Ver mis solicitudes
                </a>
            </div>
        </div>
    </div>
}

<script>
           function actualizarMonto() {
        var monto = document.getElementById("rangoMonto").value;

        document.getElementById("textoMonto").innerText =
            "S/ " + Number(monto).toLocaleString("es-PE");

        document.getElementById("montoSolicitadoReal").value = monto;
    }

    function validarPaso1() {
        var plazo = document.querySelector("[name='plazoMeses']").value;

        if (plazo == "") {
            alert("Selecciona el plazo en meses.");
            return;
        }

        mostrarPaso(2);
    }

   

    function mostrarOtroMotivo() {
        var motivo = document.getElementById("motivoPrestamo").value;
        var otro = document.getElementById("motivoOtro");

        if (motivo == "Otros") {
            otro.classList.remove("oculto");
            otro.required = true;
        } else {
            otro.classList.add("oculto");
            otro.required = false;
        }
    }
        function seleccionarCredito(valor, elemento) {
        document.getElementById("tieneOtrosCreditos").value = valor;

        var opciones = document.querySelectorAll(".opcion-card");
        opciones.forEach(x => x.classList.remove("activo"));

        elemento.classList.add("activo");
    }

    function seleccionarMotivo(valor, elemento) {
        document.getElementById("motivoPrestamo").value = valor;

        var motivos = document.querySelectorAll(".motivo-card");
        motivos.forEach(x => x.classList.remove("activo"));

        var botonOtros = document.querySelector(".motivo-otros");
        botonOtros.classList.remove("activo");

        elemento.classList.add("activo");

        document.getElementById("motivoOtro").disabled = true;
        document.getElementById("motivoOtro").required = false;
        document.getElementById("motivoOtro").value = "";
    }

    function activarOtroMotivo(elemento) {
        document.getElementById("motivoPrestamo").value = "Otros";

        var motivos = document.querySelectorAll(".motivo-card");
        motivos.forEach(x => x.classList.remove("activo"));

        elemento.classList.add("activo");

        document.getElementById("motivoOtro").disabled = false;
        document.getElementById("motivoOtro").required = true;
        document.getElementById("motivoOtro").focus();
    }

        function validarPaso2() {

        var ingreso = document.getElementById("ingresoMensual").value.trim();
        var egreso = document.getElementById("egresoMensual").value.trim();
        var credito = document.getElementById("tieneOtrosCreditos").value.trim();
        var motivo = document.getElementById("motivoPrestamo").value.trim();
        var ocupacion = document.getElementById("ocupacion").value.trim();
        var motivoOtro = document.getElementById("motivoOtro").value.trim();

        if (ingreso === "") {
            alert("Ingresa tu ingreso mensual.");
            return;
        }

        if (egreso === "") {
            alert("Ingresa tu egreso mensual.");
            return;
        }

        if (credito === "") {
            alert("Selecciona si tienes otros créditos.");
            return;
        }

        if (motivo === "") {
            alert("Selecciona el motivo del préstamo.");
            return;
        }

        if (ocupacion === "") {
            alert("Escribe tu ocupación.");
            return;
        }

        if (motivo === "Otros" && motivoOtro === "") {
            alert("Escribe el motivo del préstamo.");
            return;
        }

       mostrarPaso(3);
    }
        function formatearDinero(input) {
        let valor = input.value.replace(/\D/g, '');

        if (valor === '') {
            input.value = '';
            return;
        }

        input.value = Number(valor).toLocaleString('es-PE');
    }
                window.onload = function () {
        var mostrarConfirmacion = '@TempData["MostrarConfirmacion"]';
        var pendiente = '@ViewBag.MostrarConfirmacion';

        if (mostrarConfirmacion == 'true' || pendiente == 'True') {
            mostrarPaso(4);
        }
    };
           function seleccionarMetodoPago(metodo, elemento) {
        document.getElementById("metodoPago").value = metodo;

    document.querySelectorAll("#pantalla3 .motivo-card")
        .forEach(x => x.classList.remove("activo"));

    elemento.classList.add("activo");

        const entidad = document.getElementById("entidadPago");
        const numero = document.getElementById("numeroCuentaPago");

        entidad.innerHTML = '<option value="">Seleccione entidad</option>';
        numero.value = "";

        if (metodo === "Transferencia bancaria") {
            ["BCP", "Interbank", "BBVA", "Scotiabank", "Caja Arequipa"].forEach(x => {
                entidad.innerHTML += `<option value="${x}">${x}</option>`;
            });

            numero.placeholder = "Ingrese número de cuenta";
            numero.maxLength = 20;
        }

        if (metodo === "Yape") {
            ["Yape", "BCP"].forEach(x => {
                entidad.innerHTML += `<option value="${x}">${x}</option>`;
            });

            numero.placeholder = "Ingrese celular Yape";
            numero.maxLength = 9;
        }

        if (metodo === "Plin") {
           ["Plin", "Interbank", "BBVA", "Scotiabank", "Caja Arequipa"].forEach(x => {
                entidad.innerHTML += `<option value="${x}">${x}</option>`;
            });

            numero.placeholder = "Ingrese celular Plin";
            numero.maxLength = 9;
        }
    }

    function validarPaso3() {
        let metodo = document.getElementById("metodoPago").value.trim();
        let entidad = document.getElementById("entidadPago").value.trim();
        let numero = document.getElementById("numeroCuentaPago").value.trim();
        let titular = document.getElementById("titularCuenta").value.trim();

        if (metodo === "") {
            alert("Selecciona un método de pago.");
            return;
        }

        if (entidad === "") {
            alert("Ingresa la entidad de pago.");
            return;
        }

        if (numero === "") {
            alert("Ingresa el número de cuenta, CCI o celular.");
            return;
        }

        if (titular === "") {
            alert("Ingresa el nombre del titular.");
            return;
        }

        document.querySelector("form").submit();
    }
        function mostrarPaso(numero) {
        document.getElementById("pantalla1").classList.add("oculto");
        document.getElementById("pantalla2").classList.add("oculto");
        document.getElementById("pantalla3").classList.add("oculto");
        document.getElementById("pantalla4").classList.add("oculto");

        document.getElementById("pantalla" + numero).classList.remove("oculto");

        document.getElementById("step1").classList.remove("active");
        document.getElementById("step2").classList.remove("active");
        document.getElementById("step3").classList.remove("active");
        document.getElementById("step4").classList.remove("active");

        document.getElementById("step" + numero).classList.add("active");

        document.getElementById("btnVolver").style.display = numero == 1 ? "block" : "none";
    }
</script>

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #2e005f, #5a189a, #7b2ff7);
        color: #1f1235;
    }

    .page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 35px;
        background: radial-gradient(circle at top left, rgba(255,255,255,.18), transparent 28%), radial-gradient(circle at bottom right, rgba(255,255,255,.14), transparent 30%);
    }

    .contenedor {
        width: 1120px;
        min-height: 760px;
        display: flex;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(0,0,0,.10);
    }

    .side {
        width: 310px;
        min-height: 760px;
        background: linear-gradient(180deg, #240046, #5a189a, #6d28d9);
        color: white;
        padding: 45px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

        .side h2 {
            color: white;
            font-size: 30px;
            margin-bottom: 38px;
        }

            .side h2 i {
                color: #38bdf8;
            }

        .side p {
            font-size: 22px;
            margin-bottom: 38px;
        }

    .side-item {
        margin-bottom: 22px;
        font-size: 17px;
        line-height: 1.4;
    }

        .side-item i {
            width: 34px;
            color: #c4b5fd;
        }


    #btnVolver {
        margin-top: 35px;
        color: white;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,.55);
        padding: 15px;
        border-radius: 14px;
        text-align: center;
        font-size: 17px;
    }

    .card {
        width: 810px;
        min-height: 760px;
        background: white;
        padding: 45px 55px;
        box-sizing: border-box;
    }

    .header {
        text-align: center;
    }

        .header i {
            font-size: 48px;
            color: #6d28d9;
        }

        .header h1 {
            margin: 8px 0 4px;
            color: #3c096c;
            font-size: 38px;
        }

        .header p {
            color: #555;
        }

    .steps {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 35px;
    }

    .step {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #e5e7eb;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
    }

        .step.active {
            background: #6d28d9;
            color: white;
        }

    .line {
        width: 150px;
        height: 3px;
        background: #ddd;
    }

    .step-text {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        text-align: center;
        margin: 12px 0 35px;
        font-size: 14px;
        color: #555;
    }

    h2 {
        color: #3c096c;
        margin-bottom: 20px;
        font-size: 28px;
    }

    label {
        display: block;
        margin-top: 16px;
        margin-bottom: 7px;
        font-weight: bold;
    }

    input, select {
        width: 100%;
        padding: 16px;
        border: 1px solid #ddd;
        border-radius: 12px;
        font-size: 16px;
        box-sizing: border-box;
    }

    .monto-box {
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 18px;
    }

        .monto-box h3 {
            margin: 0;
            color: #6d28d9;
            font-size: 34px;
        }

    input[type="range"] {
        width: 100%;
        padding: 0;
        border: none;
        accent-color: #6d28d9;
    }

    .rango-texto {
        display: flex;
        justify-content: space-between;
        font-size: 15px;
        color: #555;
        margin-top: 10px;
    }

    .rango-info {
        color: #6d28d9;
        font-size: 15px;
        margin-top: 14px;
    }

    .help {
        background: #f3e8ff;
        color: #3c096c;
        padding: 18px;
        border-radius: 14px;
        margin-top: 22px;
        border: 1px solid #ddd6fe;
    }

        .help i {
            color: #facc15;
            margin-right: 8px;
        }

    .info-box {
        background: #eff6ff;
        color: #172554;
        padding: 18px;
        border-radius: 14px;
        margin-top: 22px;
        line-height: 1.7;
    }

    button {
        border: none;
        padding: 15px 28px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-main {
        background: #6d28d9;
        color: white;
        margin-top: 25px;
    }

    .btn-back {
        background: white;
        color: #333;
        border: 1px solid #ddd;
        margin-top: 25px;
    }

    .btn-right {
        float: right;
    }

    .oculto {
        display: none;
    }

    .wallet-3d {
        width: 170px;
        height: 170px;
        margin: auto auto 35px;
        position: relative;
