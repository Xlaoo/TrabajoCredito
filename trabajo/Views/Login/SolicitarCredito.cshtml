@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Solicitud de Préstamo - CrediPlus</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha384-t1nt8BQoYMLFN5p42tRAtuAAFQaCQODekUVeKKZrEnEyp4H2R0RHFz0KWpmj7i8g" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/solicitar-credito.css" />
</head>
<body>
<div class="page" id="solicitarCreditoContainer"
     data-mostrar-confirmacion="@TempData["MostrarConfirmacion"]"
     data-pendiente="@ViewBag.MostrarConfirmacion">
    <div class="contenedor @(ViewBag.MostrarModalBloqueo == true ? "contenedor-bloqueado" : "")">

        <div class="side">
            <div>
                <h2><i class="fas fa-wallet"></i> CrediPlus</h2>

                <p>Tu crédito,<br>tu mejor opción.</p>

                <div class="side-item"><i class="fas fa-bolt"></i> Aprobación rápida</div>
                <br />
                <div class="side-item"><i class="fas fa-file-alt"></i> Sin papeles</div>
                <br />
                <div class="side-item"><i class="fas fa-calendar"></i> Plazos flexibles<br>   12 a 72 meses</div>
                <br />
                <div class="side-item"><i class="fas fa-shield-alt"></i> 100% seguro</div>
                <br />
                <div class="side-item"><i class="fas fa-money-bill"></i> S/ 1,000 hasta S/ 50,000</div>
            </div>

            <div class="wallet-3d">
                <div class="bills">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <div class="wallet-body">
                    <div class="wallet-line"></div>
                    <div class="wallet-button"></div>
                </div>

                <div class="coin coin1"></div>
                <div class="coin coin2"></div>
                <div class="coin coin3"></div>
            </div>

            <a id="btnVolver" href="@Url.Action("DashboardCliente", "Login")">← Volver</a>
        </div>

        <div class="card">
            <div class="header">
                <i class="fas fa-wallet"></i>
                <h1>CrediPlus</h1>
                <p>Solicitud de préstamo personal</p>
            </div>

            <div class="steps">
                <div class="step active" id="step1">1</div>
                <div class="line"></div>
                <div class="step" id="step2">2</div>
                <div class="line"></div>
                <div class="step" id="step3">3</div>
                <div class="line"></div>
                <div class="step" id="step4">4</div>
            </div>

            <div class="step-text">
                <span>Datos del préstamo</span>
                <span>Información financiera</span>
                <span>Método de pago</span>
                <span>Confirmación</span>
            </div>

            <form id="formSolicitarCredito" method="post" action="@Url.Action("RegistrarSolicitudCredito", "Login")">
                @Html.AntiForgeryToken()

                <div id="pantalla1">
                    <h2>Datos del préstamo</h2>

                    <label for="rangoMonto">Monto solicitado <i class="fas fa-info-circle"></i></label>

                    <div class="monto-box">
                        <h3 id="textoMonto">S/ 15,000</h3>
                    </div>

                    <input type="range"
                           id="rangoMonto"
                           min="1000"
                           max="50000"
                           step="500"
                           value="15000" />

                    <input type="hidden"
                           name="montoSolicitado"
                           id="montoSolicitadoReal"
                           value="15000">

                    <div class="rango-texto">
                        <span>S/ 1,000</span>
                        <span>S/ 50,000</span>
                    </div>

                    <p class="rango-info">Rango permitido: S/ 1,000 hasta S/ 50,000</p>

                    <label for="plazoMeses">Plazo en meses <i class="fas fa-info-circle"></i></label>

                    <select id="plazoMeses" name="plazoMeses" required>
                        <option value="">Seleccione el plazo</option>
                        <option value="12">12 meses</option>
                        <option value="18">18 meses</option>
                        <option value="24">24 meses</option>
                        <option value="30">30 meses</option>
                        <option value="36">36 meses</option>
                        <option value="48">48 meses</option>
                        <option value="60">60 meses</option>
                        <option value="72">72 meses</option>
                    </select>

                    <div class="help">
                        <i class="fas fa-lightbulb"></i>
                        Puedes solicitar desde S/ 1,000 hasta S/ 50,000 según tu capacidad de pago.
                    </div>

                    <button type="button" id="btnContinuarPaso1" class="btn-main">
                        Continuar →
                    </button>
                </div>

                <div id="pantalla2" class="oculto">
                    <h2>Información financiera</h2>

                    <label for="ingresoMensual">Ingreso mensual <i class="fas fa-info-circle"></i></label>
                    <div class="input-money">
                        <span>S/</span>
                        <input type="text" name="ingresoMensual" id="ingresoMensual" required>
                        <i class="fas fa-arrow-up icon-green"></i>
                    </div>

                    <label for="egresoMensual">Egreso mensual <i class="fas fa-info-circle"></i></label>
                    <div class="input-money">
                        <span>S/</span>
                        <input type="text" name="egresoMensual" id="egresoMensual" required>
                        <i class="fas fa-arrow-down icon-red"></i>
                    </div>

                    <label>¿Tienes créditos activos? <i class="fas fa-info-circle"></i></label>
                    <input type="hidden" name="tieneOtrosCreditos" id="tieneOtrosCreditos" required>

                    <div class="opciones-creditos">
                        <div class="opcion-card" data-credito-valor="Si">
                            <span>Sí</span>
                        </div>

                        <div class="opcion-card" data-credito-valor="No">
                            <span>No</span>
                        </div>
                    </div>

                    <label>Motivo del préstamo <i class="fas fa-info-circle"></i></label>
                    <input type="hidden" name="motivoPrestamo" id="motivoPrestamo" required>

                    <div class="motivos">
                        <div class="motivo-card" data-motivo="Estudios">
                            <i class="fas fa-graduation-cap"></i> Estudios
                        </div>

                        <div class="motivo-card" data-motivo="Negocio">
                            <i class="fas fa-briefcase"></i> Negocio
                        </div>

                        <div class="motivo-card" data-motivo="Salud">
                            <i class="fas fa-heartbeat"></i> Salud
                        </div>

                        <div class="motivo-card" data-motivo="Vivienda">
                            <i class="fas fa-home"></i> Vivienda
                        </div>

                        <div class="motivo-card" data-motivo="Emergencia">
                            <i class="fas fa-exclamation-circle"></i> Emergencia
                        </div>

                        <div class="motivo-card" data-motivo="Compra personal">
                            <i class="fas fa-shopping-bag"></i> Compra personal
                        </div>
                    </div>

                    <div class="otros-box">
                        <button type="button" class="motivo-otros">
                            <i class="fas fa-pen"></i> Otros
                        </button>

                        <input type="text"
                               name="motivoOtro"
                               id="motivoOtro"
                               placeholder="Escribe tu motivo"
                               maxlength="60"
                               disabled>
                    </div>

                    <label for="ocupacion">Ocupación <i class="fas fa-info-circle"></i></label>
                    <div class="input-money">
                        <span><i class="fas fa-user"></i></span>
                        <input type="text"
                               name="ocupacion"
                               id="ocupacion"
                               required>
                    </div>

                    <div class="info-box">
                        <b>¿Qué significa cada campo?</b><br>
                        <p><i class="fas fa-arrow-up icon-green"></i> <b>Ingreso mensual:</b> dinero que recibes cada mes.</p>
                        <p><i class="fas fa-arrow-down icon-red"></i> <b>Egreso mensual:</b> dinero que gastas cada mes.</p>
                        <p><i class="fas fa-credit-card"></i> <b>Créditos activos:</b> indica si tienes préstamos o deudas activas.</p>
                        <p><i class="fas fa-pen"></i> <b>Motivo:</b> razón principal por la que solicitas el préstamo.</p>
                        <p><i class="fas fa-user"></i> <b>Ocupación:</b> actividad que realizas actualmente.</p>
                    </div>

                    <button type="button" id="btnAtrasPaso1" class="btn-back">← Atrás</button>
                    <button type="button" id="btnContinuarPaso2" class="btn-main btn-right">Solicitar evaluación →</button>
                </div>
                <div id="pantalla3" class="oculto">
                    <h2>Método de pago</h2>

                    <label>¿Dónde deseas recibir el préstamo?</label>

                    <input type="hidden" name="metodoPago" id="metodoPago" required>

                    <div class="motivos">
                        <div class="motivo-card" data-metodo-pago="Transferencia bancaria">
                            <i class="fas fa-building-columns"></i> Transferencia bancaria
                        </div>

                        <div class="motivo-card" data-metodo-pago="Yape">
                            <i class="fas fa-mobile-screen"></i> Yape
                        </div>

                        <div class="motivo-card" data-metodo-pago="Plin">
                            <i class="fas fa-mobile"></i> Plin
                        </div>
                    </div>

                    <label for="entidadPago">Entidad</label>
                    <select name="entidadPago" id="entidadPago" required>
                        <option value="">Seleccione entidad</option>
                    </select>

                    <label for="numeroCuentaPago">Número de cuenta o celular</label>
                    <input type="text"
                           name="numeroCuentaPago"
                           id="numeroCuentaPago"
                           placeholder="Ingrese número"
                           required>

                    <label for="titularCuenta">Titular</label>
                    <input type="text" name="titularCuenta" id="titularCuenta" placeholder="Nombre del titular">

                    <div class="help">
                        <i class="fas fa-shield-alt"></i>
                        Verifica que los datos sean correctos. El desembolso se realizará al método registrado.
                    </div>

                    <button type="button" id="btnAtrasPaso2" class="btn-back">← Atrás</button>
                    <button type="button" id="btnFinalizarSolicitud" class="btn-main btn-right">Finalizar solicitud →</button>
                </div>
                <div id="pantalla4" class="oculto">
                    <div class="confirm-box">
                        <div class="hourglass">⌛</div>

                        <h2>¡Solicitud recibida!</h2>
                        <p>Tu solicitud está en evaluación</p>

                        <div class="warning-box">
                            ⚠ Estamos revisando tu información.<br>
                            Te notificaremos cuando tengamos una respuesta entre 24 horas.
                        </div>

                        <div class="next-box">
                            <b>¿Qué pasa ahora?</b>
                            <p>✔ Nuestro equipo de análisis revisará tu solicitud.</p>
                            <p>✔ Te enviaremos una notificación con la respuesta.</p>
                            <p>✔ Este proceso puede tardar entre 24 horas.</p>
                        </div>

                        <div class="confirmacion-botones">

                            <a href="@Url.Action("DashboardCliente", "Login")" class="btn-salir">
                                <i class="fas fa-sign-out-alt"></i>
                                Salir
                            </a>

                            <a href="@Url.Action("MisSolicitudes", "Login")" class="btn-mis-solicitudes">
                                <i class="fas fa-file-alt"></i>
                                Ver mis solicitudes
                            </a>

                        </div>
                    </div>
                </div>

            </form>
        </div>

    </div>
</div>
@if (ViewBag.MostrarModalBloqueo == true)
{
    <div class="modal-bloqueo">
        <div class="modal-bloqueo-card">
            <div class="modal-bloqueo-icono">
                <i class="fas fa-circle-exclamation"></i>
            </div>

            <h2>@ViewBag.TituloBloqueo</h2>
            <p>@ViewBag.MensajeBloqueo</p>

            <div class="modal-bloqueo-botones">
                <a href="@Url.Action("DashboardCliente", "Login")" class="btn-modal-secundario">
                    Volver al inicio
                </a>

                <a href="@Url.Action("MisSolicitudes", "Login")" class="btn-modal-principal">
                    Ver mis solicitudes
                </a>
            </div>
        </div>
    </div>
}

<script src="~/js/solicitar-credito.js"></script>
</body>
</html>