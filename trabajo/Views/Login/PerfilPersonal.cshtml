@model trabajo.Models.Usuario

@{
    Layout = null;
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "PerfilPersonal";
    ViewData["ActivePage"] = "Perfil";
}
<style>

    h1 {
        font-size: 48px;
        font-weight: 900;
        color: #1f1235;
    }

    .subtitle {
        font-size: 20px;
        color: #51446b;
        margin-bottom: 35px;
    }

    .profile-card {
        background: white;
        border-radius: 28px;
        padding: 38px;
        max-width: 1000px;
        box-shadow: 0 18px 40px rgba(124,58,237,.12);
    }

    .profile-title {
        font-size: 32px;
        font-weight: 900;
        color: #3c096c;
        margin-bottom: 25px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid #eee;
        padding: 18px 0;
        font-size: 18px;
    }

        .info-row span {
            color: #51446b;
        }

        .info-row strong {
            color: #1f1235;
        }

    .edit-field {
        display: none;
        width: 100%;
        padding: 13px;
        border: 2px solid #7c3aed;
        border-radius: 12px;
        font-size: 17px;
        margin-top: 8px;
    }

    .btn-main {
        border: none;
        padding: 15px 25px;
        border-radius: 14px;
        color: white;
        font-weight: bold;
        font-size: 17px;
        margin-top: 25px;
        margin-right: 12px;
    }

    .btn-edit {
        background: #7c3aed;
    }

    .btn-save {
        background: #16a34a;
        display: none;
    }

    .btn-back {
        background: #6b7280;
        text-decoration: none;
    }

    .password-rules {
        display: none;
        background: #f3e8ff;
        border-radius: 16px;
        padding: 16px;
        margin-top: 12px;
        color: #4c1d95;
        font-size: 16px;
    }

        .password-rules p {
            margin: 6px 0;
        }

    .ok {
        color: #16a34a;
        font-weight: bold;
    }

    .bad {
        color: #ef4444;
        font-weight: bold;
    }

    .codigo-box {
        display: none;
        margin-top: 15px;
        background: #fff7ed;
        padding: 18px;
        border-radius: 16px;
        border: 2px solid #fed7aa;
    }

        .codigo-box button {
            background: #f59e0b;
            border: none;
            padding: 12px 18px;
            border-radius: 12px;
            color: white;
            font-weight: bold;
            margin-top: 10px;
        }

    .alert-msg {
        background: #fee2e2;
        color: #991b1b;
        padding: 15px;
        border-radius: 14px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .faq-shortcut {
        width: 100%;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        border-radius: 24px;
        padding: 28px;
        display: flex;
        align-items: center;
        gap: 18px;
        text-decoration: none;
        transition: .3s;
        box-shadow: 0 10px 25px rgba(109,40,217,.25);
    }

        .faq-shortcut:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 35px rgba(109,40,217,.35);
        }

    .faq-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        color: white;
        font-weight: 900;
    }

    .faq-shortcut h4 {
        color: white;
        margin: 0;
        font-size: 25px;
        font-weight: 800;
    }

    .faq-shortcut p {
        margin-top: 6px;
        color: #e9d5ff;
        font-size: 15px;
    }

    .sidebar {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .faq-shortcut {
        margin-top: auto;
        margin-bottom: 25px;
    }
</style>

<div class="content">
    <h1>Perfil Personal</h1>
    <p class="subtitle">Consulta y actualiza tus datos personales registrados en CrediPlus.</p>

    @if (ViewData["Mensaje"] != null)
    {
        <div class="alert-msg">@ViewData["Mensaje"]</div>
    }
    @if (TempData["MensajeOk"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeOk"]
        </div>
    }

    <form method="post" asp-action="PerfilPersonal" asp-controller="Login" class="profile-card">

        <div class="profile-title">
            <i class="fas fa-user-circle"></i> Información de tu perfil
        </div>

        <div class="info-row">
            <span>Nombre</span>
            <strong class="texto">@Model.Nombre</strong>
            <input class="edit-field" asp-for="Nombre" required />
        </div>

        <div class="info-row">
            <span>Apellido</span>
            <strong class="texto">@Model.Apellido</strong>
            <input class="edit-field" asp-for="Apellido" required />
        </div>
        <div class="info-row">
            <span>Género</span>

            <strong class="texto">@Model.Genero</strong>

            <select class="edit-field" asp-for="Genero">
                <option value="Masculino">Masculino</option>
                <option value="Femenino">Femenino</option>
            </select>
        </div>

        <div class="info-row">
            <span>DNI</span>
            <strong class="texto">@Model.Dni</strong>
            <input class="edit-field" asp-for="Dni" maxlength="8" required
                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
        </div>

        <div class="info-row">
            <span>Celular</span>
            <strong class="texto">@Model.Celular</strong>
            <input class="edit-field" asp-for="Celular" maxlength="9" required
                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
        </div>

        <div class="info-row">
            <span>Correo Gmail</span>
            <strong class="texto">@Model.Correo</strong>
            <input id="correoInput" class="edit-field" asp-for="Correo" required oninput="mostrarCodigoCorreo()" />
        </div>

        <div id="codigoBox" class="codigo-box">
            <b>Verificación de nuevo correo</b>
            <p>Si cambias el correo, solicita un código de verificación.</p>

            <button type="button" onclick="enviarCodigo()">Obtener código de verificación</button>

            <input id="codigoCorreo" name="codigoCorreo" class="form-control mt-3"
                   placeholder="Ingrese código de verificación" />
        </div>

        <div class="info-row">
            <span>Contraseña actual</span>
            <strong class="texto">********</strong>
        </div>

        <div id="nuevaClaveRow" class="info-row" style="display:none;">
            <span>Nueva contraseña</span>
            <input id="claveInput" class="edit-field" asp-for="clave" type="password"
                   placeholder="Dejar vacío si no deseas cambiarla"
                   oninput="validarClave(); marcarCambio();" />
        </div>

        <div id="reglasClave" class="password-rules">
            <p id="mayus" class="bad">✖ Una letra mayúscula</p>
            <p id="minus" class="bad">✖ Una letra minúscula</p>
            <p id="num" class="bad">✖ Un número</p>
            <p id="minimo" class="bad">✖ Mínimo 6 caracteres</p>
        </div>

        <button id="btnEditar" type="button" class="btn-main btn-edit" onclick="activarEdicion()">
            <i class="fas fa-edit"></i> Editar perfil
        </button>

        <button id="btnGuardar" type="submit" class="btn-main btn-save">
            <i class="fas fa-save"></i> Guardar cambios
        </button>

        <button id="btnCancelar" type="button" class="btn-main btn-back" style="display:none;" onclick="cancelarEdicion()">
            Cancelar
        </button>

        <a id="btnRegresar" href="@Url.Action("SolicitarCredito", "Login")" class="btn-main btn-back">
            Regresar
        </a>
    </form>
</div>

<script>
        let correoOriginal = "@Model.Correo";
    let editando = false;
    let cambioRealizado = false;

    function activarEdicion() {
        editando = true;

        document.querySelectorAll(".texto").forEach(x => x.style.display = "none");
        document.querySelectorAll(".edit-field").forEach(x => x.style.display = "block");

        document.getElementById("nuevaClaveRow").style.display = "flex";
        document.getElementById("reglasClave").style.display = "block";

        document.getElementById("btnEditar").style.display = "none";
        document.getElementById("btnGuardar").style.display = "inline-block";
        document.getElementById("btnCancelar").style.display = "inline-block";
        document.getElementById("btnRegresar").style.display = "none";
    }

    function marcarCambio() {
        cambioRealizado = true;
    }

    document.querySelectorAll(".edit-field").forEach(input => {
        input.addEventListener("input", marcarCambio);
    });

            function cancelarEdicion() {

        if (cambioRealizado) {
            let salir = confirm("¿Estás seguro que quieres salir sin guardar los datos?");

            if (salir) {
                window.location.href = '@Url.Action("PerfilPersonal", "Login")';
            } else {
                alert("Sigues editando tus datos.");
                return;
            }
        } else {
            window.location.href = '@Url.Action("PerfilPersonal", "Login")';
        }
    }

    document.querySelectorAll(".menu-link").forEach(link => {
        link.addEventListener("click", function (e) {
            if (editando && cambioRealizado) {
                let guardar = confirm("Tienes cambios sin guardar. ¿Deseas guardarlos?");

                if (guardar) {
                    e.preventDefault();
                    document.querySelector("form").submit();
                } else {
                    e.preventDefault();
                    alert("Sigues editando tus datos.");
                }
            }
        });
    });

    function mostrarCodigoCorreo() {
        let correoNuevo = document.getElementById("correoInput").value;

        if (correoNuevo !== correoOriginal) {
            document.getElementById("codigoBox").style.display = "block";
        } else {
            document.getElementById("codigoBox").style.display = "none";
        }
    }

    function enviarCodigo() {
        let correo = document.getElementById("correoInput").value;

        fetch('@Url.Action("EnviarCodigoPerfil", "Login")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: 'correo=' + encodeURIComponent(correo)
        })
        .then(response => response.json())
        .then(data => {
            alert(data.mensaje);
        })
        .catch(error => {
            alert("No se pudo enviar el código.");
        });
    }

    function validarClave() {
        let clave = document.getElementById("claveInput").value;

        cambiarRegla("mayus", /[A-Z]/.test(clave), "Una letra mayúscula");
        cambiarRegla("minus", /[a-z]/.test(clave), "Una letra minúscula");
        cambiarRegla("num", /[0-9]/.test(clave), "Un número");
        cambiarRegla("minimo", clave.length >= 6, "Mínimo 6 caracteres");
    }

    function cambiarRegla(id, cumple, texto) {
        let item = document.getElementById(id);

        if (cumple) {
            item.className = "ok";
            item.innerText = "✔ " + texto;
        } else {
            item.className = "bad";
            item.innerText = "✖ " + texto;
        }
    }
    @if (ViewData["ModoEditar"] != null)
    {
                <text>
                            activarEdicion();
                </text>
    }

    @if (ViewData["CorreoIntentado"] != null)
    {
                <text>
                            document.getElementById("correoInput").value =
                            "@ViewData["CorreoIntentado"]";
                            mostrarCodigoCorreo();
                </text>
    }

    @if (ViewBag.LimpiarCorreo != null)
    {
                <text>
                            setTimeout(function () {
                            activarEdicion();
                            document.getElementById("correoInput").value = "";
                            document.getElementById("codigoCorreo").value = "";
                            document.getElementById("codigoBox").style.display = "none";
                            }, 100);
                </text>
    }
</script>
<script src="~/js/config-global.js"></script>