@model trabajo.Models.Usuario

@{
    Layout = null;
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "PerfilPersonal";
    ViewData["ActivePage"] = "Perfil";
}

@section Styles {
    <link rel="stylesheet" href="~/css/perfil-personal.css" />
}

<div class="content">
    <h1>Perfil Personal</h1>
    <p class="subtitle">Consulta y actualiza tus datos personales registrados en CrediPlus.</p>

    @if (ViewData["Mensaje"] != null)
    {
        <div class="alert-msg">@ViewData["Mensaje"]</div>
    }
    @if (TempData["MensajeOk"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeOk"]
        </div>
    }

    <form id="perfilForm" method="post" asp-action="PerfilPersonal" asp-controller="Login" class="profile-card"
          data-correo-original="@Model.Correo"
          data-url-perfil="@Url.Action("PerfilPersonal", "Login")"
          data-url-enviar-codigo="@Url.Action("EnviarCodigoPerfil", "Login")"
          data-modo-editar="@(ViewData["ModoEditar"] != null ? "true" : "false")"
          data-correo-intentado="@(ViewData["CorreoIntentado"]?.ToString() ?? "")"
          data-limpiar-correo="@(ViewBag.LimpiarCorreo != null ? "true" : "false")">

        <div class="profile-title">
            <i class="fas fa-user-circle"></i> Información de tu perfil
        </div>

        <div class="info-row">
            <span>Nombre</span>
            <strong class="texto">@Model.Nombre</strong>
            <input class="edit-field" asp-for="Nombre" required />
        </div>

        <div class="info-row">
            <span>Apellido</span>
            <strong class="texto">@Model.Apellido</strong>
            <input class="edit-field" asp-for="Apellido" required />
        </div>
        <div class="info-row">
            <span>Género</span>

            <strong class="texto">@Model.Genero</strong>

            <select class="edit-field" asp-for="Genero">
                <option value="Masculino">Masculino</option>
                <option value="Femenino">Femenino</option>
            </select>
        </div>

        <div class="info-row">
            <span>DNI</span>
            <strong class="texto">@Model.Dni</strong>
            <input class="edit-field" asp-for="Dni" maxlength="8" required />
        </div>

        <div class="info-row">
            <span>Celular</span>
            <strong class="texto">@Model.Celular</strong>
            <input class="edit-field" asp-for="Celular" maxlength="9" required />
        </div>

        <div class="info-row">
            <span>Correo Gmail</span>
            <strong class="texto">@Model.Correo</strong>
            <input id="correoInput" class="edit-field" asp-for="Correo" required />
        </div>

        <div id="codigoBox" class="codigo-box">
            <b>Verificación de nuevo correo</b>
            <p>Si cambias el correo, solicita un código de verificación.</p>

            <button id="btnObtenerCodigo" type="button">Obtener código de verificación</button>

            <input id="codigoCorreo" name="codigoCorreo" class="form-control mt-3"
                   placeholder="Ingrese código de verificación" />
        </div>

        <div class="info-row">
            <span>Contraseña actual</span>
            <strong class="texto">********</strong>
        </div>

        <div id="nuevaClaveRow" class="info-row">
            <span>Nueva contraseña</span>
            <input id="claveInput" class="edit-field" asp-for="clave" type="password"
                   placeholder="Dejar vacío si no deseas cambiarla" />
        </div>

        <div id="reglasClave" class="password-rules">
            <p id="mayus" class="bad">✖ Una letra mayúscula</p>
            <p id="minus" class="bad">✖ Una letra minúscula</p>
            <p id="num" class="bad">✖ Un número</p>
            <p id="simbolo" class="bad">✖ Un símbolo especial (!@@#$%&*...)</p>
            <p id="minimo" class="bad">✖ Mínimo 12 caracteres</p>
        </div>

        <button id="btnEditar" type="button" class="btn-main btn-edit">
            <i class="fas fa-edit"></i> Editar perfil
        </button>

        <button id="btnGuardar" type="submit" class="btn-main btn-save">
            <i class="fas fa-save"></i> Guardar cambios
        </button>

        <button id="btnCancelar" type="button" class="btn-main btn-back">
            Cancelar
        </button>

    </form>
</div>

@section Scripts {
    <script src="~/js/perfil-personal.js"></script>
    <script src="~/js/config-global.js"></script>
}