@using trabajo.Service
@model List<trabajo.Models.SolicitudCreditoViewModel>

@{
	Layout = "~/Views/Shared/_LayoutCliente.cshtml";
	ViewData["Title"] = "Mis Solicitudes";
	ViewData["ActivePage"] = "MisSolicitudes";
}

@section Styles {
	<link rel="stylesheet" href="~/css/sweetalert2.min.css" />
	<link rel="stylesheet" href="~/css/mis-solicitudes.css" />
}

<div class="content">
	@if (TempData["Mensaje"] != null)
	{
		<div class="alert alert-success alert-msg">
			@TempData["Mensaje"]
		</div>
	}

	<div class="title">
		<h1>Mis solicitudes de préstamo</h1>
		<p>Consulta, edita, cancela o descarga el cronograma de tus solicitudes registradas.</p>
	</div>

	@if (Model == null || Model.Count == 0)
	{
		<div class="request-card">
			<h2 style="color:#3c096c; font-weight:800;">No tienes solicitudes registradas</h2>
			<p>Aún no has solicitado ningún préstamo.</p>
			<a href="@Url.Action("DashboardCliente", "Login")" class="btn btn-secondary">Regresar al inicio</a>
		</div>
	}
	else
	{
		foreach (var solicitud in Model)
		{
			var estadoNormalizado = solicitud.Estado?.Trim().ToLower();
			var evaluacion = ViewBag.Evaluaciones != null
			? ((List<trabajo.Models.Evaluacion_Riesgo>)ViewBag.Evaluaciones)
			.FirstOrDefault(e => e.SOLICITUD_CREDITO_Id_Solicitud == solicitud.IdSolicitud)
			: null;

			<div class="request-card">
				<div class="request-header">
					<h2>Solicitud N.º @solicitud.NumeroSolicitud</h2>
					<span id="estadoSolicitud_@solicitud.IdSolicitud"
						  class="status
						@(solicitud.Estado == "Aprobado" ? "approved" : "")
						@(solicitud.Estado == "Rechazado" ? "status-rechazado" : "")
						@(estadoNormalizado == "en evaluación" ? "status-evaluacion" : "")">
						@solicitud.Estado
					</span>
				</div>

				<div class="request-grid">
					<div class="data-box">
						<span>Monto solicitado</span>

						<h3 id="montoTexto_@solicitud.IdSolicitud">
							S/ @solicitud.MontoSolicitado.ToString("N0")
						</h3>

						<input id="montoInput_@solicitud.IdSolicitud"
							   class="edit-input input-edicion oculto"
							   type="number"
							   value="@solicitud.MontoSolicitado" />
					</div>

					<div class="data-box">
						<span>Plazo seleccionado</span>

						<h3 id="plazoTexto_@solicitud.IdSolicitud">
							@solicitud.PlazoMeses meses
						</h3>

						<select id="plazoInput_@solicitud.IdSolicitud"
								class="edit-input input-edicion oculto">
							<option value="12" selected="@(solicitud.PlazoMeses == 12)">12 meses</option>
							<option value="18" selected="@(solicitud.PlazoMeses == 18)">18 meses</option>
							<option value="24" selected="@(solicitud.PlazoMeses == 24)">24 meses</option>
							<option value="30" selected="@(solicitud.PlazoMeses == 30)">30 meses</option>
							<option value="36" selected="@(solicitud.PlazoMeses == 36)">36 meses</option>
							<option value="48" selected="@(solicitud.PlazoMeses == 48)">48 meses</option>
							<option value="60" selected="@(solicitud.PlazoMeses == 60)">60 meses</option>
							<option value="72" selected="@(solicitud.PlazoMeses == 72)">72 meses</option>
						</select>
					</div>

					<div class="data-box">
						<span>Interés estimado</span>
						<h3>@solicitud.InteresEstimado.ToString("N0")%</h3>
					</div>

					<div class="data-box">
						<span>Fecha de solicitud</span>
						<h3>@PeruTimeHelper.ConvertirFechaBaseDatosAPeru(solicitud.FechaSolicitud, true).ToString("dd/MM/yyyy")</h3>
					</div>
				</div>

				<div class="actions">
					@if (solicitud.Estado == "Rechazado")
					{
						<button type="button" class="btn-delete btn-borrar-solicitud" data-id-solicitud="@solicitud.IdSolicitud">
							🗑 Borrar solicitud
						</button>

						<button id="btnObservacion_@solicitud.IdSolicitud"
								type="button"
								class="btn-observacion btn-ver-observacion"
								data-observacion="@(evaluacion != null ? evaluacion.Observacion : "Sin observaciones")">
							<i class="fas fa-eye"></i> Observaciones
						</button>
					}
					else
					{
						bool bloquearAcciones =
						estadoNormalizado == "pendiente" ||
						estadoNormalizado == "pendiente cancelación" ||
						estadoNormalizado == "pendiente edición";

						bool bloquearCronograma =
						estadoNormalizado == "pendiente" ||
						estadoNormalizado == "pendiente cancelación" ||
						estadoNormalizado == "pendiente edición" ||
						estadoNormalizado == "en evaluación";

						<button id="btnEditar_@solicitud.IdSolicitud"
								type="button"
								class="btn-edit btn-editar-solicitud @(bloquearAcciones ? "bloqueado" : "")"
							@(bloquearAcciones ? "disabled" : "")
								data-id-solicitud="@solicitud.IdSolicitud" data-estado="@solicitud.Estado">
							<i class="fas fa-edit"></i> Editar solicitud
						</button>

						<button id="btnCancelar_@solicitud.IdSolicitud"
								type="button"
								class="btn-cancel btn-cancelar-solicitud @(bloquearAcciones ? "bloqueado" : "")"
							@(bloquearAcciones ? "disabled" : "")
								data-id-solicitud="@solicitud.IdSolicitud" data-estado="@solicitud.Estado" data-monto="@solicitud.MontoSolicitado">
							<i class="fas fa-times"></i> Cancelar solicitud
						</button>

						<form method="post" action="@Url.Action("EnviarCronograma", "Login")">
							@Html.AntiForgeryToken()
							<input type="hidden"
								   name="idSolicitud"
								   value="@solicitud.IdSolicitud" />

							<button id="btnCronograma_@solicitud.IdSolicitud"
									type="submit"
									class="btn-download @(bloquearCronograma ? "bloqueado" : "")"
								@(bloquearCronograma ? "disabled" : "")>
								<i class="fas fa-envelope"></i>
								Enviar cronograma
							</button>
						</form>

						<button id="btnGuardar_@solicitud.IdSolicitud"
								type="button"
								class="btn-save btn-guardar-edicion oculto"
								data-id-solicitud="@solicitud.IdSolicitud">
							<i class="fas fa-save"></i> Guardar cambios
						</button>

						<button id="btnCancelarCambios_@solicitud.IdSolicitud"
								type="button"
								class="btn-cancel btn-cancelar-cambios oculto"
								data-id-solicitud="@solicitud.IdSolicitud">
							<i class="fas fa-undo"></i> Cancelar cambios
						</button>

						<button id="btnObservacion_@solicitud.IdSolicitud"
								type="button"
								class="btn-observacion btn-ver-observacion"
								data-observacion="@(evaluacion != null ? evaluacion.Observacion : "Sin observaciones")">
							<i class="fas fa-eye"></i> Observaciones
						</button>

						<button id="btnMensaje_@solicitud.IdSolicitud"
								type="button"
								class="btn-observacion btn-abrir-chat"
								data-id-solicitud="@solicitud.IdSolicitud">
							<i class="fas fa-comments"></i> Mensaje
						</button>
					}
				</div>
			</div>
		}

		<div id="modalObservacion" class="modal-observacion oculto">
			<div class="modal-observacion-box">
				<div class="modal-header">
					<h2>Observaciones del analista</h2>
					<button type="button" class="btn-close-modal btn-cerrar-observacion">✕</button>
				</div>

				<div class="modal-body">
					<div class="observacion-icon">👁</div>
					<textarea id="textoObservacion" readonly></textarea>
				</div>

				<div class="modal-footer">
					<button type="button" class="btn-cerrar-modal btn-cerrar-observacion">Cerrar</button>
				</div>
			</div>
		</div>
	}
</div>

<div id="modalChat" class="oculto">
	<div class="chat-contenido">
		<div class="chat-header">
			<div>
				<div class="chat-titulo">
					<i class="fas fa-comments"></i>
					<span id="tituloSolicitud">
						Mensajes
					</span>
				</div>

				<div class="chat-subtitulo">
					Analista:
					<span id="chatAnalista">-</span>
					<br />
					Correo:
					<span id="chatCorreo">-</span>
				</div>
			</div>

			<button type="button" class="btn-cerrar-chat" id="btnCerrarChat" aria-label="Cerrar chat">
				<i class="fas fa-times"></i>
			</button>
		</div>

		<div id="chatMensajes">
			<div class="chat-vacio">
				<i class="fas fa-comments"></i>
				<h4>No hay mensajes</h4>
				<p>
					Inicia una conversación con el analista.
				</p>
			</div>
		</div>

		<div class="chat-footer">
			<div id="nombreArchivoSeleccionado"></div>
			<input type="text"
				   id="txtMensaje"
				   placeholder="Escribe tu mensaje..." />

			<input type="file"
				   id="fileImagen"
				   accept="image/*"
				   class="oculto">

			<button type="button" class="btn-chat-icon" id="btnAdjuntarImagen" title="Adjuntar imagen">
				<i class="far fa-image"></i>
			</button>

			<button type="button" class="btn-enviar-chat" id="btnEnviarMensaje">
				<i class="fas fa-paper-plane"></i>
				Enviar
			</button>
		</div>
	</div>
</div>

<div id="modalPago" class="modal-pago oculto">
	<div class="modal-content-pago">
		<h2>Cancelar solicitud</h2>
		<p>
			Para cancelar esta solicitud aprobada, debes devolver el monto total prestado.
		</p>

		<label>Monto a devolver</label>
		<input id="montoDevolver" type="text" value="S/ 10,000" readonly />

		<label>Método de pago</label>
		<select id="metodoPago">
			<option value="">Seleccione método de pago</option>
			<option>Yape</option>
			<option>Plin</option>
			<option>BCP</option>
			<option>Interbank</option>
			<option>BBVA</option>
			<option>Scotiabank</option>
			<option>Caja Arequipa</option>
			<option>Transferencia bancaria</option>
		</select>
		<div id="datosPago" class="oculto datos-pago-box"></div>

		<label for="motivoCancelacion">Motivo de cancelación</label>
		<textarea id="motivoCancelacion"
				  class="textarea-cancelacion"
				  maxlength="255"
				  placeholder="Explique el motivo de la cancelación"
				  required></textarea>

		<div class="modal-actions">
			<button type="button" class="btn-cancelar-modal" id="btnCerrarModalPago">Volver</button>
			<button type="button" class="btn-pagar-modal" id="btnConfirmarPagoCancelacion">Pagar y solicitar cancelación</button>
		</div>
	</div>
</div>

<div id="modalCancelacionEvaluacion" class="modal-pago oculto">
	<div class="modal-content-pago">
		<h2>Cancelar solicitud</h2>
		<p>
			Explique el motivo de la cancelación.
		</p>

		<label>Motivo de cancelación</label>
		<textarea id="motivoEvaluacion" class="textarea-cancelacion" maxlength="255" placeholder="Ingrese el motivo..."></textarea>

		<p class="ayuda-cancelacion">
			Este comentario será utilizado para futuras mejoras del proceso.
		</p>

		<div class="modal-actions">
			<button type="button" class="btn-cancelar-modal" id="btnCerrarModalEvaluacion">
				Volver
			</button>
			<button type="button" class="btn-pagar-modal" id="btnConfirmarCancelacionEvaluacion">
				Aceptar
			</button>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/sweetalert2.min.js"></script>
	<script src="~/js/mis-solicitudes.js"></script>
	<script src="~/js/config-global.js"></script>
}
