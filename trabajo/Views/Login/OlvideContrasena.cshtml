@{
    Layout = null;

    bool recuperacionValidada =
        ViewBag.RecuperacionValidada != null &&
        ViewBag.RecuperacionValidada == true;

    string dniValidado =
        ViewBag.DniRecuperacion?.ToString() ?? "";

    string correoValidado =
        ViewBag.CorreoRecuperacion?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Recuperar contraseña - CrediPlus</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/utilidades-ui.css" />

    <!-- Cloudflare Turnstile API -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <link rel="stylesheet" href="~/css/olvide-contrasena.css" asp-append-version="true" />

</head>


<body>

    <div class="main-box">


        <!-- ==========================================
             PANEL IZQUIERDO
        =========================================== -->

        <div class="left-panel">

            <div class="logo">
                <img src="~/imagenes/credi.png"
                     alt="CrediPlus"
                     class="logo-crediplus" />
            </div>


            <div class="welcome">

                <h1>
                    Recupera tu acceso
                </h1>

                <p>
                    Verifica tu identidad mediante el
                    correo asociado a tu cuenta CrediPlus
                    y establece una nueva contraseña
                    de forma segura.
                </p>

                <div class="credit-icon">
                    🔐
                </div>

            </div>

        </div>


        <!-- ==========================================
             PANEL DERECHO
        =========================================== -->

        <div class="right-panel">

            <h2>
                ¿Olvidaste tu contraseña?
            </h2>

            <p class="subtitle">
                Primero verifica tu identidad.
                Después podrás establecer una nueva contraseña.
            </p>


            <!-- MENSAJES DEL SERVIDOR -->
            @if (TempData["RecuperacionError"] != null)
            {
                <div class="mensaje mensaje-error">

                    ❌
                    @TempData["RecuperacionError"]

                </div>
            }


            @if (TempData["RecuperacionOk"] != null)
            {
                <div class="mensaje mensaje-ok">

                    ✅
                    @TempData["RecuperacionOk"]

                </div>
            }


            <!-- MENSAJES JAVASCRIPT -->

            <div id="mensajeRecuperacion"
                 class="mensaje">
            </div>



            @if (!recuperacionValidada)
            {

                <!-- ======================================
                     PASO 1 - IDENTIFICACIÓN
                ======================================= -->

                <div id="zonaIdentificacion">

                    <label class="campo-label">
                        DNI
                    </label>

                    <div class="input-util-wrap mb-3">

                        <input id="dniRecuperar"
                               class="form-control"
                               type="text"
                               placeholder="Ingresa tu DNI"
                               maxlength="8"
                               autocomplete="off"
                                />

                        <button type="button"
                                class="btn-clear"
                                >
                            ✕
                        </button>

                    </div>


                    <label class="campo-label">
                        Correo electrónico
                    </label>

                    <div class="input-util-wrap mb-3">

                        <input id="correoRecuperar"
                               class="form-control"
                               type="email"
                               placeholder="correo@gmail.com"
                               autocomplete="email" />

                        <button type="button"
                                class="btn-clear">
                            ✕
                        </button>

                    </div>

                    <!-- CLOUDFLARE TURNSTILE CAPTCHA -->
                    @if (ViewBag.TurnstileSiteKey != null && !string.IsNullOrWhiteSpace(ViewBag.TurnstileSiteKey.ToString()))
                    {
                        <div class="mb-3 text-center turnstile-center-wrap">
                            <div id="cf-turnstile-recuperacion" class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey" data-appearance="interaction-only" data-theme="light" data-language="es"></div>
                        </div>
                    }

                    <button id="btnEnviarRecuperacion"
                            type="button"
                            class="btn-enviar">

                        📩 Enviar enlace de recuperación

                    </button>

                    <button id="btnOtraCuenta"
                            type="button"
                            class="btn-otra-cuenta elemento-oculto">

                        ↻ Usar otro DNI o correo

                    </button>
                    <div id="zonaCodigoRecuperacion"
                         class="zona-codigo elemento-oculto">

                        <div class="codigo-header">

                            <div class="codigo-icon">
                                ✉
                            </div>

                            <div>
                                <div class="codigo-titulo">
                                    Verifica tu correo
                                </div>

                                <div class="codigo-subtitulo">
                                    Ingresa el código de seguridad
                                    de 6 caracteres que enviamos a tu correo.
                                </div>
                            </div>

                        </div>

                        <label class="campo-label">
                            Código de seguridad
                        </label>

                        <input id="codigoRecuperacion"
                               class="codigo-recuperacion-input"
                               type="text"
                               maxlength="6"
                               autocomplete="one-time-code"
                               spellcheck="false"
                               placeholder="A7K9Q2"
                                />

                        <div class="codigo-ayuda">

                            El código contiene 6 letras mayúsculas
                            y/o números.

                            <div id="contadorCodigo"
                                 class="contador-codigo-box">
                                Código válido por 01:00
                            </div>

                        </div>

                        <button id="btnVerificarCodigo"
                                type="button"
                                class="btn-enviar"
                                >

                            🔐 Verificar código

                        </button>
                        <button id="btnReenviarCodigo"
                                type="button"
                                class="btn-otra-cuenta elemento-oculto">

                            🔄 Reenviar código

                        </button>
                    </div>
                </div>


                <div class="
                            security-status
                            security-pending">

                    <div class="status-icon">
                        🔒
                    </div>

                    <div>

                        <div class="status-title">
                            Verificación pendiente
                        </div>

                        <div class="status-text">
                            Revisa tu correo e ingresa
                            el código de seguridad de
                            6 caracteres para continuar.
                        </div>

                    </div>

                </div>

            }
            else
            {

                <!-- ======================================
                     USUARIO YA VALIDADO
                ======================================= -->

                <div class="
                            security-status
                            security-ok">

                    <div class="status-icon">
                        ✓
                    </div>

                    <div>

                        <div class="status-title">
                            Identidad verificada
                        </div>

                        <div class="status-text">
                            Tu correo fue validado
                            correctamente.
                            Ya puedes crear una nueva
                            contraseña.
                        </div>

                    </div>

                </div>


                <label class="campo-label">
                    DNI verificado
                </label>

                <div class="mb-3">

                    <input class="form-control"
                           type="text"
                           value="@dniValidado"
                           readonly />

                </div>


                <label class="campo-label">
                    Correo verificado
                </label>

                <div class="mb-3">

                    <input class="form-control"
                           type="text"
                           value="@correoValidado"
                           readonly />

                </div>

            }
            @if (recuperacionValidada)
            {
                <div class="divider"></div>


                <!-- ==========================================
                PASO 2 - CONTRASEÑA
                =========================================== -->

                <form id="formCambiarClave">


                    <label class="campo-label">
                        Nueva contraseña
                    </label>

                    <div class="input-util-wrap mb-2">

                        <input id="nuevaClave"
                               class="form-control"
                               type="password"
                               placeholder="Nueva contraseña"
                               autocomplete="new-password" />

                        <button type="button"
                                class="btn-clear">
                            ✕
                        </button>

                        <button type="button"
                                class="btn-eye">
                            👁
                        </button>

                    </div>


                    <ul class="password-rules">

                        <li id="mayus">
                            ○ Una letra mayúscula
                        </li>

                        <li id="minus">
                            ○ Una letra minúscula
                        </li>

                        <li id="numero">
                            ○ Un número
                        </li>

                        <li id="simbolo">
                            ○ Un símbolo especial (!@@#$%&*...)
                        </li>

                        <li id="longitud">
                            ○ Mínimo 12 caracteres
                        </li>

                    </ul>


                    <label class="campo-label">
                        Confirmar contraseña
                    </label>

                    <div class="input-util-wrap mb-3">

                        <input id="confirmarClave"
                               class="form-control"
                               type="password"
                               placeholder="Confirmar contraseña"
                               autocomplete="new-password" />

                        <button type="button"
                                class="btn-clear">
                            ✕
                        </button>

                        <button type="button"
                                class="btn-eye">
                            👁
                        </button>

                    </div>


                    <div class="d-grid gap-2">

                        <button id="btnCambiarClave"
                                class="btn btn-login"
                                type="submit">
                            🔐 Cambiar contraseña
                        </button>

                    </div>

                </form>
            }

            <div class="register-link">

                <a href="@Url.Action(
                                       "IniciarSesion",
                                       "Login"
                                   )">

                    ← Volver a iniciar sesión

                </a>

            </div>

        </div>

    </div>



    @if (
        recuperacionValidada &&
        TempData["MostrarModalRecuperacion"] != null
        )
    {
        <div id="modalRecuperacionOk"
             class="modal-recuperacion-overlay">

            <div class="modal-recuperacion-card">

                <div class="modal-recuperacion-icon">
                    ✓
                </div>

                <h3>
                    Identidad verificada
                </h3>

                <p>
                    Tu correo fue validado correctamente.
                </p>

                <p>
                    Ahora sí puedes crear y confirmar
                    tu nueva contraseña de acceso a CrediPlus.
                </p>

                <button type="button"
                        id="btnCerrarModalRecuperacion">
                    Continuar
                </button>

            </div>

        </div>
    }

    <script src="~/js/utilidades-ui.js" asp-append-version="true"></script>
    <script src="~/js/olvide-contrasena.js" asp-append-version="true"></script>
</body>

</html>