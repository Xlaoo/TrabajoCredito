@{
    Layout = null;

    bool recuperacionValidada =
        ViewBag.RecuperacionValidada != null &&
        ViewBag.RecuperacionValidada == true;

    string dniValidado =
        ViewBag.DniRecuperacion?.ToString() ?? "";

    string correoValidado =
        ViewBag.CorreoRecuperacion?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Recuperar contraseña - CrediPlus</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/utilidades-ui.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient( 135deg, #240046, #3c096c, #4361ee, #00b4d8 );
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            padding: 25px;
        }


        /* ==========================================
                   CONTENEDOR PRINCIPAL
                ========================================== */

        .main-box {
            width: 1250px;
            min-height: 760px;
            display: flex;
            background: white;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,.35);
        }


        /* ==========================================
                   PANEL IZQUIERDO
                ========================================== */

        .left-panel {
            width: 48%;
            background: linear-gradient( 160deg, #4cc9f0, #4361ee, #7209b7 );
            color: white;
            padding: 55px 45px;
            position: relative;
            overflow: hidden;
        }


            .left-panel::before {
                content: "";
                position: absolute;
                width: 340px;
                height: 340px;
                border-radius: 50%;
                background: rgba(255,255,255,.08);
                top: -120px;
                right: -100px;
            }


            .left-panel::after {
                content: "";
                position: absolute;
                width: 280px;
                height: 280px;
                border-radius: 50%;
                background: rgba(255,255,255,.06);
                bottom: -100px;
                left: -80px;
            }

        .logo {
            position: relative;
            z-index: 2;
        }

        .logo-crediplus {
            width: 190px;
            max-width: 100%;
            height: auto;
            object-fit: contain;
            display: block;
        }

        .welcome {
            margin-top: 120px;
            position: relative;
            z-index: 2;
        }


            .welcome h1 {
                font-size: 52px;
                font-weight: bold;
                margin-bottom: 25px;
            }


            .welcome p {
                font-size: 20px;
                opacity: .95;
                line-height: 1.7;
                max-width: 470px;
            }


        .credit-icon {
            font-size: 115px;
            margin-top: 40px;
        }


        /* ==========================================
                   PANEL DERECHO
                ========================================== */

        .right-panel {
            width: 52%;
            padding: 55px 70px;
            background: linear-gradient( 135deg, #e0e7ff, #c7d2fe, #f3e8ff );
            display: flex;
            flex-direction: column;
            justify-content: center;
        }


            .right-panel h2 {
                color: #4c1d95;
                font-weight: bold;
                margin-bottom: 10px;
                font-size: 40px;
            }


        .subtitle {
            color: #64748b;
            margin-bottom: 28px;
            font-size: 17px;
            line-height: 1.5;
        }


        /* ==========================================
                   CAMPOS
                ========================================== */

        .campo-label {
            display: block;
            font-weight: 600;
            color: #334155;
            margin-bottom: 7px;
            font-size: 15px;
        }


        .input-util-wrap {
            position: relative;
        }


        .form-control {
            height: 58px;
            border: 1px solid transparent;
            background: #eef2f7;
            border-radius: 12px;
            font-size: 17px;
            padding-left: 18px;
            padding-right: 85px;
            transition: .2s;
        }


            .form-control:focus {
                border-color: #6366f1;
                background: white;
                box-shadow: 0 0 0 4px rgba(99,102,241,.12);
            }


            .form-control:disabled {
                background: #e2e8f0;
                color: #94a3b8;
                cursor: not-allowed;
                opacity: .8;
            }


            .form-control[readonly] {
                background: #ecfdf5;
                color: #166534;
                border: 1px solid #bbf7d0;
            }


        /* ==========================================
                   BOTONES
                ========================================== */

        .btn-enviar {
            width: 100%;
            height: 60px;
            border: none;
            border-radius: 15px;
            color: white;
            font-weight: bold;
            font-size: 17px;
            background: linear-gradient( 135deg, #4361ee, #7209b7 );
            transition: .2s;
        }


            .btn-enviar:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(79,70,229,.25);
            }


            .btn-enviar:disabled {
                cursor: not-allowed;
                opacity: .65;
                transform: none;
                box-shadow: none;
            }


        .btn-login {
            background: linear-gradient( 135deg, #4361ee, #7209b7 );
            border: none;
            color: white;
            font-weight: bold;
            height: 62px;
            border-radius: 16px;
            font-size: 18px;
            transition: .2s;
        }


            .btn-login:hover {
                color: white;
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(79,70,229,.25);
            }


            .btn-login:disabled {
                background: #94a3b8;
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }


        /* ==========================================
                   ESTADO DE VERIFICACIÓN
                ========================================== */

        .security-status {
            padding: 16px 18px;
            border-radius: 13px;
            margin: 20px 0;
            display: flex;
            align-items: center;
            gap: 13px;
        }


        .security-pending {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #9a3412;
        }


        .security-ok {
            background: #ecfdf5;
            border: 1px solid #86efac;
            color: #166534;
        }


        .status-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
        }


        .security-pending .status-icon {
            background: #ffedd5;
        }


        .security-ok .status-icon {
            background: #dcfce7;
        }


        .status-title {
            font-weight: bold;
            font-size: 15px;
            margin-bottom: 2px;
        }


        .status-text {
            font-size: 13px;
            opacity: .9;
        }


        /* ==========================================
                   MENSAJES
                ========================================== */

        .mensaje {
            display: none;
            border-radius: 12px;
            padding: 14px 16px;
            margin-bottom: 18px;
            font-size: 14px;
            line-height: 1.5;
        }


        .mensaje-error {
            display: block;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
        }


        .mensaje-ok {
            display: block;
            background: #ecfdf5;
            border: 1px solid #86efac;
            color: #166534;
        }


        /* ==========================================
                   REGLAS CONTRASEÑA
                ========================================== */

        .password-rules {
            font-size: 14px;
            color: #64748b;
            padding-left: 22px;
            margin-top: 8px;
            margin-bottom: 18px;
        }


            .password-rules li {
                margin-bottom: 4px;
            }


        /* ==========================================
                   SEPARADOR
                ========================================== */

        .divider {
            height: 1px;
            background: rgba(100,116,139,.18);
            margin: 22px 0;
        }


        /* ==========================================
                   VOLVER
                ========================================== */

        .register-link {
            text-align: center;
            font-size: 16px;
            margin-top: 17px;
            font-weight: 500;
        }


            .register-link a {
                color: #4f46e5;
                text-decoration: none;
            }


                .register-link a:hover {
                    text-decoration: underline;
                }


        /* ==========================================
                   CARGANDO
                ========================================== */

        .spinner {
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.4);
            border-top-color: white;
            border-radius: 50%;
            display: inline-block;
            animation: girar .8s linear infinite;
            margin-right: 8px;
            vertical-align: middle;
        }


        @@keyframes girar {

            to {
                transform: rotate(360deg);
            }
        }


        /* ==========================================
                   RESPONSIVE
                ========================================== */

        @@media (max-width: 900px) {

            body {
                padding: 15px;
                align-items: flex-start;
            }


            .main-box {
                width: 100%;
                min-height: auto;
                flex-direction: column;
                border-radius: 20px;
            }


            .left-panel,
            .right-panel {
                width: 100%;
            }


            .left-panel {
                padding: 35px 25px;
                min-height: 300px;
            }


            .welcome {
                margin-top: 45px;
            }


                .welcome h1 {
                    font-size: 36px;
                }


                .welcome p {
                    font-size: 16px;
                }


            .credit-icon {
                font-size: 65px;
                margin-top: 20px;
            }


            .right-panel {
                padding: 40px 25px;
            }


                .right-panel h2 {
                    font-size: 32px;
                }
        }


        @@media (max-width: 500px) {

            body {
                padding: 0;
                background: #e0e7ff;
            }


            .main-box {
                border-radius: 0;
                min-height: 100vh;
            }


            .left-panel {
                min-height: 260px;
            }


            .right-panel {
                padding: 30px 20px;
            }


                .right-panel h2 {
                    font-size: 28px;
                }
        }

        .modal-recuperacion-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .65);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 20px;
        }

        .modal-recuperacion-card {
            width: 100%;
            max-width: 470px;
            background: white;
            border-radius: 24px;
            padding: 40px 35px;
            text-align: center;
            box-shadow: 0 25px 60px rgba(0,0,0,.30);
        }

        .modal-recuperacion-icon {
            width: 88px;
            height: 88px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: #dcfce7;
            color: #16a34a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 44px;
            font-weight: bold;
        }

        .modal-recuperacion-card h3 {
            color: #4c1d95;
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .modal-recuperacion-card p {
            color: #64748b;
            font-size: 16px;
            line-height: 1.6;
        }

        .modal-recuperacion-card button {
            width: 100%;
            margin-top: 18px;
            border: none;
            border-radius: 14px;
            padding: 15px;
            color: white;
            font-weight: bold;
            font-size: 16px;
            background: linear-gradient( 135deg, #4361ee, #7209b7 );
        }
    </style>

</head>


<body>

    <div class="main-box">


        <!-- ==========================================
             PANEL IZQUIERDO
        =========================================== -->

        <div class="left-panel">

            <div class="logo">
                <img src="~/imagenes/credi.png"
                     alt="CrediPlus"
                     class="logo-crediplus" />
            </div>


            <div class="welcome">

                <h1>
                    Recupera tu acceso
                </h1>

                <p>
                    Verifica tu identidad mediante el
                    correo asociado a tu cuenta CrediPlus
                    y establece una nueva contraseña
                    de forma segura.
                </p>

                <div class="credit-icon">
                    🔐
                </div>

            </div>

        </div>


        <!-- ==========================================
             PANEL DERECHO
        =========================================== -->

        <div class="right-panel">

            <h2>
                ¿Olvidaste tu contraseña?
            </h2>

            <p class="subtitle">
                Primero verifica tu identidad.
                Después podrás establecer una nueva contraseña.
            </p>


            <!-- MENSAJES DEL SERVIDOR -->
            @if (TempData["RecuperacionError"] != null)
            {
                <div class="mensaje mensaje-error">

                    ❌
                    @TempData["RecuperacionError"]

                </div>
            }


            @if (TempData["RecuperacionOk"] != null)
            {
                <div class="mensaje mensaje-ok">

                    ✅
                    @TempData["RecuperacionOk"]

                </div>
            }


            <!-- MENSAJES JAVASCRIPT -->

            <div id="mensajeRecuperacion"
                 class="mensaje">
            </div>



            @if (!recuperacionValidada)
            {

                <!-- ======================================
                     PASO 1 - IDENTIFICACIÓN
                ======================================= -->

                <div id="zonaIdentificacion">

                    <label class="campo-label">
                        DNI
                    </label>

                    <div class="input-util-wrap mb-3">

                        <input id="dniRecuperar"
                               class="form-control"
                               type="text"
                               placeholder="Ingresa tu DNI"
                               maxlength="8"
                               autocomplete="off"
                               oninput="
                                       this.value =
                                       this.value.replace(
                                           /[^0-9]/g,
                                           ''
                                       )
                                   " />

                        <button type="button"
                                class="btn-clear"
                                onclick="
                                        clearInput(
                                            'dniRecuperar'
                                        )
                                    ">
                            ✕
                        </button>

                    </div>


                    <label class="campo-label">
                        Correo electrónico
                    </label>

                    <div class="input-util-wrap mb-3">

                        <input id="correoRecuperar"
                               class="form-control"
                               type="email"
                               placeholder="correo@gmail.com"
                               autocomplete="email" />

                        <button type="button"
                                class="btn-clear"
                                onclick="
                                        clearInput(
                                            'correoRecuperar'
                                        )
                                    ">
                            ✕
                        </button>

                    </div>


                    <button id="btnEnviarRecuperacion"
                            type="button"
                            class="btn-enviar"
                            onclick="enviarRecuperacion()">

                        📩 Enviar enlace de recuperación

                    </button>

                </div>


                <div class="
                            security-status
                            security-pending">

                    <div class="status-icon">
                        🔒
                    </div>

                    <div>

                        <div class="status-title">
                            Verificación pendiente
                        </div>

                        <div class="status-text">
                            Revisa tu correo y presiona
                            “Validar recuperación” para
                            desbloquear el cambio de contraseña.
                        </div>

                    </div>

                </div>

            }
            else
            {

                <!-- ======================================
                     USUARIO YA VALIDADO
                ======================================= -->

                <div class="
                            security-status
                            security-ok">

                    <div class="status-icon">
                        ✓
                    </div>

                    <div>

                        <div class="status-title">
                            Identidad verificada
                        </div>

                        <div class="status-text">
                            Tu correo fue validado
                            correctamente.
                            Ya puedes crear una nueva
                            contraseña.
                        </div>

                    </div>

                </div>


                <label class="campo-label">
                    DNI verificado
                </label>

                <div class="mb-3">

                    <input class="form-control"
                           type="text"
                           value="@dniValidado"
                           readonly />

                </div>


                <label class="campo-label">
                    Correo verificado
                </label>

                <div class="mb-3">

                    <input class="form-control"
                           type="text"
                           value="@correoValidado"
                           readonly />

                </div>

            }
            @if (recuperacionValidada)
            {
                <div class="divider"></div>


                <!-- ==========================================
                PASO 2 - CONTRASEÑA
                =========================================== -->

                <form id="formCambiarClave"
                onsubmit="
                      event.preventDefault();
                      cambiarContrasena();
                ">


                    <label class="campo-label">
                        Nueva contraseña
                    </label>

                    <div class="input-util-wrap mb-2">

                        <input id="nuevaClave"
                               class="form-control"
                               type="password"
                               placeholder="Nueva contraseña"
                               autocomplete="new-password" />

                        <button type="button"
                                class="btn-clear"
                                onclick="clearInput('nuevaClave')">
                            ✕
                        </button>

                        <button type="button"
                                class="btn-eye"
                                onclick="togglePassword('nuevaClave', this)">
                            👁
                        </button>

                    </div>


                    <ul class="password-rules">

                        <li id="mayus">
                            ○ Una letra mayúscula
                        </li>

                        <li id="minus">
                            ○ Una letra minúscula
                        </li>

                        <li id="numero">
                            ○ Un número
                        </li>

                        <li id="longitud">
                            ○ Mínimo 6 caracteres
                        </li>

                    </ul>


                    <label class="campo-label">
                        Confirmar contraseña
                    </label>

                    <div class="input-util-wrap mb-3">

                        <input id="confirmarClave"
                               class="form-control"
                               type="password"
                               placeholder="Confirmar contraseña"
                               autocomplete="new-password" />

                        <button type="button"
                                class="btn-clear"
                                onclick="clearInput('confirmarClave')">
                            ✕
                        </button>

                        <button type="button"
                                class="btn-eye"
                                onclick="togglePassword('confirmarClave', this)">
                            👁
                        </button>

                    </div>


                    <div class="d-grid gap-2">

                        <button id="btnCambiarClave"
                                class="btn btn-login"
                                type="submit">
                            🔐 Cambiar contraseña
                        </button>

                    </div>

                </form>
            }

            <div class="register-link">

                <a href="@Url.Action(
                                       "IniciarSesion",
                                       "Login"
                                   )">

                    ← Volver a iniciar sesión

                </a>

            </div>

        </div>

    </div>



    <script>

        // ==========================================
        // MOSTRAR MENSAJE
        // ==========================================

        function mostrarMensaje(
            texto,
            correcto
        ) {

            const mensaje =
                document.getElementById(
                    "mensajeRecuperacion"
                );

            mensaje.style.display =
                "block";

            mensaje.innerHTML =
                correcto
                    ? "✅ " + texto
                    : "❌ " + texto;


            if (correcto) {

                mensaje.className =
                    "mensaje mensaje-ok";

            }
            else {

                mensaje.className =
                    "mensaje mensaje-error";

            }


            mensaje.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }



        // ==========================================
        // ENVIAR CORREO DE RECUPERACIÓN
        // ==========================================

        async function enviarRecuperacion() {

            const dni =
                document.getElementById(
                    "dniRecuperar"
                ).value.trim();

            const correo =
                document.getElementById(
                    "correoRecuperar"
                ).value.trim();

            const boton =
                document.getElementById(
                    "btnEnviarRecuperacion"
                );


            // DNI

            if (!/^\d{8}$/.test(dni)) {

                mostrarMensaje(
                    "El DNI debe tener exactamente 8 números.",
                    false
                );

                return;
            }


            // CORREO

            if (
                !/^[A-Za-z0-9._%+-]+@@gmail\.com$/i
                    .test(correo)
            ) {

                mostrarMensaje(
                    "Ingresa un correo Gmail válido.",
                    false
                );

                return;
            }


            const textoOriginal =
                boton.innerHTML;


            boton.disabled = true;

            boton.innerHTML =
                '<span class="spinner"></span>' +
                'Enviando correo...';


            try {

                const datos =
                    new URLSearchParams();

                datos.append(
                    "dni",
                    dni
                );

                datos.append(
                    "correo",
                    correo
                );


                const respuesta =
                    await fetch(
                        '@Url.Action(
                                                        "SolicitarRecuperacion",
                                                        "Login"
                                                )',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },

                            body:
                                datos.toString()
                        }
                    );


                const resultado =
                    await respuesta.json();


                if (!resultado.ok) {

                    mostrarMensaje(
                        resultado.mensaje,
                        false
                    );

                    boton.disabled = false;

                    boton.innerHTML =
                        textoOriginal;

                    return;
                }


                mostrarMensaje(
                    resultado.mensaje,
                    true
                );


                // Dejar bloqueados DNI y correo
                // después de enviar correctamente.

                document.getElementById(
                    "dniRecuperar"
                ).readOnly = true;

                document.getElementById(
                    "correoRecuperar"
                ).readOnly = true;


                boton.innerHTML =
                    "✓ Enlace enviado";


                // No habilitamos contraseña aquí.
                // ÚNICAMENTE se habilita cuando
                // el usuario presiona el botón
                // que llegó a su correo.

            }
            catch (error) {

                console.error(error);

                mostrarMensaje(
                    "No se pudo enviar la solicitud. Inténtalo nuevamente.",
                    false
                );

                boton.disabled = false;

                boton.innerHTML =
                    textoOriginal;
            }
        }



        // ==========================================
        // CAMBIAR CONTRASEÑA
        // ==========================================

        async function cambiarContrasena() {

            const nuevaClave =
                document.getElementById(
                    "nuevaClave"
                ).value;

            const confirmarClave =
                document.getElementById(
                    "confirmarClave"
                ).value;

            const boton =
                document.getElementById(
                    "btnCambiarClave"
                );


            // VALIDAR REGLAS

            if (
                !/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,}$/
                    .test(nuevaClave)
            ) {

                mostrarMensaje(
                    "La contraseña debe tener mínimo 6 caracteres, una mayúscula, una minúscula y un número.",
                    false
                );

                return;
            }


            if (
                nuevaClave !==
                confirmarClave
            ) {

                mostrarMensaje(
                    "Las contraseñas no coinciden.",
                    false
                );

                return;
            }


            const textoOriginal =
                boton.innerHTML;


            boton.disabled = true;

            boton.innerHTML =
                '<span class="spinner"></span>' +
                'Actualizando...';


            try {

                const datos =
                    new URLSearchParams();

                datos.append(
                    "nuevaClave",
                    nuevaClave
                );

                datos.append(
                    "confirmarClave",
                    confirmarClave
                );


                const respuesta =
                    await fetch(
                        '@Url.Action(
                                                        "CambiarContrasenaRecuperada",
                                                        "Login"
                                                )',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },

                            body:
                                datos.toString()
                        }
                    );


                const resultado =
                    await respuesta.json();


                if (!resultado.ok) {

                    mostrarMensaje(
                        resultado.mensaje,
                        false
                    );

                    boton.disabled = false;

                    boton.innerHTML =
                        textoOriginal;

                    return;
                }


                mostrarMensaje(
                    resultado.mensaje,
                    true
                );


                boton.innerHTML =
                    "✓ Contraseña actualizada";


                setTimeout(
                    function () {

                        window.location.href =
                            resultado.redirectUrl;

                    },
                    1800
                );

            }
            catch (error) {

                console.error(error);

                mostrarMensaje(
                    "No se pudo cambiar la contraseña. Inténtalo nuevamente.",
                    false
                );

                boton.disabled = false;

                boton.innerHTML =
                    textoOriginal;
            }
        }



        // ==========================================
        // REGLAS VISUALES DE CONTRASEÑA
        // ==========================================

        const inputClave =
            document.getElementById(
                "nuevaClave"
            );

        const mayus =
            document.getElementById(
                "mayus"
            );

        const minus =
            document.getElementById(
                "minus"
            );

        const numero =
            document.getElementById(
                "numero"
            );

        const longitud =
            document.getElementById(
                "longitud"
            );


        if (inputClave) {

            inputClave.addEventListener(
                "input",
                function () {

                    const valor =
                        inputClave.value;


                    // MAYÚSCULA

                    if (/[A-Z]/.test(valor)) {

                        mayus.innerHTML =
                            "✔ Una letra mayúscula";

                        mayus.style.color =
                            "green";

                    }
                    else {

                        mayus.innerHTML =
                            "○ Una letra mayúscula";

                        mayus.style.color =
                            "#64748b";
                    }


                    // MINÚSCULA

                    if (/[a-z]/.test(valor)) {

                        minus.innerHTML =
                            "✔ Una letra minúscula";

                        minus.style.color =
                            "green";

                    }
                    else {

                        minus.innerHTML =
                            "○ Una letra minúscula";

                        minus.style.color =
                            "#64748b";
                    }


                    // NÚMERO

                    if (/[0-9]/.test(valor)) {

                        numero.innerHTML =
                            "✔ Un número";

                        numero.style.color =
                            "green";

                    }
                    else {

                        numero.innerHTML =
                            "○ Un número";

                        numero.style.color =
                            "#64748b";
                    }


                    // LONGITUD

                    if (valor.length >= 6) {

                        longitud.innerHTML =
                            "✔ Mínimo 6 caracteres";

                        longitud.style.color =
                            "green";

                    }
                    else {

                        longitud.innerHTML =
                            "○ Mínimo 6 caracteres";

                        longitud.style.color =
                            "#64748b";
                    }

                }
            );
        }
                function cerrarModalRecuperacion() {

            const modal =
                document.getElementById(
                    "modalRecuperacionOk"
                );

            if (modal) {
                modal.remove();
            }
        }
    </script>


    <script src="~/js/utilidades-ui.js"></script>
    @if (
        recuperacionValidada &&
        TempData["MostrarModalRecuperacion"] != null
        )
    {
        <div id="modalRecuperacionOk"
             class="modal-recuperacion-overlay">

            <div class="modal-recuperacion-card">

                <div class="modal-recuperacion-icon">
                    ✓
                </div>

                <h3>
                    Identidad verificada
                </h3>

                <p>
                    Tu correo fue validado correctamente.
                </p>

                <p>
                    Ahora sí puedes crear y confirmar
                    tu nueva contraseña de acceso a CrediPlus.
                </p>

                <button type="button"
                        onclick="cerrarModalRecuperacion()">
                    Continuar
                </button>

            </div>

        </div>
    }

</body>

</html>