                    "❌ Tu navegador no permite utilizar el micrófono.";

                return;
            }


            try {

                // ==========================================
                // REINICIAR VARIABLES
                // ==========================================

                fraseReconocida = "";

                audioChunksVerificacion = [];

                procesandoVoz = false;


                // ==========================================
                // CREAR RECONOCIMIENTO
                // ==========================================

                reconocimientoVoz =
                    new SpeechRecognition();

                reconocimientoVoz.lang = "es-PE";

                reconocimientoVoz.continuous = true;

                reconocimientoVoz.interimResults = false;


                // ==========================================
                // CUANDO DETECTA VOZ
                // ==========================================

                reconocimientoVoz.onresult =
                    function (event) {

                        let textoDetectado = "";


                        for (
                            let i = event.resultIndex;
                            i < event.results.length;
                            i++
                        ) {

                            if (event.results[i].isFinal) {

                                textoDetectado +=
                                    " " +
                                    event.results[i][0].transcript;
                            }
                        }


                        if (!textoDetectado.trim()) {
                            return;
                        }


                        fraseReconocida +=
                            " " + textoDetectado;


                        const fraseActual =
                            normalizarTextoVoz(
                                fraseReconocida
                            );


                        console.log(
                            "🎙️ Voz detectada:",
                            fraseActual
                        );


                        estado.innerText =
                            "🎙️ Detectando frase...";


                        // ==========================================
                        // FRASE ESPERADA
                        // ==========================================
                                if (!fraseVozBD) {

            estado.innerText =
                "❌ No se encontró una frase de seguridad registrada.";

            console.error(
                "FraseVoz no fue recibida desde la base de datos."
            );

            return;
        }

        const fraseEsperada =
    normalizarTextoVoz(fraseVozBD);

console.log(
    "================================="
);

console.log(
    "Frase desde BD:",
    fraseVozBD
);

console.log(
    "Frase normalizada:",
    fraseEsperada
);

console.log(
    "================================="
);


                        // ==========================================
                        // ¿YA DETECTÓ LA FRASE?
                        // ==========================================

                        if (
                            fraseActual.includes(
                                fraseEsperada
                            )
                        ) {

                            console.log(
                                "✅ FRASE DETECTADA"
                            );


                            estado.innerText =
                                "✅ Frase detectada. Verificando voz...";


                            detenerVerificacionVoz();


                        }

                    };


                // ==========================================
                // ERROR DEL RECONOCIMIENTO
                // ==========================================

                reconocimientoVoz.onerror =
                    function (event) {

                        console.error(
                            "Error reconocimiento:",
                            event.error
                        );


                        if (
                            event.error === "not-allowed" ||
                            event.error === "service-not-allowed"
                        ) {

                            estado.innerText =
                                "❌ Debes permitir el acceso al micrófono.";

                            detenerGrabacionSinEnviar();

                            return;
                        }


                        if (
                            event.error === "no-speech"
                        ) {

                            console.log(
                                "No se detectó voz todavía."
                            );

                            return;
                        }

                    };


                // ==========================================
                // SI CHROME TERMINA EL RECONOCIMIENTO
                // ==========================================

                reconocimientoVoz.onend =
                    function () {

                        console.log(
                            "Reconocimiento de voz finalizado."
                        );


                        // Si todavía estamos grabando
                        // y no hemos encontrado la frase,
                        // intentamos continuar.

                        if (
                            grabandoVerificacionVoz &&
                            !procesandoVoz
                        ) {

                            try {

                                reconocimientoVoz.start();

                            }
                            catch (error) {

                                console.log(
                                    "No se pudo reiniciar reconocimiento."
                                );

                            }

                        }

                    };


                // ==========================================
                // ACCEDER AL MICRÓFONO
                // ==========================================

                        const stream =
            await navigator.mediaDevices.getUserMedia({
                audio: {
                    echoCancellation: true,
                    noiseSuppression: true,
                    autoGainControl: true,
                    channelCount: 1
                }
            });


                // ==========================================
                // CREAR GRABADOR
                // ==========================================

                mediaRecorderVerificacion =
                    new MediaRecorder(stream);


                // ==========================================
                // GUARDAR AUDIO
                // ==========================================

                mediaRecorderVerificacion.ondataavailable =
                    function (event) {

                        if (event.data.size > 0) {

                            audioChunksVerificacion.push(
                                event.data
                            );

                        }

                    };


                        
        mediaRecorderVerificacion.onstop =
            async function () {

                console.log(
                    "🎙️ Grabación terminada."
                );

                // ==========================================
                // DETENER MICRÓFONO
                // ==========================================

                stream.getTracks()
                    .forEach(track => {
                        track.stop();
                    });


                // ==========================================
                // DETENER RECONOCIMIENTO
                // ==========================================

                if (reconocimientoVoz) {

                    try {
                        reconocimientoVoz.stop();
                    }
                    catch (error) {
                        console.log(error);
                    }

                }


                // ==========================================
                // CREAR AUDIO
                // ==========================================

                const audio =
                    new Blob(
                        audioChunksVerificacion,
                        {
                            type: "audio/webm"
                        }
                    );


                console.log(
                    "🎙️ Audio creado:",
                    audio.size,
                    "bytes"
                );


                // ==========================================
                // ENVIAR AL SERVIDOR
                // ==========================================

                estado.innerText =
                    "⏳ Procesando grabación...";


                await enviarVerificacionVoz(
                    audio
                );

            };
       



                // ==========================================
                // INICIAR RECONOCIMIENTO
                // ==========================================

                reconocimientoVoz.start();


                // ==========================================
                // INICIAR GRABACIÓN
                // ==========================================

                mediaRecorderVerificacion.start();


                grabandoVerificacionVoz = true;


                boton.disabled = true;

                boton.innerHTML =
                    "🎙️ Escuchando...";


                                estado.innerText =
            "🔴 Di tu palabra clave";


                // ==========================================
                // TIEMPO MÁXIMO
                // ==========================================

                temporizadorVoz =
                    setTimeout(function () {

                        if (
                            grabandoVerificacionVoz &&
                            !procesandoVoz
                        ) {

                            console.log(
                                "⏰ Tiempo de escucha agotado."
                            );


                            detenerGrabacionSinEnviar();


                            estado.innerText =
                                "❌ No se detectó la frase. Inténtalo nuevamente.";


                            boton.disabled = false;

                            boton.innerHTML =
                                "🎙️ Hablar palabra clave";

                        }

                    }, 10000);


            }
            catch (error) {

                console.error(
                    "Error al iniciar verificación:",
                    error
                );


                grabandoVerificacionVoz = false;


                estado.innerText =
                    "❌ No se pudo acceder al micrófono. Verifica los permisos.";


                boton.disabled = false;

                boton.innerHTML =
                    "🎙️ Hablar palabra clave";

            }

        }


               
        // ==========================================
        // DETENER AUTOMÁTICAMENTE
        // ==========================================

        function detenerVerificacionVoz() {

            if (!grabandoVerificacionVoz) {
                return;
            }


            // ==========================================
            // MARCAR QUE YA SE ESTÁ PROCESANDO
            // ==========================================

            procesandoVoz = true;


            // ==========================================
            // CANCELAR TEMPORIZADOR
            // ==========================================

            if (temporizadorVoz) {

                clearTimeout(
                    temporizadorVoz
                );

                temporizadorVoz = null;
            }


            // ==========================================
            // DETENER RECONOCIMIENTO
            // ==========================================

            if (reconocimientoVoz) {

                try {

                    reconocimientoVoz.stop();

                }
                catch (error) {

                    console.log(
                        "Reconocimiento ya detenido."
                    );

                }

            }


            // ==========================================
            // DETENER GRABACIÓN
            // ==========================================

            if (
                mediaRecorderVerificacion &&
                mediaRecorderVerificacion.state !== "inactive"
            ) {

                mediaRecorderVerificacion.stop();

            }

        }
        



        // ==========================================
        // CANCELAR SIN ENVIAR
        // ==========================================

        function detenerGrabacionSinEnviar() {

            grabandoVerificacionVoz = false;

            procesandoVoz = true;


            if (temporizadorVoz) {

                clearTimeout(
                    temporizadorVoz
                );

                temporizadorVoz = null;

            }


            if (reconocimientoVoz) {

                try {
                    reconocimientoVoz.stop();
                }
                catch (error) {
                    console.log(error);
                }

            }


            if (
                mediaRecorderVerificacion &&
                mediaRecorderVerificacion.state !== "inactive"
            ) {

                try {
                    mediaRecorderVerificacion.stop();
                }
                catch (error) {
                    console.log(error);
                }

            }


            procesandoVoz = false;

        }


        // ==========================================
        // ENVIAR VOZ AL SERVIDOR Y FINALIZAR LOGIN
        // ==========================================

        async function enviarVerificacionVoz(audioBlob) {

            const boton = document.getElementById("btnVerificarVoz");
            const estado = document.getElementById("estadoVerificacionVoz");

            if (!audioBlob || audioBlob.size === 0) {

                estado.innerText = "❌ No se obtuvo la grabación.";

                boton.disabled = false;
                boton.innerHTML = "🎙️ Hablar palabra clave";

                grabandoVerificacionVoz = false;
                procesandoVoz = false;

                return;
            }

            // ==========================================
            // FRASE RECONOCIDA
            // ==========================================

            const frase = normalizarTextoVoz(fraseReconocida);

            const fraseEsperada = normalizarTextoVoz(fraseVozBD);

            console.log("=================================");
            console.log("FRASE RECONOCIDA:", frase);
            console.log("FRASE ESPERADA:", fraseEsperada);
            console.log("=================================");


            // ==========================================
            // COMPROBAR FRASE
            // ==========================================

            if (!frase.includes(fraseEsperada)) {

                console.log("❌ FRASE INCORRECTA");

                estado.innerText =
                    "❌ La frase de seguridad es incorrecta.";

                boton.disabled = false;
                boton.innerHTML = "🎙️ Hablar palabra clave";

                grabandoVerificacionVoz = false;
                procesandoVoz = false;

                return;
            }


            // ==========================================
            // FRASE CORRECTA
            // ==========================================

            console.log("✅ FRASE CORRECTA");

            estado.innerText =
                "✅ Frase correcta. Verificando tu voz...";


            // ==========================================
            // ENVIAR AUDIO AL CONTROLADOR
            // ==========================================

            const formData = new FormData();

            formData.append(
                "audio",
                audioBlob,
                "verificacionVoz.webm"
            );


            try {

                boton.disabled = true;

                boton.innerHTML =
                    '<span class="spinner-border spinner-border-sm"></span> Verificando...';


                const respuesta = await fetch(
                    "/Login/VerificarVozLogin",
                    {
                        method: "POST",
                        body: formData
                    }
                );


                const resultado = await respuesta.json();


                console.log(
                    "================================="
                );

                console.log(
                    "RESPUESTA DEL SERVIDOR:"
                );

                console.log(
                    resultado
                );

                console.log(
                    "================================="
                );


        if (!resultado.ok) {

            // ==========================================
            // BLOQUEADO POR 3 INTENTOS FALLIDOS
            // ==========================================

            if (resultado.bloqueadoVoz) {

                grabandoVerificacionVoz = false;
                procesandoVoz = false;

                estado.innerText =
                    "🔒 " +
                    resultado.mensaje;

                boton.disabled = true;

                boton.innerHTML =
                    "🔒 Voz bloqueada";


                setTimeout(function () {

                    // ==========================================
                    // VOLVER AL PRIMER MENÚ
                    // ==========================================

                    restaurarModalSeguridad();


                    // ==========================================
                    // BLOQUEAR SOLAMENTE VOZ
                    // ==========================================

                    bloquearOpcionVoz(
                        resultado.segundosRestantes || 300
                    );

                }, 1200);

                return;
            }


            // ==========================================
            // FALLÓ PERO TODAVÍA QUEDAN INTENTOS
            // ==========================================

            estado.innerText =
                "❌ " +
                (
                    resultado.mensaje ||
                    "No se pudo verificar la voz."
                );

            boton.disabled = false;

            boton.innerHTML =
                "🎙️ Intentar nuevamente";

            grabandoVerificacionVoz = false;
            procesandoVoz = false;

            return;
        }


                // ==========================================
                // LOGIN CORRECTO
                // ==========================================

                console.log(
                    "✅ LOGIN COMPLETADO CORRECTAMENTE"
                );

                console.log(
                    "Redirigiendo a:",
                    resultado.redirectUrl
                );


                estado.innerText =
                    "🟢 Voz verificada correctamente. Ingresando...";


                boton.innerHTML =
                    "✅ Verificación correcta";


                // ==========================================
                // REDIRECCIÓN
                // ==========================================

                if (resultado.redirectUrl) {

                    setTimeout(function () {

                        window.location.href =
                            resultado.redirectUrl;

                    }, 500);

                }
                else {

                    console.error(
                        "El servidor no devolvió redirectUrl."
                    );

                    estado.innerText =
                        "❌ Inicio de sesión correcto, pero no se recibió la dirección de destino.";

                    boton.disabled = false;

                }

            }
            catch (error) {

                console.error(
                    "ERROR VERIFICANDO VOZ:",
                    error
                );

                estado.innerText =
                    "❌ No se pudo verificar la voz.";

                boton.disabled = false;

                boton.innerHTML =
                    "🎙️ Hablar palabra clave";

                grabandoVerificacionVoz = false;
                procesandoVoz = false;
            }
        }
                    // ==========================================
        // CAMBIAR MODALES SIN SUPERPONERLOS
        // ==========================================

        function abrirModalCodigo() {

            const modalSeguridadElemento =
                document.getElementById("modalVerificacionSeguridad");

            const modalCodigoElemento =
                document.getElementById("modalCodigoSeguridad");

            if (!modalSeguridadElemento || !modalCodigoElemento) {
                return;
            }

            const modalSeguridad =
                bootstrap.Modal.getOrCreateInstance(
                    modalSeguridadElemento
                );

            const modalCodigo =
                bootstrap.Modal.getOrCreateInstance(
                    modalCodigoElemento
                );

            // Esperar a que el Modal 1 termine de cerrarse
            modalSeguridadElemento.addEventListener(
                "hidden.bs.modal",
                function abrirCodigoUnaVez() {

                    modalSeguridadElemento.removeEventListener(
                        "hidden.bs.modal",
                        abrirCodigoUnaVez
                    );

                    modalCodigo.show();

                }
            );

            // Cerrar completamente Modal 1
            modalSeguridad.hide();
        }
                // ==========================================
        // RESTAURAR MODAL DE SEGURIDAD A SU ESTADO INICIAL
        // ==========================================

        function restaurarModalSeguridad() {

            const modal = document.getElementById(
                "modalVerificacionSeguridad"
            );

            if (!modal) {
                return;
            }

            const bloqueRegistroVoz =
                document.getElementById("bloqueRegistroVoz");

            const bloqueVerificacionVoz =
                document.getElementById("bloqueVerificacionVoz");

            const opcionCorreo =
                document.getElementById("opcionCorreo");

            const opcionAplicacion =
                document.getElementById("opcionAplicacion");

            const opcionVoz =
                document.getElementById("opcionVoz");

            const mensajeAplicacion =
                document.getElementById("mensajeAplicacion");

            const botonContinuar =
                modal.querySelector(".btn-continuar-seguridad");

            const titulo =
                modal.querySelector(".modal-title");

            const texto =
                modal.querySelector(".texto-seguridad");

            // ==========================================
            // MÉTODO POR DEFECTO
            // ==========================================

            metodoVerificacion = "correo";

            // ==========================================
            // MOSTRAR OPCIONES
            // ==========================================

            if (opcionCorreo) {
                opcionCorreo.style.display = "flex";
                opcionCorreo.classList.add("seleccionada");
            }

            if (opcionAplicacion) {
                opcionAplicacion.style.display = "flex";
                opcionAplicacion.classList.remove("seleccionada");
            }

            if (opcionVoz) {
                opcionVoz.style.display = "flex";
                opcionVoz.classList.remove("seleccionada");
            }

            // ==========================================
            // RADIOS
            // ==========================================

            const radioCorreo =
                document.getElementById("radioCorreo");

            const radioAplicacion =
                document.getElementById("radioAplicacion");

            const radioVoz =
                document.getElementById("radioVoz");

            if (radioCorreo) {
                radioCorreo.style.display = "block";
            }

            if (radioAplicacion) {
                radioAplicacion.style.display = "none";
            }

            if (radioVoz) {
                radioVoz.style.display = "none";
            }

            // ==========================================
            // OCULTAR BLOQUES ESPECIALES
            // ==========================================

            if (bloqueRegistroVoz) {
                bloqueRegistroVoz.style.display = "none";
            }

            if (bloqueVerificacionVoz) {
                bloqueVerificacionVoz.style.display = "none";
            }

            if (mensajeAplicacion) {
                mensajeAplicacion.style.display = "none";
            }

            // ==========================================
            // RESTAURAR TÍTULO
            // ==========================================

            if (titulo) {
                titulo.innerText =
                    "Verificación de seguridad";
            }

            // ==========================================
            // RESTAURAR DESCRIPCIÓN
            // ==========================================

            if (texto) {
                texto.innerText =
                    "Para continuar, selecciona cómo deseas recibir tu código de seguridad.";
            }

            // ==========================================
            // MOSTRAR CONTINUAR
            // ==========================================

            if (botonContinuar) {
                botonContinuar.style.display = "inline-block";
                botonContinuar.disabled = false;

                botonContinuar.innerHTML =
                    'Continuar <i class="bi bi-arrow-right ms-1"></i>';
            }
        }
        // ==========================================
        // AL CERRAR MODAL 1, RESTAURARLO
        // ==========================================

        document.addEventListener("DOMContentLoaded", function () {

            const modalSeguridad =
                document.getElementById(
                    "modalVerificacionSeguridad"
                );

            if (!modalSeguridad) {
                return;
            }

            modalSeguridad.addEventListener(
                "hidden.bs.modal",
                function () {

                    restaurarModalSeguridad();

                }
            );

        });
                // ==========================================
        // BLOQUEAR OPCIÓN DE VOZ
        // ==========================================

        let intervaloBloqueoVoz = null;


        function bloquearOpcionVoz(
            segundos
        ) {

            const opcionVoz =
                document.getElementById(
                    "opcionVoz"
                );

            if (!opcionVoz) {
                return;
            }


            // Guardamos el onclick original
            opcionVoz.onclick = null;

            opcionVoz.style.opacity =
                "0.55";

            opcionVoz.style.cursor =
                "not-allowed";

            opcionVoz.style.pointerEvents =
                "none";


            // ==========================================
            // BUSCAR TEXTO DE LA OPCIÓN
            // ==========================================

            const descripcion =
                opcionVoz.querySelector(
                    ".opcion-contenido p"
                );


            if (intervaloBloqueoVoz) {

                clearInterval(
                    intervaloBloqueoVoz
                );
            }


            let segundosRestantes =
                segundos;


            function actualizarBloqueo() {

                const minutos =
                    Math.floor(
                        segundosRestantes /
                        60
                    );

                const segundosVista =
                    segundosRestantes %
                    60;


                const tiempo =
                    String(minutos)
                        .padStart(2, "0") +
                    ":" +
                    String(segundosVista)
                        .padStart(2, "0");


                if (descripcion) {

                    descripcion.innerText =
                        "🔒 Voz bloqueada. Disponible nuevamente en " +
                        tiempo;
                }


                // ==========================================
                // TERMINÓ BLOQUEO
                // ==========================================

                if (
                    segundosRestantes <= 0
                ) {

                    clearInterval(
                        intervaloBloqueoVoz
                    );

                    intervaloBloqueoVoz =
                        null;


                    opcionVoz.style.opacity =
                        "1";

                    opcionVoz.style.cursor =
                        "pointer";

                    opcionVoz.style.pointerEvents =
                        "auto";


                    opcionVoz.onclick =
                        function () {

                            seleccionarMetodo(
                                "voz"
                            );

                        };


                    if (descripcion) {

                        descripcion.innerText =
                            "Habla tu palabra o frase de seguridad registrada.";
                    }


                    return;
                }


                segundosRestantes--;
            }


            actualizarBloqueo();


            intervaloBloqueoVoz =
                setInterval(
                    actualizarBloqueo,
                    1000
                );
        }
                function usarCorreoParaActivarVoz() {

            const modalElemento =
                document.getElementById(
                    "modalVozNoHabilitada"
                );

            if (!modalElemento) {
                return;
            }


            const modal =
                bootstrap.Modal
                    .getOrCreateInstance(
                        modalElemento
                    );


            modalElemento.addEventListener(
                "hidden.bs.modal",
                function cambiarACorreo() {

                    modalElemento.removeEventListener(
                        "hidden.bs.modal",
                        cambiarACorreo
                    );

                    seleccionarMetodo(
                        "correo"
                    );

                }
            );


            modal.hide();
        }
