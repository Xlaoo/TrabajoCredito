                    fraseRegistroVozLogin.trim()
                );
                try {

                    boton.disabled = true;

                    const respuesta =
                        await fetch(
                            "/Login/RegistrarVozLogin",
                            {
                                method: "POST",
                                body: formData
                            }
                        );

                    const resultado =
