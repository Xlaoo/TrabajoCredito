            // ==========================================
            // BLOQUEAR OPCIÓN DE VOZ
            // ==========================================

            let intervaloBloqueoVoz = null;


            function bloquearOpcionVoz(
                segundos
            ) {

                const opcionVoz =
                    document.getElementById(
                        "opcionVoz"
                    );

                if (!opcionVoz) {
                    return;
                }


                // Guardamos el onclick original
                opcionVoz.onclick = null;

                opcionVoz.style.opacity =
                    "0.55";

                opcionVoz.style.cursor =
                    "not-allowed";

                opcionVoz.style.pointerEvents =
                    "none";


                // ==========================================
                // BUSCAR TEXTO DE LA OPCIÓN
                // ==========================================

                const descripcion =
                    opcionVoz.querySelector(
                        ".opcion-contenido p"
                    );


                if (intervaloBloqueoVoz) {

                    clearInterval(
                        intervaloBloqueoVoz
                    );
                }


                let segundosRestantes =
                    segundos;


                function actualizarBloqueo() {

                    const minutos =
                        Math.floor(
                            segundosRestantes /
                            60
                        );

                    const segundosVista =
                        segundosRestantes %
                        60;


                    const tiempo =
                        String(minutos)
                            .padStart(2, "0") +
                        ":" +
                        String(segundosVista)
                            .padStart(2, "0");


                    if (descripcion) {

                        descripcion.innerText =
                            "🔒 Voz bloqueada. Disponible nuevamente en " +
                            tiempo;
                    }


                    // ==========================================
                    // TERMINÓ BLOQUEO
                    // ==========================================

                    if (
                        segundosRestantes <= 0
                    ) {

                        clearInterval(
                            intervaloBloqueoVoz
                        );

                        intervaloBloqueoVoz =
                            null;


                        opcionVoz.style.opacity =
                            "1";

                        opcionVoz.style.cursor =
                            "pointer";

                        opcionVoz.style.pointerEvents =
                            "auto";


                        opcionVoz.onclick =
                            function() {

                                seleccionarMetodo(
                                    "voz"
                                );

                            };


                        if (descripcion) {

                            descripcion.innerText =
                                "Habla tu palabra o frase de seguridad registrada.";
                        }


                        return;
                    }


                    segundosRestantes--;
                }


                actualizarBloqueo();


                intervaloBloqueoVoz =
                    setInterval(
                        actualizarBloqueo,
                        1000
                    );
            }
            function usarCorreoParaActivarVoz() {

