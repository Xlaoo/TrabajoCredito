@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Iniciar Sesión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/utilidades-ui.css" />
    <!-- ICONOS BOOTSTRAP -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+"
          crossorigin="anonymous" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
            integrity="sha384-3zSEDfvllQohrq0PHL1fOXJuC/jSOO34H46t6UQfobFOmxE5BpjjaIJY5F2/bMnU"
            crossorigin="anonymous"></script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <link rel="stylesheet" href="~/css/iniciar-sesion.css" asp-append-version="true" />
</head>

<body>
    <div class="main-box">

        <div class="left-panel">
            <div class="logo">
                <img src="~/imagenes/credi.png"
                     alt="CrediPlus"
                     class="logo-crediplus" />
            </div>

            <div class="welcome">
                <h1>Bienvenido</h1>
                <p>
                    Ingresa con tu DNI para gestionar tus solicitudes de crédito
                    de forma rápida y segura.
                </p>

                <div class="credit-icon">💰</div>
            </div>
        </div>

        <div class="right-panel">
            <h2>Iniciar Sesión</h2>
            <p class="subtitle">Accede a tu cuenta de créditos</p>
            @if (!string.IsNullOrEmpty(ViewBag.MensajeRegistro))
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @ViewBag.MensajeRegistro

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }

            

            

            <form asp-controller="Login"
                  asp-action="IniciarSesion"
                  method="post"
                  id="formLogin">

                <div class="input-util-wrap mb-3">
                    <input id="dniInput"
                           class="form-control"
                           type="text"
                           placeholder="DNI"
                           required
                           name="dni"
                           maxlength="8"
                            />

                    <button type="button"
                            class="btn-clear"
                            >
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-3">
                    <input id="claveInput"
                           class="form-control"
                           type="password"
                           placeholder="Contraseña"
                           required
                           name="clave" />

                    <button type="button" class="btn-clear" >
                        ✕
                    </button>

                    <button type="button" class="btn-eye" >
                        👁
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.TurnstileSiteKey as string))
                {
                    <div class="mb-3 d-flex justify-content-center">
                        <div class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey" data-appearance="interaction-only" data-theme="light" data-language="es"></div>
                    </div>
                }

                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-login" type="submit">Iniciar Sesión</button>
                </div>
                <div id="mensajeLogin"
                     class="alert alert-danger mt-3 oculto-inicial">
                </div>
                @if (ViewData["Mensaje"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewData["Mensaje"]
                    </div>
                }

                <div class="register-link mb-2">
                    <a href="@Url.Action("OlvideContrasena", "Login", new { nuevo = true })">¿Olvidaste tu contraseña?</a>
                </div>

                <div class="register-link">
                    ¿No tienes una cuenta?
                    <a href="@Url.Action("Registro", "Login")">Regístrate</a>
                </div>
                <a href="@Url.Action("PantallaPrincipal", "Login")" class="back-btn">
                    ← Regresar
                </a>

            </form>
        </div>
    </div>
    <!-- MODAL DE VERIFICACIÓN DE SEGURIDAD -->
    <div class="modal fade" id="modalVerificacionSeguridad" tabindex="-1"
         aria-labelledby="modalVerificacionSeguridadLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-crediplus">

                <div class="modal-header border-0">
                    <div>
                        <img src="~/imagenes/icon.png"
                             alt="CrediPlus"
                             class="logo-modal-seguridad" />

                        <h4 class="modal-title mt-3" id="modalVerificacionSeguridadLabel">
                            Verificación de seguridad
                        </h4>

                        <p class="texto-seguridad">
                            Para continuar, selecciona cómo deseas recibir tu código de seguridad.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <!-- REGISTRO DE VOZ OBLIGATORIO -->

                    <div id="bloqueRegistroVoz"
                         class="oculto-inicial">

                        <div class="text-center mb-3">

                            <div class="icono-seguridad icono-seguridad-morado mx-auto mb-3">

                                <i class="bi bi-mic-fill"></i>

                            </div>

                            <h5 class="titulo-seguridad-oscuro">
                                Registro de voz obligatorio
                            </h5>

                            <p class="texto-seguridad-sub">
                                No tienes registrada una voz de seguridad.
                                Debes realizar una grabación para continuar.
                            </p>

                        </div>

                        <div class="seguridad-voz-box">

                            <p class="texto-palabra-clave">
                                🎙️ Palabra o frase clave:
                            </p>

                            <div class="alert alert-light text-center">
                                <strong id="textoFraseEsperadaRegistroVoz" class="textoFraseEsperadaVoz">Di tu palabra o frase de seguridad registrada</strong>
                            </div>

                            <button type="button"
                                    id="btnGrabarVozLogin"
                                    class="btn btn-primary w-100 py-3 fs-6 fw-bold shadow-sm rounded-3"
                                    >

                                🎙️ Grabar mi voz

                            </button>

                            <div id="estadoVozLogin"
                                 class="text-center mt-3 estado-voz-login-texto">

                                ⚪ Aún no has grabado tu voz

                            </div>

                            <div id="btnCancelarRenovacionFormulario" class="text-center mt-3 oculto-inicial">
                                <button type="button" class="btn btn-link text-decoration-none text-muted p-0 btn-cancelar-renovacion-link" id="btnCancelarRenovacionDesdeFormulario">
                                    <i class="bi bi-arrow-left me-1"></i> Cancelar y volver a selección de métodos
                                </button>
                            </div>

                        </div>

                    </div>
                    <!-- VERIFICACIÓN DE VOZ -->

                    <div id="bloqueVerificacionVoz"
                         class="oculto-inicial">

                        <div class="text-center mb-3">

                            <div class="icono-seguridad icono-seguridad-verde mx-auto mb-3">

                                <i class="bi bi-mic-fill"></i>

                            </div>

                            <h5 class="titulo-seguridad-oscuro">
                                Verificación por voz
                            </h5>

                            <p class="texto-seguridad-sub">
                                Di tu frase de seguridad para verificar tu identidad.
                            </p>

                        </div>

                        <div class="seguridad-voz-box">

                            <p class="texto-palabra-clave">
                                🎙️ Palabra o frase clave registrada:
                            </p>

                            <div class="alert alert-light text-center">
                                <strong id="textoFraseEsperadaVoz" class="textoFraseEsperadaVoz">Di tu palabra o frase de seguridad registrada</strong>
                            </div>

                            <button type="button"
                                    id="btnVerificarVoz"
                                    class="btn btn-success w-100 py-3 fs-6 fw-bold shadow-sm rounded-3"
                                    >

                                🎙️ Hablar palabra clave

                            </button>

                            <div id="estadoVerificacionVoz"
                                 class="text-center mt-3 estado-voz-login-texto">

                                ⚪ Aún no has realizado la verificación

                            </div>

                        </div>

                    </div>
                    <!-- OPCIÓN CORREO -->
                    <div class="opcion-seguridad seleccionada"
                         id="opcionCorreo"
                         >

                        <div class="opcion-icono correo">
                            <i class="bi bi-envelope-fill"></i>
                        </div>

                        <div class="opcion-contenido">
                            <h5>Correo electrónico</h5>

                            <p>
                                Recibir un código de seguridad en el
                                correo electrónico registrado.
                            </p>
                        </div>

                        <div class="radio-seguridad">
                            <span id="radioCorreo"></span>
                        </div>
                    </div>


                    <!-- OPCIÓN CREDIPLUS AUTHENTICATOR -->
                    <div class="opcion-seguridad"
                         id="opcionAplicacion"
                         >

                        <div class="opcion-icono aplicacion">
                            <img src="~/imagenes/AplicacionCrediplus.jpeg"
                                 alt="CrediPlus Authenticator"
                                 class="logo-app-authenticator-mini" />
                        </div>

                        <div class="opcion-contenido">
                            <div class="titulo-opcion">
                                <h5>CrediPlus Authenticator</h5>
                            </div>

                            <p>
                                Verifica tu identidad mediante tu aplicación
                                CrediPlus Authenticator.
                            </p>
                        </div>

                        <div class="radio-seguridad">
                            <span id="radioAplicacion"></span>
                        </div>
                    </div>
                    <!-- OPCIÓN VOZ -->
                    <div class="opcion-seguridad"
                         id="opcionVoz"
                         >

                        <div class="opcion-icono voz">
                            <i class="bi bi-mic-fill"></i>
                        </div>

                        <div class="opcion-contenido">

                            <h5>Voz + palabra clave</h5>

                            <p>
                                Habla tu palabra o frase de seguridad registrada.
                            </p>

                        </div>

                        <div class="radio-seguridad">
                            <span id="radioVoz"></span>
                        </div>

                    </div>

                    <!-- ENLACE DISCRETO PARA ACTUALIZAR BIOMETRÍA DE VOZ -->
                    <div id="contenedorCambiarBiometria"
                         class="text-center mt-2 mb-2 oculto-inicial">
                        <a href="#" id="linkCambiarBiometriaVoz"
                           class="text-decoration-none fw-semibold link-cambiar-biometria-pill">
                            <i class="bi bi-arrow-repeat fs-6 icono-morado-biometria"></i>
                            <span class="texto-morado-biometria">🔄 ¿Deseas cambiar tu biometría de voz y palabra secreta?</span>
                        </a>
                    </div>

                </div>

                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="button"
                            id="btnContinuarSeguridad" class="btn btn-primary btn-continuar-seguridad">

                        Continuar
                        <i class="bi bi-arrow-right ms-1"></i>

                    </button>

                </div>

            </div>
        </div>
    </div>
    <!-- =====================================================
     MODAL CÓDIGO DE SEGURIDAD
     ===================================================== -->

    <div class="modal fade"
         id="modalCodigoSeguridad"
         tabindex="-1"
         aria-labelledby="modalCodigoSeguridadLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content modal-codigo-crediplus">

                <!-- CABECERA -->

                <div class="modal-header border-0">

                    <div>

                        <img src="~/imagenes/icon.png"
                             alt="CrediPlus"
                             class="logo-modal-codigo" />

                        <h4 class="modal-title mt-3"
                            id="modalCodigoSeguridadLabel">

                            Código de seguridad

                        </h4>

                        <p class="texto-seguridad">

                            Hemos enviado un código de seguridad
                            a tu correo electrónico registrado.

                        </p>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>


                <!-- CUERPO -->

                <div class="modal-body">

                    <div class="text-center">

                        <!-- ICONO CORREO -->

                        <div class="icono-correo-grande">

                            <i class="bi bi-envelope-check-fill"></i>

                        </div>


                        <h5 class="mt-4 fw-bold titulo-revisa-correo">

                            Revisa tu correo

                        </h5>


                        <p class="texto-seguridad-sub">

                            Ingresa el código de 6 caracteres
                            que recibiste.

                        </p>


                        <!-- INPUT -->

                        <input type="text"
                               id="codigoLogin"
                               class="form-control codigo-input mt-3"
                               maxlength="6"
                               autocomplete="one-time-code"
                               placeholder="XXXXXX"
                                />


                        <!-- CONTADOR -->

                        <div class="contador-codigo">

                            <i class="bi bi-clock-fill"></i>

                            <span id="textoContador">

                                El código expira en

                            </span>

                            <span id="tiempoCodigo">

                                01:00

                            </span>

                        </div>


                        <!-- REENVIAR -->

                        <div class="mt-2">

                            <button type="button"
                                    id="btnReenviarCodigo"
                                    class="btn-reenviar"
                                    disabled
                                    >

                                <i class="bi bi-arrow-clockwise"></i>

                                Reenviar código

                            </button>

                        </div>


                        <!-- MENSAJE -->

                        <div id="mensajeCodigoLogin"
                             class="mt-3 oculto-inicial">
                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="btnVerificarCodigo"
                            >

                        <i class="bi bi-shield-check"></i>

                        Verificar código

                    </button>

                </div>

            </div>

        </div>

    </div>
    <!-- ==========================================
     MODAL - ACCESO POR VOZ NO HABILITADO
     ========================================== -->

    <div class="modal fade"
         id="modalVozNoHabilitada"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-sm">

            <div class="modal-content modal-voz-no-habilitada-dialog">

                <div class="modal-body text-center p-4">

                    <div class="icono-aviso-naranja-circular">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>

                    <h5 class="titulo-seguridad-oscuro">
                        Acceso por voz pendiente
                    </h5>

                    <p class="texto-seguridad-aviso">

                        Tu voz ya está registrada.

                        <br><br>

                        Por seguridad debes iniciar sesión
                        <strong>una vez mediante correo electrónico</strong>
                        antes de poder utilizar
                        Voz + palabra clave.

                    </p>


                    <button type="button"
                            id="btnUsarCorreoParaActivarVoz" class="btn btn-primary w-100">

                        <i class="bi bi-envelope-check-fill me-1"></i>

                        Usar correo electrónico

                    </button>


                    <button type="button"
                            class="btn btn-light w-100 mt-2"
                            data-bs-dismiss="modal">

                        Cerrar

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================================
     MODAL ACTUALIZAR BIOMETRÍA DE VOZ (RENOVACIÓN SEGURA)
     ===================================================== -->
    <div class="modal fade"
         id="modalRenovacionBiometria"
         tabindex="-1"
         data-bs-backdrop="static"
         data-bs-keyboard="false"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-auth-filtro modal-renovacion-card">

                <div class="modal-header border-0 pb-1">
                    <div class="d-flex align-items-center gap-3">
                        <div class="auth-shield auth-shield-renovacion">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <h4 class="modal-title auth-titulo fw-bold mb-0 titulo-renovacion-modal" id="tituloRenovacionModal">
                                🔐 Actualizar biometría de voz
                            </h4>
                            <p class="auth-subtitulo text-muted mb-0 subtitulo-renovacion-modal" id="subtituloRenovacionModal">
                                Verificación previa de identidad
                            </p>
                        </div>
                    </div>

                    <button type="button"
                            id="btnCerrarModalRenovacionHeader" class="btn-close"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body pt-3 pb-4 px-4">

                    <!-- ========================================== -->
                    <!-- PANTALLA 1: SOLICITAR CÓDIGO DE SEGURIDAD  -->
                    <!-- ========================================== -->
                    <div id="renovacionPaso1">
                        <div class="auth-info-box p-3 mb-3 info-box-renovacion">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-shield-check fs-4 icono-morado-shield"></i>
                                <div>
                                    <strong class="strong-renovacion-info mb-1">
                                        Para proteger tu cuenta, necesitamos verificar tu identidad antes de permitirte cambiar tu biometría de voz y tu palabra secreta.
                                    </strong>
                                    <p class="mb-0 text-muted p-renovacion-info">
                                        Enviaremos un código de seguridad al correo electrónico registrado en tu cuenta.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="auth-correo-box p-3 mb-3 d-flex align-items-center justify-content-between correo-box-renovacion">
                            <div class="d-flex align-items-center gap-3">
                                <div class="auth-correo-icon correo-icon-renovacion">
                                    <i class="bi bi-envelope-check-fill"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block small-correo-label">Correo registrado</small>
                                    <strong id="correoOcultoRenovacion" class="strong-correo-texto">
                                        Cargando...
                                    </strong>
                                </div>
                            </div>
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        </div>

                        <div class="d-flex align-items-center gap-2 mb-3 nota-info-renovacion">
                            <i class="bi bi-info-circle-fill icono-info-morado"></i>
                            <span>El código será de un solo uso y tendrá una vigencia estricta de 60 segundos.</span>
                        </div>

                        <div id="mensajeRenovacionPaso1" class="alert alert-danger py-2 px-3 mb-3 oculto-inicial alert-renovacion-custom"></div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="button" id="btnCancelarRenovacionPaso1" class="btn btn-light flex-fill py-2 fw-semibold btn-cancelar-paso-renovacion">
                                Cancelar
                            </button>
                            <button type="button"
                                    id="btnEnviarCodigoRenovacion"
                                    class="btn btn-primary flex-fill py-2 fw-semibold shadow-sm"
                                    class="btn btn-primary flex-fill py-2 fw-semibold shadow-sm btn-enviar-renovacion-morado"
                                    >
                                <i class="bi bi-send-fill me-1"></i> Enviar código de verificación
                            </button>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- PANTALLA 2: INTRODUCIR OTP DE 6 CASILLAS    -->
                    <!-- ========================================== -->
                    <div id="renovacionPaso2" class="oculto-inicial">
                        <div class="text-center mb-3">
                            <div class="mx-auto mb-2 icono-paso2-circular-morado">
                                <i class="bi bi-envelope-open-fill"></i>
                            </div>
                            <h5 class="fw-bold mb-1 titulo-seguridad-oscuro">
                                📩 Verifica tu identidad
                            </h5>
                            <p class="text-muted mb-1 subtitulo-renovacion-modal">
                                Hemos enviado un código de seguridad a tu correo electrónico. Ingrésalo para continuar con la actualización de tu biometría.
                            </p>
                            <strong id="correoOcultoRenovacion2" class="strong-correo-morado"></strong>
                        </div>

                        <!-- SEIS CASILLAS PARA EL CÓDIGO -->
                        <div class="d-flex justify-content-center gap-2 my-3" id="contenedorCasillasOtp">
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="casilla-otp-renovacion casilla-otp-custom text-center fw-bold fs-4" data-index="0" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="casilla-otp-renovacion casilla-otp-custom text-center fw-bold fs-4" data-index="1" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="casilla-otp-renovacion casilla-otp-custom text-center fw-bold fs-4" data-index="2" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="casilla-otp-renovacion casilla-otp-custom text-center fw-bold fs-4" data-index="3" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="casilla-otp-renovacion casilla-otp-custom text-center fw-bold fs-4" data-index="4" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="casilla-otp-renovacion casilla-otp-custom text-center fw-bold fs-4" data-index="5" />
                        </div>

                        <!-- CONTADOR REGRESIVO 1 MINUTO -->
                        <div class="text-center my-2">
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill pill-contador-renovacion">
                                <i class="bi bi-clock-fill icono-reloj-morado" id="iconoRelojRenovacion"></i>
                                <span id="textoContadorRenovacion">El código vence en <strong id="tiempoOtpRenovacion" class="tiempo-otp-morado">01:00</strong></span>
                            </div>
                        </div>

                        <div class="text-center mb-2">
                            <button type="button"
                                    id="btnReenviarOtpRenovacion"
                                    class="btn btn-link btn-sm text-decoration-none fw-semibold btn-reenviar-morado"

                                    disabled>
                                <i class="bi bi-arrow-clockwise me-1"></i> Reenviar código
                            </button>
                        </div>

                        <div id="mensajeRenovacionPaso2" class="alert py-2 px-3 mb-3 text-center oculto-inicial alert-renovacion-custom"></div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="button" id="btnCancelarRenovacionPaso1" class="btn btn-light flex-fill py-2 fw-semibold btn-cancelar-paso-renovacion">
                                Regresar o cancelar
                            </button>
                            <button type="button"
                                    id="btnVerificarOtpRenovacion"
                                    class="btn btn-success flex-fill py-2 fw-semibold shadow-sm"
                                    class="btn btn-success flex-fill py-2 fw-semibold shadow-sm btn-verificar-renovacion-verde"
                                    >
                                <i class="bi bi-check-circle-fill me-1"></i> Verificar código
                            </button>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- =====================================================
     MODAL CONFIRMAR IDENTIDAD PARA AUTHENTICATOR
     ===================================================== -->

    <div class="modal fade"
