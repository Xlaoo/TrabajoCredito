                </div>

            </div>

        </div>

    </div>
    <!-- =====================================================
     CONFIGURACIÓN TOTP - CREDIPLUS AUTHENTICATOR
     ===================================================== -->

    <div class="modal fade"
         id="modalConfigurarTotpAuthenticator"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content modal-totp-auth">

                <!-- CABECERA -->

                <div class="modal-header totp-header">

                    <div class="d-flex align-items-center gap-3">

                        <div class="totp-icono">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>

                        <div>

                            <h4>
                                Configura tu cuenta
                            </h4>

                            <p>
                                CrediPlus Authenticator
                            </p>

                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>


                <!-- CUERPO -->

                <div class="modal-body totp-body">

                    <div class="totp-intro">

                        <h5>
                            Vincula tu cuenta con la aplicación
                        </h5>

                        <p>
                            Ingresa estos datos en
                            <strong>CrediPlus Authenticator</strong>
                            para comenzar a generar tus códigos de seguridad.
                        </p>

                    </div>


                    <!-- CORREO -->

                    <div class="totp-dato-box">

                        <div class="totp-dato-icono">
                            <i class="bi bi-envelope-fill"></i>
                        </div>

                        <div class="totp-dato-contenido">

                            <span>
                                Correo de la cuenta
                            </span>

                            <strong id="correoConfiguracionTotp">
                                Cargando...
                            </strong>

                        </div>

                        <button type="button"
                                id="btnCopiarCorreoTotp" class="btn-copiar-totp">

                            <i class="bi bi-copy"></i>

                        </button>

                    </div>


                    <!-- CLAVE TOTP -->

                    <div class="totp-dato-box">

                        <div class="totp-dato-icono clave">
                            <i class="bi bi-key-fill"></i>
                        </div>

                        <div class="totp-dato-contenido">

                            <span>
                                Clave de configuración
                            </span>

                            <strong id="claveConfiguracionTotp"
                                    class="totp-clave">
                                Cargando...
                            </strong>

                        </div>

                        <button type="button"
                                id="btnCopiarClaveTotp" class="btn-copiar-totp">

                            <i class="bi bi-copy"></i>

                        </button>

                    </div>
                    <!-- QR DE VINCULACIÓN -->

                    <div class="totp-qr-seccion">

                        <div class="totp-qr-titulo">
                            <i class="bi bi-qr-code-scan"></i>
                            <strong>Escanea para vincular más rápido</strong>
                        </div>

                        <p class="totp-qr-descripcion">
                            Abre CrediPlus Authenticator y selecciona
                            <strong>“Escanear código QR”</strong>.
                        </p>

                        <div class="totp-qr-box">

                            <div id="qrConfiguracionTotp"></div>

                            <img src="~/imagenes/AplicacionCrediplus.jpeg"
                                 alt="CrediPlus"
                                 class="totp-qr-logo" />

                        </div>

                        <span class="totp-qr-alternativa">
                            También puedes utilizar el correo y la clave
                            mostrados arriba para configurarlo manualmente.
                        </span>

                    </div>

                    <!-- INSTRUCCIÓN -->

                    <div class="totp-ayuda">

                        <i class="bi bi-phone-fill"></i>

                        <div>

                            <strong>
                                Ahora abre CrediPlus Authenticator
                            </strong>

                            <p>
                                Selecciona
                                <strong>“Agregar clave manualmente”</strong>
                                e ingresa el correo y la clave mostrados arriba.
                            </p>

                        </div>

                    </div>
                    <button type="button"
                            id="btnAbrirGuiaVinculacionTotp" class="btn-guia-vinculacion">

                        <i class="bi bi-question-circle-fill"></i>

                        ¿Cómo vinculo mi cuenta?

                    </button>

                    <hr class="totp-separador" />


                    <!-- VERIFICACIÓN -->

                    <div class="totp-verificacion">

                        <h6>
                            Verifica la vinculación
                        </h6>

                        <p>
                            La aplicación comenzará a generar un código
                            de 6 dígitos. Escríbelo aquí para confirmar
                            que la configuración fue realizada correctamente.
                        </p>


                        <input type="text"
                               id="codigoVerificacionTotp"
                               class="form-control totp-codigo-input"
                               maxlength="6"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               placeholder="000000" />


                        <div id="mensajeConfiguracionTotp"
                             class="mt-3 oculto-inicial">
                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer totp-footer">

                    <button type="button"
                            id="btnVolverGuiaInstalacion" class="btn btn-light">

                        <i class="bi bi-arrow-left me-1"></i>
                        Volver

                    </button>


                    <button type="button"
                            id="btnVerificarTotp"
                            class="btn btn-primary btn-verificar-totp"
                            >

                        Verificar y vincular

                        <i class="bi bi-check-circle ms-1"></i>

                    </button>

                </div>

            </div>

        </div>

    </div>
    <!-- =====================================================
      GUÍA VISUAL DE VINCULACIÓN TOTP
      ===================================================== -->

    <div class="modal fade"
         id="modalGuiaVinculacionTotp"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content modal-guia-totp">

                <!-- CABECERA -->

                <div class="modal-header guia-totp-header">

                    <div>

                        <span class="guia-totp-badge">
                            CREDIPLUS AUTHENTICATOR
                        </span>

                        <h5>
                            Cómo vincular tu cuenta
                        </h5>

                        <p>
                            Sigue estos pasos desde tu celular.
                        </p>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>


                <!-- CUERPO -->

                <div class="modal-body guia-vinculacion-body">


                    <!-- =============================
                         PASO 1
                         ============================= -->

                    <div class="guia-vinculacion-paso"
                         id="guiaVinculacionPaso1">

                        <div class="guia-vinculacion-imagen">

                            <img src="~/SCANO_AUTHENTICADOR/paso_1.jpeg"
                                 alt="Paso 1 - Elegir método de vinculación" />

                        </div>


                        <span class="guia-vinculacion-numero">
                            Paso 1 de 4
                        </span>


                        <h5>
                            Elige cómo vincular tu cuenta
                        </h5>

                        <p>
                            Abre <strong>CrediPlus Authenticator</strong>.
                            Puedes vincular tu cuenta escaneando el código QR
                            o agregando la clave manualmente.
                        </p>


                        <div class="guia-vinculacion-nota">

                            <i class="bi bi-info-circle-fill"></i>

                            <span>
                                Si deseas usar el QR, presiona
                                <strong>“Escanear código QR”</strong>.
                            </span>

                        </div>

                    </div>


                    <!-- =============================
                         PASO 2
                         ============================= -->

                    <div class="guia-vinculacion-paso oculto-inicial"
                         id="guiaVinculacionPaso2">

                        <div class="guia-vinculacion-imagen">

                            <img src="~/SCANO_AUTHENTICADOR/paso_2.jpeg"
                                 alt="Paso 2 - Permitir acceso a cámara" />

                        </div>


                        <span class="guia-vinculacion-numero">
                            Paso 2 de 4
                        </span>


                        <h5>
                            Permite el acceso a la cámara
                        </h5>

                        <p>
                            La primera vez que uses el escáner,
                            Android solicitará permiso para utilizar
                            la cámara del dispositivo.
                        </p>


                        <div class="guia-vinculacion-nota">

                            <i class="bi bi-camera-fill"></i>

                            <span>
                                Presiona
                                <strong>“Mientras la app está en uso”</strong>
                                para continuar.
                            </span>

                        </div>

                    </div>


                    <!-- =============================
                         PASO 3
                         ============================= -->

                    <div class="guia-vinculacion-paso oculto-inicial"
                         id="guiaVinculacionPaso3">

                        <div class="guia-vinculacion-imagen">

                            <img src="~/SCANO_AUTHENTICADOR/paso_3.jpeg"
                                 alt="Paso 3 - Escanear código QR" />

                        </div>


                        <span class="guia-vinculacion-numero">
                            Paso 3 de 4
                        </span>


                        <h5>
                            Escanea el código QR
                        </h5>

                        <p>
                            Apunta la cámara del celular hacia el código QR
                            que aparece en la página web de CrediPlus.
                        </p>


                        <div class="guia-vinculacion-nota">

                            <i class="bi bi-qr-code-scan"></i>

                            <span>
                                Coloca el QR dentro del recuadro.
                                La aplicación lo reconocerá automáticamente.
                            </span>

                        </div>

                    </div>


                    <!-- =============================
                         PASO 4
                         ============================= -->

                    <div class="guia-vinculacion-paso oculto-inicial"
                         id="guiaVinculacionPaso4">

                        <div class="guia-vinculacion-imagen">

                            <img src="~/SCANO_AUTHENTICADOR/paso_4.jpeg"
                                 alt="Paso 4 - Agregar cuenta manualmente" />

                        </div>


                        <span class="guia-vinculacion-numero">
                            Paso 4 de 4
                        </span>


                        <h5>
                            También puedes agregarla manualmente
                        </h5>

                        <p>
                            Si prefieres no usar el QR, presiona
                            <strong>“Agregar clave manualmente”</strong>
                            e ingresa los datos mostrados en la web.
                        </p>


                        <div class="guia-vinculacion-nota">

                            <i class="bi bi-key-fill"></i>

                            <span>
                                En <strong>Nombre de cuenta</strong> coloca
                                tu correo y en <strong>Clave secreta</strong>
                                coloca la clave de configuración.
                            </span>

                        </div>

                    </div>


                    <!-- INDICADORES -->

                    <div class="guia-vinculacion-indicadores">

                        <span class="guia-vinculacion-punto activo"></span>
                        <span class="guia-vinculacion-punto"></span>
                        <span class="guia-vinculacion-punto"></span>
                        <span class="guia-vinculacion-punto"></span>

                    </div>


                    <!-- BOTONES -->

                    <div class="guia-vinculacion-botones">

                        <button type="button"
                                id="btnGuiaVinculacionAnterior"
                                class="btn-guia-vinculacion-atras"

                                disabled>

                            <i class="bi bi-arrow-left me-1"></i>

                            Anterior

                        </button>


                        <button type="button"
                                id="btnGuiaVinculacionSiguiente"
                                class="btn-guia-vinculacion-siguiente"
                                >

                            Siguiente

                            <i class="bi bi-arrow-right ms-1"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- ==========================================
     MODAL CONFIRMAR NUEVA VOZ
     ========================================== -->

    <div class="modal fade"
         id="modalConfirmarRegistroVozLogin"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content modal-confirmar-voz-dialog">

                <div class="modal-body text-center p-4">

                    <div class="icono-voz-detectada-verde">
                        <i class="bi bi-mic-fill"></i>
                    </div>

                    <h5 class="titulo-seguridad-oscuro">
                        Voz detectada
                    </h5>

                    <p class="texto-seguridad-sub">
                        Detectamos que dijiste:
                    </p>

                    <div id="textoRegistroVozDetectado"
                         class="alert alert-light texto-voz-detectado-box">
                        ...
                    </div>

                    <p class="texto-seguridad-sub">
                        ¿Deseas registrar esta frase y esta voz
                        como seguridad de tu cuenta?
                    </p>

                    <div class="d-flex gap-2 mt-3">

                        <button type="button"
                                id="btnRechazarRegistroVozModal" class="btn btn-light flex-fill">

                            <i class="bi bi-arrow-repeat"></i>
                            Volver a grabar

                        </button>

                        <button type="button"
                                id="btnConfirmarRegistroVozModal"
                                class="btn btn-success flex-fill"
                                >

                            <i class="bi bi-check-circle-fill"></i>
                            Confirmar voz

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- ==========================================
     MODAL ESPERANDO CREDIPLUS AUTHENTICATOR
     ========================================== -->

    <div class="modal fade"
         id="modalEsperandoAuthenticator"
         tabindex="-1"
         data-bs-backdrop="static"
         data-bs-keyboard="false"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content modal-esperando-auth-dialog">

                <div class="modal-body text-center p-4">

                    <div class="icono-esperando-auth-box">
                        <i id="iconoEstadoAuthenticator" class="bi bi-phone"></i>
                    </div>

                    <h4 id="tituloEstadoAuthenticator" class="titulo-esperando-auth">
                        Confirma desde tu celular
                    </h4>

                    <p id="textoEstadoAuthenticator" class="texto-esperando-auth">
                        Hemos enviado una solicitud a CrediPlus Authenticator.
                    </p>

                    <div id="contenedorNumeroAuthenticator">
                        <small class="small-num-verificacion">
                            NÚMERO DE VERIFICACIÓN
                        </small>
                        <div id="numeroEstadoAuthenticator" class="numero-verificacion-box">
                            --
                        </div>
                    </div>

                    <div id="esperandoEstadoAuthenticator" class="d-flex flex-column align-items-center justify-content-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="span-esperando-texto">Esperando confirmación...</span>
                        </div>
                        <div class="div-expira-texto">
                            La solicitud expira en <strong id="tiempoSolicitudAuthenticator" class="strong-tiempo-azul">30 s</strong>
                        </div>
                    </div>

                    <button type="button" id="btnCancelarEstadoAuthenticator" class="btn btn-outline-danger mt-3 px-4">
                        <i class="bi bi-x-circle me-1"></i> Cancelar solicitud
                    </button>
                    <button type="button" id="btnReenviarEstadoAuthenticator" class="btn btn-primary mt-3 px-4 oculto-inicial">
                        <i class="bi bi-arrow-clockwise me-1"></i> Reenviar solicitud
                    </button>
                    <button type="button" id="btnCerrarEstadoAuthenticator" class="btn btn-light mt-3 px-4 oculto-inicial" data-bs-dismiss="modal">
                        Cerrar
                    </button>

                </div>

            </div>

        </div>

    </div>
    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Utilidades -->
    <script src="~/js/utilidades-ui.js"></script>
    <script src="~/js/iniciar-sesion.js" asp-append-version="true"></script>
</body>
</html>