            }
            let mediaRecorderVerificacion = null;
            let audioChunksVerificacion = [];
            let grabandoVerificacionVoz = false;

            let reconocimientoVoz = null;
            let fraseReconocida = "";

            let procesandoVoz = false;
            let temporizadorVoz = null;


            // ==========================================
            // NORMALIZAR TEXTO
            // ==========================================

            function normalizarTextoVoz(texto) {

                return texto
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/[.,!?;:]/g, "")
                    .replace(/\s+/g, " ")
                    .trim();
            }


            // ==========================================
            // INICIAR VERIFICACIÓN DE VOZ
            // ==========================================

            async function iniciarVerificacionVoz() {

                const boton =
                    document.getElementById("btnVerificarVoz");

                const estado =
                    document.getElementById("estadoVerificacionVoz");


                if (!boton || !estado) {
                    return;
                }


                // ==========================================
                // EVITAR DOBLE CLIC
                // ==========================================

                if (grabandoVerificacionVoz || procesandoVoz) {
                    return;
                }


                // ==========================================
                // COMPROBAR SOPORTE
                // ==========================================

                const SpeechRecognition =
                    window.SpeechRecognition ||
                    window.webkitSpeechRecognition;


                if (!SpeechRecognition) {

                    estado.innerText =
                        "❌ Tu navegador no permite reconocer la voz. Utiliza Google Chrome.";

                    return;
                }


                if (!navigator.mediaDevices ||
                    !navigator.mediaDevices.getUserMedia) {

                    estado.innerText =
                        "❌ Tu navegador no permite utilizar el micrófono.";

                    return;
                }


                try {

                    // ==========================================
                    // REINICIAR VARIABLES
                    // ==========================================

                    fraseReconocida = "";

                    audioChunksVerificacion = [];

                    procesandoVoz = false;


                    // ==========================================
                    // CREAR RECONOCIMIENTO
                    // ==========================================

                    reconocimientoVoz =
                        new SpeechRecognition();

                    reconocimientoVoz.lang = "es-PE";

                    reconocimientoVoz.continuous = true;

                    reconocimientoVoz.interimResults = false;


                    // ==========================================
                    // CUANDO DETECTA VOZ
                    // ==========================================

                    reconocimientoVoz.onresult =
                        function(event) {

                            let textoDetectado = "";


                            for (
                                let i = event.resultIndex;
                                i < event.results.length;
                                i++
                            ) {

                                if (event.results[i].isFinal) {

                                    textoDetectado +=
                                        " " +
                                        event.results[i][0].transcript;
                                }
                            }


                            if (!textoDetectado.trim()) {
                                return;
                            }


                            fraseReconocida +=
                                " " + textoDetectado;


                            const fraseActual =
                                normalizarTextoVoz(
                                    fraseReconocida
                                );


                            console.log(
                                "🎙️ Voz detectada:",
                                fraseActual
                            );


                            estado.innerText =
                                "🎙️ Detectando frase...";


                            // ==========================================
                            // FRASE ESPERADA
                            // ==========================================
                            if (!fraseVozBD) {

                                estado.innerText =
                                    "❌ No se encontró una frase de seguridad registrada.";

                                console.error(
                                    "FraseVoz no fue recibida desde la base de datos."
                                );

                                return;
                            }

                            const fraseEsperada =
                                normalizarTextoVoz(fraseVozBD);

                            console.log(
                                "================================="
                            );

                            console.log(
                                "Frase desde BD:",
                                fraseVozBD
                            );

                            console.log(
                                "Frase normalizada:",
                                fraseEsperada
                            );

                            console.log(
                                "================================="
                            );


                            // ==========================================
                            // ¿YA DETECTÓ LA FRASE?
                            // ==========================================

                            if (
                                fraseActual.includes(
                                    fraseEsperada
                                )
                            ) {

                                console.log(
                                    "✅ FRASE DETECTADA"
                                );


                                estado.innerText =
                                    "✅ Frase detectada. Verificando voz...";


                                detenerVerificacionVoz();


                            }

                        };


                    // ==========================================
                    // ERROR DEL RECONOCIMIENTO
                    // ==========================================

                    reconocimientoVoz.onerror =
                        function(event) {

                            console.error(
                                "Error reconocimiento:",
                                event.error
                            );


                            if (
                                event.error === "not-allowed" ||
                                event.error === "service-not-allowed"
                            ) {

                                estado.innerText =
                                    "❌ Debes permitir el acceso al micrófono.";

                                detenerGrabacionSinEnviar();

                                return;
                            }


                            if (
                                event.error === "no-speech"
                            ) {

                                console.log(
                                    "No se detectó voz todavía."
                                );

                                return;
                            }

                        };


                    // ==========================================
                    // SI CHROME TERMINA EL RECONOCIMIENTO
                    // ==========================================

                    reconocimientoVoz.onend =
                        function() {

                            console.log(
                                "Reconocimiento de voz finalizado."
                            );


                            // Si todavía estamos grabando
                            // y no hemos encontrado la frase,
                            // intentamos continuar.

                            if (
                                grabandoVerificacionVoz &&
                                !procesandoVoz
                            ) {

                                try {

                                    reconocimientoVoz.start();

                                }
                                catch (error) {

                                    console.log(
                                        "No se pudo reiniciar reconocimiento."
                                    );

                                }

                            }

                        };


                    // ==========================================
                    // ACCEDER AL MICRÓFONO
                    // ==========================================

                    const stream =
                        await navigator.mediaDevices.getUserMedia({
                            audio: true
                        });


                    // ==========================================
                    // CREAR GRABADOR
                    // ==========================================

                    mediaRecorderVerificacion =
                        new MediaRecorder(stream);


                    // ==========================================
                    // GUARDAR AUDIO
                    // ==========================================

                    mediaRecorderVerificacion.ondataavailable =
                        function(event) {

                            if (event.data.size > 0) {

                                audioChunksVerificacion.push(
                                    event.data
                                );

                            }

                        };


                        
                    mediaRecorderVerificacion.onstop =
                        async function() {

                            console.log(
                                "🎙️ Grabación terminada."
                            );

                            // ==========================================
                            // DETENER MICRÓFONO
                            // ==========================================

                            stream.getTracks()
                                .forEach(track => {
                                    track.stop();
                                });


                            // ==========================================
                            // DETENER RECONOCIMIENTO
                            // ==========================================

                            if (reconocimientoVoz) {

                                try {
                                    reconocimientoVoz.stop();
                                }
                                catch (error) {
                                    console.log(error);
                                }

                            }


                            // ==========================================
                            // CREAR AUDIO
                            // ==========================================

                            const audio =
                                new Blob(
                                    audioChunksVerificacion,
                                    {
                                        type: "audio/webm"
                                    }
                                );


                            console.log(
                                "🎙️ Audio creado:",
                                audio.size,
                                "bytes"
                            );


                            // ==========================================
                            // ENVIAR AL SERVIDOR
                            // ==========================================

                            estado.innerText =
                                "⏳ Procesando grabación...";


                            await enviarVerificacionVoz(
                                audio
                            );

                        };

       


                    // ==========================================
                    // INICIAR RECONOCIMIENTO
                    // ==========================================

                    reconocimientoVoz.start();


                    // ==========================================
                    // INICIAR GRABACIÓN
                    // ==========================================

                    mediaRecorderVerificacion.start();


                    grabandoVerificacionVoz = true;


                    boton.disabled = true;

                    boton.innerHTML =
                        "🎙️ Escuchando...";


                    estado.innerText =
                        "🔴 Di: Mi voz protege mi cuenta";


                    // ==========================================
                    // TIEMPO MÁXIMO
                    // ==========================================

                    temporizadorVoz =
