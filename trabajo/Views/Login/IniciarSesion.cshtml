@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Iniciar Sesión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/utilidades-ui.css" />
    <!-- ICONOS BOOTSTRAP -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+"
          crossorigin="anonymous" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
            integrity="sha384-3zSEDfvllQohrq0PHL1fOXJuC/jSOO34H46t6UQfobFOmxE5BpjjaIJY5F2/bMnU"
            crossorigin="anonymous"></script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100%;
            }

            body {
                min-height: 100vh;
                background: linear-gradient(135deg, #240046, #3c096c, #4361ee, #00b4d8);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                font-family: Arial, sans-serif;
            }

            .main-box {
                width: min(1250px, 100%);
                min-height: 760px;
                display: flex;
                background: #ffffff;
                border-radius: 28px;
                overflow: hidden;
                box-shadow: 0 25px 60px rgba(0, 0, 0, .35);
            }

            /* ==========================================
                                   PANEL IZQUIERDO
                                   ========================================== */

            .left-panel {
                width: 48%;
                background: linear-gradient(160deg, #4cc9f0, #4361ee, #7209b7);
                color: white;
                padding: 45px 35px;
                position: relative;
                overflow: hidden;
            }

                .left-panel::before {
                    content: "";
                    position: absolute;
                    width: 240px;
                    height: 240px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, .18);
                    bottom: -80px;
                    left: -80px;
                }

                .left-panel::after {
                    content: "";
                    position: absolute;
                    width: 170px;
                    height: 170px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, .13);
                    top: 70px;
                    right: -70px;
                }

            .logo {
                position: relative;
                z-index: 2;
                display: flex;
                align-items: center;
                width: 100%;
            }

            .logo-crediplus {
                width: 190px;
                max-width: 100%;
                height: auto;
                display: block;
                object-fit: contain;
                mix-blend-mode: multiply;
                filter: contrast(1.05);
            }

            .welcome {
                margin-top: 120px;
                position: relative;
                z-index: 2;
            }

                .welcome h1 {
                    font-size: 52px;
                    font-weight: bold;
                    margin-bottom: 12px;
                }

                .welcome p {
                    font-size: 20px;
                    opacity: .95;
                    line-height: 1.7;
                    margin-bottom: 0;
                }

            .credit-icon {
                font-size: 120px;
                line-height: 1;
                margin-top: 45px;
            }

            /* ==========================================
                                   PANEL DERECHO
                                   ========================================== */

            .right-panel {
                width: 52%;
                padding: 95px 80px;
                background: linear-gradient(135deg, #e0e7ff, #c7d2fe, #f3e8ff);
            }

                .right-panel h2 {
                    color: #4c1d95;
                    font-size: 42px;
                    font-weight: bold;
                    margin-bottom: 12px;
                }

            .subtitle {
                color: #64748b;
                margin-bottom: 35px;
                font-size: 18px;
            }

            .input-util-wrap {
                width: 100%;
            }

            .form-control {
                width: 100%;
                height: 60px;
                border: none;
                background: #eef2f7;
                border-radius: 12px;
                font-size: 18px;
                padding-left: 18px;
            }

                .form-control:focus {
                    box-shadow: 0 0 0 2px rgba(67, 97, 238, .25);
                    background: #ffffff;
                }

            .btn-login {
                width: 100%;
                height: 62px;
                border: none;
                border-radius: 18px;
                background: linear-gradient(135deg, #4361ee, #7209b7);
                color: white;
                font-size: 20px;
                font-weight: bold;
            }

                .btn-login:hover {
                    opacity: .9;
                    color: white;
                }

            .register-link {
                margin-top: 12px;
                text-align: center;
                font-size: 18px;
                font-weight: 500;
            }

                .register-link a {
                    color: #4f46e5;
                    font-weight: bold;
                    text-decoration: none;
                }

                    .register-link a:hover {
                        text-decoration: underline;
                    }

            .back-btn {
                display: block;
                width: 100%;
                margin-top: 30px;
                padding: 14px 25px;
                border-radius: 14px;
                background: linear-gradient(135deg, #6d28d9, #7c3aed);
                box-shadow: 0 8px 20px rgba(109, 40, 217, .35);
                color: white;
                text-align: center;
                text-decoration: none;
                font-weight: 700;
                transition: .3s;
            }

                .back-btn:hover {
                    background: linear-gradient(135deg, #5b21b6, #6d28d9);
                    color: white;
                    transform: translateY(-2px);
                }

            .btn-regresar {
                display: inline-block !important;
                margin-top: 20px !important;
                padding: 14px 28px !important;
                border-radius: 14px !important;
                background: linear-gradient(135deg, #6d28d9, #7c3aed) !important;
                box-shadow: 0 8px 20px rgba(109, 40, 217, .35);
                color: white !important;
                text-decoration: none !important;
                font-size: 18px !important;
                font-weight: 700 !important;
                transition: .3s;
            }

                .btn-regresar:hover {
                    background: linear-gradient(135deg, #5b21b6, #6d28d9) !important;
                    color: white !important;
                    transform: translateY(-3px);
                }

            /* ==========================================
                                   MODALES
                                   ========================================== */

            .modal-seguridad,
            .modal-crediplus,
            .modal-codigo-crediplus {
                border: none;
                border-radius: 24px;
                overflow: hidden;
                background: #ffffff;
                box-shadow: 0 25px 70px rgba(0, 0, 0, .30);
            }

                .modal-seguridad .modal-header,
                .modal-crediplus .modal-header {
                    padding: 28px 30px 15px;
                    border: none;
                }

                .modal-seguridad .modal-body,
                .modal-crediplus .modal-body {
                    padding: 20px 30px;
                }

                .modal-seguridad .modal-footer,
                .modal-crediplus .modal-footer {
                    padding: 10px 30px 25px;
                    border: none;
                }

            .icono-seguridad {
                width: 60px;
                height: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 15px;
                background: #e8f0ff;
                color: #2563eb;
                font-size: 28px;
            }

            .logo-modal-seguridad,
            .logo-modal-codigo {
                width: 62px;
                height: 62px;
                object-fit: contain;
                border-radius: 16px;
                padding: 7px;
                background: #eef2ff;
                box-shadow: 0 5px 15px rgba(67, 97, 238, .12);
            }

            .modal-crediplus .modal-title,
            .modal-seguridad .modal-title {
                color: #172554;
                font-size: 22px;
                font-weight: 800;
            }

            .texto-seguridad {
                margin-top: 5px;
                margin-bottom: 0;
                color: #64748b;
                font-size: 14px;
                line-height: 1.5;
            }

            .opcion-seguridad {
                display: flex;
                align-items: center;
                width: 100%;
                margin-bottom: 12px;
                padding: 16px;
                border: 2px solid #e2e8f0;
                border-radius: 16px;
                background: #ffffff;
                cursor: pointer;
                transition: all .2s ease;
            }

                .opcion-seguridad:hover {
                    border-color: #93c5fd;
                    background: #f8fbff;
                    transform: translateY(-1px);
                }

                .opcion-seguridad.seleccionada {
                    border-color: #2563eb;
                    background: #eff6ff;
                    box-shadow: 0 5px 15px rgba(37, 99, 235, .08);
                }

                .btn.grabando {
                    animation: pulsoGrabando 1.5s infinite;
                }

                @@keyframes pulsoGrabando {
                    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
                    70% { transform: scale(1.02); box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
                    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
                }

            .opcion-icono {
                width: 48px;
                height: 48px;
                min-width: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 14px;
                border-radius: 13px;
                font-size: 22px;
            }

                .opcion-icono.correo {
                    background: #dbeafe;
                    color: #2563eb;
                }

                .opcion-icono.aplicacion {
                    background: #ede9fe;
                    color: #7c3aed;
                }

                .opcion-icono.voz {
                    background: #dcfce7;
                    color: #16a34a;
                }

            .opcion-contenido {
                flex: 1;
                min-width: 0;
            }

                .opcion-contenido h5 {
                    margin: 0;
                    color: #1e293b;
                    font-size: 15px;
                    font-weight: 800;
                }

                .opcion-contenido p {
                    margin: 4px 0 0;
                    color: #64748b;
                    font-size: 12px;
                    line-height: 1.45;
                }

            .radio-seguridad {
                width: 22px;
                height: 22px;
                min-width: 22px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-left: 12px;
                border: 2px solid #cbd5e1;
                border-radius: 50%;
            }

                .radio-seguridad span {
                    width: 10px;
                    height: 10px;
                    display: block;
                    border-radius: 50%;
                }

            .opcion-seguridad.seleccionada .radio-seguridad {
                border-color: #2563eb;
            }

                .opcion-seguridad.seleccionada .radio-seguridad span {
                    background: #2563eb;
                }

            .titulo-opcion {
                display: flex;
                align-items: center;
                gap: 7px;
                flex-wrap: wrap;
            }

            .badge-proximamente {
                padding: 3px 7px;
                border-radius: 20px;
                background: #f1f5f9;
                color: #64748b;
                font-size: 9px;
                font-weight: 700;
            }

            .btn-continuar-seguridad {
                min-width: 125px;
                border: none;
                border-radius: 10px;
                background: linear-gradient(135deg, #2563eb, #4f46e5);
                font-weight: 700;
            }

                .btn-continuar-seguridad:hover {
                    background: linear-gradient(135deg, #1d4ed8, #4338ca);
                }

            #mensajeAplicacion {
                margin-bottom: 0;
                border-radius: 10px;
                font-size: 13px;
            }

            /* ==========================================
                                   MODAL CÓDIGO
                                   ========================================== */

            .icono-correo-grande {
                width: 75px;
                height: 75px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto;
                border-radius: 20px;
                background: #dbeafe;
                color: #2563eb;
                font-size: 34px;
            }

            .codigo-input {
                width: 100%;
                height: 65px;
                border: 2px solid #dbe4f0 !important;
                border-radius: 14px !important;
                background: #f8fafc !important;
                color: #1e3a8a;
                text-align: center;
                font-size: 27px !important;
                font-weight: 800;
                letter-spacing: 10px;
            }

                .codigo-input:focus {
                    border-color: #2563eb !important;
                    background: #ffffff !important;
                    box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
                }

            .contador-codigo {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                margin-top: 15px;
                color: #64748b;
                font-size: 14px;
            }

                .contador-codigo i,
                #tiempoCodigo {
                    color: #2563eb;
                }

            #tiempoCodigo {
                font-weight: 800;
            }

            .contador-expirado,
            .contador-expirado i {
                color: #dc2626 !important;
            }

            .btn-reenviar {
                padding: 5px 10px;
                border: none;
                border-radius: 8px;
                background: transparent;
                color: #2563eb;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s;
            }

                .btn-reenviar:hover:not(:disabled) {
                    background: #eff6ff;
                }

                .btn-reenviar:disabled {
                    color: #94a3b8;
                    cursor: not-allowed;
                }

            #mensajeCodigoLogin {
                border-radius: 10px;
                text-align: left;
                font-size: 13px;
            }

            /* ==========================================
                                   LAPTOP
                                   ========================================== */

            @@media (max-width: 1300px) {
                body {
                    padding: 25px;
                }

                .main-box {
                    max-width: 1100px;
                    min-height: 680px;
                }

                .left-panel {
                    padding: 35px 30px;
                }

                .right-panel {
                    padding: 70px 55px;
                }

                .welcome {
                    margin-top: 90px;
                }

                    .welcome h1 {
                        font-size: 46px;
                    }

                    .welcome p {
                        font-size: 18px;
                    }
            }
        /* ==========================================
           FILTRO CREDIPLUS AUTHENTICATOR
           ========================================== */

        .modal-auth-filtro {
            border: none;
            border-radius: 26px;
            overflow: hidden;
            box-shadow: 0 25px 70px rgba(15, 23, 42, .30);
        }

            .modal-auth-filtro .modal-header {
                padding: 28px 30px 16px;
            }

            .modal-auth-filtro .modal-body {
                padding: 15px 30px 25px;
            }

        .auth-shield {
            width: 54px;
            height: 54px;
            min-width: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: linear-gradient(135deg, #dbeafe, #ede9fe);
            color: #4f46e5;
            font-size: 25px;
        }

        .auth-titulo {
            margin: 0;
            color: #172554;
            font-size: 22px;
            font-weight: 800;
        }

        .auth-subtitulo {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 13px;
        }

        .auth-pasos {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            margin: 5px 0 28px;
        }

        .auth-paso {
            min-width: 85px;
            text-align: center;
            color: #94a3b8;
        }

            .auth-paso span {
                width: 34px;
                height: 34px;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #e2e8f0;
                font-weight: 800;
            }

            .auth-paso small {
                display: block;
                margin-top: 6px;
                font-weight: 700;
            }

            .auth-paso.activo {
                color: #2563eb;
            }

                .auth-paso.activo span {
                    background: #2563eb;
                    color: white;
                    box-shadow: 0 5px 15px rgba(37, 99, 235, .25);
                }

        .auth-linea {
            width: 100px;
            height: 3px;
            margin-top: 16px;
            background: #e2e8f0;
        }

        .auth-info-box {
            display: flex;
            gap: 13px;
            padding: 16px;
            border: 1px solid #dbeafe;
            border-radius: 16px;
            background: #f8fbff;
            color: #1e3a8a;
        }

            .auth-info-box > i {
                margin-top: 2px;
                color: #2563eb;
                font-size: 21px;
            }

            .auth-info-box p {
                margin: 5px 0 0;
                color: #64748b;
                font-size: 13px;
                line-height: 1.5;
            }

        .auth-texto {
            margin-top: 20px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.6;
        }

        .auth-correo-box {
            display: flex;
            align-items: center;
            gap: 13px;
            margin-top: 12px;
            padding: 15px;
            border: 2px solid #e2e8f0;
            border-radius: 16px;
        }

        .auth-correo-icon {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 19px;
        }

        .auth-correo-box > div:nth-child(2) {
            flex: 1;
        }

        .auth-correo-box small {
            display: block;
            color: #64748b;
            font-size: 11px;
        }

        .auth-correo-box strong {
            display: block;
            margin-top: 2px;
            color: #172554;
            font-size: 14px;
        }

        .auth-check {
            color: #22c55e;
            font-size: 20px;
        }

        .auth-seguridad-nota {
            display: flex;
            gap: 9px;
            margin-top: 15px;
            padding: 12px 14px;
            border-radius: 12px;
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            line-height: 1.5;
        }

            .auth-seguridad-nota i {
                color: #2563eb;
            }

        .auth-codigo-icon {
            width: 68px;
            height: 68px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 30px;
        }

        .codigo-authenticator {
            height: 64px;
            border: 2px solid #dbe4f0 !important;
            border-radius: 14px !important;
            background: #f8fafc !important;
            text-align: center;
            font-size: 27px !important;
            font-weight: 800;
            letter-spacing: 9px;
            color: #1e3a8a;
        }

            .codigo-authenticator:focus {
                border-color: #2563eb !important;
                background: white !important;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
            }

        .auth-contador {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 7px;
            color: #64748b;
            font-size: 13px;
        }

            .auth-contador i,
            .auth-contador strong {
                color: #2563eb;
            }

        .auth-footer {
            padding: 5px 30px 25px;
        }

        .auth-btn-principal {
            border: none;
            border-radius: 11px;
            padding: 10px 18px;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            font-weight: 700;
        }

            /* ==========================================
                                   TABLET
                                   ========================================== */

            @@media (max-width: 900px) {

                body {
                    align-items: flex-start;
                    padding: 20px 14px;
                }

                .main-box {
                    width: 100%;
                    max-width: 700px;
                    min-height: auto;
                    height: auto;
                    flex-direction: column;
                    border-radius: 22px;
                    overflow: hidden;
                }

                .left-panel,
                .right-panel {
                    width: 100%;
                }
                /* ================================
                               PANEL SUPERIOR
                               ================================ */

                .left-panel {
                    min-height: auto;
                    height: auto;
                    padding: 30px;
                }

                .logo-crediplus {
                    width: 160px;
                    max-width: 100%;
                    height: auto;
                }

                .welcome {
                    margin-top: 35px;
                }

                    .welcome h1 {
                        font-size: 38px;
                        line-height: 1.2;
                        margin-bottom: 10px;
                    }

                    .welcome p {
                        font-size: 17px;
                        line-height: 1.5;
                        margin-bottom: 0;
                    }

                .credit-icon {
                    font-size: 75px;
                    line-height: 1;
                    margin-top: 20px;
                    margin-bottom: 0;
                }
                /* ================================
                               PANEL DEL FORMULARIO
                               ================================ */

                .right-panel {
                    min-height: auto;
                    height: auto;
                    padding: 50px 45px;
                }

                    .right-panel h2 {
                        font-size: 36px;
                        line-height: 1.2;
                        margin-bottom: 8px;
                    }

                .subtitle {
                    font-size: 17px;
                    margin-bottom: 28px;
                }
                /* ================================
                               FORMULARIO
                               ================================ */

                .right-panel form {
                    width: 100%;
                    margin-bottom: 0;
                }

                    .right-panel form > *:last-child {
                        margin-bottom: 0 !important;
                    }

                input,
                .form-control {
                    width: 100%;
                    max-width: 100%;
                    box-sizing: border-box;
                }

                .form-control {
                    height: 58px;
                    font-size: 17px;
                }

                .btn-login {
                    width: 100%;
                    height: 58px;
                    font-size: 18px;
                }

                .register-link {
                    font-size: 17px;
                }

                .back-btn {
                    width: 100%;
                    text-align: center;
                    margin-bottom: 0;
                }
                /* ================================
                               MODALES TABLET
                               ================================ */

                .modal-dialog {
                    max-width: 560px;
                    margin-left: auto;
                    margin-right: auto;
                }

                .modal-content {
                    max-width: 100%;
                }

                .modal-crediplus .modal-header,
                .modal-crediplus .modal-body,
                .modal-crediplus .modal-footer,
                .modal-seguridad .modal-header,
                .modal-seguridad .modal-body,
                .modal-seguridad .modal-footer {
                    padding-left: 24px;
                    padding-right: 24px;
                }

                .opcion-seguridad {
                    width: 100%;
                }

                .codigo-input {
                    width: 100%;
                    max-width: 100%;
                    box-sizing: border-box;
                }
            }

            /* ==========================================
                                   CELULARES PEQUEÑOS
                                   ========================================== */

            @@media (max-width: 400px) {
                .left-panel {
                    padding: 18px;
                }

                .logo-crediplus {
                    width: 120px;
                }

                .welcome {
                    margin-top: 10px;
                }

                    .welcome h1 {
                        font-size: 28px;
                    }

                    .welcome p {
                        font-size: 14px;
                    }

                .credit-icon {
                    margin-top: 8px;
                    font-size: 42px;
                }

                .right-panel {
                    padding: 27px 18px 24px;
                }

                    .right-panel h2 {
                        font-size: 29px;
                    }

                .subtitle {
                    margin-bottom: 20px;
                    font-size: 14px;
                }

                .form-control {
