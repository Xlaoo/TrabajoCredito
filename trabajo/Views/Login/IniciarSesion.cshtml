                    boton.disabled = true;

                    // ==========================================
                    // DESPUÉS DE REGISTRAR VOZ
                    // VOLVER A MOSTRAR OPCIONES
                    // ==========================================

                    setTimeout(function() {

                        const bloqueRegistroVoz =
                            document.getElementById(
                                "bloqueRegistroVoz"
                            );

                        const opcionCorreo =
                            document.getElementById(
                                "opcionCorreo"
                            );

                        const opcionAplicacion =
                            document.getElementById(
                                "opcionAplicacion"
                            );
                        const opcionVoz =
