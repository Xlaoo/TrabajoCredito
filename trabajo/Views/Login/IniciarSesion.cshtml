@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Iniciar Sesión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/utilidades-ui.css" />
    <!-- ICONOS BOOTSTRAP -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #240046, #3c096c, #4361ee, #00b4d8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .main-box {
            width: 1250px;
            min-height: 760px;
            display: flex;
            background: white;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,.35);
        }

        .left-panel {
            width: 48%;
            background: linear-gradient(160deg, #4cc9f0, #4361ee, #7209b7);
            color: white;
            padding: 45px 35px;
            position: relative;
            overflow: hidden;
        }

            .left-panel::before {
                content: "";
                position: absolute;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(255,255,255,.18);
                bottom: -80px;
                left: -80px;
            }

            .left-panel::after {
                content: "";
                position: absolute;
                width: 170px;
                height: 170px;
                border-radius: 50%;
                background: rgba(255,255,255,.13);
                top: 70px;
                right: -70px;
            }

        .logo {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .logo-crediplus {
            width: 190px;
            height: auto;
            display: block;
            object-fit: contain;
            mix-blend-mode: multiply;
            filter: contrast(1.05);
        }

        .welcome {
            margin-top: 120px;
            position: relative;
            z-index: 2;
        }

            .welcome h1 {
                font-size: 52px;
                font-weight: bold;
            }

            .welcome p {
                font-size: 20px;
                opacity: .95;
                line-height: 1.7;
            }

        .credit-icon {
            font-size: 120px;
            margin-top: 45px;
        }

        .right-panel {
            width: 52%;
            padding: 95px 80px;
            background: linear-gradient(135deg, #e0e7ff, #c7d2fe, #f3e8ff);
        }

            .right-panel h2 {
                color: #4c1d95;
                font-size: 42px;
                font-weight: bold;
                margin-bottom: 12px;
            }

        .subtitle {
            color: #64748b;
            margin-bottom: 35px;
            font-size: 18px;
        }

        .form-control {
            height: 60px;
            border: none;
            background: #eef2f7;
            border-radius: 12px;
            font-size: 18px;
            padding-left: 18px;
        }

            .form-control:focus {
                box-shadow: 0 0 0 2px rgba(67, 97, 238, .25);
                background: #fff;
            }

        .btn-login {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border: none;
            color: white;
            font-weight: bold;
            height: 62px;
            border-radius: 18px;
            font-size: 20px;
        }

            .btn-login:hover {
                opacity: .9;
                color: white;
            }

        .register-link {
            text-align: center;
            font-size: 18px;
            margin-top: 12px;
            font-weight: 500;
        }

            .register-link a {
                color: #4f46e5;
                font-weight: bold;
                text-decoration: none;
            }

                .register-link a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 900px) {
            .main-box {
                width: 95%;
                flex-direction: column;
            }

            .left-panel, .right-panel {
                width: 100%;
            }

            .welcome {
                margin-top: 40px;
            }
        }

        .back-btn {
            display: inline-block;
            margin-top: 30px;
            padding: 14px 25px;
            background: linear-gradient(135deg,#6d28d9,#7c3aed);
            color: white;
            text-decoration: none;
            border-radius: 14px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(109,40,217,.35);
            transition: .3s;
        }

            .back-btn:hover {
                background: linear-gradient(135deg,#5b21b6,#6d28d9);
                color: white;
                transform: translateY(-3px);
            }

        .btn-regresar {
            display: inline-block !important;
            background: linear-gradient(135deg,#6d28d9,#7c3aed) !important;
            color: white !important;
            text-decoration: none !important;
            padding: 14px 28px !important;
            border-radius: 14px !important;
            font-size: 18px !important;
            font-weight: 700 !important;
            margin-top: 20px !important;
            box-shadow: 0 8px 20px rgba(109,40,217,.35);
            transition: .3s;
        }

            .btn-regresar:hover {
                background: linear-gradient(135deg,#5b21b6,#6d28d9) !important;
                color: white !important;
                transform: translateY(-3px);
            }
        /* ==========================================
           MODAL DE VERIFICACIÓN DE SEGURIDAD
           ========================================== */

        .modal-seguridad {
            border: none;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
        }

            .modal-seguridad .modal-header {
                padding: 30px 30px 10px 30px;
            }

            .modal-seguridad .modal-body {
                padding: 20px 30px;
            }

            .modal-seguridad .modal-footer {
                padding: 10px 30px 25px 30px;
            }


        /* ICONO PRINCIPAL */

        .icono-seguridad {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            background: #e8f0ff;
            color: #2563eb;
            font-size: 28px;
        }


        /* TITULO */

        .modal-seguridad .modal-title {
            font-weight: 700;
            color: #1e293b;
        }

        .texto-seguridad {
            color: #64748b;
            margin-top: 6px;
            margin-bottom: 0;
            font-size: 14px;
        }


        /* OPCIONES */

        .opcion-seguridad {
            display: flex;
            align-items: center;
            width: 100%;
            padding: 18px;
            margin-bottom: 12px;
            border: 2px solid #e2e8f0;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.2s ease;
            background: #ffffff;
        }

            .opcion-seguridad:hover {
                border-color: #93c5fd;
                background: #f8fbff;
            }

            .opcion-seguridad.seleccionada {
                border-color: #2563eb;
                background: #eff6ff;
            }


        /* ICONOS DE OPCIONES */

        .opcion-icono {
            width: 48px;
            height: 48px;
            min-width: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 21px;
            margin-right: 14px;
        }

            .opcion-icono.correo {
                background: #dbeafe;
                color: #2563eb;
            }

            .opcion-icono.aplicacion {
                background: #ede9fe;
                color: #7c3aed;
            }

            .opcion-icono.voz {
                background: #dcfce7;
                color: #16a34a;
            }

        /* CONTENIDO */

        .opcion-contenido {
            flex: 1;
        }

            .opcion-contenido h5 {
                margin: 0;
                font-size: 16px;
                font-weight: 700;
                color: #1e293b;
            }

            .opcion-contenido p {
                margin: 5px 0 0;
                font-size: 13px;
                line-height: 1.4;
                color: #64748b;
            }


        /* RADIO */

        .radio-seguridad {
            width: 22px;
            height: 22px;
            border: 2px solid #cbd5e1;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 12px;
        }

            .radio-seguridad span {
                width: 11px;
                height: 11px;
                border-radius: 50%;
                display: block;
            }

        .opcion-seguridad.seleccionada .radio-seguridad {
            border-color: #2563eb;
        }

            .opcion-seguridad.seleccionada .radio-seguridad span {
                background: #2563eb;
            }


        /* TITULO + BADGE */

        .titulo-opcion {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .badge-proximamente {
            background: #f1f5f9;
            color: #64748b;
            font-size: 10px;
            padding: 3px 8px;
            border-radius: 20px;
            font-weight: 600;
        }


        /* BOTON */

        .btn-continuar-seguridad {
            min-width: 130px;
            border-radius: 10px;
            font-weight: 600;
        }


        /* ALERTA */

        #mensajeAplicacion {
            font-size: 13px;
            border-radius: 10px;
            margin-bottom: 0;
        }
        /* =========================================================
           MODAL CREDIPLUS - VERIFICACIÓN
           ========================================================= */

        .modal-crediplus {
            border: none;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 25px 70px rgba(0, 0, 0, .30);
            background: #ffffff;
        }

            /* CABECERA */

            .modal-crediplus .modal-header {
                padding: 28px 30px 15px 30px;
                border: none;
            }

        .logo-modal-seguridad {
            width: 62px;
            height: 62px;
            object-fit: contain;
            border-radius: 16px;
            padding: 7px;
            background: #eef2ff;
            box-shadow: 0 5px 15px rgba(67, 97, 238, .12);
        }

        .modal-crediplus .modal-title {
            color: #172554;
            font-size: 22px;
            font-weight: 800;
        }

        .texto-seguridad {
            color: #64748b;
            font-size: 14px;
            line-height: 1.5;
            margin-top: 5px;
        }

        /* OPCIONES */

        .opcion-seguridad {
            display: flex;
            align-items: center;
            width: 100%;
            padding: 16px;
            margin-bottom: 12px;
            border: 2px solid #e2e8f0;
            border-radius: 16px;
            cursor: pointer;
            transition: all .2s ease;
            background: #ffffff;
        }

            .opcion-seguridad:hover {
                border-color: #93c5fd;
                background: #f8fbff;
                transform: translateY(-1px);
            }

            .opcion-seguridad.seleccionada {
                border-color: #2563eb;
                background: #eff6ff;
                box-shadow: 0 5px 15px rgba(37, 99, 235, .08);
            }

        /* ICONOS DE LAS OPCIONES */

        .opcion-icono {
            width: 48px;
            height: 48px;
            min-width: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            font-size: 22px;
            margin-right: 14px;
        }

            .opcion-icono.correo {
                background: #dbeafe;
                color: #2563eb;
            }

            .opcion-icono.aplicacion {
                background: #ede9fe;
                color: #7c3aed;
            }

        /* CONTENIDO */

        .opcion-contenido {
            flex: 1;
        }

            .opcion-contenido h5 {
                margin: 0;
                color: #1e293b;
                font-size: 15px;
                font-weight: 800;
            }

            .opcion-contenido p {
                margin: 4px 0 0;
                color: #64748b;
                font-size: 12px;
                line-height: 1.45;
            }

        /* RADIO */

        .radio-seguridad {
            width: 22px;
            height: 22px;
            min-width: 22px;
            border: 2px solid #cbd5e1;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 12px;
        }

            .radio-seguridad span {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                display: block;
            }

        .opcion-seguridad.seleccionada .radio-seguridad {
            border-color: #2563eb;
        }

            .opcion-seguridad.seleccionada .radio-seguridad span {
                background: #2563eb;
            }

        /* BADGE */

        .badge-proximamente {
            background: #f1f5f9;
            color: #64748b;
            font-size: 9px;
            padding: 3px 7px;
            border-radius: 20px;
            font-weight: 700;
        }

        .titulo-opcion {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        /* BOTONES */

        .btn-continuar-seguridad {
            min-width: 125px;
            border-radius: 10px;
            font-weight: 700;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            border: none;
        }

            .btn-continuar-seguridad:hover {
                background: linear-gradient(135deg, #1d4ed8, #4338ca);
            }

        /* =========================================================
           MODAL CÓDIGO
           ========================================================= */

        .modal-codigo-crediplus {
            border: none;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 25px 70px rgba(0, 0, 0, .30);
        }

        .logo-modal-codigo {
            width: 62px;
            height: 62px;
            object-fit: contain;
            border-radius: 16px;
            padding: 7px;
            background: #eef2ff;
        }

        /* ICONO CENTRAL */

        .icono-correo-grande {
            width: 75px;
            height: 75px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 34px;
        }

        /* INPUT CÓDIGO */

        .codigo-input {
            height: 65px;
            border: 2px solid #dbe4f0 !important;
            border-radius: 14px !important;
            background: #f8fafc !important;
            font-size: 27px !important;
            letter-spacing: 10px;
            font-weight: 800;
            color: #1e3a8a;
            text-align: center;
        }

            .codigo-input:focus {
                background: #ffffff !important;
                border-color: #2563eb !important;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
            }

        /* CONTADOR */

        .contador-codigo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin-top: 15px;
            color: #64748b;
            font-size: 14px;
        }

            .contador-codigo i {
                color: #2563eb;
            }

        #tiempoCodigo {
            font-weight: 800;
            color: #2563eb;
        }

        /* CUANDO EXPIRA */

        .contador-expirado {
            color: #dc2626 !important;
        }

            .contador-expirado i {
                color: #dc2626 !important;
            }

        /* REENVIAR */

        .btn-reenviar {
            border: none;
            background: transparent;
            color: #2563eb;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 8px;
            transition: .2s;
        }

            .btn-reenviar:hover:not(:disabled) {
                background: #eff6ff;
            }

            .btn-reenviar:disabled {
                color: #94a3b8;
                cursor: not-allowed;
            }

        /* ALERTA */

        #mensajeCodigoLogin {
            border-radius: 10px;
            font-size: 13px;
            text-align: left;
        }

        /* RESPONSIVE */

        @@media (max-width: 600px) {

            .modal-dialog {
                margin: 12px;
            }

            .modal-crediplus .modal-header,
            .modal-crediplus .modal-body,
            .modal-crediplus .modal-footer {
                padding-left: 20px;
                padding-right: 20px;
            }

            .opcion-seguridad {
                padding: 13px;
            }
        }
        </style>
</head>

<body>
    <div class="main-box">

        <div class="left-panel">
            <div class="logo">
                <img src="~/imagenes/credi.png"
                     alt="CrediPlus"
                     class="logo-crediplus" />
            </div>

            <div class="welcome">
                <h1>Bienvenido</h1>
                <p>
                    Ingresa con tu DNI para gestionar tus solicitudes de crédito
                    de forma rápida y segura.
                </p>

                <div class="credit-icon">💰</div>
            </div>
        </div>

        <div class="right-panel">
            <h2>Iniciar Sesión</h2>
            <p class="subtitle">Accede a tu cuenta de créditos</p>
            @if (!string.IsNullOrEmpty(ViewBag.MensajeRegistro))
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @ViewBag.MensajeRegistro

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }

            

            

            <form asp-controller="Login"
                  asp-action="IniciarSesion"
                  method="post"
                  id="formLogin">

                <div class="input-util-wrap mb-3">
                    <input id="dniInput"
                           class="form-control"
                           type="text"
                           placeholder="DNI"
                           required
                           name="dni"
                           maxlength="8"
                           oninput="this.value=this.value.replace(/[^0-9]/g,'')" />

                    <button type="button"
                            class="btn-clear"
                            onclick="clearInput('dniInput')">
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-3">
                    <input id="claveInput"
                           class="form-control"
                           type="password"
                           placeholder="Contraseña"
                           required
                           name="clave" />

                    <button type="button" class="btn-clear" onclick="clearInput('claveInput')">
                        ✕
                    </button>

                    <button type="button" class="btn-eye" onclick="togglePassword('claveInput', this)">
                        👁
                    </button>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-login" type="submit">Iniciar Sesión</button>
                </div>
                <div id="mensajeLogin"
                     class="alert alert-danger mt-3"
                     style="display:none;">
                </div>
                @if (ViewData["Mensaje"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewData["Mensaje"]
                    </div>
                }

                <div class="register-link mb-2">
                    <a href="@Url.Action("OlvideContrasena", "Login")">¿Olvidaste tu contraseña?</a>
                </div>

                <div class="register-link">
                    ¿No tienes una cuenta?
                    <a href="@Url.Action("Registro", "Login")">Regístrate</a>
                </div>
                <a href="@Url.Action("PantallaPrincipal", "Login")" class="back-btn">
                    ← Regresar
                </a>

            </form>
        </div>
    </div>
    <!-- MODAL DE VERIFICACIÓN DE SEGURIDAD -->
    <div class="modal fade" id="modalVerificacionSeguridad" tabindex="-1"
         aria-labelledby="modalVerificacionSeguridadLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-crediplus">

                <div class="modal-header border-0">
                    <div>
                        <img src="~/imagenes/icon.png"
                             alt="CrediPlus"
                             class="logo-modal-seguridad" />

                        <h4 class="modal-title mt-3" id="modalVerificacionSeguridadLabel">
                            Verificación de seguridad
                        </h4>

                        <p class="texto-seguridad">
                            Para continuar, selecciona cómo deseas recibir tu código de seguridad.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <!-- REGISTRO DE VOZ OBLIGATORIO -->

                    <div id="bloqueRegistroVoz"
                         style="display:none;">

                        <div class="text-center mb-3">

                            <div class="icono-seguridad mx-auto mb-3"
                                 style="background:#ede9fe;color:#7c3aed;">

                                <i class="bi bi-mic-fill"></i>

                            </div>

                            <h5 style="font-weight:800;color:#1e293b;">
                                Registro de voz obligatorio
                            </h5>

                            <p style="color:#64748b;font-size:14px;">
                                No tienes registrada una voz de seguridad.
                                Debes realizar una grabación para continuar.
                            </p>

                        </div>

                        <div class="seguridad-voz-box">

                            <p style="font-weight:700;color:#3c096c;">
                                🎙️ HABLA:
                            </p>

                            <div class="alert alert-light text-center">
                                <strong id="fraseVozMostrarLogin">
                                    Tu frase de seguridad
                                </strong>
                            </div>

                            <button type="button"
                                    id="btnGrabarVozLogin"
                                    class="btn btn-primary w-100"
                                    onclick="grabarVozLogin()">

                                🎙️ Grabar mi voz

                            </button>

                            <div id="estadoVozLogin"
                                 class="text-center mt-3"
                                 style="font-size:13px;color:#64748b;">

                                ⚪ Aún no has grabado tu voz

                            </div>

                        </div>

                    </div>
                    <!-- VERIFICACIÓN DE VOZ -->

                    <div id="bloqueVerificacionVoz"
                         style="display:none;">

                        <div class="text-center mb-3">

                            <div class="icono-seguridad mx-auto mb-3"
                                 style="background:#dcfce7;color:#16a34a;">

                                <i class="bi bi-mic-fill"></i>

                            </div>

                            <h5 style="font-weight:800;color:#1e293b;">
                                Verificación por voz
                            </h5>

                            <p style="color:#64748b;font-size:14px;">
                                Di tu frase de seguridad para verificar tu identidad.
                            </p>

                        </div>

                        <div class="seguridad-voz-box">

                            <p style="font-weight:700;color:#3c096c;">
                                🎙️ HABLA:
                            </p>

                            <div class="alert alert-light text-center">
                                <strong>Di tu palabra clave</strong>
                            </div>

                            <button type="button"
                                    id="btnVerificarVoz"
                                    class="btn btn-success w-100"
                                    onclick="iniciarVerificacionVoz()">

                                🎙️ Hablar palabra clave

                            </button>

                            <div id="estadoVerificacionVoz"
                                 class="text-center mt-3"
                                 style="font-size:13px;color:#64748b;">

                                ⚪ Aún no has realizado la verificación

                            </div>

                        </div>

                    </div>
                    <!-- OPCIÓN CORREO -->
                    <div class="opcion-seguridad seleccionada"
                         id="opcionCorreo"
                         onclick="seleccionarMetodo('correo')">

                        <div class="opcion-icono correo">
