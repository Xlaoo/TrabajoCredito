            // ==========================================
            // REGISTRO DE VOZ DESDE LOGIN
            // ==========================================

            let mediaRecorderLogin = null;
            let audioChunksLogin = [];
            let audioBlobLogin = null;
            let grabandoVozLogin = false;

            // ==========================================
            // RECONOCIMIENTO PARA REGISTRAR NUEVA VOZ
            // ==========================================

            let reconocimientoRegistroVozLogin = null;
            let fraseRegistroVozLogin = "";
            let finalizandoRegistroVozLogin = false;

            async function grabarVozLogin() {

                const boton =
                    document.getElementById(
                        "btnGrabarVozLogin"
                    );

                const estado =
                    document.getElementById(
                        "estadoVozLogin"
                    );


                // ==========================================
                // EVITAR DOBLE GRABACIÓN
                // ==========================================

                if (
                    grabandoVozLogin ||
                    finalizandoRegistroVozLogin
                ) {
                    return;
                }


                // ==========================================
                // COMPROBAR RECONOCIMIENTO DE VOZ
                // ==========================================

                const SpeechRecognition =
                    window.SpeechRecognition ||
                    window.webkitSpeechRecognition;

                if (!SpeechRecognition) {

                    estado.innerText =
                        "❌ Tu navegador no permite reconocer voz. Utiliza Google Chrome o Microsoft Edge.";

                    return;
                }


                // ==========================================
                // COMPROBAR MICRÓFONO
                // ==========================================

                if (
                    !navigator.mediaDevices ||
                    !navigator.mediaDevices.getUserMedia
                ) {

                    estado.innerText =
                        "❌ Tu navegador no permite utilizar el micrófono.";

                    return;
                }


                try {

                    // ==========================================
                    // PEDIR MICRÓFONO
                    // ==========================================

                    const stream =
                        await navigator.mediaDevices
                            .getUserMedia({
                                audio: true
                            });


                    // ==========================================
                    // REINICIAR TODO
                    // ==========================================

                    audioChunksLogin = [];
                    audioBlobLogin = null;

                    fraseRegistroVozLogin = "";

                    finalizandoRegistroVozLogin =
                        false;


                    // ==========================================
                    // CREAR MEDIA RECORDER
                    // ==========================================

                    mediaRecorderLogin =
                        new MediaRecorder(stream);


                    mediaRecorderLogin.ondataavailable =
                        function(event) {

                            if (event.data.size > 0) {

                                audioChunksLogin.push(
                                    event.data
                                );
                            }
                        };


                    // ==========================================
                    // CUANDO TERMINA EL AUDIO
                    // ==========================================

                    mediaRecorderLogin.onstop =
                        function() {

                            audioBlobLogin =
                                new Blob(
                                    audioChunksLogin,
                                    {
                                        type: "audio/webm"
                                    }
                                );


                            // Liberar micrófono

                            stream
                                .getTracks()
                                .forEach(track => {
                                    track.stop();
                                });


                            grabandoVozLogin = false;

                            boton.disabled = false;

                            boton.classList.remove(
                                "grabando"
                            );

                            boton.innerHTML =
                                "🎙️ Grabar nuevamente";


                            // ==========================================
                            // TODAVÍA NO ENVIAMOS NADA
                            // MOSTRAR CONFIRMACIÓN
                            // ==========================================

                            mostrarConfirmacionRegistroVozLogin();
                        };


                    // ==========================================
                    // CREAR RECONOCIMIENTO
                    // ==========================================

                    reconocimientoRegistroVozLogin =
                        new SpeechRecognition();

                    reconocimientoRegistroVozLogin.lang =
                        "es-PE";

                    reconocimientoRegistroVozLogin.continuous =
                        true;

                    reconocimientoRegistroVozLogin.interimResults =
                        false;


                    // ==========================================
                    // CUANDO ESCUCHA ALGO
                    // ==========================================

                    reconocimientoRegistroVozLogin.onresult =
                        function(event) {

                            let textoFinal = "";

                            for (
                                let i = event.resultIndex;
                                i < event.results.length;
                                i++
                            ) {

                                if (event.results[i].isFinal) {

                                    textoFinal +=
                                        event.results[i][0]
                                            .transcript
                                            .trim() +
                                        " ";
                                }
                            }


                            textoFinal =
                                textoFinal.trim();


                            // Si todavía no reconoció palabras,
                            // seguimos esperando.

                            if (textoFinal === "") {
                                return;
                            }


                            fraseRegistroVozLogin =
                                textoFinal;


                            console.log(
                                "🎙️ Frase detectada:",
                                fraseRegistroVozLogin
                            );


                            estado.innerText =
                                "🟢 Voz detectada. Preparando confirmación...";


                            // ==========================================
                            // DETENER AUTOMÁTICAMENTE
                            // ==========================================

                            finalizarRegistroVozLogin();
                        };


                    // ==========================================
                    // ERRORES DEL RECONOCIMIENTO
                    // ==========================================

                    reconocimientoRegistroVozLogin.onerror =
                        function(event) {

                            console.log(
                                "Reconocimiento:",
                                event.error
                            );


                            // Si todavía no habló,
                            // NO cancelamos la grabación.

                            if (
                                event.error === "no-speech" ||
                                event.error === "aborted"
                            ) {
                                return;
                            }


                            if (
                                event.error === "not-allowed" ||
                                event.error ===
                                "service-not-allowed"
                            ) {

                                estado.innerText =
                                    "❌ Debes permitir el uso del micrófono.";

                                cancelarRegistroVozLogin();

                                return;
                            }
                        };


                    // ==========================================
                    // COMENZAR GRABACIÓN
                    // ==========================================

                    mediaRecorderLogin.start();

                    grabandoVozLogin = true;


                    boton.disabled = true;

                    boton.classList.add(
                        "grabando"
                    );

                    boton.innerHTML =
                        "🎙️ Escuchando...";


                    estado.innerText =
                        "🟡 Esperando tu voz... Habla cuando estés listo.";


                    // ==========================================
                    // COMENZAR RECONOCIMIENTO
                    // ==========================================

                    try {

                        reconocimientoRegistroVozLogin
                            .start();

                    }
                    catch (error) {

                        console.log(
                            "Reconocimiento ya iniciado:",
                            error
                        );
                    }

                }
                catch (error) {

                    console.error(error);

                    grabandoVozLogin = false;

                    boton.disabled = false;

                    boton.innerHTML =
                        "🎙️ Grabar mi voz";

                    estado.innerText =
                        "❌ No se pudo acceder al micrófono. Verifica los permisos.";
                }
            }
            function finalizarRegistroVozLogin() {

                if (finalizandoRegistroVozLogin) {
                    return;
                }

                if (!grabandoVozLogin) {
                    return;
                }


                finalizandoRegistroVozLogin = true;


                const estado =
                    document.getElementById(
                        "estadoVozLogin"
                    );


                estado.innerText =
                    "🟢 Voz detectada. Procesando...";


                // ==========================================
                // DETENER RECONOCIMIENTO
                // ==========================================

                if (reconocimientoRegistroVozLogin) {

                    try {

                        reconocimientoRegistroVozLogin
                            .stop();

                    }
                    catch (error) {

                        console.log(error);
                    }
                }


                // ==========================================
                // DETENER AUDIO
                // ==========================================

                if (
                    mediaRecorderLogin &&
                    mediaRecorderLogin.state !==
                    "inactive"
                ) {

                    mediaRecorderLogin.stop();
                }
            }
            function mostrarConfirmacionRegistroVozLogin() {

                const estado =
                    document.getElementById(
