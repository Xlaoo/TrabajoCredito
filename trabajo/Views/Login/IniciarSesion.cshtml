                min-width: 110px;
                padding: 10px 13px;
            }
        }
        /* ==========================================
           PASO 2 - DOS FORMAS DE ABRIR EL APK
           ========================================== */

        .guia-dos-imagenes {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .guia-opcion-imagen {
            position: relative;
            padding-top: 14px;
            text-align: center;
        }

        .guia-opcion-etiqueta {
            position: absolute;
            top: 0;
            left: 50%;
            z-index: 2;
            transform: translateX(-50%);
            padding: 5px 13px;
            border-radius: 20px;
            background: #2563eb;
            color: #ffffff;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .4px;
        }

        .guia-imagen-box-doble {
            min-height: 320px;
        }

            .guia-imagen-box-doble .guia-imagen-paso {
                max-height: 390px;
            }

        .guia-opcion-texto {
            max-width: 300px;
            margin: 10px auto 0;
            color: #64748b;
            font-size: 11px;
            line-height: 1.45;
        }


        /* CELULAR */

        @@media (max-width: 650px) {

            .guia-dos-imagenes {
                grid-template-columns: 1fr;
            }

            .guia-imagen-box-doble {
                min-height: 250px;
            }

                .guia-imagen-box-doble .guia-imagen-paso {
                    max-height: 320px;
                }
        }
        /* ==========================================
           CONFIGURACIÓN TOTP AUTHENTICATOR
           ========================================== */

        .modal-totp-auth {
            border: none;
            border-radius: 26px;
            overflow: hidden;
            background: #ffffff;
            box-shadow: 0 30px 80px rgba(15, 23, 42, .30);
        }

        .totp-header {
            padding: 22px 26px;
            border: none;
            background: linear-gradient( 135deg, #eff6ff, #eef2ff, #f5f3ff );
        }

        .totp-icono {
            width: 54px;
            height: 54px;
            min-width: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 24px;
        }

        .totp-header h4 {
            margin: 0;
            color: #172554;
            font-size: 21px;
            font-weight: 800;
        }

        .totp-header p {
            margin: 3px 0 0;
            color: #64748b;
            font-size: 12px;
        }

        .totp-body {
            padding: 23px 26px;
        }

        .totp-intro {
            margin-bottom: 20px;
            text-align: center;
        }

            .totp-intro h5 {
                margin-bottom: 6px;
                color: #172554;
                font-size: 18px;
                font-weight: 800;
            }

            .totp-intro p {
                margin: 0;
                color: #64748b;
                font-size: 12px;
                line-height: 1.55;
            }


        /* DATOS */

        .totp-dato-box {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 11px;
            padding: 14px;
            border: 1px solid #dbe4f0;
            border-radius: 14px;
            background: #f8fafc;
        }

        .totp-dato-icono {
            width: 40px;
            height: 40px;
            min-width: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 17px;
        }

            .totp-dato-icono.clave {
                background: #ede9fe;
                color: #7c3aed;
            }

        .totp-dato-contenido {
            flex: 1;
            min-width: 0;
        }

            .totp-dato-contenido span {
                display: block;
                color: #64748b;
                font-size: 10px;
            }

            .totp-dato-contenido strong {
                display: block;
                margin-top: 3px;
                color: #172554;
                font-size: 13px;
                word-break: break-all;
            }

        .totp-clave {
            letter-spacing: 1px;
        }

        .btn-copiar-totp {
            width: 36px;
            height: 36px;
            min-width: 36px;
            border: none;
            border-radius: 10px;
            background: #ffffff;
            color: #2563eb;
            box-shadow: 0 3px 10px rgba(15, 23, 42, .08);
        }


        /* AYUDA */

        .totp-ayuda {
            display: flex;
            gap: 11px;
            margin-top: 16px;
            padding: 13px 14px;
            border-radius: 14px;
            background: #eff6ff;
        }

            .totp-ayuda > i {
                margin-top: 2px;
                color: #2563eb;
                font-size: 20px;
            }

            .totp-ayuda strong {
                color: #1e40af;
                font-size: 12px;
            }

            .totp-ayuda p {
                margin: 4px 0 0;
                color: #64748b;
                font-size: 11px;
                line-height: 1.5;
            }

        .totp-separador {
            margin: 21px 0;
            border-color: #e2e8f0;
        }


        /* VERIFICACIÓN */

        .totp-verificacion {
            text-align: center;
        }

            .totp-verificacion h6 {
                color: #172554;
                font-size: 15px;
                font-weight: 800;
            }

            .totp-verificacion p {
                max-width: 430px;
                margin: 5px auto 14px;
                color: #64748b;
                font-size: 11px;
                line-height: 1.5;
            }

        .totp-codigo-input {
            width: 230px !important;
            height: 58px;
            margin: 0 auto;
            border: 2px solid #dbe4f0 !important;
            border-radius: 14px !important;
            background: #f8fafc !important;
            color: #1e3a8a;
            text-align: center;
            font-size: 25px !important;
            font-weight: 800;
            letter-spacing: 8px;
        }

            .totp-codigo-input:focus {
                border-color: #2563eb !important;
                background: #ffffff !important;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
            }


        /* FOOTER */

        .totp-footer {
            padding: 5px 26px 24px;
            border: none;
        }

        .btn-verificar-totp {
            border: none;
            border-radius: 11px;
            padding: 10px 17px;
            background: linear-gradient( 135deg, #2563eb, #4f46e5 );
            font-weight: 700;
        }


        @@media (max-width: 520px) {

            .totp-header,
            .totp-body,
            .totp-footer {
                padding-left: 17px;
                padding-right: 17px;
            }

            .totp-footer {
                gap: 8px;
            }

            .totp-codigo-input {
                width: 100% !important;
            }
        }
        /* ==========================================
           QR CONFIGURACIÓN TOTP
           ========================================== */

        .totp-qr-seccion {
            margin-top: 18px;
            padding: 16px;
            border: 1px solid #dbeafe;
            border-radius: 16px;
            background: #f8fbff;
            text-align: center;
        }

        .totp-qr-titulo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            color: #172554;
            font-size: 13px;
        }

            .totp-qr-titulo i {
                color: #2563eb;
                font-size: 18px;
            }

        .totp-qr-descripcion {
            margin: 6px 0 13px;
            color: #64748b;
            font-size: 11px;
        }

        .totp-qr-box {
            position: relative;
            width: 180px;
            height: 180px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 7px 20px rgba(37, 99, 235, .10);
        }

        #qrConfiguracionTotp img,
        #qrConfiguracionTotp canvas {
            width: 164px !important;
            height: 164px !important;
        }

        .totp-qr-logo {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 38px;
            height: 38px;
            transform: translate(-50%, -50%);
            padding: 3px;
            border: 4px solid white;
            border-radius: 10px;
            background: white;
            object-fit: cover;
        }

        .totp-qr-alternativa {
            display: block;
            margin-top: 11px;
            color: #64748b;
            font-size: 10px;
        }


        /* BOTÓN GUÍA */

        .btn-guia-vinculacion {
            width: 100%;
            margin-top: 12px;
            padding: 10px 14px;
            border: 1px solid #bfdbfe;
            border-radius: 12px;
            background: #ffffff;
            color: #2563eb;
            font-size: 12px;
            font-weight: 800;
        }

            .btn-guia-vinculacion:hover {
                background: #eff6ff;
            }


        /* MODAL GUÍA VINCULACIÓN */

        .modal-guia-totp {
            border: none;
            border-radius: 22px;
            overflow: hidden;
        }

        .guia-totp-header {
            padding: 20px 22px;
            border: none;
            background: linear-gradient( 135deg, #eff6ff, #eef2ff );
        }

            .guia-totp-header h5 {
                margin: 0;
                color: #172554;
                font-weight: 800;
            }

            .guia-totp-header p {
                margin: 3px 0 0;
                color: #64748b;
                font-size: 11px;
            }

        .guia-totp-body {
            padding: 20px 22px;
        }

        .guia-totp-opcion {
            display: flex;
            gap: 12px;
            margin-bottom: 13px;
            padding: 13px;
            border: 1px solid #e2e8f0;
            border-radius: 13px;
        }

        .guia-totp-numero {
            width: 31px;
            height: 31px;
            min-width: 31px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #dbeafe;
            color: #2563eb;
            font-weight: 800;
        }

        .guia-totp-opcion strong {
            color: #172554;
            font-size: 12px;
        }

        .guia-totp-opcion p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 11px;
            line-height: 1.5;
        }

        .guia-totp-final {
            display: flex;
            gap: 11px;
            padding: 13px;
            border-radius: 13px;
            background: #f0fdf4;
        }

            .guia-totp-final > i {
                color: #16a34a;
                font-size: 20px;
            }

            .guia-totp-final strong {
                color: #166534;
                font-size: 12px;
            }

            .guia-totp-final p {
                margin: 3px 0 0;
                color: #4b7b5b;
                font-size: 11px;
            }
        /* ==========================================
           GUÍA VISUAL VINCULACIÓN TOTP
           ========================================== */

        .guia-vinculacion-body {
            padding: 20px 22px 22px;
        }

        .guia-totp-badge {
            display: inline-block;
            margin-bottom: 5px;
            padding: 4px 9px;
            border-radius: 20px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .4px;
        }

        .guia-vinculacion-paso {
            text-align: center;
        }

        .guia-vinculacion-imagen {
            width: 100%;
            min-height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px;
            border-radius: 17px;
            background: #f8fafc;
        }

            .guia-vinculacion-imagen img {
                display: block;
                max-width: 100%;
                max-height: 390px;
                object-fit: contain;
                border-radius: 12px;
                box-shadow: 0 8px 25px rgba(15, 23, 42, .12);
            }

        .guia-vinculacion-numero {
            display: inline-block;
            margin-top: 15px;
            padding: 5px 12px;
            border-radius: 20px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 10px;
            font-weight: 800;
        }

        .guia-vinculacion-paso h5 {
            margin: 10px 0 5px;
            color: #172554;
            font-size: 18px;
            font-weight: 800;
        }

        .guia-vinculacion-paso > p {
            max-width: 430px;
            margin: 0 auto;
            color: #64748b;
            font-size: 11px;
            line-height: 1.55;
        }

        .guia-vinculacion-nota {
            max-width: 430px;
            margin: 12px auto 0;
            padding: 11px 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 12px;
            background: #eff6ff;
            color: #1e40af;
            font-size: 11px;
        }

            .guia-vinculacion-nota i {
                color: #2563eb;
                font-size: 16px;
            }

        .guia-vinculacion-indicadores {
            display: flex;
            justify-content: center;
            gap: 7px;
            margin-top: 17px;
        }

        .guia-vinculacion-punto {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #cbd5e1;
            transition: .2s;
        }

            .guia-vinculacion-punto.activo {
                width: 23px;
                border-radius: 10px;
                background: #2563eb;
            }

        .guia-vinculacion-botones {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-top: 18px;
        }

        .btn-guia-vinculacion-atras,
        .btn-guia-vinculacion-siguiente {
            min-width: 115px;
            padding: 10px 15px;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 800;
        }

        .btn-guia-vinculacion-atras {
            border: 1px solid #dbe4f0;
            background: #ffffff;
            color: #64748b;
        }

            .btn-guia-vinculacion-atras:disabled {
                opacity: .45;
            }

        .btn-guia-vinculacion-siguiente {
            border: none;
            background: linear-gradient( 135deg, #2563eb, #4f46e5 );
            color: #ffffff;
        }

        @@media (max-width: 520px) {

            .guia-vinculacion-body {
                padding-left: 15px;
                padding-right: 15px;
            }

            .guia-vinculacion-imagen {
                min-height: 240px;
            }

                .guia-vinculacion-imagen img {
                    max-height: 310px;
                }
        }
    </style>
</head>

<body>
    <div class="main-box">

        <div class="left-panel">
            <div class="logo">
                <img src="~/imagenes/credi.png"
                     alt="CrediPlus"
                     class="logo-crediplus" />
            </div>

            <div class="welcome">
                <h1>Bienvenido</h1>
                <p>
                    Ingresa con tu DNI para gestionar tus solicitudes de crédito
                    de forma rápida y segura.
                </p>

                <div class="credit-icon">💰</div>
            </div>
        </div>

        <div class="right-panel">
            <h2>Iniciar Sesión</h2>
            <p class="subtitle">Accede a tu cuenta de créditos</p>
            @if (!string.IsNullOrEmpty(ViewBag.MensajeRegistro))
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @ViewBag.MensajeRegistro

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }

            

            

            <form asp-controller="Login"
                  asp-action="IniciarSesion"
                  method="post"
                  id="formLogin">

                <div class="input-util-wrap mb-3">
                    <input id="dniInput"
                           class="form-control"
                           type="text"
                           placeholder="DNI"
                           required
                           name="dni"
                           maxlength="8"
                            />

                    <button type="button"
                            class="btn-clear"
                            >
                        ✕
                    </button>
                </div>

                <div class="input-util-wrap mb-3">
                    <input id="claveInput"
                           class="form-control"
                           type="password"
                           placeholder="Contraseña"
                           required
                           name="clave" />

                    <button type="button" class="btn-clear" >
                        ✕
                    </button>

                    <button type="button" class="btn-eye" >
                        👁
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.TurnstileSiteKey as string))
                {
                    <div class="mb-3 d-flex justify-content-center">
                        <div class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey" data-appearance="interaction-only" data-theme="light" data-language="es"></div>
                    </div>
                }

                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-login" type="submit">Iniciar Sesión</button>
                </div>
                <div id="mensajeLogin"
                     class="alert alert-danger mt-3"
                     style="display:none;">
                </div>
                @if (ViewData["Mensaje"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewData["Mensaje"]
                    </div>
                }

                <div class="register-link mb-2">
                    <a href="@Url.Action("OlvideContrasena", "Login", new { nuevo = true })">¿Olvidaste tu contraseña?</a>
                </div>

                <div class="register-link">
                    ¿No tienes una cuenta?
                    <a href="@Url.Action("Registro", "Login")">Regístrate</a>
                </div>
                <a href="@Url.Action("PantallaPrincipal", "Login")" class="back-btn">
                    ← Regresar
                </a>

            </form>
        </div>
    </div>
    <!-- MODAL DE VERIFICACIÓN DE SEGURIDAD -->
    <div class="modal fade" id="modalVerificacionSeguridad" tabindex="-1"
         aria-labelledby="modalVerificacionSeguridadLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-crediplus">

                <div class="modal-header border-0">
                    <div>
                        <img src="~/imagenes/icon.png"
                             alt="CrediPlus"
                             class="logo-modal-seguridad" />

                        <h4 class="modal-title mt-3" id="modalVerificacionSeguridadLabel">
                            Verificación de seguridad
                        </h4>

                        <p class="texto-seguridad">
                            Para continuar, selecciona cómo deseas recibir tu código de seguridad.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <!-- REGISTRO DE VOZ OBLIGATORIO -->

                    <div id="bloqueRegistroVoz"
                         style="display:none;">

                        <div class="text-center mb-3">

                            <div class="icono-seguridad mx-auto mb-3"
                                 style="background:#ede9fe;color:#7c3aed;">

                                <i class="bi bi-mic-fill"></i>

                            </div>

                            <h5 style="font-weight:800;color:#1e293b;">
                                Registro de voz obligatorio
                            </h5>

                            <p style="color:#64748b;font-size:14px;">
                                No tienes registrada una voz de seguridad.
                                Debes realizar una grabación para continuar.
                            </p>

                        </div>

                        <div class="seguridad-voz-box">

                            <p style="font-weight:700;color:#3c096c;">
                                🎙️ Palabra o frase clave:
                            </p>

                            <div class="alert alert-light text-center">
                                <strong id="textoFraseEsperadaRegistroVoz" class="textoFraseEsperadaVoz">Di tu palabra o frase de seguridad registrada</strong>
                            </div>

                            <button type="button"
                                    id="btnGrabarVozLogin"
                                    class="btn btn-primary w-100 py-3 fs-6 fw-bold shadow-sm rounded-3"
                                    >

                                🎙️ Grabar mi voz

                            </button>

                            <div id="estadoVozLogin"
                                 class="text-center mt-3"
                                 style="font-size:13px;color:#64748b;">

                                ⚪ Aún no has grabado tu voz

                            </div>

                            <div id="btnCancelarRenovacionFormulario" class="text-center mt-3" style="display:none;">
                                <button type="button" class="btn btn-link text-decoration-none text-muted p-0" style="font-size:13px;" id="btnCancelarRenovacionDesdeFormulario">
                                    <i class="bi bi-arrow-left me-1"></i> Cancelar y volver a selección de métodos
                                </button>
                            </div>

                        </div>

                    </div>
                    <!-- VERIFICACIÓN DE VOZ -->

                    <div id="bloqueVerificacionVoz"
                         style="display:none;">

                        <div class="text-center mb-3">

                            <div class="icono-seguridad mx-auto mb-3"
                                 style="background:#dcfce7;color:#16a34a;">

                                <i class="bi bi-mic-fill"></i>

                            </div>

                            <h5 style="font-weight:800;color:#1e293b;">
                                Verificación por voz
                            </h5>

                            <p style="color:#64748b;font-size:14px;">
                                Di tu frase de seguridad para verificar tu identidad.
                            </p>

                        </div>

                        <div class="seguridad-voz-box">

                            <p style="font-weight:700;color:#3c096c;">
                                🎙️ Palabra o frase clave registrada:
                            </p>

                            <div class="alert alert-light text-center">
                                <strong id="textoFraseEsperadaVoz" class="textoFraseEsperadaVoz">Di tu palabra o frase de seguridad registrada</strong>
                            </div>

                            <button type="button"
                                    id="btnVerificarVoz"
                                    class="btn btn-success w-100 py-3 fs-6 fw-bold shadow-sm rounded-3"
                                    >

                                🎙️ Hablar palabra clave

                            </button>

                            <div id="estadoVerificacionVoz"
                                 class="text-center mt-3"
                                 style="font-size:13px;color:#64748b;">

                                ⚪ Aún no has realizado la verificación

                            </div>

                        </div>

                    </div>
                    <!-- OPCIÓN CORREO -->
                    <div class="opcion-seguridad seleccionada"
                         id="opcionCorreo"
                         >

                        <div class="opcion-icono correo">
                            <i class="bi bi-envelope-fill"></i>
                        </div>

                        <div class="opcion-contenido">
                            <h5>Correo electrónico</h5>

                            <p>
                                Recibir un código de seguridad en el
                                correo electrónico registrado.
                            </p>
                        </div>

                        <div class="radio-seguridad">
                            <span id="radioCorreo"></span>
                        </div>
                    </div>


                    <!-- OPCIÓN CREDIPLUS AUTHENTICATOR -->
                    <div class="opcion-seguridad"
                         id="opcionAplicacion"
                         >

                        <div class="opcion-icono aplicacion">
                            <img src="~/imagenes/AplicacionCrediplus.jpeg"
                                 alt="CrediPlus Authenticator"
                                 style="width:38px;height:38px;border-radius:9px;object-fit:cover;" />
