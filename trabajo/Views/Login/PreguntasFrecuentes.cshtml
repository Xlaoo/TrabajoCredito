@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Preguntas frecuentes - CrediPlus</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            overflow-x: hidden;
            background: linear-gradient(135deg, #2e005f, #6d28d9) !important;
        }

        .faq-page {
            width: 100%;
            min-height: 100vh;
            background: linear-gradient(135deg, #2e005f, #6d28d9);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 45px;
        }

        .faq-wrapper {
            width: 1100px;
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 22px;
        }

        .faq-left {
            background: linear-gradient( 180deg, #3c096c 0%, #5a189a 45%, #7c3aed 100% );
            border-radius: 26px;
            padding: 45px 35px;
            color: white;
            min-height: 620px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 18px 40px rgba(76, 29, 149, .35);
            position: relative;
            overflow: hidden;
        }

            .faq-left::before {
                content: "";
                position: absolute;
                top: -100px;
                right: -100px;
                width: 250px;
                height: 250px;
                border-radius: 50%;
                background: rgba(255,255,255,.08);
            }

            .faq-left::after {
                content: "";
                position: absolute;
                bottom: -120px;
                left: -120px;
                width: 280px;
                height: 280px;
                border-radius: 50%;
                background: rgba(255,255,255,.05);
            }

            .faq-left h1 {
                font-size: 38px;
                line-height: 1.1;
                margin: 0;
                font-weight: 900;
            }

            .faq-left p {
                color: #ddd6fe;
                font-size: 17px;
                margin-top: 12px;
            }

        .question-circle {
            width: 170px;
            height: 170px;
            margin: 55px auto;
            border-radius: 50%;
            background: rgba(255,255,255,.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 95px;
            font-weight: 900;
            color: white;
            box-shadow: 0 15px 35px rgba(0,0,0,.25);
            transition: .3s;
        }

            .question-circle:hover {
                transform: scale(1.05);
            }

        .back-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: rgba(255,255,255,.12);
            color: white;
            padding: 14px 24px;
            border-radius: 14px;
            text-decoration: none;
            font-weight: 700;
            font-size: 16px;
            transition: .3s;
        }

            .back-link:hover {
                background: rgba(255,255,255,.22);
                transform: translateY(-3px);
                color: white;
                text-decoration: none;
            }

        .faq-right {
            background: white;
            border-radius: 26px;
            padding: 35px;
            box-shadow: 0 18px 40px rgba(76, 29, 149, .13);
        }

        .faq-item {
            border: 1px solid #eadfff;
            border-radius: 16px;
            margin-bottom: 15px;
            overflow: hidden;
            background: white;
        }

        .faq-question {
            width: 100%;
            border: none;
            background: white;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            color: #240046;
            font-weight: 800;
            font-size: 16px;
        }

            .faq-question span {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .faq-question i {
                color: #7c3aed;
                font-size: 18px;
                width: 22px;
            }

            .faq-question b {
                color: #4c1d95;
                font-size: 22px;
            }

        .faq-answer {
            display: none;
            padding: 0 24px 22px 60px;
            color: #4b5563;
            line-height: 1.6;
            font-size: 15px;
        }

        .faq-item.active .faq-question {
            background: #faf7ff;
        }

        .faq-item.active .faq-answer {
            display: block;
        }

        @@media(max-width: 900px) {
            .faq-wrapper {
                grid-template-columns: 1fr;
            }

            .faq-left {
                min-height: auto;
            }
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.15);
            color: white;
            text-decoration: none;
            padding: 16px 32px;
            border-radius: 16px;
            font-size: 18px;
            font-weight: 800;
            position: relative;
            z-index: 9999;
            cursor: pointer;
            transition: .3s;
        }

            .back-link:hover {
                background: rgba(255,255,255,.25);
                color: white;
                transform: translateY(-2px);
            }

        .faq-left {
            position: relative;
        }

        .back-link {
            align-self: center;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>

    <div class="faq-page">

        <div class="faq-wrapper">

            <div class="faq-left">
                <div>
                    <h1>Preguntas<br>frecuentes</h1>
                    <p>Resolvemos tus dudas</p>

                    <div class="question-circle">
                        ?
                    </div>
                </div>

                <a href="javascript:history.back()"
                   class="back-link">
                    <i class="fas fa-arrow-left"></i>
                    Regresar
                </a>
            </div>

            <div class="faq-right">

                <div class="faq-item active">
                    <button class="faq-question">
                        <span><i class="fas fa-file-alt"></i> ¿Cómo solicito un préstamo?</span>
                        <b>−</b>
                    </button>
                    <div class="faq-answer">
                        Puedes solicitar tu préstamo desde la opción “Solicitar préstamo”, completando el monto, plazo y tu información financiera.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        <span><i class="fas fa-clock"></i> ¿Cuánto demora la evaluación?</span>
                        <b>+</b>
                    </button>
                    <div class="faq-answer">
                        La evaluación puede tardar hasta 24 horas. Mientras tanto, tu solicitud aparecerá como pendiente.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        <span><i class="fas fa-clipboard-list"></i> ¿Qué requisitos necesito?</span>
                        <b>+</b>
                    </button>
                    <div class="faq-answer">
                        Necesitas estar registrado, ingresar tus datos financieros y no tener una solicitud activa pendiente, aprobada o rechazada sin borrar.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        <span><i class="fas fa-times-circle"></i> ¿Qué pasa si rechazan mi solicitud?</span>
                        <b>+</b>
                    </button>
                    <div class="faq-answer">
                        Puedes revisar las observaciones del analista. Para volver a solicitar, primero debes borrar la solicitud rechazada.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        <span><i class="fas fa-credit-card"></i> ¿Cómo pago mis cuotas?</span>
                        <b>+</b>
                    </button>
                    <div class="faq-answer">
                        Desde “Pagos pendientes” podrás ver tus cuotas y registrar el pago con monto, método y código de operación.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        <span><i class="fas fa-chart-column"></i> ¿Dónde veo mis cuotas pendientes?</span>
                        <b>+</b>
                    </button>
                    <div class="faq-answer">
                        En el menú lateral, entra a “Pagos Pendientes”. Ahí se mostrará la cuota que corresponde pagar.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        <span><i class="fas fa-calendar-check"></i> ¿Puedo pagar anticipadamente?</span>
                        <b>+</b>
                    </button>
                    <div class="faq-answer">
                        Sí, puedes adelantar pagos, pero deben registrarse correctamente para que sean validados.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        <span><i class="fas fa-shield-alt"></i> ¿Es seguro usar la plataforma?</span>
                        <b>+</b>
                    </button>
                    <div class="faq-answer">
                        Sí, tu información se maneja de forma segura dentro del sistema CrediPlus.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        <span><i class="fas fa-ban"></i> ¿Puedo cancelar mi solicitud?</span>
                        <b>+</b>
                    </button>
                    <div class="faq-answer">
                        Si tu préstamo fue aprobado, puedes solicitar cancelación. Esta quedará pendiente de validación.
                    </div>
                </div>

            </div>

        </div>

    </div>

    <script>
        document.querySelectorAll(".faq-question").forEach(btn => {
            btn.addEventListener("click", function () {
                const item = this.parentElement;
                const icon = this.querySelector("b");

                document.querySelectorAll(".faq-item").forEach(i => {
                    if (i !== item) {
                        i.classList.remove("active");
                        i.querySelector("b").innerText = "+";
                    }
                });

                item.classList.toggle("active");
                icon.innerText = item.classList.contains("active") ? "−" : "+";
            });
        });
    </script>
    <script src="~/js/config-global.js"></script>
</body>
</html>