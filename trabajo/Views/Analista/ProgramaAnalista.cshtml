		<div class="content">

			<div class="top-bar">

				<div>
					<div class="welcome">
						Bienvenido Analista
					</div>

					<h1>
						Panel de Análisis de Riesgos
					</h1>

					<p>
						Gestiona y evalúa solicitudes de crédito.
					</p>
				</div>

				<a href="@Url.Action("PerfilAnalista", "Analista")"
				   class="profile-box profile-link">

					<div class="avatar">
						<svg width="30"
							 height="30"
							 fill="white"
							 viewBox="0 0 16 16">
							<path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0 1c-2.33 0-7 1.17-7 3.5V14h14v-1.5C15 10.17 10.33 9 8 9z" />
						</svg>
					</div>

					<div>
						<strong>
							@ViewBag.Analista.Nombre @ViewBag.Analista.Apellido
						</strong>
						<br />
						<span>@ViewBag.Analista.Correo</span>

						<small class="perfil-texto">
							Ver perfil completo →
						</small>
					</div>

				</a>

			</div>

			<div class="stats">

				<div class="card-stat">

					<div class="kpi-header">
						<div class="icon-stat success">✓</div>
						<div class="kpi-title">Aprobadas</div>
					</div>

					<div class="kpi-number">
						@Model.Count(x => x.Estado == "Aprobado")
					</div>

					<div class="kpi-subtitle">
						Este mes
					</div>

				</div>

				<div class="card-stat">

					<div class="kpi-header">
						<div class="icon-stat danger">✕</div>
						<div class="kpi-title">Rechazadas</div>
					</div>

					<div class="kpi-number">
						@Model.Count(x => x.Estado == "Rechazado")
					</div>

					<div class="kpi-subtitle">
						Este mes
					</div>

				</div>

				<div class="card-stat">

					<div class="kpi-header">
						<div class="icon-stat warning">🕒</div>
						<div class="kpi-title">Pendientes</div>
					</div>

					<div class="kpi-number">
						@Model.Count(x => x.Estado == "Pendiente")
					</div>

					<div class="kpi-subtitle">
						Este mes
					</div>

				</div>

				<div class="card-stat">

					<div class="kpi-header">
						<div class="icon-stat primary">📄</div>
						<div class="kpi-title">En Evaluación</div>
					</div>

					<div class="kpi-number">
						@Model.Count(x => x.Estado == "En Evaluación")
					</div>

					<div class="kpi-subtitle">
						Este mes
					</div>

				</div>

				<div class="card-stat">

					<div class="kpi-header">

						<div class="icon-stat purple">
							<i class="fas fa-users"></i>
						</div>

						<div class="kpi-title">
							Clientes Atendidos
						</div>

					</div>

					<div class="kpi-number">
						@(Model.Count(x =>
												x.Estado == "Aprobado" ||
												x.Estado == "Rechazado"))
					</div>

					<div class="kpi-subtitle">
						Desde el inicio
					</div>

				</div>

			</div>
			<div class="dashboard-row">

				<div class="estado-card">

					<div class="estado-title">
						Solicitudes por Estado(ESTE MES)
					</div>

					<div class="estado-container">

						<div class="estado-chart"
							 style="
                 background:conic-gradient(
                 #f59e0b 0 @(total == 0 ? 0 : pendientes * 100 / total)%,
                 #2563eb @(total == 0 ? 0 : pendientes * 100 / total)% @((total == 0 ? 0 : (pendientes + evaluacion) * 100 / total))%,
                 #22c55e @((total == 0 ? 0 : (pendientes + evaluacion) * 100 / total))% @((total == 0 ? 0 : (pendientes + evaluacion + aprobadas) * 100 / total))%,
                 #ef4444 @((total == 0 ? 0 : (pendientes + evaluacion + aprobadas) * 100 / total))% 100%
                 );">

							<div class="estado-center">
								<span>Total</span>
								<strong>@total</strong>
							</div>

						</div>

						<div class="estado-list">

							<div class="estado-item">
								<div>
									<span class="dot dot-pendiente"></span>
									Pendiente
								</div>
								<div>
									@pendientes (@pPendiente.ToString("0.0")%)
								</div>
							</div>

							<div class="estado-item">
								<div>
									<span class="dot dot-evaluacion"></span>
									En Evaluación
								</div>
								<div>
									@evaluacion (@pEvaluacion.ToString("0.0")%)
								</div>
							</div>

							<div class="estado-item">
								<div>
									<span class="dot dot-aprobada"></span>
									Aprobadas
								</div>
								<div>
									@aprobadas (@pAprobadas.ToString("0.0")%)
								</div>
							</div>

							<div class="estado-item">
								<div>
									<span class="dot dot-rechazada"></span>
									Rechazadas
								</div>
								<div>
									@rechazadas (@pRechazadas.ToString("0.0")%)
								</div>
							</div>

						</div>

					</div>

				</div>
				<div class="riesgo-card">

					<div class="riesgo-title">
						Distribución de Riesgo(ESTE MES)
					</div>
					<div class="eje-y">
						<span>@maxEscala</span>
						<span>@(maxEscala * 8 / 10)</span>
						<span>@(maxEscala * 6 / 10)</span>
						<span>@(maxEscala * 4 / 10)</span>
						<span>@(maxEscala * 2 / 10)</span>
						<span>0</span>
					</div>
					<div class="riesgo-chart">

						<div class="bar-group">
							<div class="bar bajo" style="height:@((int)(bajo * factorAltura))px;">
								<div class="bar-value">@bajo</div>
							</div>
							<div class="bar-label">Bajo</div>
						</div>

						<div class="bar-group">
							<div class="bar medio" style="height:@((int)(medio * factorAltura))px;">
								<div class="bar-value">@medio</div>
							</div>
							<div class="bar-label">Medio</div>
						</div>

						<div class="bar-group">
							<div class="bar alto" style="height:@((int)(alto * factorAltura))px;">
								<div class="bar-value">@alto</div>
							</div>
							<div class="bar-label">Alto</div>
						</div>

						<div class="bar-group">
							<div class="bar critico" style="height:@((int)(critico * factorAltura))px;">
								<div class="bar-value">@critico</div>
							</div>
							<div class="bar-label">Critico</div>
						</div>

					</div>

				</div>
				<div class="monto-card">

					<div class="monto-title">
						Solicitudes por Montos Aprobados (Este mes)
					</div>

					<div class="medidor">

						<div class="medidor-externo"
							 style="
background:
conic-gradient(
from 270deg,
#4f46e5 0deg @((double)porcentaje * 1.8)deg,
#e5e7eb @((double)porcentaje * 1.8)deg 180deg,
transparent 180deg 360deg
);
">
						</div>

						<div class="medidor-interno"></div>

						<div class="medidor-texto">
							<div class="medidor-monto">
								S/ @montoTotal.ToString("N0")
							</div>

							<div class="medidor-sub">
								Monto total evaluado
							</div>
						</div>

					</div>
					<div class="medidor-limites">
						<span>S/ @limiteInferior.ToString("N0")</span>
						<span>S/ @limiteSuperior.ToString("N0")</span>
					</div>

				</div>



			</div>
			<div class="seccion-inferior">
				<div class="ultimas-solicitudes">

					<div class="titulo-tabla">
						📄 Últimas Solicitudes Recibidas
					</div>

					<div class="tabla-scroll">

						<table>

							<thead>
								<tr>
									<th>N° Solicitud</th>
									<th>Cliente</th>
									<th>Monto</th>
									<th>Fecha</th>
									<th>Riesgo</th>
									<th>Acción</th>
								</tr>
							</thead>

							<tbody>

								@for (int i = 0; i < solicitudesOrdenadas.Count; i++)
								{
									var solicitud = solicitudesOrdenadas[i];
									var ultimaEvaluacion = solicitud.HISTORIAL_ESTADOS?
									.OrderByDescending(h => h.FechaCambio)
									.FirstOrDefault();

									string riesgoTexto = "Bajo";
									string riesgoClase = "bajo";

									if (solicitud.PERFIL_FINANCIERO != null)
									{
										switch (solicitud.PERFIL_FINANCIERO.NivelRiesgo)
										{
											case "Medio":
												riesgoTexto = "Medio";
												riesgoClase = "medio";
												break;

											case "Alto":
												riesgoTexto = "Alto";
												riesgoClase = "alto";
												break;

											case "Critico":
												riesgoTexto = "Critico";
												riesgoClase = "critico";
												break;
										}
									}

								<tr class="@(i >= 5 ? "fila-extra" : "")"
									style="@(i >= 5 ? "display:none;" : "")">

									<td>
										SOL-@solicitud.Id_Solicitud.ToString("D5")
									</td>

									<td>
										@solicitud.USUARIO.Nombre
										@solicitud.USUARIO.Apellido
									</td>

									<td>
										S/ @solicitud.MontoSolicitado.ToString("N0")
									</td>

									<td>
										@(ultimaEvaluacion != null
																				? ultimaEvaluacion.FechaCambio.ToString("dd/MM/yyyy hh:mm tt")
																				: "-")
									</td>

										<td>
											<span class="riesgo @riesgoClase">
												@riesgoTexto
											</span>
										</td>

										<td>
											<button class="btn-ver"
													onclick="abrirDetallePrograma(
	            '@solicitud.USUARIO.Nombre @solicitud.USUARIO.Apellido',
	            '@solicitud.USUARIO.Dni',
	            '@solicitud.USUARIO.Celular',
	            '@solicitud.USUARIO.Correo',
	            '@solicitud.MontoSolicitado.ToString("N0")',
	            '@solicitud.PlazoMeses',
	            '@(solicitud.PERFIL_FINANCIERO?.MotivoPrestamo ?? "-")',
	            '@(solicitud.PERFIL_FINANCIERO?.Ocupacion ?? "-")',
	            '@(solicitud.PERFIL_FINANCIERO?.IngresoMensual.ToString("N2") ?? "0")',
	            '@(solicitud.PERFIL_FINANCIERO?.EgresoMensual.ToString("N2") ?? "0")',
	            '@solicitud.Estado',
	            '@(ultimaEvaluacion?.MotivoCambio ?? "Sin observación")',
	            'SOL-@solicitud.Id_Solicitud.ToString("D5")'
	        )">
												👁
											</button>
										</td>

									</tr>
								}

							</tbody>


						</table>


					</div>
					<div id="contadorSolicitudes"
						 style="
     margin-top:15px;
     color:#64748b;
     font-size:14px;
     font-weight:600;">

						Mostrando @visiblesIniciales de @totalSolicitudes solicitudes

					</div>
					@if (totalSolicitudes > 5)
					{
						<div style="text-align:center;margin-top:15px;">

							<button id="btnVerMas"
									onclick="mostrarMas()"
									style="
						                        border:none;
						                        background:none;
						                        color:#6d28d9;
						                        font-weight:700;
						                        cursor:pointer;">

								Ver más solicitudes →

							</button>

							<button id="btnVerMenos"
									onclick="mostrarMenos()"
									style="
						                        border:none;
						                        background:none;
						                        color:#dc2626;
						                        font-weight:700;
						                        cursor:pointer;
						                        display:none;">

								← Ver menos solicitudes

							</button>

						</div>
					}

				</div>
				<div class="historial-card">

					<div class="titulo-historial">
						Historial Reciente
					</div>


					<div class="historial-scroll">

						@for (int i = 0; i < historialOrdenado.Count; i++)
						{
							var solicitud = historialOrdenado[i];
							var ultimaEvaluacion = solicitud.HISTORIAL_ESTADOS?
							.OrderByDescending(h => h.FechaCambio)
							.FirstOrDefault();

							string iconoClase = "ok";
							string iconoTexto = "✓";
							string textoEstado = "aprobada";

							switch (solicitud.Estado)
							{
								case "Rechazado":
									iconoClase = "bad";
									iconoTexto = "✕";
									textoEstado = "rechazada";
									break;

								case "En Evaluación":
									iconoClase = "eval";
									iconoTexto = "🕒";
									textoEstado = "en evaluación";
									break;

								case "Pendiente":
									iconoClase = "wait";
									iconoTexto = "⌛";
									textoEstado = "pendiente";
									break;
							}

						<div class="historial-item @(i >= 5 ? "historial-extra" : "")"
							 style="@(i >= 5 ? "display:none;" : "")">

							<div class="@iconoClase">
								@iconoTexto
							</div>

							<div class="historial-contenido">

								<div class="historial-superior">

									<strong>
										Solicitud
										SOL-@solicitud.Id_Solicitud.ToString("D5")
										@textoEstado
									</strong>

									<span class="historial-fecha">
										@(ultimaEvaluacion != null
																				? ultimaEvaluacion.FechaCambio.ToString("dd/MM/yyyy hh:mm tt")
																				: "-")
									</span>

									</div>

									<div class="historial-detalle">

										Cliente:
										@solicitud.USUARIO.Nombre
										@solicitud.USUARIO.Apellido

										&nbsp; • &nbsp;

										Monto:
										S/ @solicitud.MontoSolicitado.ToString("N0")

									</div>

								</div>

							</div>
												}
					</div>
					@if (totalHistorial > 5)
					{
						<div style="
		        display:flex;
		        justify-content:center;
		        align-items:center;
		        margin-top:20px;">

							<button id="btnVerMasHistorial"
									onclick="mostrarMasHistorial()"
									style="
		                    border:none;
		                    background:none;
		                    color:#6d28d9;
		                    font-weight:700;
		                    cursor:pointer;
		                    text-align:center;">

								Ver más historial →
							</button>

							<button id="btnVerMenosHistorial"
									onclick="mostrarMenosHistorial()"
									style="
		                    border:none;
		                    background:none;
		                    color:#dc2626;
		                    font-weight:700;
		                    cursor:pointer;
		                    text-align:center;
		                    display:none;">

								← Ver menos historial
							</button>

						</div>
					}


				</div>



			</div>

		</div>
	</div>


	<script>

		function mostrarMas() {

			document.querySelectorAll('.fila-extra')
				.forEach(f => f.style.display = '');

			document.getElementById('btnVerMas').style.display = 'none';
			document.getElementById('btnVerMenos').style.display = 'inline';

			document.getElementById('contadorSolicitudes').style.display = 'none';
		}

		function mostrarMenos() {

			document.querySelectorAll('.fila-extra')
				.forEach(f => f.style.display = 'none');

			document.getElementById('btnVerMas').style.display = 'inline';
			document.getElementById('btnVerMenos').style.display = 'none';

			document.getElementById('contadorSolicitudes').style.display = 'block';
		}
				function abrirDetallePrograma(
			cliente,
			dni,
			celular,
			correo,
			monto,
			plazo,
			motivo,
			ocupacion,
			ingreso,
			egreso,
			estado,
			observacion,
			solicitud
		) {
			document.getElementById("pSolicitud").innerText =
				"Detalle de Evaluación - " + solicitud;

			document.getElementById("pCliente").innerText = cliente;
			document.getElementById("pDni").innerText = dni;
			document.getElementById("pCelular").innerText = celular;
			document.getElementById("pCorreo").innerText = correo;

			document.getElementById("pMonto").innerText = "S/ " + monto;
			document.getElementById("pPlazo").innerText = plazo + " meses";
			document.getElementById("pMotivo").innerText = motivo;
			document.getElementById("pOcupacion").innerText = ocupacion;

			document.getElementById("pIngreso").innerText = "S/ " + ingreso;
			document.getElementById("pEgreso").innerText = "S/ " + egreso;

			document.getElementById("pEstado").innerText = estado;
			document.getElementById("pObservacion").innerText = observacion;

			document.getElementById("modalDetallePrograma").style.display = "flex";
		}

		function cerrarDetallePrograma() {
			document.getElementById("modalDetallePrograma").style.display = "none";
		}
				function mostrarMasHistorial() {

			document.querySelectorAll('.historial-extra')
				.forEach(x => x.style.display = '');

			document.getElementById('btnVerMasHistorial').style.display = 'none';
			document.getElementById('btnVerMenosHistorial').style.display = 'block';

			document.getElementById('contadorHistorial').style.display = 'none';
		}

		function mostrarMenosHistorial() {

			document.querySelectorAll('.historial-extra')
				.forEach(x => x.style.display = 'none');

			document.getElementById('btnVerMasHistorial').style.display = 'block';
			document.getElementById('btnVerMenosHistorial').style.display = 'none';

			document.getElementById('contadorHistorial').style.display = 'block';
		}

	</script>
	<div id="modalDetallePrograma" class="modal-historial" style="display:none;">
		<div class="modal-box">

			<div class="modal-title">
				<span id="pSolicitud"></span>
			</div>

			<div class="modal-grid">

				<div class="info-card">
					<h3>Datos personales</h3>

					<div class="fila"><span>Cliente:</span><strong id="pCliente"></strong></div>
					<div class="fila"><span>DNI:</span><strong id="pDni"></strong></div>
					<div class="fila"><span>Teléfono:</span><strong id="pCelular"></strong></div>
					<div class="fila"><span>Email:</span><strong id="pCorreo"></strong></div>
				</div>

				<div class="info-card">
					<h3>Perfil financiero</h3>

					<div class="fila"><span>Monto:</span><strong id="pMonto"></strong></div>
					<div class="fila"><span>Plazo:</span><strong id="pPlazo"></strong></div>
					<div class="fila"><span>Motivo:</span><strong id="pMotivo"></strong></div>
					<div class="fila"><span>Ocupación:</span><strong id="pOcupacion"></strong></div>
				</div>

				<div class="info-card">
					<h3>Resumen financiero</h3>

					<div class="fila"><span>Ingresos:</span><strong id="pIngreso"></strong></div>
					<div class="fila"><span>Egresos:</span><strong id="pEgreso"></strong></div>
				</div>

				<div class="info-card">
					<h3>Resultado</h3>

					<div class="fila"><span>Estado:</span><strong id="pEstado"></strong></div>
				</div>

			</div>

			<div class="observacion">
				<b>Observación del analista:</b>
				<p id="pObservacion"></p>
			</div>

			<div class="modal-actions">
				<button class="btn-aceptar"
						onclick="cerrarDetallePrograma()">
					Aceptar
				</button>
			</div>

		</div>
	</div>

