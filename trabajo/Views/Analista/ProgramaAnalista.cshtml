@model List<trabajo.Models.SolicitudCredito>

@{
	var pendientes = Model.Count(x => x.Estado == "Pendiente");
	var evaluacion = Model.Count(x => x.Estado == "En Evaluación");
	var aprobadas = Model.Count(x => x.Estado == "Aprobado");
	var rechazadas = Model.Count(x => x.Estado == "Rechazado");
	var total = Model.Count();

	var pPendiente = total > 0 ? (pendientes * 100.0 / total) : 0;
	var pEvaluacion = total > 0 ? (evaluacion * 100.0 / total) : 0;
	var pAprobadas = total > 0 ? (aprobadas * 100.0 / total) : 0;
	var pRechazadas = total > 0 ? (rechazadas * 100.0 / total) : 0;

	var bajo = 0;
	var medio = 0;
	var alto = 0;
	var critico = 0;
	var solicitudesOrdenadas = Model
	.Where(x =>
		(x.Estado == "Aprobado" ||
		 x.Estado == "Rechazado") &&
		x.HISTORIAL_ESTADOS != null &&
		x.HISTORIAL_ESTADOS.Any())
	.OrderByDescending(x =>
		x.HISTORIAL_ESTADOS.Max(h => h.FechaCambio))
	.ToList();

	var solicitudesVisibles = Model.Take(5).ToList();

	var totalSolicitudes = solicitudesOrdenadas.Count();
	var visiblesIniciales = totalSolicitudes > 5 ? 5 : totalSolicitudes;

	foreach (var s in Model)
	{
		if (s.Estado != "Aprobado" &&
			s.Estado != "Rechazado")
		{
			continue;
		}

		if (s.PERFIL_FINANCIERO == null)
		{
			continue;
		}

		switch (s.PERFIL_FINANCIERO.NivelRiesgo)
		{
			case "Bajo":
				bajo++;
				break;

			case "Medio":
				medio++;
				break;

			case "Alto":
				alto++;
				break;

			case "Critico":
				critico++;
				break;
		}
	}

	var maxValor = new[] { bajo, medio, alto, critico }.Max();

	var maxEscala = 10;

	while (maxEscala < maxValor)
	{
		maxEscala += 10;
	}

	decimal factorAltura = 180m / maxEscala;
	decimal montoTotal = Model
	.Where(x => x.Estado == "Aprobado")
	.Sum(x => x.MontoSolicitado);
	decimal limiteInferior = 0;
	decimal limiteSuperior = 50000;

	if (montoTotal > 50000)
	{
		limiteInferior = 50000;
		limiteSuperior = 100000;
	}

	decimal porcentaje = ((montoTotal - limiteInferior) * 100m)
						 / (limiteSuperior - limiteInferior);

	if (porcentaje < 0)
	{
		porcentaje = 0;
	}

	if (porcentaje > 100)
	{
		porcentaje = 100;
	}
	var historialOrdenado = Model
	.Where(x => x.HISTORIAL_ESTADOS != null &&
				x.HISTORIAL_ESTADOS.Any())
	.OrderByDescending(x =>
		x.HISTORIAL_ESTADOS.Max(h => h.FechaCambio))
	.ToList();

	var totalHistorial = historialOrdenado.Count;
	var visiblesHistorial = totalHistorial > 5 ? 5 : totalHistorial;

	Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
	ViewData["Title"] = "Inicio";
	ViewData["ActivePage"] = "ProgramaAnalista";
}


