@model List<trabajo.Models.SolicitudCredito>

@{
    var pendientes = Model.Count(x => x.Estado == "Pendiente");
    var evaluacion = Model.Count(x => x.Estado == "En Evaluación");
    var aprobadas = Model.Count(x => x.Estado == "Aprobado");
    var rechazadas = Model.Count(x => x.Estado == "Rechazado");
    var total = Model.Count();

    var pPendiente = total > 0 ? (pendientes * 100.0 / total) : 0;
    var pEvaluacion = total > 0 ? (evaluacion * 100.0 / total) : 0;
    var pAprobadas = total > 0 ? (aprobadas * 100.0 / total) : 0;
    var pRechazadas = total > 0 ? (rechazadas * 100.0 / total) : 0;

    var bajo = 0;
    var medio = 0;
    var alto = 0;
    var critico = 0;
    var solicitudesOrdenadas = Model
    .Where(x =>
        (x.Estado == "Aprobado" ||
         x.Estado == "Rechazado") &&
        x.HISTORIAL_ESTADOS != null &&
        x.HISTORIAL_ESTADOS.Any())
    .OrderByDescending(x =>
        x.HISTORIAL_ESTADOS.Max(h => h.FechaCambio))
    .ToList();

    var solicitudesVisibles = Model.Take(5).ToList();

    var totalSolicitudes = solicitudesOrdenadas.Count();
    var visiblesIniciales = totalSolicitudes > 5 ? 5 : totalSolicitudes;

    foreach (var s in Model)
    {
        if (s.Estado != "Aprobado" &&
            s.Estado != "Rechazado")
        {
            continue;
        }

        if (s.PERFIL_FINANCIERO == null)
        {
            continue;
        }

        switch (s.PERFIL_FINANCIERO.NivelRiesgo)
        {
            case "Bajo":
                bajo++;
                break;

            case "Medio":
                medio++;
                break;

            case "Alto":
                alto++;
                break;

            case "Critico":
                critico++;
                break;
        }
    }

    var maxValor = new[] { bajo, medio, alto, critico }.Max();

    var maxEscala = 10;

    while (maxEscala < maxValor)
    {
        maxEscala += 10;
    }

    decimal factorAltura = 180m / maxEscala;
    decimal montoTotal = Model
    .Where(x => x.Estado == "Aprobado")
    .Sum(x => x.MontoSolicitado);
    decimal limiteInferior = 0;
    decimal limiteSuperior = 50000;

    if (montoTotal > 50000)
    {
        limiteInferior = 50000;
        limiteSuperior = 100000;
    }

    decimal porcentaje = ((montoTotal - limiteInferior) * 100m)
                         / (limiteSuperior - limiteInferior);

    if (porcentaje < 0)
    {
        porcentaje = 0;
    }

    if (porcentaje > 100)
    {
        porcentaje = 100;
    }
    var historialOrdenado = Model
    .Where(x => x.HISTORIAL_ESTADOS != null &&
                x.HISTORIAL_ESTADOS.Any())
    .OrderByDescending(x =>
        x.HISTORIAL_ESTADOS.Max(h => h.FechaCambio))
    .ToList();

    var totalHistorial = historialOrdenado.Count;
    var visiblesHistorial = totalHistorial > 5 ? 5 : totalHistorial;

    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Inicio";
    ViewData["ActivePage"] = "ProgramaAnalista";
}


@section Styles {
    <link rel="stylesheet" href="~/css/analista-css/programa-analista.css" asp-append-version="true" />
}

<div class="content">

    <div class="top-bar">

        <div>
            <div class="welcome">
                Bienvenido Analista
            </div>

            <h1>
                Panel de Análisis de Riesgos
            </h1>

            <p>
                Gestiona y evalúa solicitudes de crédito.
            </p>
        </div>

        <a href="@Url.Action("PerfilAnalista", "Analista")"
           class="profile-box profile-link">

            <div class="avatar">
                <svg width="30"
                     height="30"
                     fill="white"
                     viewBox="0 0 16 16">
                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0 1c-2.33 0-7 1.17-7 3.5V14h14v-1.5C15 10.17 10.33 9 8 9z" />
                </svg>
            </div>

            <div>
                <strong>
                    @ViewBag.Analista.Nombre @ViewBag.Analista.Apellido
                </strong>
                <br />
                <span>@ViewBag.Analista.Correo</span>

                <small class="perfil-texto">
                    Ver perfil completo →
                </small>
            </div>

        </a>

    </div>

    <div class="stats">

        <div class="card-stat">

            <div class="kpi-header">
                <div class="icon-stat success">✓</div>
                <div class="kpi-title">Aprobadas</div>
            </div>

            <div class="kpi-number">
                @Model.Count(x => x.Estado == "Aprobado")
            </div>

            <div class="kpi-subtitle">
                Este mes
            </div>

        </div>

        <div class="card-stat">

            <div class="kpi-header">
                <div class="icon-stat danger">✕</div>
                <div class="kpi-title">Rechazadas</div>
            </div>

            <div class="kpi-number">
                @Model.Count(x => x.Estado == "Rechazado")
            </div>

            <div class="kpi-subtitle">
                Este mes
            </div>

        </div>

        <div class="card-stat">

            <div class="kpi-header">
                <div class="icon-stat warning">🕒</div>
                <div class="kpi-title">Pendientes</div>
            </div>

            <div class="kpi-number">
                @Model.Count(x => x.Estado == "Pendiente")
            </div>

            <div class="kpi-subtitle">
                Este mes
            </div>

        </div>

        <div class="card-stat">

            <div class="kpi-header">
                <div class="icon-stat primary">📄</div>
                <div class="kpi-title">En Evaluación</div>
            </div>

            <div class="kpi-number">
                @Model.Count(x => x.Estado == "En Evaluación")
            </div>

            <div class="kpi-subtitle">
                Este mes
            </div>

        </div>

        <div class="card-stat">

            <div class="kpi-header">

                <div class="icon-stat purple">
                    <i class="fas fa-users"></i>
                </div>

                <div class="kpi-title">
                    Clientes Atendidos
                </div>

            </div>

            <div class="kpi-number">
                @(Model.Count(x =>
                                x.Estado == "Aprobado" ||
                                x.Estado == "Rechazado"))
            </div>

            <div class="kpi-subtitle">
                Desde el inicio
            </div>

        </div>

    </div>
    <div class="dashboard-row">

        <div class="estado-card">

            <div class="estado-title">
                Solicitudes por Estado(Este mes)
            </div>

            <div class="estado-container">

                <div class="estado-chart"
                     data-gradient="conic-gradient(#f59e0b 0 @(total == 0 ? 0 : pendientes * 100 / total)%, #2563eb @(total == 0 ? 0 : pendientes * 100 / total)% @((total == 0 ? 0 : (pendientes + evaluacion) * 100 / total))%, #22c55e @((total == 0 ? 0 : (pendientes + evaluacion) * 100 / total))% @((total == 0 ? 0 : (pendientes + evaluacion + aprobadas) * 100 / total))%, #ef4444 @((total == 0 ? 0 : (pendientes + evaluacion + aprobadas) * 100 / total))% 100%)">

                    <div class="estado-center">
                        <span>Total</span>
                        <strong>@total</strong>
                    </div>

                </div>

                <div class="estado-list">

                    <div class="estado-item">
                        <div>
                            <span class="dot dot-pendiente"></span>
                            Pendiente
                        </div>
                        <div>
                            @pendientes (@pPendiente.ToString("0.0")%)
                        </div>
                    </div>

                    <div class="estado-item">
                        <div>
                            <span class="dot dot-evaluacion"></span>
                            En Evaluación
                        </div>
                        <div>
                            @evaluacion (@pEvaluacion.ToString("0.0")%)
                        </div>
                    </div>

                    <div class="estado-item">
                        <div>
                            <span class="dot dot-aprobada"></span>
                            Aprobadas
                        </div>
                        <div>
                            @aprobadas (@pAprobadas.ToString("0.0")%)
                        </div>
                    </div>

                    <div class="estado-item">
                        <div>
                            <span class="dot dot-rechazada"></span>
                            Rechazadas
                        </div>
                        <div>
                            @rechazadas (@pRechazadas.ToString("0.0")%)
                        </div>
                    </div>

                </div>

            </div>

        </div>
        <div class="riesgo-card">

            <div class="riesgo-title">
                Distribución de Riesgo(Este mes)
            </div>
            <div class="eje-y">
                <span>@maxEscala</span>
                <span>@(maxEscala * 8 / 10)</span>
                <span>@(maxEscala * 6 / 10)</span>
                <span>@(maxEscala * 4 / 10)</span>
                <span>@(maxEscala * 2 / 10)</span>
                <span>0</span>
            </div>
            <div class="riesgo-chart">

                <div class="bar-group">
                    <div class="bar bajo" data-height="@((int)(bajo * factorAltura))">
                        <div class="bar-value">@bajo</div>
                    </div>
                    <div class="bar-label">Bajo</div>
                </div>

                <div class="bar-group">
                    <div class="bar medio" data-height="@((int)(medio * factorAltura))">
                        <div class="bar-value">@medio</div>
                    </div>
                    <div class="bar-label">Medio</div>
                </div>

                <div class="bar-group">
                    <div class="bar alto" data-height="@((int)(alto * factorAltura))">
                        <div class="bar-value">@alto</div>
                    </div>
                    <div class="bar-label">Alto</div>
                </div>

                <div class="bar-group">
                    <div class="bar critico" data-height="@((int)(critico * factorAltura))">
                        <div class="bar-value">@critico</div>
                    </div>
                    <div class="bar-label">Critico</div>
                </div>

            </div>

        </div>
        <div class="monto-card">

            <div class="monto-title">
                Solicitudes por Montos Aprobados (Este mes)
            </div>

            <div class="medidor">

                <div class="medidor-externo"
                     data-gradient="conic-gradient(from 270deg, #4f46e5 0deg @(((double)porcentaje * 1.8).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))deg, #e5e7eb @(((double)porcentaje * 1.8).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))deg 180deg, transparent 180deg 360deg)">
                </div>

                <div class="medidor-interno"></div>

                <div class="medidor-texto">
                    <div class="medidor-monto">
                        S/ @montoTotal.ToString("N0")
                    </div>

                    <div class="medidor-sub">
                        Monto total evaluado
                    </div>
                </div>

            </div>
            <div class="medidor-limites">
                <span>S/ @limiteInferior.ToString("N0")</span>
                <span>S/ @limiteSuperior.ToString("N0")</span>
            </div>

        </div>



    </div>
    <div class="seccion-inferior">
        <div class="ultimas-solicitudes">

            <div class="titulo-tabla">
                📄 Últimas Solicitudes Recibidas
            </div>

            <div class="tabla-scroll">

                <table>

                    <thead>
                        <tr>
                            <th>N° Solicitud</th>
                            <th>Cliente</th>
                            <th>Monto</th>
                            <th>Fecha</th>
                            <th>Riesgo</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody>

                        @for (int i = 0; i < solicitudesOrdenadas.Count; i++)
                        {
                            var solicitud = solicitudesOrdenadas[i];
                            var ultimaEvaluacion = solicitud.HISTORIAL_ESTADOS?
                            .OrderByDescending(h => h.FechaCambio)
                            .FirstOrDefault();

                            string riesgoTexto = "Bajo";
                            string riesgoClase = "bajo";

                            if (solicitud.PERFIL_FINANCIERO != null)
                            {
                                switch (solicitud.PERFIL_FINANCIERO.NivelRiesgo)
                                {
                                    case "Medio":
                                        riesgoTexto = "Medio";
                                        riesgoClase = "medio";
                                        break;

                                    case "Alto":
                                        riesgoTexto = "Alto";
                                        riesgoClase = "alto";
                                        break;

                                    case "Critico":
                                        riesgoTexto = "Critico";
                                        riesgoClase = "critico";
                                        break;
                                }
                            }

                            <tr class="@(i >= 5 ? "fila-extra fila-oculta" : "")">

                                <td>
                                    SOL-@solicitud.Id_Solicitud.ToString("D5")
                                </td>

                                <td>
                                    @solicitud.USUARIO.Nombre
                                    @solicitud.USUARIO.Apellido
                                </td>

                                <td>
                                    S/ @solicitud.MontoSolicitado.ToString("N0")
                                </td>

                                <td>
                                    @(ultimaEvaluacion != null
                                                                    ? ultimaEvaluacion.FechaCambio.ToString("dd/MM/yyyy hh:mm tt")
                                                                    : "-")
                                </td>

                                <td>
                                    <span class="riesgo @riesgoClase">
                                        @riesgoTexto
                                    </span>
                                </td>

                                <td>
                                    <button type="button" class="btn-ver btn-detalle-programa"
                                            data-cliente="@solicitud.USUARIO.Nombre @solicitud.USUARIO.Apellido"
                                            data-dni="@solicitud.USUARIO.Dni"
                                            data-celular="@solicitud.USUARIO.Celular"
                                            data-correo="@solicitud.USUARIO.Correo"
                                            data-monto="@solicitud.MontoSolicitado.ToString("N0")"
                                            data-plazo="@solicitud.PlazoMeses"
                                            data-motivo="@(solicitud.PERFIL_FINANCIERO?.MotivoPrestamo ?? "-")"
                                            data-ocupacion="@(solicitud.PERFIL_FINANCIERO?.Ocupacion ?? "-")"
                                            data-ingreso="@(solicitud.PERFIL_FINANCIERO?.IngresoMensual.ToString("N2") ?? "0")"
                                            data-egreso="@(solicitud.PERFIL_FINANCIERO?.EgresoMensual.ToString("N2") ?? "0")"
                                            data-estado="@solicitud.Estado"
                                            data-observacion="@(ultimaEvaluacion?.MotivoCambio ?? "Sin observación")"
                                            data-solicitud="SOL-@solicitud.Id_Solicitud.ToString("D5")">
                                        👁
                                    </button>
                                </td>

                            </tr>
                        }

                    </tbody>


                </table>


            </div>
            <div id="contadorSolicitudes" class="contador-solicitudes">

                Mostrando @visiblesIniciales de @totalSolicitudes solicitudes

            </div>
            @if (totalSolicitudes > 5)
            {
                <div class="acciones-ver-mas-wrap">
                    <button type="button" id="btnVerMas" class="btn-ver-mas-solicitudes">
                        Ver más solicitudes →
                    </button>
                    <button type="button" id="btnVerMenos" class="btn-ver-menos-solicitudes btn-oculto">
                        ← Ver menos solicitudes
                    </button>
                </div>
            }

        </div>
        <div class="historial-card">

            <div class="titulo-historial">
                Historial Reciente
            </div>


            <div class="historial-scroll">

                @for (int i = 0; i < historialOrdenado.Count; i++)
                {
                    var solicitud = historialOrdenado[i];
                    var ultimaEvaluacion = solicitud.HISTORIAL_ESTADOS?
                    .OrderByDescending(h => h.FechaCambio)
                    .FirstOrDefault();

                    string iconoClase = "ok";
                    string iconoTexto = "✓";
                    string textoEstado = "aprobada";

                    switch (solicitud.Estado)
                    {
                        case "Rechazado":
                            iconoClase = "bad";
                            iconoTexto = "✕";
                            textoEstado = "rechazada";
                            break;

                        case "En Evaluación":
                            iconoClase = "eval";
                            iconoTexto = "🕒";
                            textoEstado = "en evaluación";
                            break;

                        case "Pendiente":
                            iconoClase = "wait";
                            iconoTexto = "⌛";
                            textoEstado = "pendiente";
                            break;
                    }

                    <div class="historial-item @(i >= 5 ? "historial-extra fila-oculta" : "")">

                        <div class="@iconoClase">
                            @iconoTexto
                        </div>

                        <div class="historial-contenido">

                            <div class="historial-superior">

                                <strong>
                                    Solicitud
                                    SOL-@solicitud.Id_Solicitud.ToString("D5")
                                    @textoEstado
                                </strong>

                                <span class="historial-fecha">
                                    @(ultimaEvaluacion != null
                                                                    ? ultimaEvaluacion.FechaCambio.ToString("dd/MM/yyyy hh:mm tt")
                                                                    : "-")
                                </span>

                            </div>

                            <div class="historial-detalle">

                                Cliente:
                                @solicitud.USUARIO.Nombre
                                @solicitud.USUARIO.Apellido

                                &nbsp; • &nbsp;

                                Monto:
                                S/ @solicitud.MontoSolicitado.ToString("N0")

                            </div>

                        </div>

                    </div>
                }
            </div>
            @if (totalHistorial > 5)
            {
                <div class="acciones-historial-wrap">
                    <button type="button" id="btnVerMasHistorial" class="btn-ver-mas-solicitudes">
                        Ver más historial →
                    </button>
                    <button type="button" id="btnVerMenosHistorial" class="btn-ver-menos-solicitudes btn-oculto">
                        ← Ver menos historial
                    </button>
                </div>
            }


        </div>



    </div>

</div>
</div>



<div id="modalDetallePrograma" class="modal-historial">
    <div class="modal-box">

        <div class="modal-title">
            <span id="pSolicitud"></span>
        </div>

        <div class="modal-grid">

            <div class="info-card">
                <h3>Datos personales</h3>

                <div class="fila"><span>Cliente:</span><strong id="pCliente"></strong></div>
                <div class="fila"><span>DNI:</span><strong id="pDni"></strong></div>
                <div class="fila"><span>Teléfono:</span><strong id="pCelular"></strong></div>
                <div class="fila"><span>Email:</span><strong id="pCorreo"></strong></div>
            </div>

            <div class="info-card">
                <h3>Perfil financiero</h3>

                <div class="fila"><span>Monto:</span><strong id="pMonto"></strong></div>
                <div class="fila"><span>Plazo:</span><strong id="pPlazo"></strong></div>
                <div class="fila"><span>Motivo:</span><strong id="pMotivo"></strong></div>
                <div class="fila"><span>Ocupación:</span><strong id="pOcupacion"></strong></div>
            </div>

            <div class="info-card">
                <h3>Resumen financiero</h3>

                <div class="fila"><span>Ingresos:</span><strong id="pIngreso"></strong></div>
                <div class="fila"><span>Egresos:</span><strong id="pEgreso"></strong></div>
            </div>

            <div class="info-card">
                <h3>Resultado</h3>

                <div class="fila"><span>Estado:</span><strong id="pEstado"></strong></div>
            </div>

        </div>

        <div class="observacion">
            <b>Observación del analista:</b>
            <p id="pObservacion"></p>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-aceptar" id="btnAceptarDetallePrograma">
                Aceptar
            </button>
        </div>

    </div>

@section Scripts {
    <script src="~/js/analista-js/programa-analista.js" asp-append-version="true"></script>
}
