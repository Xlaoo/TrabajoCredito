                                                onclick="abrirDetalle(
                    @solicitud.Id_Solicitud,
                    '@(solicitud.USUARIO.Nombre + " " + solicitud.USUARIO.Apellido)',
                    '@solicitud.USUARIO.Dni',
                    '@solicitud.USUARIO.Celular',
                    '@solicitud.USUARIO.Correo',
                    '@solicitud.MontoSolicitado.ToString("N0")',
                    '@solicitud.PlazoMeses',
                    '@solicitud.PERFIL_FINANCIERO?.MotivoPrestamo',
                    '@solicitud.PERFIL_FINANCIERO?.Ocupacion',
                    '@solicitud.PERFIL_FINANCIERO?.IngresoMensual.ToString("N2")',
                    '@solicitud.PERFIL_FINANCIERO?.EgresoMensual.ToString("N2")',
                    '@solicitud.Estado',
                    '@observacion')">
                                            👁
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align:center;padding:70px;">
                                    📄 No hay solicitudes rechazadas disponibles.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div id="modalDetalle" class="modal-historial">
        <div class="modal-box">
            <div class="modal-title" id="modalTitulo">Detalle de Evaluación</div>

            <div class="modal-grid">
                <div class="info-card">
                    <h3>Datos personales</h3>
                    <div class="fila"><span>Cliente:</span><strong id="mCliente"></strong></div>
                    <div class="fila"><span>DNI:</span><strong id="mDni"></strong></div>
                    <div class="fila"><span>Teléfono:</span><strong id="mCelular"></strong></div>
                    <div class="fila"><span>Email:</span><strong id="mCorreo"></strong></div>
                </div>

                <div class="info-card">
                    <h3>Perfil financiero</h3>
                    <div class="fila"><span>Monto:</span><strong id="mMonto"></strong></div>
                    <div class="fila"><span>Plazo:</span><strong id="mPlazo"></strong></div>
                    <div class="fila"><span>Motivo:</span><strong id="mMotivo"></strong></div>
                    <div class="fila"><span>Ocupación:</span><strong id="mOcupacion"></strong></div>
                </div>

                <div class="info-card">
                    <h3>Resumen financiero</h3>
                    <div class="fila"><span>Ingresos mensuales:</span><strong id="mIngreso"></strong></div>
                    <div class="fila"><span>Egresos mensuales:</span><strong id="mEgreso"></strong></div>
                </div>

                <div class="info-card">
                    <h3>Resultado</h3>
                    <div class="fila"><span>Estado:</span><strong id="mEstado"></strong></div>
                    <div class="fila"><span>N° Solicitud:</span><strong id="mSolicitud"></strong></div>
                </div>
            </div>

            <div class="observacion">
                <b>Observación del analista:</b>
                <p id="mObservacion"></p>
            </div>

            <div class="modal-actions">
                <button class="btn-aceptar" onclick="cerrarDetalle()">Aceptar</button>
                <button class="btn-mensaje" onclick="abrirMensajeDesdeHistorial()">💬 Mensaje</button>
            </div>
        </div>
    </div>
    <div id="modalChat" style="display:none;">
        <div class="chat-contenido">

            <div class="chat-header">
                <div>
                    <div class="chat-titulo">
                        💬 <span id="tituloSolicitud">Mensajes</span>
                    </div>

                    <div class="chat-subtitulo">
                        Cliente: <span id="chatCliente">-</span>
                        &nbsp; • &nbsp;
                        Estado: <span id="chatEstado">-</span>
                    </div>
                </div>

                <button type="button" class="btn-cerrar-chat" onclick="cerrarChat()">
                    ✕
                </button>
            </div>

            <div id="chatMensajes">
                <div class="chat-vacio">
                    <img src="https://cdn-icons-png.flaticon.com/512/1041/1041916.png"
                         class="chat-vacio-img" />

                    <h4>No hay mensajes todavía</h4>
                    <p>Inicia una conversación con el Usuario</p>
                </div>
            </div>

            <div class="chat-footer">

                <input type="text"
                       id="txtMensaje"
                       placeholder="Escribe tu mensaje..." />

                <div id="nombreArchivoSeleccionado" class="archivo-seleccionado"></div>

                <input type="file"
                       id="fileImagen"
                       accept="image/*"
                       style="display:none">

                <button type="button"
                        class="btn-chat-icon"
                        onclick="document.getElementById('fileImagen').click()">
                    🖼
                </button>

                <button type="button"
                        class="btn-enviar-chat"
                        onclick="enviarMensaje()">
                    ✈ Enviar
                </button>

            </div>

        </div>
    </div>

    <script>
        let solicitudSeleccionada = 0;

        function abrirDetalle(id, cliente, dni, celular, correo, monto, plazo, motivo, ocupacion, ingreso, egreso, estado, observacion) {
            solicitudSeleccionada = id;

            document.getElementById("modalTitulo").innerText =
                "Detalle de Evaluación - SOL-" + id.toString().padStart(5, "0");

            document.getElementById("mCliente").innerText = cliente;
            document.getElementById("mDni").innerText = dni;
            document.getElementById("mCelular").innerText = celular;
            document.getElementById("mCorreo").innerText = correo;
            document.getElementById("mMonto").innerText = "S/ " + monto;
            document.getElementById("mPlazo").innerText = plazo + " meses";
            document.getElementById("mMotivo").innerText = motivo;
            document.getElementById("mOcupacion").innerText = ocupacion;
            document.getElementById("mIngreso").innerText = "S/ " + ingreso;
            document.getElementById("mEgreso").innerText = "S/ " + egreso;
            document.getElementById("mEstado").innerText = estado;
            document.getElementById("mSolicitud").innerText = "SOL-" + id.toString().padStart(5, "0");
            document.getElementById("mObservacion").innerText = observacion;

            document.getElementById("modalDetalle").style.display = "flex";
        }

        function cerrarDetalle() {
            document.getElementById("modalDetalle").style.display = "none";
        }

                      function abrirMensajeDesdeHistorial() {
            console.log("Solicitud seleccionada:", solicitudSeleccionada);

            if (solicitudSeleccionada == 0 || solicitudSeleccionada == null) {
                alert("No se encontró la solicitud seleccionada.");
                return;
            }

            cerrarDetalle();

            setTimeout(function () {
                abrirChat(solicitudSeleccionada);
            }, 100);
        }
                        let imagenSeleccionada = null;

        function abrirChat(idSolicitud) {
            solicitudSeleccionada = idSolicitud;

            document.getElementById("modalChat").style.display = "flex";

            cargarInfoSolicitud(idSolicitud);
            cargarMensajes(idSolicitud);
        }


        function cargarInfoSolicitud(idSolicitud) {
            fetch('/Analista/ObtenerInfoSolicitud?idSolicitud=' + idSolicitud)
                .then(r => r.json())
                .then(data => {
                    document.getElementById("tituloSolicitud").innerHTML =
                        "Mensajes - Solicitud " + data.numeroSolicitud;

                    document.getElementById("chatCliente").innerHTML = data.cliente;
                    document.getElementById("chatEstado").innerHTML = data.estado;
                });
        }

        document.getElementById("fileImagen").addEventListener("change", function () {
            if (this.files.length > 0) {
                imagenSeleccionada = this.files[0];

                document.getElementById("nombreArchivoSeleccionado").innerHTML = `
                    <div class="archivo-preview">
                        📷 <span>${imagenSeleccionada.name}</span>
                        <button type="button" onclick="quitarImagen()">✕</button>
                    </div>
                `;
            }
        });

        function quitarImagen() {
            imagenSeleccionada = null;
            document.getElementById("fileImagen").value = "";
            document.getElementById("nombreArchivoSeleccionado").innerHTML = "";
        }

        function cerrarChat() {
            document.getElementById("modalChat").style.display = "none";
            quitarImagen();
        }

        function enviarMensaje() {
            let mensaje = document.getElementById("txtMensaje").value.trim();

            if (mensaje === "" && imagenSeleccionada == null) {
                alert("Debe escribir un mensaje o adjuntar una imagen.");
                return;
            }

            let formData = new FormData();
            formData.append("idSolicitud", solicitudSeleccionada);
            formData.append("mensaje", mensaje);

            if (imagenSeleccionada != null) {
                formData.append("imagen", imagenSeleccionada);
            }

            fetch('/Analista/EnviarMensaje', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                document.getElementById("txtMensaje").value = "";
                quitarImagen();
                cargarMensajes(solicitudSeleccionada);
            });
        }

        function verImagen(url) {
            Swal.fire({
                imageUrl: url,
                imageAlt: 'Imagen del chat',
                showConfirmButton: false,
                showCloseButton: true,
                width: '70%',
                background: '#ffffff'
            });
        }

              function cargarMensajes(idSolicitud) {
            fetch('/Analista/ObtenerMensajes?idSolicitud=' + idSolicitud)
                .then(r => r.json())
                .then(data => {

                    let html = "";

                    if (data.length === 0) {
                        html = `
                        <div class="chat-vacio">
                            <img src="https://cdn-icons-png.flaticon.com/512/1041/1041916.png"
                                 class="chat-vacio-img" />
                            <h4>No hay mensajes todavía</h4>
                            <p>Inicia una conversación con el Usuario</p>
                        </div>`;
                    }
                    else {
                        data.forEach(m => {

                            if (m.tipoUsuario === "Analista") {

                                html += `
                                <div class="mensaje-analista">
                                    <div class="chat-derecha">

                                        <div class="cabecera-derecha">
                                            <span class="nombre-chat">${m.nombre}</span>
                                            <div class="avatar-chat">
                                                <i class="fas fa-user-circle"></i>
                                            </div>
                                        </div>

                                        ${m.imagen
                                            ? `<div class="imagen-contenedor">
                                                   <img src="${m.imagen}"
                                                        class="imagen-chat"
                                                        onclick="verImagen('${m.imagen}')">
                                               </div>`
                                            : `<div class="burbuja-analista">
                                                   <div class="texto-chat">${m.mensaje}</div>
                                               </div>`
                                        }

                                        ${m.imagen && m.mensaje !== "[Imagen]"
                                            ? `<div class="burbuja-analista" style="margin-top:6px;">
                                                   <div class="texto-chat">${m.mensaje}</div>
                                               </div>`
                                            : ''
                                        }

                                        <div class="fecha-chat fecha-derecha">${m.fecha}</div>
                                    </div>
                                </div>`;
                            }
                            else {

                                html += `
                                <div class="mensaje-cliente">

                                    <div class="avatar-chat">
                                        <i class="fas fa-user-circle"></i>
                                    </div>

                                    <div>
                                        <div class="nombre-chat">${m.nombre}</div>

                                        ${m.imagen
                                            ? `<div class="imagen-contenedor">
                                                   <img src="${m.imagen}"
                                                        class="imagen-chat"
                                                        onclick="verImagen('${m.imagen}')">
                                               </div>`
                                            : `<div class="burbuja-cliente">
                                                   <div class="texto-chat">${m.mensaje}</div>
                                               </div>`
                                        }

                                        ${m.imagen && m.mensaje !== "[Imagen]"
                                            ? `<div class="burbuja-cliente" style="margin-top:6px;">
                                                   <div class="texto-chat">${m.mensaje}</div>
                                               </div>`
                                            : ''
                                        }

                                        <div class="fecha-chat">${m.fecha}</div>
                                    </div>

                                </div>`;
                            }

                        });
                    }

                    document.getElementById("chatMensajes").innerHTML = html;
                });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
