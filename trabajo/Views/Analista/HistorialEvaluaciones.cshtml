@model List<trabajo.Models.SolicitudCredito>

@{
    Layout = null;
    var aprobadas = Model
    .Where(x => x.Estado == "Aprobado")
    .ToList();

    var rechazadas = Model
        .Where(x => x.Estado == "Rechazado")
        .ToList();

    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Historial Evaluaciones";
    ViewData["ActivePage"] = "HistorialEvaluaciones";
}

