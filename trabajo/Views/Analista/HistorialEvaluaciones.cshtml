        <div class="content">
            <div class="contenedor">
                <h1>Solicitudes Aprobadas</h1>

                <div class="total">
                    Total registros: @aprobadas.Count()
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>N° Solicitud</th>
                            <th>Cliente</th>
                            <th>Monto</th>
                            <th>Plazo</th>
                            <th>Fecha</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (aprobadas.Any())
                        {
                            foreach (var solicitud in aprobadas)
                            {
                                var evaluacion = ViewBag.Evaluaciones != null
                                ? ((List<trabajo.Models.Evaluacion_Riesgo>)ViewBag.Evaluaciones)
                                .FirstOrDefault(x => x.SOLICITUD_CREDITO_Id_Solicitud == solicitud.Id_Solicitud)
                                : null;

                                var observacion = evaluacion?.Observacion ?? "Sin observación";
                                var ultimaFecha = solicitud.HISTORIAL_ESTADOS?
                                .OrderByDescending(h => h.FechaCambio)
                                .FirstOrDefault()?.FechaCambio ?? solicitud.FechaSolicitud;

                                <tr>
                                    <td>SOL-@solicitud.Id_Solicitud.ToString("D5")</td>
                                    <td>@solicitud.USUARIO.Nombre @solicitud.USUARIO.Apellido</td>
                                    <td>S/ @solicitud.MontoSolicitado.ToString("N0")</td>
                                    <td>@solicitud.PlazoMeses meses</td>
                                    <td>@ultimaFecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="acciones-historial">
                                        <button type="button"
                                                class="btn-ojo"
                                                onclick="abrirDetalle(
                    @solicitud.Id_Solicitud,
                    '@(solicitud.USUARIO.Nombre + " " + solicitud.USUARIO.Apellido)',
                    '@solicitud.USUARIO.Dni',
                    '@solicitud.USUARIO.Celular',
                    '@solicitud.USUARIO.Correo',
                    '@solicitud.MontoSolicitado.ToString("N0")',
                    '@solicitud.PlazoMeses',
                    '@solicitud.PERFIL_FINANCIERO?.MotivoPrestamo',
                    '@solicitud.PERFIL_FINANCIERO?.Ocupacion',
                    '@solicitud.PERFIL_FINANCIERO?.IngresoMensual.ToString("N2")',
                    '@solicitud.PERFIL_FINANCIERO?.EgresoMensual.ToString("N2")',
                    '@solicitud.Estado',
                    '@observacion')">
                                            👁
                                        </button>
                                        <div class="dropdown d-inline">
                                            <button class="btn-cronograma" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-file-invoice"></i>
                                            </button>

                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-controller="Analista"
                                                       asp-action="CronogramaEvaluacionPdf"
                                                       asp-route-idSolicitud="@solicitud.Id_Solicitud"
                                                       target="_blank">
                                                        <i class="fas fa-file-pdf text-danger"></i> PDF
                                                    </a>
                                                </li>

                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-controller="Analista"
                                                       asp-action="CronogramaEvaluacionExcel"
                                                       asp-route-idSolicitud="@solicitud.Id_Solicitud">
                                                        <i class="fas fa-file-excel text-success"></i> Excel
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align:center;padding:70px;">
                                    📄 No hay solicitudes aprobadas disponibles.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <br /><br />

                <h1>Solicitudes Rechazadas</h1>

                <div class="total">
                    Total registros: @rechazadas.Count()
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>N° Solicitud</th>
                            <th>Cliente</th>
                            <th>Monto</th>
                            <th>Plazo</th>
                            <th>Fecha</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (rechazadas.Any())
                        {
                            foreach (var solicitud in rechazadas)
                            {
                                var evaluacion = ViewBag.Evaluaciones != null
