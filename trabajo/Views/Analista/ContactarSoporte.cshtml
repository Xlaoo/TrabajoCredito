@{
    Layout = null;

    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Contactar Soporte";
    ViewData["ActivePage"] = "ContactarSoporte";

    int idAdministrador = ViewBag.IdAdministrador == null ? 0 : Convert.ToInt32(ViewBag.IdAdministrador);
    int idAnalista = ViewBag.IdAnalista == null ? 0 : Convert.ToInt32(ViewBag.IdAnalista);
    string nombreAdministrador = ViewBag.NombreAdministrador as string ?? "Administrador";
    int mensajesAdminNoLeidos = ViewBag.MensajesAdminNoLeidos == null ? 0 : Convert.ToInt32(ViewBag.MensajesAdminNoLeidos);

    var mensajesAdmin = ViewBag.ChatAdminMensajes as System.Collections.Generic.List<trabajo.Models.ViewModels.AdminAnalistaMensajeViewModel>
        ?? new System.Collections.Generic.List<trabajo.Models.ViewModels.AdminAnalistaMensajeViewModel>();

    bool chatBloqueado = idAdministrador <= 0 || idAnalista <= 0;
}

