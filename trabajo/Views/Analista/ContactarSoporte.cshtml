    <main class="content">

        <div class="top-soporte">
            <div>
                <h1>Centro de Soporte</h1>
                <p>Estamos aquí para ayudarte. Envía tu consulta o comunícate por nuestros canales.</p>
            </div>

            <a href="@Url.Action("PerfilAnalista", "Analista")" class="perfil-analista perfil-link">
                <div class="perfil-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <div>
                    <strong>@ViewBag.NombreAnalista</strong><br />
                    <span>@ViewBag.CorreoAnalista</span>
                    <small>Ver perfil completo</small>
                </div>
            </a>
        </div>

        <div class="contact-grid">

            <div class="contact-card">
                <div class="contact-icon email">
                    <i class="fas fa-envelope"></i>
                </div>
                <div>
                    <h3>Correo Electrónico</h3>
                    <p>soporte@crediplus.com</p>
                    <small>Respuesta en menos de 24 horas.</small>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon whatsapp">
                    <i class="fab fa-whatsapp"></i>
                </div>
                <div>
                    <h3>WhatsApp</h3>
                    <p>+51 987 654 321</p>
                    <small>Lun a Vie de 8:00 am a 6:00 pm</small>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon horario">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <h3>Horario de Atención</h3>
                    <p>Lunes a Viernes<br />8:00 am - 6:00 pm</p>
                    <small>Sábados 8:00 am - 1:00 pm</small>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon telefono">
                    <i class="fas fa-headset"></i>
                </div>
                <div>
                    <h3>Llamada Telefónica</h3>
                    <p>(01) 123 4567</p>
                    <small>Lun a Vie de 8:00 am a 6:00 pm</small>
                </div>
            </div>

        </div>

        <div class="soporte-grid">

            <section class="panel">
                <div class="panel-title">
                    <i class="fas fa-comments"></i>
                    <div>
                        <h2>Envía una solicitud de soporte</h2>
                        <p>Completa el formulario y nuestro equipo te ayudará.</p>
                    </div>
                </div>

                <form onsubmit="enviarSoporte(event)">
                    <label>Asunto</label>
                    <input type="text" id="asunto" placeholder="Escribe el asunto de tu consulta" required />

                    <label>Tipo de consulta</label>
                    <select id="tipoConsulta" required>
                        <option value="">Selecciona una opción</option>
                        <option>Error del sistema</option>
                        <option>Problema con solicitudes</option>
                        <option>Gestión de pagos</option>
                        <option>Evaluación de riesgo</option>
                        <option>Cuenta de usuario</option>
                        <option>Otro</option>
                    </select>

                    <label>Mensaje</label>
                    <textarea id="mensaje" maxlength="500" oninput="actualizarContador()" placeholder="Describe tu problema o consulta con el mayor detalle posible..." required></textarea>
                    <div class="contador"><span id="contadorMensaje">0</span>/500</div>

                    <div class="acciones-soporte">
                        <button type="submit" class="btn-enviar">
                            <i class="fas fa-paper-plane"></i>
                            Enviar Solicitud
                        </button>

                        <button type="button"
                                class="btn-chat-admin @(mensajesAdminNoLeidos > 0 ? "tiene-alerta" : "")"
                                id="btnChatAdmin"
                                onclick="abrirChatAdmin()"
                                disabled="@(chatBloqueado ? "disabled" : null)">
                            <i class="fas fa-user-shield"></i>
                            Chat con el admin
                            <span id="badgeChatAdmin"
                                  class="chat-admin-alert-badge @(mensajesAdminNoLeidos > 0 ? "" : "oculto")">
                                @mensajesAdminNoLeidos
                            </span>
                        </button>
                    </div>

                    <div id="mensajeOk" class="mensaje-ok">
                        ✅ Solicitud enviada correctamente. Soporte revisará tu caso.
                    </div>
                </form>
            </section>

            <section class="panel">
                <div class="panel-title">
                    <i class="fas fa-question"></i>
                    <div>
                        <h2>Preguntas Frecuentes</h2>
                        <p>Encuentra respuestas rápidas para el trabajo del analista.</p>
                    </div>
                </div>

                <div class="faq-list">

                    <div class="faq-item" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>¿Cómo puedo restablecer mi contraseña?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Ingresa a “Olvidé mi contraseña”, coloca tu DNI y registra una nueva clave. Si el DNI no existe, debes reportarlo al administrador.
                        </p>
                    </div>

                    <div class="faq-item" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>No puedo ver mis solicitudes pendientes</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Verifica que la solicitud tenga estado “Pendiente”. Si está “En Evaluación”, “Aprobado” o “Rechazado”, aparecerá en otra sección.
                        </p>
                    </div>

                    <div class="faq-item" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>Error al aprobar una evaluación</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Revisa que la solicitud tenga perfil financiero, usuario vinculado y datos completos. Luego vuelve a intentar la aprobación.
                        </p>
                    </div>

                    <div class="faq-item" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>Problemas con la carga de documentos</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Valida que el archivo no esté dañado y que el cliente haya completado todos los campos requeridos antes de enviar la solicitud.
                        </p>
                    </div>

                    <div class="faq-item" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>Métodos de pago no disponibles</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Verifica que el cliente haya registrado correctamente el método, entidad, número y titular en su solicitud de préstamo.
                        </p>
                    </div>

                    <div class="faq-item faq-extra" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>¿Cuándo debo rechazar una solicitud?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Cuando el cliente presente riesgo crítico, información falsa, historial vencido grave o datos financieros inconsistentes.
                        </p>
                    </div>

                    <div class="faq-item faq-extra" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>¿Cuándo enviar una propuesta alternativa?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Cuando el cliente no califica para el monto solicitado, pero sí puede asumir un monto menor o un plazo diferente.
                        </p>
                    </div>

                    <div class="faq-item faq-extra" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>¿Qué hago si el cliente registra datos incorrectos?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Observa la solicitud o envía un mensaje solicitando corrección. No apruebes solicitudes con datos incompletos.
                        </p>
                    </div>

                    <div class="faq-item faq-extra" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>¿Cómo validar el pago de una cuota?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Revisa método, entidad, código de operación, fecha y monto pagado. Si coincide, el pago puede aprobarse.
                        </p>
                    </div>

                    <div class="faq-item faq-extra" onclick="toggleFaq(this)">
                        <div class="faq-pregunta">
                            <span>¿Qué pasa si apruebo por error?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Reporta el caso a soporte o al administrador para revisar la solicitud y corregir el estado si corresponde.
                        </p>
                    </div>

                </div>

                <button type="button" class="btn-faq" onclick="mostrarMasFaq()">
                    <span id="textoFaq">Ver todas las preguntas</span>
                    <i class="fas fa-chevron-right" style="margin-left:12px;"></i>
                </button>
            </section>

        </div>

        <div class="bottom-soporte">

            <div class="bottom-item compromiso-pro">
                <div class="soporte-persona">
                    <i class="fas fa-headset"></i>
                    <span><i class="fas fa-comment-dots"></i></span>
                </div>

                <div>
                    <h3>Nuestro compromiso</h3>
                    <p>
                        En CrediPlus nos esforzamos por brindarte la mejor atención.
                        Nuestro equipo está disponible para ayudarte ante cualquier inconveniente.
                    </p>
                    <small>Tu satisfacción y confianza son nuestra prioridad.</small>
                </div>
            </div>

            <div class="bottom-item seguridad-pro">
                <div class="bottom-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div>
                    <h3>Seguridad y Confidencialidad</h3>
                    <p>Tu información está protegida y será tratada de manera confidencial.</p>
                </div>
            </div>

        </div>

    </main>
</div>



<div class="chat-admin-overlay" id="modalChatAdmin" onclick="cerrarChatAdminDesdeFondo(event)">
    <div class="chat-admin-modal">
        <div class="chat-admin-header">
            <div class="chat-admin-title">
                <div class="chat-admin-title-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div>
                    <h3>Chat con el administrador</h3>
                    <p>Comunicación directa y en tiempo real</p>
                </div>
            </div>

            <button type="button" class="chat-admin-close" onclick="cerrarChatAdmin()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="chat-admin-status-row">
            <span>
                Administrador: <strong>@nombreAdministrador</strong>
            </span>
            <span class="chat-admin-status" id="chatAdminEstado">
                <i class="fas fa-circle-notch fa-spin"></i>
                Preparando chat
            </span>
        </div>

        <div class="chat-admin-messages" id="chatAdminMensajes">
            @if (mensajesAdmin.Any())
            {
                foreach (var mensajeChat in mensajesAdmin)
                {
                    var claseMensaje = mensajeChat.RemitenteRol == "Analista" ? "analista" : "admin";

                    <div class="chat-admin-message @claseMensaje">
                        <div class="chat-admin-bubble">@mensajeChat.Mensaje</div>
                        <div class="chat-admin-meta">
                            @mensajeChat.RemitenteRol · @mensajeChat.FechaEnvio.ToString("dd/MM/yyyy hh:mm tt")
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="chat-admin-empty" id="chatAdminVacio">
                    <i class="far fa-comments"></i>
                    <strong>Aún no hay mensajes</strong>
                    <span>Escribe al administrador para iniciar la conversación.</span>
                </div>
            }
        </div>

        <form class="chat-admin-form" id="formChatAdmin">
            <input type="text"
                   id="mensajeAdminInput"
                   autocomplete="off"
                   placeholder="Escribe un mensaje para el administrador..."
                   disabled="@(chatBloqueado ? "disabled" : null)" />

            <button type="submit"
                    class="chat-admin-send"
                    id="btnEnviarAdmin"
                    disabled="@(chatBloqueado ? "disabled" : null)">
                <i class="fas fa-paper-plane"></i>
            </button>
        </form>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>
    function actualizarContador() {
    let mensaje = document.getElementById("mensaje").value;
    document.getElementById("contadorMensaje").innerText = mensaje.length;
    }

    function enviarSoporte(event) {
    event.preventDefault();

    document.getElementById("mensajeOk").classList.add("activo");

    document.getElementById("asunto").value = "";
    document.getElementById("tipoConsulta").value = "";
    document.getElementById("mensaje").value = "";
    document.getElementById("contadorMensaje").innerText = "0";

    setTimeout(() => {
    document.getElementById("mensajeOk").classList.remove("activo");
    }, 4000);
    }
    function toggleFaq(elemento) {
    elemento.classList.toggle("abierto");
    }

    function mostrarMasFaq() {
    let lista = document.querySelector(".faq-list");
    let texto = document.getElementById("textoFaq");

    lista.classList.toggle("mostrar-todo");

    if (lista.classList.contains("mostrar-todo")) {
    texto.innerText = "Ver menos preguntas";
    } else {
    texto.innerText = "Ver todas las preguntas";
    }
    }


    const idAdministradorChat = @idAdministrador;
    const idAnalistaChat = @idAnalista;
    const remitenteChat = "Analista";
    let chatAdminConnection = null;
    let chatAdminIniciado = false;

    const modalChatAdmin = document.getElementById("modalChatAdmin");
    const chatAdminMensajes = document.getElementById("chatAdminMensajes");
    const formChatAdmin = document.getElementById("formChatAdmin");
    const mensajeAdminInput = document.getElementById("mensajeAdminInput");
    const btnEnviarAdmin = document.getElementById("btnEnviarAdmin");
    const chatAdminEstado = document.getElementById("chatAdminEstado");
    const btnChatAdmin = document.getElementById("btnChatAdmin");
    const badgeChatAdmin = document.getElementById("badgeChatAdmin");

    function chatAdminEstaAbierto() {
    return modalChatAdmin && modalChatAdmin.classList.contains("show");
    }

    function actualizarBadgeChatAdmin(total) {
    const cantidad = Number(total || 0);
    const badgeLayout = document.getElementById("badgeChatAdminLayout");
    const linkLayout = document.getElementById("linkContactarSoporte");

    if (badgeChatAdmin && btnChatAdmin) {
    if (cantidad > 0) {
    badgeChatAdmin.textContent = cantidad > 99 ? "99+" : cantidad;
    badgeChatAdmin.classList.remove("oculto");
    btnChatAdmin.classList.add("tiene-alerta");
    } else {
    badgeChatAdmin.textContent = "0";
    badgeChatAdmin.classList.add("oculto");
    btnChatAdmin.classList.remove("tiene-alerta");
    }
    }

    if (badgeLayout && linkLayout) {
    if (cantidad > 0) {
    badgeLayout.textContent = cantidad > 99 ? "99+" : cantidad;
    badgeLayout.classList.remove("oculto");
    linkLayout.classList.add("tiene-alerta-admin");
    } else {
    badgeLayout.textContent = "0";
    badgeLayout.classList.add("oculto");
    linkLayout.classList.remove("tiene-alerta-admin");
    }
    }
    }

    async function consultarNotificacionesChatAdmin() {
    if (!idAdministradorChat || !idAnalistaChat) return;

    try {
    const respuesta = await fetch("/Analista/ChatAdminNoLeidos", {
    method: "GET",
    credentials: "same-origin"
    });

    const data = await respuesta.json();

    if (data.ok) {
    actualizarBadgeChatAdmin(data.total);
    }
    } catch (e) {
    console.log("No se pudo consultar notificaciones del chat admin.");
    }
    }

    async function marcarChatAdminLeido() {
    if (!idAdministradorChat || !idAnalistaChat) return;

    try {
    const respuesta = await fetch("/Analista/MarcarChatAdminLeido", {
    method: "POST",
    credentials: "same-origin"
    });

    const data = await respuesta.json();

    if (data.ok) {
    actualizarBadgeChatAdmin(0);
    }
    } catch (e) {
    console.log("No se pudo marcar el chat admin como leído.");
    }
    }

    function abrirChatAdmin() {
    if (!modalChatAdmin) return;

    modalChatAdmin.classList.add("show");
    document.body.style.overflow = "hidden";
    scrollChatAdminFinal();
    iniciarChatAdminTiempoReal();
    marcarChatAdminLeido();

    if (mensajeAdminInput && !mensajeAdminInput.disabled) {
    setTimeout(() => mensajeAdminInput.focus(), 250);
    }
    }

    function cerrarChatAdmin() {
    if (!modalChatAdmin) return;

    modalChatAdmin.classList.remove("show");
    document.body.style.overflow = "";
    }

    function cerrarChatAdminDesdeFondo(event) {
    if (event.target === modalChatAdmin) {
    cerrarChatAdmin();
    }
    }

    function scrollChatAdminFinal() {
    if (chatAdminMensajes) {
    chatAdminMensajes.scrollTop = chatAdminMensajes.scrollHeight;
    }
    }

    function cambiarEstadoChatAdmin(texto, icono, color) {
    if (!chatAdminEstado) return;

    chatAdminEstado.innerHTML = `<i class="${icono}"></i> ${texto}`;
    chatAdminEstado.style.color = color;
    }

    function agregarMensajeChatAdmin(remitente, mensaje, fechaEnvio) {
    if (!chatAdminMensajes) return;

    const vacio = document.getElementById("chatAdminVacio");
    if (vacio) vacio.remove();

    const clase = remitente === "Analista" ? "analista" : "admin";

    const contenedor = document.createElement("div");
    contenedor.className = "chat-admin-message " + clase;

    const burbuja = document.createElement("div");
    burbuja.className = "chat-admin-bubble";
    burbuja.textContent = mensaje;

    const meta = document.createElement("div");
    meta.className = "chat-admin-meta";
    meta.textContent = remitente + " · " + fechaEnvio;

    contenedor.appendChild(burbuja);
    contenedor.appendChild(meta);
    chatAdminMensajes.appendChild(contenedor);

    scrollChatAdminFinal();
    }

    async function iniciarChatAdminTiempoReal() {
    if (chatAdminIniciado) return;

    if (!idAdministradorChat || !idAnalistaChat) {
    cambiarEstadoChatAdmin("Chat no disponible", "fas fa-circle-xmark", "#ef4444");
    return;
    }

    chatAdminIniciado = true;

    chatAdminConnection = new signalR.HubConnectionBuilder()
    .withUrl("/chatAnalistaHub")
    .withAutomaticReconnect()
    .build();

    chatAdminConnection.on("RecibirMensaje", function (data) {
    agregarMensajeChatAdmin(data.remitenteRol, data.mensaje, data.fechaEnvio);

    if (data.remitenteRol === "Administrador") {
    if (chatAdminEstaAbierto()) {
    marcarChatAdminLeido();
    } else {
    consultarNotificacionesChatAdmin();
    }
    }
    });

    chatAdminConnection.onreconnecting(function () {
    cambiarEstadoChatAdmin("Reconectando", "fas fa-circle-notch fa-spin", "#f59e0b");
    });

    chatAdminConnection.onreconnected(function () {
    chatAdminConnection.invoke("UnirseConversacion", idAdministradorChat, idAnalistaChat);
    cambiarEstadoChatAdmin("Conectado", "fas fa-circle", "#16a34a");
    });

    chatAdminConnection.onclose(function () {
    cambiarEstadoChatAdmin("Desconectado", "fas fa-circle", "#ef4444");
    chatAdminIniciado = false;
    });

    try {
    await chatAdminConnection.start();
    await chatAdminConnection.invoke("UnirseConversacion", idAdministradorChat, idAnalistaChat);
    cambiarEstadoChatAdmin("Conectado", "fas fa-circle", "#16a34a");
    scrollChatAdminFinal();
    } catch (error) {
    console.error("Error SignalR:", error);
    cambiarEstadoChatAdmin("Error de conexión", "fas fa-circle", "#ef4444");
    chatAdminIniciado = false;
    }
    }

    if (formChatAdmin) {
    formChatAdmin.addEventListener("submit", function (event) {
    event.preventDefault();

    if (!chatAdminConnection) {
    iniciarChatAdminTiempoReal();
    return;
    }

    const texto = mensajeAdminInput.value.trim();
    if (!texto) return;

    btnEnviarAdmin.disabled = true;

    chatAdminConnection.invoke("EnviarMensaje", idAdministradorChat, idAnalistaChat, remitenteChat, texto)
    .then(function () {
    mensajeAdminInput.value = "";
    })
    .catch(function (error) {
    console.error("Error enviando mensaje:", error);
    alert("No se pudo enviar el mensaje. Revisa la conexión del chat.");
    })
    .finally(function () {
    btnEnviarAdmin.disabled = false;
    mensajeAdminInput.focus();
    });
    });
    }

    document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && modalChatAdmin && modalChatAdmin.classList.contains("show")) {
    cerrarChatAdmin();
    }
    });

    scrollChatAdminFinal();
    consultarNotificacionesChatAdmin();
    iniciarChatAdminTiempoReal();
    setInterval(consultarNotificacionesChatAdmin, 10000);

</script>
@* </body>
</html> *@