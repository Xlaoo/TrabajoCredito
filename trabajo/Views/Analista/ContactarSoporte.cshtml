    .content {
        flex: 1;
        padding: 35px 45px;
    }

    .top-soporte {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
    }

    h1 {
        color: #4c1d95;
        font-size: 42px;
        font-weight: 900;
    }

    .top-soporte p {
        color: #6b7280;
        margin-top: 8px;
        font-size: 15px;
    }

    .perfil-analista {
        background: white;
        border-radius: 20px;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 12px 30px rgba(124,58,237,.10);
    }

    .perfil-avatar {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: #7c3aed;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .perfil-analista strong {
        color: #241041;
        font-size: 15px;
    }

    .perfil-analista span {
        color: #6b7280;
        font-size: 13px;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
        margin-bottom: 28px;
    }

    .contact-card {
        background: white;
        border-radius: 22px;
        padding: 28px;
        min-height: 170px;
        display: flex;
        gap: 18px;
        align-items: flex-start;
        box-shadow: 0 12px 30px rgba(124,58,237,.08);
        border: 1px solid #eee;
    }

    .contact-icon {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        flex-shrink: 0;
    }

        .contact-icon.email {
            background: #7c3aed;
        }

        .contact-icon.whatsapp {
            background: #22c55e;
        }

        .contact-icon.horario {
            background: #2563eb;
        }

        .contact-icon.telefono {
            background: #f59e0b;
        }

    .contact-card h3 {
        color: #4c1d95;
        font-size: 18px;
        margin-bottom: 10px;
    }

    .contact-card p {
        color: #374151;
        line-height: 1.6;
        font-weight: 600;
    }

    .contact-card small {
        display: block;
        color: #6d28d9;
        margin-top: 18px;
        font-weight: 900;
    }

    .soporte-grid {
        display: grid;
        grid-template-columns: 1.15fr .95fr;
        gap: 28px;
    }

    .panel {
        background: white;
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(124,58,237,.08);
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 24px;
    }

        .panel-title i {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #6d28d9;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .panel-title h2 {
            color: #4c1d95;
            font-size: 22px;
        }

        .panel-title p {
            color: #6b7280;
            margin-top: 4px;
        }

    label {
        display: block;
        color: #241041;
        font-weight: 800;
        margin-bottom: 8px;
        margin-top: 14px;
    }

    input,
    select,
    textarea {
        width: 100%;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 14px;
        outline: none;
        font-size: 14px;
        font-family: 'Segoe UI';
    }

    textarea {
        height: 135px;
        resize: none;
    }

    .contador {
        text-align: right;
        color: #6b7280;
        font-size: 13px;
        margin-top: 6px;
    }

    .btn-enviar {
        margin: 20px auto 0;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #4c1d95);
        color: white;
        border-radius: 12px;
        padding: 15px 48px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        box-shadow: 0 14px 28px rgba(109,40,217,.25);
    }

    .faq-item {
        border: 1px solid #e5d4ff;
        padding: 16px 18px;
        border-radius: 14px;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #241041;
        font-weight: 700;
        background: #fff;
    }

        .faq-item i {
            color: #6d28d9;
        }

    .btn-faq {
        margin: 18px auto 0;
        display: flex;
        border: 1px solid #c4b5fd;
        background: white;
        color: #5b21b6;
        padding: 14px 35px;
        border-radius: 12px;
        font-weight: 900;
        cursor: pointer;
    }

    .bottom-soporte {
        margin-top: 28px;
        background: linear-gradient(135deg, #f5f3ff, #ffffff);
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(124,58,237,.08);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 35px;
    }

    .bottom-item {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .bottom-icon {
        width: 86px;
        height: 86px;
        border-radius: 50%;
        background: #ede9fe;
        color: #6d28d9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
    }

    .bottom-item h3 {
        color: #4c1d95;
        font-size: 20px;
    }

    .bottom-item p {
        color: #374151;
        margin-top: 8px;
        line-height: 1.6;
    }

    .mensaje-ok {
        display: none;
        margin-top: 18px;
        background: #dcfce7;
        color: #15803d;
        border-radius: 12px;
        padding: 14px;
        font-weight: 900;
        text-align: center;
    }

        .mensaje-ok.activo {
            display: block;
        }

    .faq-list {
        max-height: 430px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .faq-item {
        border: 1px solid #e5d4ff;
        padding: 0;
        border-radius: 14px;
        margin-bottom: 12px;
        background: #fff;
        overflow: hidden;
        cursor: pointer;
    }

    .faq-pregunta {
        padding: 16px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #241041;
        font-weight: 800;
    }

        .faq-pregunta i {
            color: #6d28d9;
            transition: .3s;
        }

    .faq-respuesta {
        display: none;
        padding: 0 18px 16px;
        color: #6b7280;
        line-height: 1.5;
        font-size: 14px;
    }

    .faq-item.abierto {
        background: #faf5ff;
        border-color: #c4b5fd;
    }

        .faq-item.abierto .faq-respuesta {
            display: block;
        }

        .faq-item.abierto .faq-pregunta i {
            transform: rotate(90deg);
        }

    .faq-extra {
        display: none;
    }

    .faq-list.mostrar-todo .faq-extra {
        display: block;
    }

    .soporte-persona {
        position: relative;
        width: 95px;
        height: 95px;
        min-width: 95px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ede9fe, #ffffff);
        color: #6d28d9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 46px;
        box-shadow: inset 0 0 0 8px rgba(124,58,237,.08);
    }

        .soporte-persona span {
            position: absolute;
            right: -4px;
            top: 16px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #a78bfa;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

    .compromiso-pro {
        background: linear-gradient(135deg, #ffffff, #f5f3ff);
        border-radius: 22px;
    }

        .compromiso-pro small {
            display: block;
            margin-top: 8px;
            color: #6d28d9;
            font-weight: 800;
        }

    .seguridad-pro {
        background: linear-gradient(135deg, #ffffff, #f8f5ff);
        border-radius: 22px;
    }

    .perfil-link {
        text-decoration: none;
        cursor: pointer;
        transition: .25s;
    }

        .perfil-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 35px rgba(124,58,237,.18);
        }

        .perfil-link small {
            display: block;
            margin-top: 5px;
            color: #6d28d9;
            font-size: 12px;
            font-weight: 800;
        }


    .acciones-soporte {
        margin-top: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

        .acciones-soporte .btn-enviar {
            margin: 0;
        }

    .btn-chat-admin {
        position: relative;
        border: none;
        background: linear-gradient(135deg, #7c3aed, #5b21b6);
        color: white;
        border-radius: 12px;
        padding: 15px 34px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        box-shadow: 0 14px 28px rgba(109,40,217,.25);
        transition: .25s;
    }

    .chat-admin-alert-badge {
        position: absolute;
        top: -9px;
        right: -9px;
        min-width: 24px;
        height: 24px;
        padding: 0 7px;
        border-radius: 999px;
        background: #ef4444;
        color: #ffffff;
        border: 3px solid #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 950;
        line-height: 1;
        box-shadow: 0 10px 22px rgba(239, 68, 68, .38);
        animation: pulsoChatAdmin 1.2s infinite;
    }

        .chat-admin-alert-badge.oculto {
            display: none;
        }

    @@keyframes pulsoChatAdmin {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, .55);
        }

        70% {
            transform: scale(1.08);
            box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }
    }

    .btn-chat-admin.tiene-alerta {
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        box-shadow: 0 18px 34px rgba(239, 68, 68, .30);
    }

    .btn-chat-admin:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 34px rgba(109,40,217,.32);
    }

    .btn-chat-admin:disabled {
        opacity: .55;
        cursor: not-allowed;
        transform: none;
    }

    .chat-admin-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, .58);
        backdrop-filter: blur(5px);
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 22px;
    }

        .chat-admin-overlay.show {
            display: flex;
        }

    .chat-admin-modal {
        width: min(760px, 96vw);
        height: min(720px, 92vh);
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 30px 70px rgba(31, 11, 74, .28);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1px solid #eee7ff;
    }

    .chat-admin-header {
        padding: 20px 22px;
        background: linear-gradient(135deg, #6d28d9, #4c1d95);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .chat-admin-title {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .chat-admin-title-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: rgba(255,255,255,.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .chat-admin-title h3 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
    }

    .chat-admin-title p {
        margin: 3px 0 0;
        font-size: 12px;
        color: #ddd6fe;
        font-weight: 700;
    }

    .chat-admin-close {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,.14);
        color: #ffffff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .chat-admin-status-row {
        padding: 12px 22px;
        background: #faf7ff;
        border-bottom: 1px solid #eee7ff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: #6b7280;
        font-size: 12px;
        font-weight: 800;
    }

    .chat-admin-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #6d28d9;
    }

    .chat-admin-messages {
        flex: 1;
        padding: 22px;
        overflow-y: auto;
        background: linear-gradient(180deg, #ffffff 0%, #faf7ff 100%);
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .chat-admin-empty {
        height: 100%;
        min-height: 260px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #6b7280;
        gap: 10px;
    }

        .chat-admin-empty i {
            font-size: 44px;
            color: #a78bfa;
        }

    .chat-admin-message {
        max-width: 76%;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .chat-admin-message.analista {
            align-self: flex-end;
            align-items: flex-end;
        }

        .chat-admin-message.admin {
            align-self: flex-start;
            align-items: flex-start;
        }

    .chat-admin-bubble {
        padding: 12px 15px;
        border-radius: 17px;
        font-size: 14px;
        line-height: 1.45;
        word-break: break-word;
    }

    .chat-admin-message.analista .chat-admin-bubble {
        background: #6d28d9;
        color: #ffffff;
        border-bottom-right-radius: 5px;
    }

    .chat-admin-message.admin .chat-admin-bubble {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #e9e2ff;
        border-bottom-left-radius: 5px;
    }

    .chat-admin-meta {
        font-size: 11px;
        color: #94a3b8;
        font-weight: 800;
    }

    .chat-admin-form {
        border-top: 1px solid #eee7ff;
        background: #ffffff;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .chat-admin-form input {
            flex: 1;
            width: auto;
            height: 48px;
            border: 1px solid #ddd6fe;
            border-radius: 999px;
            padding: 0 16px;
            outline: none;
            font-size: 14px;
        }

            .chat-admin-form input:focus {
                border-color: #7c3aed;
                box-shadow: 0 0 0 3px rgba(124,58,237,.12);
            }

    .chat-admin-send {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: none;
        background: #6d28d9;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        cursor: pointer;
        flex-shrink: 0;
    }

        .chat-admin-send:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    @@media (max-width: 700px) {
        .acciones-soporte {
            flex-direction: column;
        }

            .acciones-soporte .btn-enviar,
            .btn-chat-admin {
                width: 100%;
                justify-content: center;
            }

        .chat-admin-modal {
            height: 94vh;
            border-radius: 18px;
        }

        .chat-admin-message {
            max-width: 90%;
        }
    }
</style>
