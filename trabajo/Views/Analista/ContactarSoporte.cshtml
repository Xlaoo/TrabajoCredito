@{
    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Contactar Soporte";
    ViewData["ActivePage"] = "ContactarSoporte";
}

@section Styles {
    <link rel="stylesheet" href="~/css/analista-css/contactar-soporte.css" asp-append-version="true" />
}



<div class="layout">

    <main class="content">

        <div class="top-soporte">
            <div>
                <h1>Centro de Soporte</h1>
                <p>Estamos aquí para ayudarte. Envía tu consulta o comunícate por nuestros canales.</p>
            </div>

            <a href="@Url.Action("PerfilAnalista", "Analista")" class="perfil-analista perfil-link">
                <div class="perfil-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <div>
                    <strong>@ViewBag.NombreAnalista</strong><br />
                    <span>@ViewBag.CorreoAnalista</span>
                    <small>Ver perfil completo</small>
                </div>
            </a>
        </div>

        <div class="contact-grid">

            <div class="contact-card">
                <div class="contact-icon email">
                    <i class="fas fa-envelope"></i>
                </div>
                <div>
                    <h3>Correo Electrónico</h3>
                    <p>soporte@crediplus.com</p>
                    <small>Respuesta en menos de 24 horas.</small>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon whatsapp">
                    <i class="fab fa-whatsapp"></i>
                </div>
                <div>
                    <h3>WhatsApp</h3>
                    <p>+51 987 654 321</p>
                    <small>Lun a Vie de 8:00 am a 6:00 pm</small>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon horario">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <h3>Horario de Atención</h3>
                    <p>Lunes a Viernes<br />8:00 am - 6:00 pm</p>
                    <small>Sábados 8:00 am - 1:00 pm</small>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon telefono">
                    <i class="fas fa-headset"></i>
                </div>
                <div>
                    <h3>Llamada Telefónica</h3>
                    <p>(01) 123 4567</p>
                    <small>Lun a Vie de 8:00 am a 6:00 pm</small>
                </div>
            </div>

        </div>

        <div class="soporte-grid">

            <section class="panel">
                <div class="panel-title">
                    <i class="fas fa-comments"></i>
                    <div>
                        <h2>Envía una solicitud de soporte</h2>
                        <p>Completa el formulario y nuestro equipo te ayudará.</p>
                    </div>
                </div>

                <form asp-action="EnviarSolicitudSoporte" asp-controller="Analista" method="post">
                    <label>Asunto</label>
                    <input type="text" id="asunto" name="asunto" placeholder="Escribe el asunto de tu consulta" required />

                    <label>Tipo de consulta</label>
                    <select id="tipoConsulta" required>
                        <option value="">Selecciona una opción</option>
                        <option>Error del sistema</option>
                        <option>Problema con solicitudes</option>
                        <option>Gestión de pagos</option>
                        <option>Evaluación de riesgo</option>
                        <option>Cuenta de usuario</option>
                        <option>Otro</option>
                    </select>

                    <label>Mensaje</label>
                    <textarea id="mensaje" name="mensaje" maxlength="500"  placeholder="Describe tu problema o consulta con el mayor detalle posible..." required></textarea>
                    <div class="contador"><span id="contadorMensaje">0</span>/500</div>

                    <button type="submit" class="btn-enviar">
                        <i class="fas fa-paper-plane"></i>
                        Enviar Solicitud
                    </button>
                    <button type="button"
                            class="btn-enviar"
                            data-bs-toggle="modal"
                            data-bs-target="#modalChatAdmin">
                        <i class="fas fa-comments"></i>
                        Comunicarme con Administrador
                    </button>

                    <div id="mensajeOk" class="mensaje-ok">
                        ✅ Solicitud enviada correctamente. Soporte revisará tu caso.
                    </div>
                </form>
            </section>

            <section class="panel">
                <div class="panel-title">
                    <i class="fas fa-question"></i>
                    <div>
                        <h2>Preguntas Frecuentes</h2>
                        <p>Encuentra respuestas rápidas para el trabajo del analista.</p>
                    </div>
                </div>

                <div class="faq-list">

                    <div class="faq-item">
                        <div class="faq-pregunta">
                            <span>¿Cómo puedo restablecer mi contraseña?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Ingresa a “Olvidé mi contraseña”, coloca tu DNI y registra una nueva clave. Si el DNI no existe, debes reportarlo al administrador.
                        </p>
                    </div>

                    <div class="faq-item">
                        <div class="faq-pregunta">
                            <span>No puedo ver mis solicitudes pendientes</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Verifica que la solicitud tenga estado “Pendiente”. Si está “En Evaluación”, “Aprobado” o “Rechazado”, aparecerá en otra sección.
                        </p>
                    </div>

                    <div class="faq-item">
                        <div class="faq-pregunta">
                            <span>Error al aprobar una evaluación</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Revisa que la solicitud tenga perfil financiero, usuario vinculado y datos completos. Luego vuelve a intentar la aprobación.
                        </p>
                    </div>

                    <div class="faq-item">
                        <div class="faq-pregunta">
                            <span>Problemas con la carga de documentos</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Valida que el archivo no esté dañado y que el cliente haya completado todos los campos requeridos antes de enviar la solicitud.
                        </p>
                    </div>

                    <div class="faq-item">
                        <div class="faq-pregunta">
                            <span>Métodos de pago no disponibles</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Verifica que el cliente haya registrado correctamente el método, entidad, número y titular en su solicitud de préstamo.
                        </p>
                    </div>

                    <div class="faq-item faq-extra">
                        <div class="faq-pregunta">
                            <span>¿Cuándo debo rechazar una solicitud?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Cuando el cliente presente riesgo crítico, información falsa, historial vencido grave o datos financieros inconsistentes.
                        </p>
                    </div>

                    <div class="faq-item faq-extra">
                        <div class="faq-pregunta">
                            <span>¿Cuándo enviar una propuesta alternativa?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Cuando el cliente no califica para el monto solicitado, pero sí puede asumir un monto menor o un plazo diferente.
                        </p>
                    </div>

                    <div class="faq-item faq-extra">
                        <div class="faq-pregunta">
                            <span>¿Qué hago si el cliente registra datos incorrectos?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Observa la solicitud o envía un mensaje solicitando corrección. No apruebes solicitudes con datos incompletos.
                        </p>
                    </div>

                    <div class="faq-item faq-extra">
                        <div class="faq-pregunta">
                            <span>¿Cómo validar el pago de una cuota?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Revisa método, entidad, código de operación, fecha y monto pagado. Si coincide, el pago puede aprobarse.
                        </p>
                    </div>

                    <div class="faq-item faq-extra">
                        <div class="faq-pregunta">
                            <span>¿Qué pasa si apruebo por error?</span>
                            <i class="fas fa-chevron-right"></i>
                        </div>
                        <p class="faq-respuesta">
                            Reporta el caso a soporte o al administrador para revisar la solicitud y corregir el estado si corresponde.
                        </p>
                    </div>

                </div>

                <button type="button" class="btn-faq" id="btnMostrarMasFaq">
                    <span id="textoFaq">Ver todas las preguntas</span>
                    <i class="fas fa-chevron-right ml-12"></i>
                </button>
            </section>

        </div>

        <div class="bottom-soporte">

            <div class="bottom-item compromiso-pro">
                <div class="soporte-persona">
                    <i class="fas fa-headset"></i>
                    <span><i class="fas fa-comment-dots"></i></span>
                </div>

                <div>
                    <h3>Nuestro compromiso</h3>
                    <p>
                        En CrediPlus nos esforzamos por brindarte la mejor atención.
                        Nuestro equipo está disponible para ayudarte ante cualquier inconveniente.
                    </p>
                    <small>Tu satisfacción y confianza son nuestra prioridad.</small>
                </div>
            </div>

            <div class="bottom-item seguridad-pro">
                <div class="bottom-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div>
                    <h3>Seguridad y Confidencialidad</h3>
                    <p>Tu información está protegida y será tratada de manera confidencial.</p>
                </div>
            </div>

        </div>

    </main>
</div>
<div class="modal fade" id="modalChatAdmin" tabindex="-1" data-admin-id="@ViewBag.IdAdministrador" data-analista-id="@ViewBag.IdAnalista">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content modal-chat-custom">

            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-comments"></i> Comunicación con Administrador
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>


            <div class="modal-body p-0">
                <div class="analistas-panel chat-panel">
                    <div class="analistas-panel-header">
                        <div>
                            <h3 class="analistas-panel-title">Chat con Administrador</h3>
                            <span id="chatEstadoAdmin" class="chat-estado @(ViewBag.AdminActivo == true ? "activo" : "inactivo")">
                                <i class="fas fa-circle"></i>
                                <span id="chatEstadoAdminTexto">@(ViewBag.AdminActivo == true ? "Administrador Activo" : "Administrador Inactivo")</span>
                            </span>
                            <p class="analistas-panel-subtitle">Mensajes en tiempo real Analista ↔ Administrador.</p>
                        </div>
                    </div>

                    <div id="chatAlertaError" class="chat-alerta-error d-none" role="alert">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span id="chatAlertaErrorTexto"></span>
                    </div>

                    <div class="chat-messages" id="chatMensajesAdmin">
                        @if (ViewBag.MensajesAdmin != null)
                        {
                            foreach (var mensaje in ViewBag.MensajesAdmin)
                            {
                                var claseMensaje = mensaje.RemitenteRol == "Analista" ? "analista" : "admin";

                                <div class="chat-message @claseMensaje" data-id-mensaje="@mensaje.IdMensaje">
                                    <div class="chat-bubble">@mensaje.Mensaje</div>
                                    <div class="chat-meta">
                                        @mensaje.RemitenteRol · @mensaje.FechaEnvio.ToString("dd/MM/yyyy hh:mm tt")
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <form class="chat-form" id="formChatAdmin">
                        <input type="text"
                               id="mensajeAdminInput"
                               autocomplete="off"
                               placeholder="Escribe un mensaje para el administrador..." />

                        <button type="submit" class="chat-send-btn" id="btnEnviarAdmin" title="Enviar mensaje">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha384-mU1xC5yC2LldSW74Rj1Ax8wPiLw/28V5eh51uKJMlBbRVsOtUYd4xyzNsgIAJARB"
            crossorigin="anonymous"></script>
    <script src="~/js/analista-js/contactar-soporte.js" asp-append-version="true"></script>
}
