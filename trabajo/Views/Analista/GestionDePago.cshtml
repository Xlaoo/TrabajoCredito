        transition: .25s;
    }

        .perfil-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 35px rgba(124,58,237,.18);
        }

        .perfil-link small {
            display: block;
            margin-top: 5px;
            color: #6d28d9;
            font-size: 12px;
            font-weight: 800;
        }
</style>

<main class="content">

        <div class="top-pagos">
            <div>
                <h1>Gestión de Métodos de Pago</h1>
                <p>Supervisa y aprueba los métodos de pago registrados por los clientes.</p>
            </div>

            <a href="@Url.Action("PerfilAnalista", "Analista")"
               style="
        background:white;
        border-radius:20px;
        padding:20px 25px;
        display:flex;
        align-items:center;
        gap:15px;
        width:320px;
        text-decoration:none;
        color:#241041;
        box-shadow:0 10px 30px rgba(124,58,237,.08);
        cursor:pointer;">

                <div style="
        width:60px;
        height:60px;
        min-width:60px;
        border-radius:50%;
        background:linear-gradient(135deg,#6d28d9,#9333ea);
        color:white;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:25px;">
                    <i class="fas fa-user"></i>
                </div>

                <div style="display:flex; flex-direction:column; gap:3px;">
                    <strong style="color:#241041; font-size:16px; font-weight:800;">
                        @ViewBag.NombreAnalista
                    </strong>

                    <span style="color:#6b7280; font-size:14px;">
                        @ViewBag.CorreoAnalista
                    </span>

                    <small style="color:#6d28d9; font-size:12px; font-weight:800;">
                        Ver perfil completo →
                    </small>
                </div>
            </a>
        </div>

        <div class="pagos-layout">

            <div class="pagos-main">

                <div class="resumen-metodos">

                    <div class="resumen-card card-pendientes">
                        <div class="resumen-left">
                            <div class="resumen-icon naranja">
                                🕘
                            </div>
                            <div>
                                <span>PENDIENTES</span>
                                <h2 class="num-pendiente">@ViewBag.TotalPendientes</h2>
                                <p>Por pagar</p>
                            </div>
                        </div>
                        <div class="pendiente-ilustracion">
                            <div class="clipboard">
                                <div class="clip"></div>
                                <div class="check-line"></div>
                                <div class="check-line"></div>
                                <div class="check-line"></div>
                            </div>
                        </div>
                    </div>

                    <div class="resumen-card card-aprobados">
                        <div class="resumen-left">
                            <div class="resumen-icon verde">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div>
                                <span>APROBADOS</span>
                                <h2 class="num-aprobado">@ViewBag.TotalAprobados</h2>
                                <p>Métodos aprobados</p>
                            </div>
                        </div>
                        <div class="resumen-visual visual-aprobado">
                            <i class="fas fa-shield-alt"></i>
                            <span class="mini-check">
                                <i class="fas fa-check"></i>
                            </span>
                        </div>
                    </div>

                </div>

                <div class="mini-resumen-metodos">

                    <div class="mini-metodo">
                        <span>💳</span>
                        <div>
                            <p>Total Métodos</p>
                            <strong>@ViewBag.TotalMetodosRegistrados</strong>
                            <small>Registrados</small>
                        </div>
                    </div>

                    <div class="mini-metodo">
                        <span>📅</span>
                        <div>
                            <p>Este mes</p>
                            <strong class="porcentaje-mes">
                                @ViewBag.PorcentajeEsteMes%
                            </strong>
                            <small>vs mes anterior</small>
                        </div>
                    </div>

                    <div class="mini-metodo">
                        <span>👥</span>
                        <div>
                            <p>Clientes únicos</p>
                            <strong>@ViewBag.ClientesUnicosPago</strong>
                            <small>Con métodos</small>
                        </div>
                    </div>

                    <div class="mini-metodo">
                        <span>🏦</span>
                        <div>
                            <p>Transferencias</p>
                            <strong>@ViewBag.TotalTransferencias</strong>
                            <small>Este mes</small>
                        </div>
                    </div>

                    <div class="mini-metodo">
                        <span class="mini-icon-yape">
                            <img src="~/img/YapePlin.png" class="logo-mini-yape" />
                        </span>
                        <div>
                            <p>Yape / Plin</p>
                            <strong>@ViewBag.TotalYapePlin</strong>
                            <small>Este mes</small>
                        </div>
                    </div>

                </div>

                <div class="tabla-pagos-card">
                    <div class="tabla-header">
                        <h2>💳 Métodos de Pago Registrados</h2>
                        <input type="text" id="buscarPago" placeholder="Buscar por método, entidad o titular..." onkeyup="filtrarPagos()" />
                    </div>

                    <table class="tabla-pagos">
                        <thead>
                            <tr>
                                <th>Solicitud</th>
                                <th>Cliente</th>
                                <th>Método de Pago</th>
                                <th>Entidad / Número</th>
                                <th>Titular</th>
                                <th>Fecha Registro</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var cuotasPago = ViewBag.CuotasPago as Dictionary<int, trabajo.Models.Cuota>;
                                var metodosSolicitudPago = ViewBag.MetodosSolicitudPago as Dictionary<int, trabajo.Models.MetodoPagoSolicitud>;
                            }

                            @foreach (var m in Model)
                            {
                                var cuotaPago = cuotasPago != null && cuotasPago.ContainsKey(m.IdCuota)
                                ? cuotasPago[m.IdCuota]
                                : null;
                                var solicitud = cuotaPago?.SOLICITUD_CREDITO;

                                var metodoSolicitud = solicitud != null && metodosSolicitudPago != null && metodosSolicitudPago.ContainsKey(solicitud.Id_Solicitud)
                                ? metodosSolicitudPago[solicitud.Id_Solicitud]
                                : null;

                                <tr class="fila-pago"
                                    data-busqueda="@($"{m.MetodoPago} {m.EntidadPago} {m.NumeroCuentaPago} CrediPlus Financiera {m.Cliente} {m.Dni}".ToLower())">

                                    <td>SOL-@m.IdSolicitud.ToString("D5")</td>

                                    <td>
                                        <strong>@m.Cliente</strong><br />
                                        <small>DNI: @m.Dni</small>
                                    </td>

                                    <td>
                                        <span class="metodo-badge metodo-badge-img">
                                            @if (m.MetodoPago != null && m.MetodoPago.ToLower().Contains("yape"))
                                            {
                                                <img src="~/img/yape.png" class="logo-tabla-metodo" />
                                            }
                                            else if (m.MetodoPago != null && m.MetodoPago.ToLower().Contains("plin"))
                                            {
                                                <img src="~/img/plin.webp" class="logo-tabla-metodo" />
                                            }
                                            else
                                            {
                                                <span class="icon-transferencia">🏦</span>
                                            }

                                            @m.MetodoPago
                                        </span>
                                    </td>

                                    <td>
                                        <strong>@m.EntidadPago</strong><br />
                                        <small>@m.NumeroCuentaPago</small>
                                    </td>

                                    <td>@m.TitularCuenta</td>

                                    <td>
                                        @m.FechaRegistro.ToString("dd/MM/yyyy")<br />
                                        <small>@m.FechaRegistro.ToString("hh:mm tt")</small>
                                    </td>

                                    <td>
                                        <span class="@(m.Estado == "Pendiente" ? "estado-pendiente" : "estado-aprobado")">
                                            @m.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="tabla-footer">
                        <span id="textoPaginacion">Mostrando 0 de 0 resultados</span>

                        <div class="paginacion" id="paginacionPagos"></div>
                    </div>
                </div>

            </div>

            <aside class="pagos-sidebar">

                <div class="side-card">
                    <h3>Resumen de Estados</h3>

                    @{
                        int pendientes = ViewBag.TotalPendientes ?? 0;
                        int aprobados = ViewBag.TotalAprobados ?? 0;
                        int total = ViewBag.TotalMetodosResumen ?? 0;

                        decimal porcPendientes = total > 0 ? Math.Round((decimal)pendientes * 100 / total, 1) : 0;
                        decimal porcAprobados = total > 0 ? Math.Round((decimal)aprobados * 100 / total, 1) : 0;
                    }

                    <div class="donut-resumen"
                         style="background: conic-gradient(#f59e0b 0 @porcPendientes%, #22c55e @porcPendientes% 100%);">
                        <div class="donut-centro">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                    </div>

                    <div class="estado-linea">
                        <span><b class="dot pendiente"></b> Pendientes</span>
                        <strong>@pendientes (@porcPendientes%)</strong>
                    </div>

                    <div class="estado-linea">
                        <span><b class="dot aprobado"></b> Aprobados</span>
                        <strong>@aprobados (@porcAprobados%)</strong>
                    </div>

                    <p class="total-metodos">Total @total métodos</p>
                </div>

                <div class="side-card">
                    <h3>Entidades más usadas</h3>

                    @{
                        var metodosUsados = ViewBag.MetodosMasUsados as IEnumerable<dynamic>;
                    }

                    @if (metodosUsados != null && metodosUsados.Any())
                    {
                        foreach (var metodo in metodosUsados)
                        {
                            string nombreMetodo = metodo.Nombre;
                            string claseIcono = "gris";
                            string icono = "•••";

                            if (nombreMetodo == "Yape")
                            {
                                claseIcono = "yape";
                                icono = "yape";
                            }
                            else if (nombreMetodo == "Plin")
                            {
                                claseIcono = "verde";
                                icono = "🟢";
                            }
                            else if (nombreMetodo == "BCP")
                            {
                                claseIcono = "bcp";
                                icono = "BCP";
                            }
                            else if (nombreMetodo == "Interbank")
                            {
                                claseIcono = "interbank";
                                icono = "IB";
                            }
                            else if (nombreMetodo == "BBVA")
                            {
                                claseIcono = "bbva";
                                icono = "BBVA";
                            }
                            else if (nombreMetodo == "Scotiabank")
                            {
                                claseIcono = "scotia";
                                icono = "S";
                            }
                            else if (nombreMetodo == "Caja Arequipa")
                            {
                                claseIcono = "caja";
                                icono = "CA";
                            }
                            else if (nombreMetodo == "Transferencia Bancaria")
                            {
                                claseIcono = "morado";
                                icono = "🏦";
                            }

                            <div class="metodo-uso-bar">
                                <div class="metodo-info">
                                    <span class="metodo-icon @claseIcono">

                                        @if (nombreMetodo == "Yape")
                                        {
                                            <img src="~/img/yape.png" class="logo-metodo" />
                                        }
                                        else if (nombreMetodo == "Plin")
                                        {
                                            <img src="~/img/plin.webp" class="logo-metodo" />
                                        }
                                        else if (nombreMetodo == "BCP")
                                        {
                                            <img src="~/img/bcp.webp" class="logo-metodo" />
                                        }
                                        else if (nombreMetodo == "Interbank")
                                        {
                                            <img src="~/img/interbank.png" class="logo-metodo" />
                                        }
                                        else if (nombreMetodo == "BBVA")
                                        {
                                            <img src="~/img/bbva.png" class="logo-metodo" />
                                        }
                                        else if (nombreMetodo == "Scotiabank")
                                        {
                                            <img src="~/img/scotiabank.png" class="logo-metodo" />
                                        }
                                        else if (nombreMetodo == "Caja Arequipa")
                                        {
                                            <img src="~/img/cajaArequipa.jpg" class="logo-metodo" />
                                        }
                                        else
                                        {
                                            @icono
                                        }

                                    </span>
                                    <strong>@nombreMetodo</strong>
                                </div>

                                <b>@metodo.Porcentaje%</b>

                                <div class="barra">
                                    <div class="barra-fill @claseIcono"
                                         style="width:@metodo.Porcentaje%">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="side-card actividad-card">
                    <h3>Actividad reciente</h3>

                    <div id="listaActividad" class="actividad-lista">
                        @foreach (var m in Model)
                        {
                            var cuotaAct = cuotasPago != null && cuotasPago.ContainsKey(m.IdCuota)
                            ? cuotasPago[m.IdCuota]
                            : null;

                            var solicitudAct = cuotaAct?.SOLICITUD_CREDITO;
                            var clienteAct = solicitudAct?.USUARIO;

                            <div class="actividad-item actividad-extra">
                                <span class="actividad-icon">✅</span>

                                <div>
                                    <strong>@(m.Estado == "Pendiente" ? "Pago pendiente" : "Método aprobado")</strong>
                                    <p>
                                        SOL-@(solicitudAct != null ? solicitudAct.Id_Solicitud.ToString("D5") : "00000")
                                        - @(clienteAct != null ? clienteAct.Nombre + " " + clienteAct.Apellido : "Cliente")
                                    </p>
                                    <small>@m.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</small>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.Count > 3)
                    {
                        <button type="button" class="btn-historial" onclick="toggleHistorial()">
                            Ver todo el historial →
                        </button>
                    }
                </div>
                <div class="consejo-card-pro">
                    <div class="consejo-shield">
                        <i class="fas fa-shield-alt"></i>
                        <span><i class="fas fa-check"></i></span>
                    </div>

                    <div class="consejo-persona">
                        <i class="fas fa-user-tie"></i>
                    </div>

                    <div class="consejo-texto-pro">
                        <strong>Verifica cuidadosamente cada método de pago antes de aprobar.</strong>
                        <p>Una aprobación incorrecta puede afectar el flujo financiero del cliente.</p>
                    </div>
                </div>

            </aside>

        </div>

    </main>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<script>
        function filtrarPagos() {
        paginaActual = 1;
        paginarPagos();
    }

    let paginaActual = 1;
    const filasPorPagina = 5;

    function paginarPagos() {
    let texto = document.getElementById("buscarPago").value.toLowerCase().trim();

    let filasTodas = Array.from(document.querySelectorAll(".fila-pago"));

    let filas = filasTodas.filter(fila => {
        let busqueda = fila.dataset.busqueda || "";
        return busqueda.includes(texto);
    });

    filasTodas.forEach(fila => fila.style.display = "none");
        let totalFilas = filas.length;
        let totalPaginas = Math.ceil(totalFilas / filasPorPagina);

        filas.forEach((fila, index) => {
            let inicio = (paginaActual - 1) * filasPorPagina;
            let fin = inicio + filasPorPagina;

            fila.style.display =
                index >= inicio && index < fin ? "" : "none";
        });

        document.getElementById("textoPaginacion").innerText =
            `Mostrando ${
                Math.min(
                    filasPorPagina,
                    totalFilas - ((paginaActual - 1) * filasPorPagina)
                )
            } de ${totalFilas} resultados`;
        let contenedor = document.getElementById("paginacionPagos");
        contenedor.innerHTML = "";

        let btnAnterior = document.createElement("button");
        btnAnterior.innerText = "‹";
        btnAnterior.onclick = function () {
            if (paginaActual > 1) {
                paginaActual--;
                paginarPagos();
            }
        };
            if (paginaActual === 1) {
        btnAnterior.disabled = true;
        btnAnterior.style.opacity = "0.5";
        btnAnterior.style.cursor = "not-allowed";
    } else {
        btnAnterior.style.cursor = "pointer";
    }
        contenedor.appendChild(btnAnterior);

        for (let i = 1; i <= totalPaginas; i++) {
            let btn = document.createElement("button");
            btn.innerText = i;

            if (i === paginaActual) {
                btn.classList.add("active");
            }

            btn.onclick = function () {
                paginaActual = i;
                paginarPagos();
            };

            contenedor.appendChild(btn);
        }

        let btnSiguiente = document.createElement("button");
        btnSiguiente.innerText = "›";

        btnSiguiente.onclick = function () {
            if (paginaActual < totalPaginas) {
                paginaActual++;
                paginarPagos();
            }
        };
            if (paginaActual === totalPaginas || totalPaginas === 0) {
        btnSiguiente.disabled = true;
        btnSiguiente.style.opacity = "0.5";
        btnSiguiente.style.cursor = "not-allowed";
    } else {
        btnSiguiente.style.cursor = "pointer";
    }
        contenedor.appendChild(btnSiguiente);
    }
        function toggleHistorial() {
        let lista = document.getElementById("listaActividad");
        let boton = document.querySelector(".btn-historial");

        lista.classList.toggle("expandido");

        if (lista.classList.contains("expandido")) {
            boton.innerText = "Ver menos historial ↑";
        } else {
            boton.innerText = "Ver todo el historial →";
        }
    }

    window.onload = paginarPagos;
</script>