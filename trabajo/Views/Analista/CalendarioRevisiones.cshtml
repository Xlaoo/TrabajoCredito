@model List<trabajo.Models.RevisionCalendarioViewModel>
@{
    Layout = null;

    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Inicio";
    ViewData["ActivePage"] = "CalendarioRevisiones";
}

@section Styles {
    <link rel="stylesheet" href="~/css/analista-css/fullcalendar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/analista-css/calendario-revisiones.css" asp-append-version="true" />
}

<main class="content calendario-content">

    <div class="calendar-layout">

        <div class="calendar-card">
            <h2>Calendario de Revisiones</h2>

            <div class="calendar-top-stats">
                <div class="mini-stat aprobaciones-stat">
                    <div class="mini-icon">✅</div>
                    <div>
                        <span>Aprobaciones</span>
                        <strong>Mensuales: <span id="aprobacionesMensuales">0</span></strong>
                    </div>
                </div>
            </div>

            <div id="calendar"></div>
        </div>

        <aside class="revisiones-panel">

            <h3>Próximas Revisiones</h3>
            <small>Todos los préstamos aprobados</small>

            <div class="buscador-revisiones">
                <input type="text"
                       id="buscarCliente"
                       placeholder="Buscar cliente o DNI..." />
                <span>🔍</span>
            </div>

            @{
                var aprobados = Model;

                var hoy = trabajo.Service.PeruTimeHelper.TodayPeru;

                var revisionesHoy = aprobados
                    .Count(x => x.FechaRevisionPeru.Date == hoy);

                var revisionesSemana = aprobados
                    .Count(x => x.FechaRevisionPeru.Date >= hoy &&
                    x.FechaRevisionPeru.Date <= hoy.AddDays(7));

                var proxima = aprobados.FirstOrDefault(x => x.FechaRevisionPeru.Date >= hoy);
            }

            <div class="panel-stats">
                <div class="panel-stat">
                    <div class="stat-icon">📅</div>
                    <strong>@aprobados.Count</strong>
                    <span>Total</span>
                </div>

                <div class="panel-stat">
                    <div class="stat-icon naranja">🕒</div>
                    <strong>@revisionesHoy</strong>
                    <span>Hoy</span>
                </div>

                <div class="panel-stat">
                    <div class="stat-icon verde">✅</div>
                    <strong>@revisionesSemana</strong>
                    <span>Semana</span>
                </div>
            </div>

            @if (proxima != null)
            {
                <div class="proxima-box">
                    <div class="proxima-fecha">
                        <span>@proxima.FechaRevisionPeru.ToString("MMM").ToUpper()</span>
                        <strong>@proxima.FechaRevisionPeru.ToString("dd")</strong>
                        <small>@proxima.FechaRevisionPeru.ToString("dddd")</small>
                    </div>

                    <div class="proxima-info">
                        <strong>Revisión @proxima.NumeroSolicitud</strong>
                        <span>@proxima.ClienteNombre</span>
                        <small>@proxima.HoraRevisionTexto</small>
                    </div>
                </div>
            }

            <h4 class="lista-title">Lista de revisiones</h4>

            <div class="revision-list">
                @foreach (var p in aprobados)
                {
                    <div class="revision-item"
                         data-nombre="@p.ClienteNombre.ToLower()"
                         data-dni="@p.ClienteDni">

                        <div class="revision-avatar">👤</div>

                        <div class="revision-info">
                            <strong>Revisión @p.NumeroSolicitud</strong>
                            <span>@p.ClienteNombre</span>
                            <small>DNI: @p.ClienteDni</small>
                        </div>

                        <div class="revision-fecha">
                            <span>@p.FechaRevisionTexto</span>
                            <small>@p.HoraRevisionTexto</small>
                        </div>

                        <button type="button"
                                class="btn-eye"
                                data-id="@p.Id_Solicitud">
                            👁
                        </button>
                    </div>
                }
            </div>

            <div class="panel-footer-info">
                ℹ Las revisiones se generan automáticamente cuando un préstamo es aprobado.
            </div>

        </aside>

    </div>

</main>

<div class="modal fade" id="detalleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-detalle-limpio">
            <div id="detalleContenido"></div>
        </div>
    </div>
</div>

@{
    var eventosCalendario = Model.Select(p => new {
        id = p.Id_Solicitud.ToString(),
        title = $"Revisión {p.NumeroSolicitud}\n{p.ClienteNombre}\n{p.HoraRevisionTexto}",
        start = p.FechaIso,
        color = "green"
    });
    var eventosJson = System.Text.Json.JsonSerializer.Serialize(eventosCalendario);
}
<script id="calendarioEventosData" type="application/json">@Html.Raw(eventosJson)</script>

@section Scripts {
    <script src="~/lib/fullcalendar/index.global.min.js" asp-append-version="true"></script>
    <script src="~/js/analista-js/calendario-revisiones.js" asp-append-version="true"></script>
}