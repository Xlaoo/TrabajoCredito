<script>
document.addEventListener('DOMContentLoaded', function () {

    var calendarEl = document.getElementById('calendar');

	var calendar = new FullCalendar.Calendar(calendarEl, {

		initialView: 'dayGridMonth',

		locale: 'es',

		showNonCurrentDates: false,

		fixedWeekCount: false,

	datesSet: function(info) {
	actualizarAprobacionesMensuales(info.start, info.end);
	},

    events: [

		@foreach (var p in Model.Where(x => x.Estado == "Aprobado"))
        {
            <text>
            {
                id:'@p.Id_Solicitud',
				title:'Revisión @p.NumeroSolicitud\n@(p.USUARIO.Nombre) @(p.USUARIO.Apellido)\n@(p.FechaSolicitud.ToString("HH:mm"))',
                start:'@p.FechaSolicitud.ToString("yyyy-MM-dd")',
                color:'green'
