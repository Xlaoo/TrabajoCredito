        }

    ]
});
		function actualizarAprobacionesMensuales(inicio, fin) {
		let eventos = calendar.getEvents();
		let mesActual = calendar.getDate().getMonth();
		let anioActual = calendar.getDate().getFullYear();

		let total = eventos.filter(e => {
			return e.start.getMonth() === mesActual &&
				   e.start.getFullYear() === anioActual;
		}).length;

		document.getElementById("aprobacionesMensuales").innerText = total;
	}

calendar.render();
    }); 
