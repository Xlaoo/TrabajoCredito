	<main class="content calendario-content">

		<div class="calendar-layout">

			<div class="calendar-card">
				<h2>Calendario de Revisiones</h2>

				<div class="calendar-top-stats">
					<div class="mini-stat aprobaciones-stat">
						<div class="mini-icon">✅</div>
						<div>
							<span>Aprobaciones</span>
							<strong>Mensuales: <span id="aprobacionesMensuales">0</span></strong>
						</div>
					</div>
				</div>

				<div id="calendar"></div>
			</div>

			<aside class="revisiones-panel">

				<h3>Próximas Revisiones</h3>
				<small>Todos los préstamos aprobados</small>

				<div class="buscador-revisiones">
					<input type="text"
						   id="buscarCliente"
						   placeholder="Buscar cliente o DNI..."
						   onkeyup="filtrarRevisiones()" />
					<span>🔍</span>
				</div>

				@{
					var aprobados = Model.Where(x => x.Estado == "Aprobado")
					.OrderBy(x => x.FechaSolicitud)
					.ToList();

					var hoy = DateTime.Today;

					var revisionesHoy = aprobados
					.Count(x => x.FechaSolicitud.Date == hoy);

					var revisionesSemana = aprobados
					.Count(x => x.FechaSolicitud.Date >= hoy &&
					x.FechaSolicitud.Date <= hoy.AddDays(7));

					var proxima = aprobados.FirstOrDefault(x => x.FechaSolicitud.Date >= hoy);
				}

				<div class="panel-stats">
					<div class="panel-stat">
						<div class="stat-icon">📅</div>
						<strong>@aprobados.Count</strong>
						<span>Total</span>
					</div>

					<div class="panel-stat">
						<div class="stat-icon naranja">🕒</div>
						<strong>@revisionesHoy</strong>
						<span>Hoy</span>
					</div>

					<div class="panel-stat">
						<div class="stat-icon verde">✅</div>
						<strong>@revisionesSemana</strong>
						<span>Semana</span>
					</div>
				</div>

				@if (proxima != null)
				{
					<div class="proxima-box">
						<div class="proxima-fecha">
							<span>@proxima.FechaSolicitud.ToString("MMM").ToUpper()</span>
							<strong>@proxima.FechaSolicitud.ToString("dd")</strong>
							<small>@proxima.FechaSolicitud.ToString("dddd")</small>
						</div>

						<div class="proxima-info">
							<strong>Revisión @proxima.NumeroSolicitud</strong>
							<span>@proxima.USUARIO.Nombre @proxima.USUARIO.Apellido</span>
							<small>@proxima.FechaSolicitud.ToString("HH:mm")</small>
						</div>
					</div>
				}

				<h4 class="lista-title">Lista de revisiones</h4>

				<div class="revision-list">
					@foreach (var p in aprobados)
					{
						<div class="revision-item"
							 data-nombre="@($"{p.USUARIO.Nombre} {p.USUARIO.Apellido}".ToLower())"
							 data-dni="@p.USUARIO.Dni">

							<div class="revision-avatar">👤</div>

							<div class="revision-info">
								<strong>Revisión @p.NumeroSolicitud</strong>
								<span>@p.USUARIO.Nombre @p.USUARIO.Apellido</span>
								<small>DNI: @p.USUARIO.Dni</small>
							</div>

							<div class="revision-fecha">
								<span>@p.FechaSolicitud.ToString("dd/MM/yyyy")</span>
								<small>@p.FechaSolicitud.ToString("HH:mm")</small>
							</div>

							<button type="button"
									class="btn-eye"
									onclick="obtenerDetalle(@p.Id_Solicitud)">
								👁
							</button>
						</div>
					}
				</div>

				<div class="panel-footer-info">
					ℹ Las revisiones se generan automáticamente cuando un préstamo es aprobado.
				</div>

			</aside>

		</div>

	</main>
</div>

