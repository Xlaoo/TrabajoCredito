	function filtrarRevisiones() {
	let texto = document.getElementById("buscarCliente").value.toLowerCase();
	let items = document.querySelectorAll(".revision-item");

	items.forEach(item => {
	let nombre = item.dataset.nombre || "";
	let dni = item.dataset.dni || "";

	if (nombre.includes(texto) || dni.includes(texto)) {
	item.style.display = "grid";
	} else {
	item.style.display = "none";
	}
	});
	}

