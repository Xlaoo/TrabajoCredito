        }

        .bar-count {
            font-size: 11px;
            font-weight: 700;
        }

        /* Tabla */
        .table-card {
            background: white;
            border-radius: 22px;
            box-shadow: 0 10px 25px rgba(124,58,237,.08);
            padding: 25px;
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

            .table-header h2 {
                font-size: 18px;
                font-weight: 800;
                color: #4c1d95;
                margin: 0;
            }

        .btn-icon {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 20px;
            color: #6b7280;
        }

            .btn-icon:hover {
                color: #7c3aed;
            }

        /* Filtros */
        .filters {
            display: flex;
            gap: 14px;
            margin-bottom: 18px;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-label {
            font-size: 13px;
            font-weight: 700;
            color: #374151;
        }

        .filter-group {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
        }

        .btn-filter {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 5px 13px;
            font-size: 13px;
            cursor: pointer;
            font-weight: 500;
            background: #fff;
            color: #374151;
            transition: all .15s;
        }

            .btn-filter.active, .btn-filter:hover {
                background: #3c096c;
                color: #fff;
                border-color: #3c096c;
            }

        .search-input {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 7px 14px;
            font-size: 13px;
            outline: none;
            width: 230px;
            margin-left: auto;
        }

            .search-input:focus {
