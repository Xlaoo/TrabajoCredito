@{
    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Calificaciones de Servicio";
    ViewData["ActivePage"] = "CalificacionesServicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/analista-css/calificaciones-servicio.css" asp-append-version="true" />
}

<!-- ── CONTENIDO ── -->
<div class="content">

    <!-- Header -->
    <div class="cal-header">
        <div>
            <div class="cal-bienvenida">Bienvenido Analista</div>
            <h1>Resumen de Calificaciones del Servicio</h1>
            <p class="cal-sub">Monitorea y analiza la satisfacción del cliente.</p>
        </div>
        <a href="@Url.Action("PerfilAnalista", "Analista")" class="cal-profile-card">
            <div class="cal-profile-avatar">
                <i class="fas fa-user"></i>
            </div>

            <div class="cal-profile-info">
                <strong>
                    @(ViewBag.NombreAnalista ?? "Analista")
                </strong>

                <span>
                    @(ViewBag.CorreoAnalista ?? "")
                </span>

                <small>
                    Ver perfil completo →
                </small>
            </div>
        </a>
    </div>

    <!-- Métricas -->
    <div class="metrics-row">
        <div class="metric-card card-green">
            <div class="mlabel">Puntaje Promedio (Este mes)</div>
            <div class="mvalue" id="metricPromedio">—</div>
            <div class="msub" id="metricEstrellas"></div>
        </div>
        <div class="metric-card card-blue">
            <div class="mlabel">Total Calificaciones (Este mes)</div>
            <div class="mvalue" id="metricTotal">—</div>
            <div class="msub" id="metricCrecimiento"></div>
        </div>
        <div class="metric-card card-purple">
            <div class="mlabel">NPS (Net Promoter Score)</div>
            <div class="mvalue" id="metricNps">—</div>
            <div class="msub" id="metricNpsLabel"></div>
        </div>
        <div class="chart-card">
            <div class="chart-title">Distribución de Estrellas (Este mes)</div>
            <div class="bar-chart" id="barChart">
                <p class="chart-loading-text">Cargando...</p>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="table-card">
        <div class="table-header">
            <h2>☰ Listado Detallado de Calificaciones</h2>
            <button class="btn-icon" id="btnActualizarCalificaciones" title="Actualizar">↻</button>
        </div>

        <div class="filters">
            <span class="filter-label">Puntaje</span>
            <div class="filter-group" id="filterPuntaje">
                <button class="btn-filter active" data-filter="all">all</button>
                <button class="btn-filter" data-filter="5">5 ★</button>
                <button class="btn-filter" data-filter="4">4 ★</button>
                <button class="btn-filter" data-filter="3">3 ★</button>
                <button class="btn-filter" data-filter="2">2 ★</button>
                <button class="btn-filter" data-filter="1">1 ★</button>
            </div>
            <input class="search-input" id="searchInput"
                   placeholder="🔍  Buscar cliente o comentario..." />
        </div>

        <div class="cal-table-scroll">
            <table class="cal-table">
                <thead>
                    <tr>
                        <th>Puntaje</th>
                        <th>Comentario</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Analista</th>
                    </tr>
                </thead>
                <tbody id="tablaBody">
                    <tr><td colspan="5" class="estado-msg">Cargando datos...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="table-footer" id="tableFooter"></div>
    </div>

</div><!-- /content -->

@section Scripts {
    <script src="~/js/analista-js/calificaciones-servicio.js" asp-append-version="true"></script>
}