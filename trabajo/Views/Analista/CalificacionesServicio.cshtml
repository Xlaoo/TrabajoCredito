            }

        /* Tabla datos */
        .cal-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

            .cal-table th {
                padding: 12px 14px;
                text-align: left;
                font-weight: 700;
                color: #5b21b6;
                border-bottom: 2px solid #f3e8ff;
