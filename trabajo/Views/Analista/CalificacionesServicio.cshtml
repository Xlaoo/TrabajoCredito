            }

        /* ── CONTENIDO ── */
        .content {
            flex: 1;
            padding: 35px;
            overflow-y: auto;
        }

        /* Header */
        .cal-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 28px;
            flex-wrap: wrap;
