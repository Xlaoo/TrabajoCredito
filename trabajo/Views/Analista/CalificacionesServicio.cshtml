        }

            .cal-header h1 {
                font-size: 38px;
                font-weight: 800;
                color: #4c1d95;
                margin: 0;
            }

        .cal-bienvenida {
            color: #6b7280;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .cal-sub {
            color: #6b7280;
