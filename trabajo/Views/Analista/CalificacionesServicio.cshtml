            box-shadow: 0 14px 32px rgba(0,0,0,.12);
        }

            .metric-card .mlabel {
                font-size: 13px;
                font-weight: 600;
                opacity: .92;
                margin-bottom: 10px;
            }

            .metric-card .mvalue {
                font-size: 60px;
                font-weight: 900;
