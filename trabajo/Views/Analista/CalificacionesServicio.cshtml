        }

        .menu {
            margin-top: 15px;
        }

            .menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                color: white;
                text-decoration: none;
                padding: 15px 18px;
                border-radius: 14px;
                margin-bottom: 10px;
