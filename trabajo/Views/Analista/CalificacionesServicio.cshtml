            }

            .metric-card .msub {
                font-size: 12px;
                margin-top: 8px;
                opacity: .85;
            }

        .card-green {
            background: linear-gradient(135deg, #22c55e, #16a34a);
        }

        .card-blue {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
        }

        .card-purple {
            background: linear-gradient(135deg, #7c3aed, #6d28d9);
        }

        .chart-card {
            flex: 1.35;
            min-width: 280px;
            background: white;
            border-radius: 20px;
            padding: 24px 28px;
            min-height: 170px;
            box-shadow: 0 14px 32px rgba(124,58,237,.10);
        }

        .chart-title {
            font-size: 13px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 14px;
        }

        .bar-chart {
            display: flex;
            align-items: flex-end;
            gap: 12px;
            height: 120px;
        }

        .bar-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            height: 100%;
            justify-content: flex-end;
            gap: 3px;
        }

        .bar-fill {
            width: 100%;
            border-radius: 4px 4px 0 0;
        }

        .bar-label {
            font-size: 10px;
            color: #6b7280;
