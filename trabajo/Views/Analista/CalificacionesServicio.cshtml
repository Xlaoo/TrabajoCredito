@{
    Layout = null;
    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Calificaciones de Servicio";
    ViewData["ActivePage"] = "CalificacionesServicio";
}
@* <!DOCTYPE html>
<html>
<head> *@
    <title>Calificaciones del Servicio - CrediPlus</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #faf8ff;
            font-family: 'Segoe UI', sans-serif;
            color: #241041;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }


        .sidebar {
            width: 280px;
            background: linear-gradient(180deg, #240046, #3c096c, #5a189a);
            color: white;
            padding: 25px;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }

        .logo {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .role {
            color: #d8b4fe;
            margin-bottom: 40px;
