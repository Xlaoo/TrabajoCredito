            .help-card h4 {
                font-size: 20px;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .help-card p {
                color: #d8b4fe;
                font-size: 14px;
                margin-bottom: 15px;
            }

        .btn-help {
            width: 100%;
            border: 1px solid rgba(255,255,255,.15);
            background: rgba(255,255,255,.05);
            color: white;
            border-radius: 12px;
            padding: 12px;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
