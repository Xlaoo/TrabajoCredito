@model trabajo.Models.ViewModels.AlertasNotificacionesViewModel

@{
    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Alertas y Notificaciones";
    ViewData["ActivePage"] = "AlertasNotificaciones";
}
<div class="top-bar">

    <div>
        <div class="welcome">
            Bienvenido Analista
        </div>

        <h1>
            Detalle de Alertas y Notificaciones
        </h1>

        <p class="estado-texto">
            Estado: <span class="estado-activo">Activo</span>
        </p>
    </div>

    <a href="@Url.Action("PerfilAnalista", "Analista")"
       style="
        background:white;
        border-radius:20px;
        padding:20px 25px;
        display:flex;
        align-items:center;
        gap:15px;
        width:320px;
        text-decoration:none;
        color:#241041;
        box-shadow:0 10px 30px rgba(124,58,237,.08);
        cursor:pointer;">

        <div style="
        width:60px;
        height:60px;
        min-width:60px;
        border-radius:50%;
        background:linear-gradient(135deg,#6d28d9,#9333ea);
        color:white;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:25px;">
            <i class="fas fa-user"></i>
        </div>

        <div style="
        display:flex;
        flex-direction:column;
        align-items:flex-start;
        gap:3px;">

            <strong style="
            color:#241041;
            font-size:16px;
            font-weight:800;
            text-decoration:none;">
                @Model.AnalistaNombre
            </strong>

            <span style="
            color:#241041;
            font-size:15px;
            text-decoration:none;">
                @Model.AnalistaCorreo
            </span>

            <small style="
            color:#6d28d9;
            font-size:12px;
            font-weight:800;
            text-decoration:none;">
                Ver perfil completo →
            </small>

        </div>

    </a>

</div>

<div class="stats">

    <div class="stat-card">
        <div class="card-top top-rojo">
            <div class="card-icon">🔔</div>
        </div>
        <div class="card-num num-rojo">@Model.TotalCriticas</div>
        <div class="card-label">Alertas Críticas Recientes</div>
    </div>

    <div class="stat-card">
        <div class="card-top top-amber">
            <div class="card-icon">🕐</div>
        </div>
        <div class="card-num num-amber">@Model.TotalRevisionesPendientes</div>
        <div class="card-label">Notificaciones de Revisión Pendiente</div>
    </div>

    <div class="stat-card">
        <div class="card-top top-blue">
            <div class="card-icon">💬</div>
        </div>
        <div class="card-num num-blue">@Model.TotalInformativas</div>
        <div class="card-label">Notificaciones Informativas</div>
    </div>

    <div class="stat-card">
        <div class="card-top top-purple">
            <div class="card-icon">⭐</div>
        </div>
        <div class="card-num num-purple">@Model.TotalCalificaciones</div>
        <div class="card-label">Nuevas Calificaciones de Servicio</div>
    </div>


</div>

<div class="seccion-principal">

    <div class="seccion-tabla">

        <div class="tabla-header">
            <h2>Listado Completo de Alertas y Notificaciones</h2>
            <select class="filtro-select" onchange="filtrarTabla(this.value)">
                <option value="todos">Todos</option>
                <option value="critico">Crítico</option>
                <option value="revision">Revisión Pendiente</option>
                <option value="informativa">Informativa</option>
                <option value="calificacion">Calificación</option>
            </select>
        </div>

        <table class="tabla-alertas">
            <thead>
                <tr>
                    <th>Prioridad</th>
                    <th>Asunto</th>
                    <th>Cliente / Solicitud</th>
                    <th>Fecha</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alerta in Model.Alertas)
                {
                    <tr data-prioridad="@alerta.Prioridad">
                        <td>
                            <span class="badge-prioridad badge-@alerta.Prioridad">
                                @alerta.PrioridadEtiqueta
                            </span>
                        </td>
                        <td>
                            <div class="asunto-principal">@alerta.AsuntoPrincipal</div>
                            <div class="asunto-sub">@alerta.AsuntoSubtitulo</div>
                        </td>
                        <td>
                            @alerta.ClienteNombre
                            (S/ @alerta.MontoSolicitado.ToString("N0"))<br />
                            <span style="color:#6b7280">[SOL-@alerta.IdSolicitud.ToString("D5")]</span>
                        </td>
                        <td>
                            @alerta.FechaFormateada<br />
                            <span style="color:#6b7280">@alerta.HoraFormateada</span>
                        </td>
                        <td>
                            <div class="accion-btns">
                                <a href="@alerta.UrlOjo"
                                   class="btn-accion">👁</a>

                                @if (alerta.Tipo != "revision")
                                {
                                    <button type="button"
                                            class="btn-accion"
                                            onclick="marcarAlertaVista('@alerta.Tipo', @alerta.IdOrigen, this)">
                                        ✔
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

    <div class="alertas-rapidas">

        <div class="alertas-rapidas-header">
            <h3>Alertas Rápidas</h3>
            <span style="cursor:pointer; font-size:18px; color:#6b7280">&#8743;</span>
        </div>

        <div class="alertas-rapidas-scroll">

            @foreach (var alerta in Model.Alertas)
            {
                <div class="alerta-rapida-item @alerta.Prioridad">
                    <div class="alerta-rapida-titulo">
                        @alerta.AsuntoPrincipal<br />
                        @alerta.ClienteNombre
                    </div>
                    <div class="alerta-rapida-fecha">
                        @alerta.FechaFormateada @alerta.HoraFormateada
                    </div>
                </div>
            }
        </div>

    </div>

</div>

<script>
    function filtrarTabla(valor) {
        document.querySelectorAll('.tabla-alertas tbody tr').forEach(function(fila) {
            var prioridad = fila.getAttribute('data-prioridad');
            fila.style.display = (valor === 'todos' || prioridad === valor) ? '' : 'none';
        });
    }
            function marcarAlertaVista(tipo, idOrigen, boton) {
        fetch('/Analista/MarcarAlertaVista', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body:
                'tipo=' + encodeURIComponent(tipo) +
                '&idOrigen=' + encodeURIComponent(idOrigen)
        })
        .then(r => r.json())
        .then(data => {
            if (data.ok) {
                boton.closest('tr').remove();
            }
        });
    }
</script>