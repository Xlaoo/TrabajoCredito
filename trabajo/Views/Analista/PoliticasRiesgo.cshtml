@{
    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Politicas de Riesgo";
    ViewData["ActivePage"] = "PoliticasRiesgo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/analista-css/politicas-riesgo.css" asp-append-version="true" />
}
<div class="layout">
		<main class="content">

			<div class="top-politicas">
				<div>
					<h1>Políticas de Riesgo</h1>
					<p>Lineamientos y criterios que el analista debe seguir para evaluar, aprobar u observar solicitudes de crédito.</p>
				</div>

			<a href="@Url.Action("PerfilAnalista", "Analista")" class="perfil-analista perfil-link">
				<div class="perfil-avatar">
					<i class="fas fa-user"></i>
				</div>
				<div>
					<strong>@ViewBag.NombreAnalista</strong><br />
					<span>@ViewBag.CorreoAnalista</span>
					<small>Ver perfil completo</small>
				</div>
			</a>
			</div>

			<section class="panel-principal">

				<h2>1. Niveles de Riesgo y Acciones Recomendadas</h2>

				<div class="riesgo-grid">
					<div class="riesgo-card bajo">
						<div class="riesgo-icon"><i class="fas fa-check"></i></div>
						<h3>RIESGO BAJO</h3>
						<p>Cliente con buen comportamiento financiero.</p>
						<button>ACCIÓN: APROBAR</button>
					</div>

					<div class="riesgo-card medio">
						<div class="riesgo-icon"><i class="fas fa-exclamation"></i></div>
						<h3>RIESGO MEDIO</h3>
						<p>Existen factores moderados que requieren revisión.</p>
						<button>ACCIÓN: REVISAR</button>
					</div>

					<div class="riesgo-card alto">
						<div class="riesgo-icon"><i class="fas fa-triangle-exclamation"></i></div>
						<h3>RIESGO ALTO</h3>
						<p>Alta probabilidad de incumplimiento.</p>
						<button>ACCIÓN: OBSERVAR</button>
					</div>

					<div class="riesgo-card critico">
						<div class="riesgo-icon"><i class="fas fa-xmark"></i></div>
						<h3>RIESGO CRÍTICO</h3>
						<p>Muy alto riesgo de impago.</p>
						<button>ACCIÓN: RECHAZAR</button>
					</div>

					<div class="objetivo-card">
						<h3><i class="fas fa-bullseye"></i> Objetivo</h3>
						<p>
							Minimizar el riesgo crediticio garantizando decisiones justas,
							responsables y alineadas a la política de CrediPlus.
						</p>
						<div class="objetivo-dibujo">
							<i class="fas fa-clipboard-check"></i>
							<span><i class="fas fa-shield-alt"></i></span>
						</div>
					</div>
				</div>

			</section>

			<div class="politicas-grid">

				<section class="politica-card grande">
					<h2>2. Criterios de Evaluación</h2>

					<table class="tabla-politicas">
						<thead>
							<tr>
								<th>Criterio</th>
								<th>Descripción</th>
								<th>Condición</th>
								<th>Impacto</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>💵 Ingresos Mensuales</td>
								<td>Evalúa la capacidad de pago del cliente.</td>
								<td>Ingreso menor a S/ 1,200</td>
								<td><span class="tag alto">Alto</span></td>
							</tr>
							<tr>
								<td>📊 Relación Deuda / Ingreso</td>
								<td>Cuánto compromete el cliente de sus ingresos.</td>
								<td>Mayor a 50%</td>
								<td><span class="tag alto">Alto</span></td>
							</tr>
							<tr>
								<td>📈 Historial Crediticio</td>
								<td>Revisa pagos anteriores, atrasos o vencidos.</td>
								<td>Pagos vencidos</td>
								<td><span class="tag alto">Alto</span></td>
							</tr>
							<tr>
								<td>💳 Créditos Activos</td>
								<td>Cantidad de créditos vigentes del cliente.</td>
								<td>3 o más créditos</td>
								<td><span class="tag medio">Medio</span></td>
							</tr>
							<tr>
								<td>🏢 Antigüedad Laboral</td>
								<td>Estabilidad del ingreso del cliente.</td>
								<td>Menor a 6 meses</td>
								<td><span class="tag medio">Medio</span></td>
							</tr>
							<tr>
								<td>📁 Documentación</td>
								<td>Verifica documentos completos y válidos.</td>
								<td>Documentos faltantes</td>
								<td><span class="tag medio">Medio</span></td>
							</tr>
							<tr>
								<td>🔎 Consultas de Riesgo</td>
								<td>Historial en centrales de riesgo.</td>
								<td>Reporte negativo</td>
								<td><span class="tag alto">Alto</span></td>
							</tr>
						</tbody>
					</table>

					<div class="nota-politica">
						<i class="fas fa-circle-info"></i>
						La evaluación es integral. Ningún criterio por sí solo determina la decisión final.
					</div>
				</section>

				<section class="politica-card">
					<h2>3. Proceso de Evaluación</h2>

					<div class="pasos">
						<div><b>1</b><i class="fas fa-envelope-open-text"></i><span><strong>Recibir solicitud</strong><small>Verifica que la información esté completa.</small></span></div>
						<div><b>2</b><i class="fas fa-id-card"></i><span><strong>Validar datos</strong><small>Revisa identidad, ingresos y referencias.</small></span></div>
						<div><b>3</b><i class="fas fa-chart-line"></i><span><strong>Revisar perfil financiero</strong><small>Analiza historial y comportamiento de pagos.</small></span></div>
						<div><b>4</b><i class="fas fa-list-check"></i><span><strong>Aplicar criterios</strong><small>Clasifica el nivel de riesgo.</small></span></div>
						<div><b>5</b><i class="fas fa-gauge-high"></i><span><strong>Determinar riesgo</strong><small>Bajo, Medio, Alto o Crítico.</small></span></div>
						<div><b>6</b><i class="fas fa-gavel"></i><span><strong>Tomar decisión</strong><small>Aprobar, revisar, observar o rechazar.</small></span></div>
						<div><b>7</b><i class="fas fa-clipboard-check"></i><span><strong>Registrar evaluación</strong><small>Guarda observaciones y decisión final.</small></span></div>
					</div>
				</section>

			</div>

			<div class="bottom-grid">

				<div class="mini-politica alerta">
					<h2>4. Alertas Automáticas</h2>
					<ul>
						<li>Cliente con muchas deudas vigentes.</li>
						<li>DNI con múltiples solicitudes en corto tiempo.</li>
						<li>Ingresos declarados inconsistentes.</li>
						<li>Datos incompletos o documentos inválidos.</li>
						<li>Monto solicitado muy alto frente a ingresos.</li>
					</ul>
					<i class="fas fa-triangle-exclamation dibujo-alerta"></i>
				</div>

				<div class="mini-politica recomendacion">
					<h2>5. Recomendaciones Generales</h2>
					<ul>
						<li>Siempre verifica la información antes de aprobar.</li>
						<li>No te bases en un solo criterio.</li>
						<li>Documenta tus observaciones.</li>
						<li>Respeta los límites de aprobación.</li>
						<li>Si tienes dudas, escala al supervisor.</li>
					</ul>
					<i class="fas fa-user-check dibujo-reco"></i>
				</div>

				<div class="mini-politica limites">
					<h2>6. Límites de Aprobación</h2>

					<table>
						<tr>
							<th>Nivel de Analista</th>
							<th>Monto Máximo</th>
						</tr>
						<tr>
							<td>Analista Junior</td>
							<td>Hasta S/ 10,000</td>
						</tr>
						<tr>
							<td>Analista Senior</td>
							<td>Hasta S/ 25,000</td>
						</tr>
						<tr>
							<td>Coordinador de Riesgos</td>
							<td>Hasta S/ 50,000</td>
						</tr>
						<tr>
							<td>Gerente de Riesgos</td>
							<td>Sin límite</td>
						</tr>
					</table>
				</div>

			</div>

			<div class="version-politica">
				<span><i class="fas fa-circle-info"></i> Estas políticas pueden actualizarse. Consulta siempre la versión vigente.</span>
				<span>Versión actual: 1.0</span>
				<span>Última actualización: 15/06/2026</span>
			</div>

		</main>

	</div>

@section Scripts {
    <script src="~/js/analista-js/politicas-riesgo.js" asp-append-version="true"></script>
}
