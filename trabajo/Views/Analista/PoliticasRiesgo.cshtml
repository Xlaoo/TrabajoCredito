		.top-politicas {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			margin-bottom: 25px;
		}

			.top-politicas p {
				color: #6b7280;
				font-size: 15px;
			}

		.perfil-analista {
			background: white;
			border-radius: 20px;
			padding: 16px 22px;
			display: flex;
			align-items: center;
			gap: 14px;
			box-shadow: 0 12px 30px rgba(124,58,237,.10);
		}

		.perfil-avatar {
			width: 58px;
			height: 58px;
			border-radius: 50%;
			background: #7c3aed;
			color: white;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 26px;
		}

		.perfil-analista strong {
			color: #241041;
			font-size: 15px;
		}

		.perfil-analista span {
			color: #6b7280;
			font-size: 13px;
		}

		.panel-principal,
		.politica-card,
		.mini-politica,
		.version-politica {
			background: white;
			border-radius: 24px;
			padding: 24px;
			box-shadow: 0 14px 34px rgba(124,58,237,.08);
		}

			.panel-principal h2,
			.politica-card h2,
			.mini-politica h2 {
				color: #4c1d95;
				font-size: 20px;
				font-weight: 900;
				margin-bottom: 18px;
			}

		.riesgo-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr) 1.6fr;
			gap: 18px;
		}

		.riesgo-card {
			border-radius: 18px;
			padding: 20px;
			border: 1px solid #eee;
		}

			.riesgo-card .riesgo-icon {
				width: 48px;
				height: 48px;
				border-radius: 14px;
				color: white;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 22px;
				margin-bottom: 12px;
			}

			.riesgo-card h3 {
				font-size: 15px;
				font-weight: 900;
				margin-bottom: 8px;
			}

			.riesgo-card p {
				color: #374151;
				font-size: 13px;
				min-height: 48px;
			}

			.riesgo-card button {
				margin-top: 15px;
				width: 100%;
				border-radius: 10px;
				padding: 10px;
				font-weight: 900;
				border: none;
			}

			.riesgo-card.bajo {
				background: #f0fdf4;
				border-color: #86efac;
			}

				.riesgo-card.bajo .riesgo-icon,
				.riesgo-card.bajo button {
					background: #22c55e;
					color: white;
				}

				.riesgo-card.bajo h3 {
					color: #15803d;
				}

			.riesgo-card.medio {
				background: #fffbeb;
				border-color: #fde68a;
			}

				.riesgo-card.medio .riesgo-icon,
				.riesgo-card.medio button {
					background: #f59e0b;
					color: white;
				}

				.riesgo-card.medio h3 {
					color: #b45309;
				}

			.riesgo-card.alto {
				background: #fff7ed;
				border-color: #fdba74;
			}

				.riesgo-card.alto .riesgo-icon,
				.riesgo-card.alto button {
					background: #f97316;
					color: white;
				}

				.riesgo-card.alto h3 {
					color: #c2410c;
				}

			.riesgo-card.critico {
				background: #fef2f2;
				border-color: #fca5a5;
			}

				.riesgo-card.critico .riesgo-icon,
				.riesgo-card.critico button {
					background: #ef4444;
					color: white;
				}

				.riesgo-card.critico h3 {
					color: #dc2626;
				}

		.objetivo-card {
			background: linear-gradient(135deg, #eff6ff, #ffffff);
			border: 1px solid #bfdbfe;
			border-radius: 18px;
			padding: 22px;
			position: relative;
			overflow: hidden;
		}

			.objetivo-card h3 {
				color: #4c1d95;
				font-size: 22px;
				font-weight: 900;
			}

			.objetivo-card p {
				color: #1e3a8a;
				font-size: 14px;
				line-height: 1.6;
				max-width: 70%;
			}

		.objetivo-dibujo {
			position: absolute;
			right: 20px;
			bottom: 18px;
			color: #2563eb;
			font-size: 78px;
		}

			.objetivo-dibujo span {
				position: absolute;
				right: -8px;
				bottom: 0;
				font-size: 42px;
				color: #7c3aed;
			}

		.politicas-grid {
			display: grid;
			grid-template-columns: 1.4fr 1fr;
			gap: 22px;
			margin-top: 24px;
		}

		.tabla-politicas th {
			background: #f8fafc;
			color: #4c1d95;
			font-size: 13px;
		}

		.tabla-politicas td {
			font-size: 13px;
		}

		.tag {
			padding: 5px 10px;
			border-radius: 999px;
			font-weight: 900;
			font-size: 12px;
		}

			.tag.alto {
				background: #fee2e2;
				color: #dc2626;
			}

			.tag.medio {
				background: #fef3c7;
				color: #b45309;
			}

		.nota-politica {
			margin-top: 18px;
			background: #f5f3ff;
			color: #4c1d95;
			border: 1px solid #ddd6fe;
			padding: 14px;
			border-radius: 14px;
			font-weight: 700;
		}

		.pasos {
			display: flex;
			flex-direction: column;
			gap: 18px;
			position: relative;
		}

			.pasos::before {
				content: "";
				position: absolute;
				left: 15px;
				top: 20px;
				bottom: 20px;
				width: 3px;
				background: linear-gradient(#7c3aed, #22c55e);
				border-radius: 10px;
			}

			.pasos div {
				display: grid;
				grid-template-columns: 34px 58px 1fr;
				align-items: center;
				gap: 14px;
				position: relative;
			}

			.pasos b {
				width: 32px;
				height: 32px;
				background: #6d28d9;
				color: white;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.pasos i {
				width: 52px;
				height: 52px;
				background: #ede9fe;
				color: #4c1d95;
				border-radius: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 24px;
			}

			.pasos strong {
				color: #241041;
				font-size: 15px;
			}

			.pasos small {
				color: #6b7280;
				display: block;
				margin-top: 4px;
			}

		.bottom-grid {
			display: grid;
			grid-template-columns: 1fr 1fr 1.1fr;
			gap: 22px;
			margin-top: 24px;
		}

		.mini-politica {
			position: relative;
			overflow: hidden;
			min-height: 210px;
		}

			.mini-politica ul {
				padding-left: 18px;
				line-height: 1.9;
				color: #374151;
				font-weight: 600;
			}

		.alerta {
			background: linear-gradient(135deg, #fffbeb, #fff);
		}

		.recomendacion {
			background: linear-gradient(135deg, #eff6ff, #fff);
		}

		.limites {
			background: linear-gradient(135deg, #ecfdf5, #fff);
		}

		.dibujo-alerta {
			position: absolute;
			right: 28px;
			bottom: 28px;
			color: #ef4444;
			font-size: 80px;
			opacity: .9;
		}

		.dibujo-reco {
			position: absolute;
			right: 28px;
			bottom: 25px;
			color: #7c3aed;
			font-size: 75px;
			opacity: .85;
		}

		.limites table {
			width: 100%;
			border-collapse: collapse;
		}

		.limites th {
			background: #d1fae5;
			color: #047857;
		}

		.limites td {
			font-size: 13px;
		}

		.version-politica {
			margin-top: 22px;
			display: flex;
			justify-content: space-between;
			color: #4c1d95;
			font-weight: 700;
			font-size: 13px;
		}

	.perfil-link {
		text-decoration: none;
		cursor: pointer;
		transition: .25s;
	}

		.perfil-link:hover {
			transform: translateY(-3px);
			box-shadow: 0 16px 35px rgba(124,58,237,.18);
		}

		.perfil-link small {
			display: block;
			margin-top: 5px;
			color: #6d28d9;
			font-size: 12px;
			font-weight: 800;
		}
	</style>

