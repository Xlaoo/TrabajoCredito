	.content {
		flex: 1;
		padding: 40px;
	}

	h1 {
		font-size: 44px;
		font-weight: 900;
		color: #4c1d95;
	}

	.subtitle {
		color: #6b7280;
		font-size: 18px;
		margin-bottom: 30px;
	}

	.profile-card {
		background: white;
		border-radius: 28px;
		padding: 35px;
		max-width: 1000px;
		box-shadow: 0 18px 40px rgba(124,58,237,.12);
	}

	.profile-title {
		font-size: 30px;
		font-weight: 900;
		color: #4c1d95;
		margin-bottom: 22px;
	}

	.info-row {
		display: grid;
		grid-template-columns: 220px 1fr;
		align-items: center;
		border-bottom: 1px solid #eee;
		padding: 17px 0;
		gap: 20px;
	}

		.info-row span {
			color: #6b7280;
			font-weight: 700;
		}

		.info-row strong {
			color: #1f1235;
			font-weight: 800;
		}

	.edit-field {
		display: none;
		width: 100%;
		padding: 13px;
		border: 2px solid #7c3aed;
		border-radius: 12px;
		font-size: 16px;
	}

	.btn-main {
		border: none;
		padding: 14px 24px;
		border-radius: 14px;
		color: white;
		font-weight: bold;
		margin-top: 25px;
		margin-right: 10px;
		text-decoration: none;
		display: inline-block;
	}

	.btn-edit {
		background: #7c3aed;
	}

	.btn-save {
		background: #16a34a;
		display: none;
	}

	.btn-back {
		background: #6b7280;
	}

	.password-rules {
		display: none;
		background: #f3e8ff;
		border-radius: 16px;
		padding: 16px;
		margin-top: 12px;
		color: #4c1d95;
	}

	.ok {
		color: #16a34a;
		font-weight: bold;
	}

	.bad {
		color: #ef4444;
		font-weight: bold;
	}

	.alert-msg {
		background: #dcfce7;
		color: #166534;
		padding: 15px;
		border-radius: 14px;
		margin-bottom: 20px;
		font-weight: bold;
	}

	.codigo-box {
		display: none;
		margin-top: 15px;
		background: #fff7ed;
		padding: 18px;
		border-radius: 16px;
		border: 2px solid #fed7aa;
	}

		.codigo-box button {
			background: #f59e0b;
			border: none;
			padding: 12px 18px;
			border-radius: 12px;
			color: white;
			font-weight: bold;
			margin-top: 10px;
		}

