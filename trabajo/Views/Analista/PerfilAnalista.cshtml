	<div class="content">
		<h1>Perfil del Analista</h1>
		<p class="subtitle">Consulta y actualiza tus datos personales como analista de riesgo.</p>

		@if (TempData["MensajeOk"] != null)
		{
			<div class="alert-msg">
				@TempData["MensajeOk"]
			</div>
		}

		<form method="post"
			  asp-action="PerfilAnalista"
			  asp-controller="Analista"
			  class="profile-card">

			<div class="profile-title">
				<i class="fas fa-user-circle"></i>
				Información del analista
			</div>

			<div class="info-row">
				<span>Nombre</span>
				<strong class="texto">@Model.Nombre</strong>
				<input class="edit-field" asp-for="Nombre" required />
			</div>

			<div class="info-row">
				<span>Apellido</span>
				<strong class="texto">@Model.Apellido</strong>
				<input class="edit-field" asp-for="Apellido" required />
			</div>

			<div class="info-row">
				<span>Género</span>
				<strong class="texto">@Model.Genero</strong>
				<select class="edit-field" asp-for="Genero">
					<option value="Masculino">Masculino</option>
					<option value="Femenino">Femenino</option>
				</select>
			</div>

			<div class="info-row">
				<span>DNI</span>
				<strong class="texto">@Model.Dni</strong>
				<input class="edit-field"
					   asp-for="Dni"
					   maxlength="8"
					   required
					   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
			</div>

			<div class="info-row">
				<span>Celular</span>
				<strong class="texto">@Model.Celular</strong>
				<input class="edit-field"
					   asp-for="Celular"
					   maxlength="9"
					   required
					   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
			</div>

			<div class="info-row">
				<span>Correo</span>
				<strong class="texto">@Model.Correo</strong>
				<input id="correoInput"
					   class="edit-field"
					   asp-for="Correo"
					   required
					   oninput="mostrarCodigoCorreo()" />
			</div>

			<div id="codigoBox" class="codigo-box">
				<b>Verificación de nuevo correo</b>
				<p>Si cambias el correo, solicita un código de verificación.</p>

				<button type="button" onclick="enviarCodigo()">
					Obtener código de verificación
				</button>

				<input id="codigoCorreo"
					   name="codigoCorreo"
					   class="form-control mt-3"
					   placeholder="Ingrese código de verificación" />
			</div>
			<div id="nuevaClaveRow" class="info-row" style="display:none;">
				<span>Nueva contraseña</span>

				<div class="password-wrap">
					<input id="claveInput"
						   name="clave"
						   class="edit-field password-input"
						   type="password"
						   placeholder="Dejar vacío si no deseas cambiarla"
						   oninput="validarClave(); marcarCambio();" />

					<button type="button"
							class="btn-eye"
							onclick="togglePassword('claveInput', this)">
						<i class="fas fa-eye"></i>
					</button>
				</div>
			</div>

			<div id="confirmarClaveRow" class="info-row" style="display:none;">
				<span>Confirmar nueva contraseña</span>

				<div class="password-wrap">
					<input id="confirmarClaveInput"
						   name="confirmarClave"
						   class="edit-field password-input"
						   type="password"
						   placeholder="Repite la nueva contraseña"
						   oninput="marcarCambio();" />

					<button type="button"
							class="btn-eye"
							onclick="togglePassword('confirmarClaveInput', this)">
						<i class="fas fa-eye"></i>
					</button>
				</div>
			</div>

			<div id="reglasClave" class="password-rules">
				<p id="mayus" class="bad">✖ Una letra mayúscula</p>
				<p id="minus" class="bad">✖ Una letra minúscula</p>
				<p id="num" class="bad">✖ Un número</p>
				<p id="minimo" class="bad">✖ Mínimo 6 caracteres</p>
			</div>

			<button id="btnEditar"
					type="button"
					class="btn-main btn-edit"
					onclick="activarEdicion()">
				<i class="fas fa-edit"></i>
				Editar perfil
			</button>

			<button id="btnGuardar"
					type="submit"
					class="btn-main btn-save">
				<i class="fas fa-save"></i>
				Guardar cambios
			</button>

			<button id="btnCancelar"
					type="button"
					class="btn-main btn-back"
					style="display:none;"
					onclick="cancelarEdicion()">
				Cancelar
			</button>

			<a id="btnRegresar"
			   href="@Url.Action("ProgramaAnalista", "Analista")"
			   class="btn-main btn-back">
				Regresar
			</a>

		</form>
	</div>

</div>

<script>
		let correoOriginal = "@Model.Correo";
		let cambioRealizado = false;

		function activarEdicion() {
			document.querySelectorAll(".texto")
				.forEach(x => x.style.display = "none");

			document.querySelectorAll(".edit-field")
				.forEach(x => x.style.display = "block");

			document.getElementById("nuevaClaveRow").style.display = "grid";
			  document.getElementById("confirmarClaveRow").style.display = "grid";
			document.getElementById("reglasClave").style.display = "block";

			document.getElementById("btnEditar").style.display = "none";
			document.getElementById("btnGuardar").style.display = "inline-block";
			document.getElementById("btnCancelar").style.display = "inline-block";
			document.getElementById("btnRegresar").style.display = "none";
		}

		document.querySelectorAll(".edit-field").forEach(input => {
			input.addEventListener("input", function () {
				cambioRealizado = true;
			});
		});

		function cancelarEdicion() {
			if (cambioRealizado) {
				let salir = confirm("¿Estás seguro que quieres salir sin guardar los cambios?");
				if (!salir) return;
			}

			window.location.href = '@Url.Action("PerfilAnalista", "Analista")';
		}

		function validarClave() {
			let clave = document.getElementById("claveInput").value;

			cambiarRegla("mayus", /[A-Z]/.test(clave), "Una letra mayúscula");
			cambiarRegla("minus", /[a-z]/.test(clave), "Una letra minúscula");
			cambiarRegla("num", /[0-9]/.test(clave), "Un número");
			cambiarRegla("minimo", clave.length >= 6, "Mínimo 6 caracteres");
		}

		function cambiarRegla(id, cumple, texto) {
			let item = document.getElementById(id);

			if (cumple) {
				item.className = "ok";
				item.innerText = "✔ " + texto;
			} else {
				item.className = "bad";
				item.innerText = "✖ " + texto;
			}
		}
				function mostrarCodigoCorreo() {
			let correoNuevo = document.getElementById("correoInput").value;

			if (correoNuevo !== correoOriginal) {
				document.getElementById("codigoBox").style.display = "block";
			} else {
				document.getElementById("codigoBox").style.display = "none";
			}
		}

		function enviarCodigo() {
			let correo = document.getElementById("correoInput").value;

			fetch('@Url.Action("EnviarCodigoPerfilAnalista", "Analista")', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/x-www-form-urlencoded'
				},
				body: 'correo=' + encodeURIComponent(correo)
			})
			.then(response => response.json())
			.then(data => {
				alert(data.mensaje);
			})
			.catch(error => {
				alert("No se pudo enviar el código.");
			});
		}
				@if (ViewData["ModoEditar"] != null)
		{
					<text>
						activarEdicion();
					</text>
		}

		@if (ViewData["CorreoIntentado"] != null)
		{
					<text>
						document.getElementById("correoInput").value = "@ViewData["CorreoIntentado"]";
						mostrarCodigoCorreo();
					</text>
		}
			function togglePassword(inputId, boton) {
		const input = document.getElementById(inputId);
		const icono = boton.querySelector("i");

		if (input.type === "password") {
			input.type = "text";
			icono.classList.remove("fa-eye");
			icono.classList.add("fa-eye-slash");
		} else {
			input.type = "password";
			icono.classList.remove("fa-eye-slash");
			icono.classList.add("fa-eye");
		}
	}
</script>
@* </body>
</html> *@