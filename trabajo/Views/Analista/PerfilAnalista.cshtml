	.password-wrap {
		width: 100%;
		position: relative;
	}

		.password-wrap .password-input {
			width: 100%;
			padding-right: 48px;
		}

	.btn-eye {
		position: absolute;
		right: 12px;
		top: 50%;
		transform: translateY(-50%);
		border: none;
		background: transparent;
		color: #6d28d9;
		font-size: 18px;
		cursor: pointer;
		display: none;
	}

	.password-wrap .edit-field[style*="block"] + .btn-eye,
	.password-wrap .edit-field:not([style*="display: none"]) + .btn-eye {
		display: block;
	}

	input[type="password"]::-ms-reveal,
	input[type="password"]::-ms-clear {
		display: none;
	}

	.password-wrap {
		width: 100%;
