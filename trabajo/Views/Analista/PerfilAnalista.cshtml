@model trabajo.Models.Usuario

@{
	Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
	ViewData["Title"] = "Perfil Analista - CrediPlus";
	ViewData["ActivePage"] = "PerfilAnalista";
}

@section Styles {
	<link rel="stylesheet" href="~/css/analista-css/perfil-analista.css" asp-append-version="true" />
}

<div class="layout">

	<div class="content">
		<h1>Perfil del Analista</h1>
		<p class="subtitle">Consulta y actualiza tus datos personales como analista de riesgo.</p>

		@if (TempData["MensajeOk"] != null)
		{
			<div class="alert-msg">
				@TempData["MensajeOk"]
			</div>
		}

		<form method="post"
			  asp-action="PerfilAnalista"
			  asp-controller="Analista"
			  class="profile-card"
			  id="formPerfilAnalista"
			  data-correo-original="@Model.Correo"
			  data-url-enviar-codigo="@Url.Action("EnviarCodigoPerfilAnalista", "Analista")"
			  data-url-cancelar="@Url.Action("PerfilAnalista", "Analista")"
			  data-modo-editar="@(ViewData["ModoEditar"] != null ? "true" : "false")"
			  data-correo-intentado="@(ViewData["CorreoIntentado"]?.ToString() ?? "")">

			<div class="profile-title">
				<i class="fas fa-user-circle"></i>
				Información del analista
			</div>

			<div class="info-row">
				<span>Nombre</span>
				<strong class="texto">@Model.Nombre</strong>
				<input class="edit-field" asp-for="Nombre" required />
			</div>

			<div class="info-row">
				<span>Apellido</span>
				<strong class="texto">@Model.Apellido</strong>
				<input class="edit-field" asp-for="Apellido" required />
			</div>

			<div class="info-row">
				<span>DNI</span>
				<strong class="texto">@Model.Dni</strong>
				<input class="edit-field"
					   asp-for="Dni"
					   id="Dni"
					   maxlength="8"
					   required />
			</div>

			<div class="info-row">
				<span>Celular</span>
				<strong class="texto">@Model.Celular</strong>
				<input class="edit-field"
					   asp-for="Celular"
					   id="Celular"
					   maxlength="9"
					   required />
			</div>

			<div class="info-row">
				<span>Correo</span>
				<strong class="texto">@Model.Correo</strong>
				<input id="correoInput"
					   class="edit-field"
					   asp-for="Correo"
					   required />
			</div>

			<div class="info-row">
				<span>Género</span>
				<strong class="texto">@(string.IsNullOrWhiteSpace(Model.Genero) ? "No especificado" : Model.Genero)</strong>
				<select class="edit-field" asp-for="Genero" id="generoSelect">
					@if (string.IsNullOrWhiteSpace(Model.Genero))
					{
						<option value="" disabled selected>Seleccione género</option>
					}
					<option value="Masculino">Masculino</option>
					<option value="Femenino">Femenino</option>
				</select>
			</div>

			<div id="codigoBox" class="codigo-box">
				<b>Verificación de nuevo correo</b>
				<p>Si cambias el correo, solicita un código de verificación.</p>

				<button type="button" id="btnEnviarCodigoCorreo">
					Obtener código de verificación
				</button>

				<input id="codigoCorreo"
					   name="codigoCorreo"
					   class="form-control mt-3"
					   placeholder="Ingrese código de verificación" />
			</div>
			<div id="nuevaClaveRow" class="info-row hidden-row">
				<span>Nueva contraseña</span>

				<div class="password-wrap">
					<input id="claveInput"
						   name="clave"
						   class="edit-field password-input"
						   type="password"
						   placeholder="Dejar vacío si no deseas cambiarla" />

					<button type="button"
							class="btn-eye"
							data-target="claveInput"
							aria-label="Mostrar contraseña">
						<i class="fas fa-eye"></i>
					</button>
				</div>
			</div>

			<div id="confirmarClaveRow" class="info-row hidden-row">
				<span>Confirmar nueva contraseña</span>

				<div class="password-wrap">
					<input id="confirmarClaveInput"
						   name="confirmarClave"
						   class="edit-field password-input"
						   type="password"
						   placeholder="Repite la nueva contraseña" />

					<button type="button"
							class="btn-eye"
							data-target="confirmarClaveInput"
							aria-label="Mostrar contraseña">
						<i class="fas fa-eye"></i>
					</button>
				</div>
			</div>

			<div id="reglasClave" class="password-rules">
				<p id="mayus" class="bad">✖ Una letra mayúscula</p>
				<p id="minus" class="bad">✖ Una letra minúscula</p>
				<p id="num" class="bad">✖ Un número</p>
				<p id="simbolo" class="bad">✖ Un símbolo especial (!@@#$%&*...)</p>
				<p id="minimo" class="bad">✖ Mínimo 12 caracteres</p>
			</div>

			<button id="btnEditar"
					type="button"
					class="btn-main btn-edit">
				<i class="fas fa-edit"></i>
				Editar perfil
			</button>

			<button id="btnGuardar"
					type="submit"
					class="btn-main btn-save">
				<i class="fas fa-save"></i>
				Guardar cambios
			</button>

			<button id="btnCancelar"
					type="button"
					class="btn-main btn-back hidden-row">
				Cancelar
			</button>

			<a id="btnRegresar"
			   href="@Url.Action("ProgramaAnalista", "Analista")"
			   class="btn-main btn-back">
				Regresar
			</a>

		</form>
	</div>

</div>

@section Scripts {
	<script src="~/js/analista-js/perfil-analista.js" asp-append-version="true"></script>
}