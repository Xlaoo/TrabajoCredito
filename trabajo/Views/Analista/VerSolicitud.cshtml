@model trabajo.Models.SolicitudCredito
@using trabajo.Models
@using trabajo.Service
@{
    Layout = null;
    Layout = "~/Views/Shared/_LayoutAnalista.cshtml";
    ViewData["Title"] = "Ver Solicitud";
    ViewData["ActivePage"] = "VerSolicitud";

    if (Model.PERFIL_FINANCIERO == null)
    {
        <text>No existe perfil financiero</text>
        return;
    }

    var evaluacion = ViewBag.EvaluacionRiesgo as ResultadoEvaluacionRiesgo;
    decimal capacidadPago = evaluacion?.CapacidadPago ?? (Model.PERFIL_FINANCIERO.IngresoMensual * 0.30m);
    decimal disponiblePrestamo = evaluacion?.DisponiblePrestamo ?? (capacidadPago * 10.5m);

    var historial = ViewBag.Historial as List<HistorialCredito>;
    var ultimoHistorial = historial?.LastOrDefault();
    var resumen = ViewBag.Resumen as ResumenCredito;

    int activas = evaluacion?.DeudasActivas ?? (resumen?.DeudasActivas ?? 0);
    int pagadas = evaluacion?.DeudasPagadas ?? (resumen?.DeudasPagadas ?? 0);
    int vencidas = evaluacion?.DeudasVencidas ?? (resumen?.DeudasVencidas ?? 0);
    int deudasEncontradas = activas + vencidas;
    bool tieneOtrosCreditos = Model.PERFIL_FINANCIERO?.OtrosCreditos ?? false;

    var ultimaActualizacion = (historial != null && historial.Any(x => x.FechaFin.HasValue))
        ? historial.Where(x => x.FechaFin.HasValue).Max(x => x.FechaFin)
        : null;

    int totalHistorial = activas + pagadas + vencidas;

    string nivelRiesgo = evaluacion?.NivelRiesgo ?? "MEDIO";
    string claseColor = evaluacion?.ClaseColor ?? "medio";
    string posicionAguja = evaluacion?.PosicionAguja ?? "-20deg";

    var estadoNormalizado = Model.Estado?.Trim().ToLower();
    var estaEnEvaluacion = estadoNormalizado == "en evaluación";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/analista-css/ver-solicitud.css" asp-append-version="true" />
}

<div id="solicitudContexto"
     data-id-solicitud="@Model.Id_Solicitud"
     data-esta-en-evaluacion="@(estaEnEvaluacion ? "true" : "false")"
     data-plazo="@Model.PlazoMeses"
     data-abrir-mensaje="@(ViewBag.AbrirMensaje?.ToString()?.ToLower() ?? "")">
</div>


<div class="content">

    <div class="contenedor">
        <div class="top-bar">

            <a id="btnRegresar"
               href="@Url.Action("SolicitudesPendientes", "Analista")"
               class="btn-regresar">
                ← Regresar
            </a>

        </div>

        <h2 class="titulo-principal">
            Detalle de Solicitud - SOL-@Model.Id_Solicitud.ToString("D5")
        </h2>

        <div class="estado">
            Estado: @Model.Estado
        </div>

        <div class="fila-superior">

            <div class="card card-personal">

                <h3>DATOS PERSONALES</h3>

                @if (Model.USUARIO.Genero == "Femenino")
                {
                    <img src="https://cdn-icons-png.flaticon.com/512/6997/6997662.png"
                         class="foto-usuario" />
                }
                else
                {
                    <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
                         class="foto-usuario" />
                }

                <p>
                    <b>Nombre Completo:</b>
                    @Model.USUARIO.Nombre @Model.USUARIO.Apellido
                </p>

                <p>
                    <b>DNI:</b>
                    @Model.USUARIO.Dni
                </p>

                <p>
                    <b>Teléfono:</b>
                    @Model.USUARIO.Celular
                </p>

                <p>
                    <b>Email:</b>
                    @Model.USUARIO.Correo
                </p>
                <p>
                    <b>Género:</b>
                    @Model.USUARIO.Genero
                </p>

                <p>
                    <b>Fecha de Evaluación:</b>
                    @Model.FechaSolicitud.ToString("dd/MM/yyyy")
                </p>

            </div>

            <div class="perfil-columna-cards">

                <div class="card card-financiero card-relativo">

                    <h3>PERFIL FINANCIERO</h3>

                    <p>
                        <b>Monto</b>
                        <span class="float-right-val">
                            S/ @Model.MontoSolicitado.ToString("N0")
                        </span>
                    </p>

                    <p>
                        <b>Plazo</b>
                        <span class="float-right-val">
                            @Model.PlazoMeses meses
                        </span>
                    </p>

                    <p>
                        <b>Motivo</b>
                        <span class="float-right-val">
                            @Model.PERFIL_FINANCIERO.MotivoPrestamo
                        </span>
                    </p>
                    <p>
                        <b>Ocupación</b>
                        <span class="float-right-val">
                            @Model.PERFIL_FINANCIERO.Ocupacion
                        </span>
                    </p>


                </div>

                <div class="card card-financiero">

                    <h3>RESUMEN FINANCIERO</h3>

                    <p>
                        <b>Ingresos mensuales:</b>
                        <span class="float-right-val">
                            S/ @Model.PERFIL_FINANCIERO.IngresoMensual.ToString("N2")
                        </span>
                    </p>

                    <p>
                        <b>Egresos mensuales:</b>
                        <span class="float-right-val">
                            S/ @Model.PERFIL_FINANCIERO.EgresoMensual.ToString("N2")
                        </span>
                    </p>

                </div>

            </div>

            <div class="card card-derecha">

                <h3>CRÉDITOS ACTIVOS</h3>

                <p>
                    <b>¿Tienes créditos activos?</b>
                    <span class="float-right-val">
                        @(Model.PERFIL_FINANCIERO.OtrosCreditos ? "Sí" : "No")
                    </span>
                </p>

            </div>

        </div>
        <div class="acciones">

            <button id="btnValidar"
                    class="btn-validar">
                VALIDAR CLIENTE
            </button>

        </div>
        <div id="evaluacionFinanciera" class="elemento-oculto">
            <div class="fila-cards">
                <div class="card perfil-financiero-modern">

                    <div class="header-perfil">
                        <h3>PERFIL FINANCIERO</h3>

                        <div id="iconoEstado" class="icono-header">
                            ✏️
                        </div>
                    </div>

                    <div class="item-perfil">
                        <div class="icono">💲</div>

                        <div class="texto">
                            <strong>Monto solicitado:</strong>
                        </div>

                        <span id="txtMonto" class="float-right-val">
                            S/ @Model.MontoSolicitado.ToString("N0")
                        </span>
                        <input type="text"
                               id="inputMonto"
                               class="input-editar elemento-oculto"
                               value="@Model.MontoSolicitado.ToString("N0")" />
                    </div>

                    <div class="item-perfil">
                        <div class="icono">📅</div>

                        <div class="texto">
                            <strong>Plazo:</strong>
                        </div>

                        <span id="txtPlazo" class="float-right-val">
                            @Model.PlazoMeses meses
                        </span>
                        <select id="inputPlazo"
                                class="select-editar elemento-oculto">
                            <option value="12">12 meses</option>
                            <option value="18">18 meses</option>
                            <option value="24">24 meses</option>
                            <option value="30">30 meses</option>
                            <option value="36">36 meses</option>
                            <option value="48">48 meses</option>
                            <option value="60">60 meses</option>
                            <option value="72">72 meses</option>
                        </select>

                    </div>

                    <div class="item-perfil">
                        <div class="icono">📄</div>

                        <div class="texto">
                            <strong>Motivo:</strong>
                        </div>

                        <div class="valor">
                            @Model.PERFIL_FINANCIERO.MotivoPrestamo
                        </div>
                    </div>

                    <div class="item-perfil">
                        <div class="icono">💼</div>

                        <div class="texto">
                            <strong>Ocupación:</strong>
                        </div>

                        <div class="valor">
                            @Model.PERFIL_FINANCIERO.Ocupacion
                        </div>
                    </div>

                    <div class="item-perfil">
                        <div class="icono">📈</div>

                        <div class="texto">
                            <strong>Ingreso mensual:</strong>
                        </div>

                        <span id="txtIngresoPerfil" class="float-right-val">
                            S/ @Model.PERFIL_FINANCIERO.IngresoMensual.ToString("N0")
                        </span>
                        <input type="text"
                               id="inputIngreso"
                               class="input-editar elemento-oculto"
                               value="@Model.PERFIL_FINANCIERO.IngresoMensual.ToString("N0")" />
                    </div>

                    <div class="item-perfil">
                        <div class="icono">📉</div>

                        <div class="texto">
                            <strong>Egreso mensual:</strong>
                        </div>

                        <span id="txtEgresoPerfil" class="float-right-val">
                            S/ @Model.PERFIL_FINANCIERO.EgresoMensual.ToString("N0")
                        </span>
                        <input type="text"
                               id="inputEgreso"
                               class="input-editar elemento-oculto"
                               value="@Model.PERFIL_FINANCIERO.EgresoMensual.ToString("N0")" />
                    </div>

                    <div class="acciones-inferiores">

                        <button id="btnIniciarEdicion"
                                class="btn-editar-perfil">
                            ✏️ Editar Perfil Financiero
                        </button>

                        <div id="grupoAcciones" class="elemento-oculto">

                            <button type="button"
                                    id="btnGuardarPerfil"
                                    class="btn-guardar-perfil">
                                💾 Guardar
                            </button>

                            <button type="button"
                                    id="btnCancelarPerfil"
                                    class="btn-cancelar-perfil">
                                ❌ Cancelar
                            </button>

                        </div>

                    </div>



                </div>

                <div class="card resumen-financiero-modern">

                    <h3>RESUMEN FINANCIERO</h3>

                    <div class="item-resumen">
                        <div class="icono-resumen">📈</div>

                        <div class="texto">
                            <strong>Ingresos mensuales:</strong>
                        </div>

                        <div class="valor-verde" id="txtIngresosResumen">
                            S/ @Model.PERFIL_FINANCIERO.IngresoMensual.ToString("N2")
                        </div>
                    </div>

                    <div class="item-resumen">
                        <div class="icono-resumen">📉</div>

                        <div class="texto">
                            <strong>Egresos mensuales:</strong>
                        </div>

                        <div class="valor-rojo" id="txtEgresosResumen">
                            S/ @Model.PERFIL_FINANCIERO.EgresoMensual.ToString("N2")
                        </div>
                    </div>

                    <div class="item-resumen">
                        <div class="icono-resumen">📊</div>

                        <div class="texto">
                            <strong>Capacidad de pago (30%):</strong>
                        </div>

                        <div class="valor-azul" id="txtCapacidadResumen">
                            S/ @capacidadPago.ToString("N2")
                        </div>
                    </div>

                    <div class="item-resumen">
                        <div class="icono-resumen">💸</div>

                        <div class="texto">
                            <strong>Disponible para préstamo:</strong>
                        </div>

                        <div class="valor-morado" id="txtDisponibleResumen">
                            S/ @disponiblePrestamo.ToString("N2")
                        </div>
                    </div>

                </div>
                <div class="card comentarios-analisis">

                    <h3>COMENTARIOS DEL SISTEMA Y ANÁLISIS</h3>

                    <div class="toolbar-analisis">
                        <button type="button" class="btn-format-text" data-cmd="bold"><b>B</b></button>

                        <button type="button" class="btn-format-text" data-cmd="italic">
                            <i>I</i>
                        </button>

                        <button type="button" class="btn-format-text" data-cmd="underline">
                            <u>U</u>
                        </button>

                        <button type="button" class="btn-format-text" data-cmd="insertUnorderedList">
                            ☰
                        </button>

                        <button type="button" class="btn-format-text" data-cmd="justifyLeft">
                            ≡
                        </button>

                        <button type="button" class="btn-format-text" data-cmd="justifyCenter">
                            ≣
                        </button>

                        <button type="button" class="btn-format-text" data-cmd="justifyRight">
                            ☷
                        </button>
                    </div>

                    <div id="editorComentarios"
                         class="editor-comentarios"
                         contenteditable="true"
                         data-placeholder="Escriba un comentario sobre la evaluación...">
                    </div>

                    <div class="recomendacion-footer">

                        <div class="nivel-recomendacion">
                            <strong>Nivel de recomendación:</strong>

                            <span id="badgeNivel" class="badge-manual">
                                Manual
                            </span>
                        </div>

                        <select id="selectorRiesgo" class="selector-riesgo">
                            <option value="" selected>Manual</option>
                            <option value="critico">Crítico</option>
                            <option value="alto">Alto</option>
                            <option value="medio">Medio</option>
                            <option value="bajo">Bajo</option>
                        </select>

                    </div>

                </div>
            </div>
            <div class="fila-cards">
                <div class="card deuda-crediticia">

                    <div class="header-deuda">
                        <h3>DEUDA ACTUAL Y DEUDOR</h3>

                        <button class="btn-editar-deuda">
                            ✏️
                        </button>
                    </div>

                    <div class="contenido-deuda">

                        <div class="lado-izquierdo">

                            <div class="fila-deuda">
                                <strong>¿Tienes créditos activos?</strong>

                                @if (tieneOtrosCreditos)
                                {
                                    <span class="badge-si">Sí</span>
                                }
                                else
                                {
                                    <span class="badge-no">No</span>
                                }
                            </div>

                            <div class="historial">
                                <strong>Historial crediticio:</strong><br />
                                <span id="txtDeudasEncontradas">
                                    @deudasEncontradas deudas encontradas
                                </span>
                                <div id="sinHistorial" class="sin-historial-msg elemento-oculto">
                                    No cuenta con historial crediticio.
                                </div>
                            </div>

                            <button class="btnHistorialCredito btn-historial"
                                    data-id="@Model.Id_Solicitud">

                                👁 Ver historial crediticio
                            </button>
                            <div id="modalHistorialCredito"
                                 class="modalHistorialCredito">

                                <div class="contenidoHistorial">

                                    <h2>Historial Crediticio</h2>


                                    <div id="datosCliente"></div>

                                    <table class="table">

                                        <thead>
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Apellido</th>
                                                <th>DNI</th>
                                                <th>Entidad</th>
                                                <th>Tipo Crédito</th>
                                                <th>Monto</th>
                                                <th>Plazo</th>
                                                <th>Cuotas Pagadas</th>
                                                <th>Estado</th>
                                                <th>Fecha Inicio</th>
                                                <th>Fecha Fin</th>
                                            </tr>
                                        </thead>

                                        <tbody id="tablaHistorial">
                                        </tbody>

                                    </table>

                                    <button id="cerrarHistorial"
                                            class="btnCerrarHistorial">
                                        Cerrar
                                    </button>

                                </div>

                            </div>

                        </div>

                        <div class="lado-derecho">
                            <div class="dato">
                                <span>Deudas activas:</span>
                                <strong id="txtActivas" class="rojo">@activas</strong>
                            </div>

                            <div class="dato">
                                <span>Deudas pagadas:</span>
                                <strong id="txtPagadas" class="verde">@pagadas</strong>
                            </div>

                            <div class="dato">
                                <span>Deudas vencidas:</span>
                                <strong id="txtVencidas" class="naranja">@vencidas</strong>
                            </div>


                            <div class="dato">
                                <span>Última actualización:</span>
                                <strong id="txtUltimaActualizacion">
                                    @ultimaActualizacion?.ToString("dd/MM/yyyy")
                                </strong>
                            </div>

                        </div>

                    </div>

                    <div class="footer-deuda">
                        ℹ La información mostrada es referencial y generada automáticamente.
                    </div>



                </div>

                <div class="card scoring-card">

                    <div class="scoring-title">
                        PUNTAJE DE RIESGO (SCORING)
                    </div>

                    <div class="medidor">

                        <div class="aguja" data-rotation="@posicionAguja">
                        </div>

                        <div class="centro"></div>

                    </div>

                    <div class="resultado-riesgo">
                        <span class="@claseColor">
                            @nivelRiesgo
                        </span>
                    </div>

                    <div class="info-scoring" id="txtMotivoScoring">
                        @(evaluacion?.MotivoClasificacion ?? "El puntaje se calcula en base al comportamiento financiero del cliente y su capacidad de pago.")
                    </div>

                </div>
            </div>
            <div class="acciones-evaluacion">

                <button id="btnNoValidar" class="btn-no-validar">
                    <span class="icono-no-validar">👤</span>
                    NO VALIDAR CLIENTE
                </button>

                <button id="btnRechazar" class="btn-rechazar">
                    ✖ RECHAZAR
                </button>

                <button id="btnAprobar" class="btn-aprobar">
                    ✔ APROBAR
                </button>

                @if (!estaEnEvaluacion)
                {
                    <button id="btnEvaluacion" class="btn-evaluacion">
                        🕒 EN EVALUACIÓN
                    </button>
                }
                else
                {
                    <button id="btnReporte"
                            type="button"
                            class="btn-reporte"
                            data-id="@Model.Id_Solicitud">
                        📄 REPORTE
                    </button>
                }
                <button id="btnMensaje"
                        type="button"
                        class="btn-mensaje"
                        data-id="@Model.Id_Solicitud">
                    <i class="fas fa-comments"></i>
                    MENSAJE
                </button>

            </div>


        </div>

    </div>

</div>

<div id="modalChat">

    <div class="chat-contenido">

        <div class="chat-header">

            <div>

                <div class="chat-titulo">
                    <i class="fas fa-comments"></i>
                    <span id="tituloSolicitud">
                        Mensajes
                    </span>
                </div>

                <div class="chat-subtitulo">

                    Cliente:
                    <span id="chatCliente">
                        -
                    </span>
                    &nbsp; • &nbsp;

                    Estado:
                    <span id="chatEstado">-</span>

                </div>

            </div>

            <button class="btn-cerrar-chat"
                    id="btnCerrarChat">
                <i class="fas fa-times"></i>
            </button>

        </div>

        <div id="chatMensajes">

            <div class="chat-vacio">

                <i class="fas fa-comments"></i>

                <h4>No hay mensajes</h4>

                <p>
                    Inicia una conversación con el Usuario.
                </p>

            </div>

        </div>

        <div class="chat-footer">

            <div id="nombreArchivoSeleccionado" class="archivo-seleccionado"></div>
            <input type="text"
                   id="txtMensaje"
                   placeholder="Escribe tu mensaje..." />

            <input type="file"
                   id="fileImagen"
                   accept="image/*"
                   class="elemento-oculto">

            <button class="btn-chat-icon"
                    id="btnSubirImagenChat">
                <i class="far fa-image"></i>
            </button>

            <button class="btn-enviar-chat"
                    id="btnEnviarChat">

                <i class="fas fa-paper-plane"></i>

                Enviar

            </button>

        </div>

    </div>


</div>
<div id="modalReporte" class="modal-reporte elemento-oculto">
    <div class="reporte-box">

        <div class="reporte-header">
            <h3>📄 Reporte de propuestas</h3>
            <button type="button" id="btnCerrarReporte">✕</button>
        </div>

        <div id="contenidoReporte" class="reporte-body">
        </div>

    </div>
</div>
<div id="modalEvaluacion" class="modal-evaluacion">

    <div class="modal-contenido">

        <div class="modal-header">
            <h4>¿Desea agregar otras opciones de crédito?</h4>
        </div>

        <div class="modal-body">

            <div id="contenedorOpciones"></div>

        </div>

        <div class="contenedor-mas">
            <button type="button"
                    id="btnAgregarOpcion"
                    class="btn-mas">
                +
            </button>
        </div>

        <div class="acciones-modal">
            <button type="button"
                    id="btnRegresarModal"
                    class="btn-regresar-modal">

                Regresar

            </button>

            <button type="button"
                    id="btnEnviarModal"
                    class="btn-enviar-modal">

                Enviar

            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sweetalert2.min.js" asp-append-version="true"></script>
    <script src="~/js/analista-js/ver-solicitud.js" asp-append-version="true"></script>
}
