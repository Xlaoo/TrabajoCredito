@model trabajo.Models.ViewModels.AdminCreditosViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
    ViewData["Title"] = "Créditos";
    ViewData["ActivePage"] = "Creditos";
}

<div class="creditos-page">

    <div class="creditos-header">
        <div>
            <h1 class="creditos-title">Créditos</h1>
            <p class="creditos-subtitle">Consulta y supervisa las solicitudes de crédito registradas en CrediPlus.</p>
        </div>
    </div>

    <div class="creditos-stats-grid">
        <div class="credito-stat-card">
            <div class="credito-stat-icon purple">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <p>Total Créditos</p>
                <h2>@Model.TotalCreditos</h2>
            </div>
        </div>

        <div class="credito-stat-card">
            <div class="credito-stat-icon green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <p>Aprobados</p>
                <h2>@Model.CreditosAprobados</h2>
            </div>
        </div>

        <div class="credito-stat-card">
            <div class="credito-stat-icon orange">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <p>En Evaluación</p>
                <h2>@Model.CreditosEvaluacion</h2>
            </div>
        </div>

        <div class="credito-stat-card">
            <div class="credito-stat-icon blue">
                <i class="fas fa-coins"></i>
            </div>
            <div>
                <p>Monto Solicitado</p>
                <h2>S/ @Model.MontoTotalSolicitado.ToString("N2")</h2>
            </div>
        </div>
    </div>
    @{
        decimal totalEstado = Model.TotalDistribucionEstado == 0 ? 1 : Model.TotalDistribucionEstado;

        decimal pAprobados = Math.Round(Model.CreditosActivosDistribucion * 100 / totalEstado, 1);
        decimal pCurso = Math.Round(Model.CreditosCursoDistribucion * 100 / totalEstado, 1);
        decimal pPendientes = Math.Round(Model.CreditosPendientesDistribucion * 100 / totalEstado, 1);
        decimal pCancelados = Math.Round(Model.CreditosCanceladosDistribucion * 100 / totalEstado, 1);

        decimal e1 = pAprobados;
        decimal e2 = pAprobados + pCurso;
        decimal e3 = pAprobados + pCurso + pPendientes;

        decimal totalTipo = Model.TotalDistribucionTipo == 0 ? 1 : Model.TotalDistribucionTipo;

        decimal pPersonal = Math.Round(Model.CreditosPersonalTipo * 100 / totalTipo, 1);
        decimal pNegocio = Math.Round(Model.CreditosNegocioTipo * 100 / totalTipo, 1);
        decimal pEstudio = Math.Round(Model.CreditosEstudioTipo * 100 / totalTipo, 1);

        decimal t1 = pPersonal;
        decimal t2 = pPersonal + pNegocio;
        var gradienteTipo = "";
        decimal acumuladoTipo = 0;

        foreach (var tipo in Model.TiposCreditoGrafico)
        {
            var inicio = acumuladoTipo;
            acumuladoTipo += tipo.Porcentaje;
            gradienteTipo += $"{tipo.Color} {inicio}% {acumuladoTipo}%, ";
        }

        gradienteTipo = gradienteTipo.TrimEnd(',', ' ');
    }
    <div class="creditos-resumen-grid">

        <div class="credito-resumen-card">
            <h3><i class="fas fa-chart-pie"></i> Distribución por Estado</h3>

            <div class="donut-box">
                <div class="donut estado"
                     style="background: conic-gradient(#22c55e 0 @e1%, #2563eb @e1% @e2%, #f97316 @e2% @e3%, #ef4444 @e3% 100%);">
                    <span>Total<br /><strong>@Model.TotalDistribucionEstado</strong><br />créditos</span>
                </div>

                <div class="resumen-list">
                    <p><span class="dot green"></span> Aprobados <strong>@Model.CreditosActivosDistribucion (@pAprobados%)</strong></p>
                    <p><span class="dot blue"></span> Pendientes <strong>@Model.CreditosPendientesDistribucion (@pPendientes%)</strong></p>
                    <p><span class="dot orange"></span> En Evaluación <strong>@Model.CreditosCursoDistribucion (@pCurso%)</strong></p>
                    <p><span class="dot red"></span> Rechazados <strong>@Model.CreditosCanceladosDistribucion (@pCancelados%)</strong></p>
                </div>
            </div>
        </div>

        <div class="credito-resumen-card">
            <h3><i class="fas fa-chart-pie"></i> Distribución por Tipo</h3>

            <div class="donut-box">
                <div class="donut tipo"
                     style="background: conic-gradient(@gradienteTipo);">
                    <span>Total<br /><strong>@Model.TotalDistribucionTipo</strong><br />créditos</span>
                </div>

                <div class="resumen-list">
                    @foreach (var tipo in Model.TiposCreditoGrafico)
                    {
                        <p>
                            <span class="dot" style="background:@tipo.Color"></span>
                            @tipo.Tipo
                            <strong>@tipo.Cantidad (@tipo.Porcentaje%)</strong>
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="credito-resumen-card">
            <h3><i class="fas fa-calendar-alt"></i> Resumen del Mes</h3>

            <div class="mes-list">
                <div class="mes-item">
                    <span class="mes-icon purple"><i class="fas fa-file-circle-plus"></i></span>
                    <p>Nuevos Créditos</p>
                    <strong>@Model.NuevosCreditosMes</strong>
                </div>

                <div class="mes-item">
                    <span class="mes-icon green"><i class="fas fa-coins"></i></span>
                    <p>Monto Otorgado</p>
                    <strong>S/ @Model.MontoOtorgadoMes.ToString("N2")</strong>
                </div>

                <div class="mes-item">
                    <span class="mes-icon blue"><i class="fas fa-check-circle"></i></span>
                    <p>Créditos Desembolsados</p>
                    <strong>@Model.CreditosDesembolsadosMes</strong>
                </div>
            </div>
        </div>

    </div>

    <div class="creditos-card">
        <form method="get" asp-controller="Administrador" asp-action="Creditos" class="creditos-toolbar">
            <div class="creditos-search">
                <i class="fas fa-search"></i>
                <input type="text" name="buscar" value="@Model.Buscar" placeholder="Buscar por cliente, DNI o solicitud..." />
            </div>

            <select name="estado" onchange="this.form.submit()">
                <option value="Todos" selected="@(Model.Estado == "Todos")">Todos</option>
                <option value="Pendiente" selected="@(Model.Estado == "Pendiente")">Pendiente</option>
                <option value="En Evaluación" selected="@(Model.Estado == "En Evaluación")">En Evaluación</option>
                <option value="Aprobado" selected="@(Model.Estado == "Aprobado")">Aprobado</option>
                <option value="Rechazado" selected="@(Model.Estado == "Rechazado")">Rechazado</option>
                <option value="Cancelado" selected="@(Model.Estado == "Cancelado")">Cancelado</option>
            </select>

            <button type="submit" class="creditos-btn">
                <i class="fas fa-filter"></i> Filtrar
            </button>

            <a class="creditos-btn export" href="@Url.Action("ExportarCreditosExcel", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado })">
                <i class="fas fa-file-excel"></i> Excel
            </a>

            <a class="creditos-btn export pdf" href="@Url.Action("ExportarCreditosPdf", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado })">
                <i class="fas fa-file-pdf"></i> PDF
            </a>
        </form>

        <div class="creditos-table-wrapper">
            <table class="creditos-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Solicitud</th>
                        <th>Monto</th>
                        <th>Plazo</th>
                        <th>Interés</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Creditos.Any())
                    {
                        foreach (var credito in Model.Creditos)
                        {
                            <tr>
                                <td>#@credito.NumeroFila.ToString("000")</td>

                                <td>
                                    <div class="credito-info">
                                        <div class="credito-avatar">@credito.Iniciales</div>
                                        <div>
                                            <strong>@credito.Cliente</strong>
                                            <span>DNI: @credito.Dni</span>
                                        </div>
                                    </div>
                                </td>

                                <td>@credito.NumeroSolicitud</td>
                                <td>S/ @credito.MontoSolicitado.ToString("N2")</td>
                                <td>@credito.PlazoMeses meses</td>
                                <td>S/ @credito.InteresEstimado.ToString("N2")</td>

                                <td>
                                    <span class="estado-credito-badge @credito.Estado.ToLower().Replace(" ", "-")">
                                        @credito.Estado
                                    </span>
                                </td>

                                <td>@credito.FechaSolicitud.ToString("dd/MM/yyyy")</td>

                                <td>
                                    <div class="creditos-actions">

                                        <button type="button"
                                                class="action-btn"
                                                onclick="abrirDetalleCredito(
                            '@credito.NumeroSolicitud',
                            '@credito.Cliente',
                            '@credito.Dni',
                            'S/ @credito.MontoSolicitado.ToString("N2")',
                            '@credito.PlazoMeses meses',
                            'S/ @credito.InteresEstimado.ToString("N2")',
                            '@credito.Estado',
                            '@credito.FechaSolicitud.ToString("dd/MM/yyyy")',
                            '@credito.MotivoPrestamo'
                        )">
                                            <i class="far fa-eye"></i>
                                        </button>

                                        @if (credito.Estado == "Aprobado")
                                        {
                                            <div class="dropdown d-inline">

                                                <button class="btn-cronograma"
                                                        type="button"
                                                        data-bs-toggle="dropdown">
                                                    <i class="fas fa-file-invoice"></i>
                                                </button>

                                                <ul class="dropdown-menu">

                                                    <li>
                                                        <a class="dropdown-item"
                                                           asp-controller="Administrador"
                                                           asp-action="CronogramaCreditoPdf"
                                                           asp-route-idSolicitud="@credito.IdSolicitud"
                                                           target="_blank">

                                                            <i class="fas fa-file-pdf text-danger"></i>
                                                            PDF
                                                        </a>
                                                    </li>

                                                    <li>
                                                        <a class="dropdown-item"
                                                           asp-controller="Administrador"
                                                           asp-action="CronogramaCreditoExcel"
                                                           asp-route-idSolicitud="@credito.IdSolicitud">

                                                            <i class="fas fa-file-excel text-success"></i>
                                                            Excel
                                                        </a>
                                                    </li>

                                                </ul>

                                            </div>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="creditos-empty">No se encontraron créditos.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="creditos-footer-table">
            <span>Mostrando @Model.InicioRegistro a @Model.FinRegistro de @Model.TotalFiltrado créditos</span>

            <div class="creditos-pagination">
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <a class="page-btn @(i == Model.PaginaActual ? "active" : "")"
                       href="@Url.Action("Creditos", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado, pagina = i })">
                        @i
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleCredito" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content creditos-modal">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del Crédito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p><strong>Solicitud:</strong> <span id="detalleSolicitud"></span></p>
                <p><strong>Cliente:</strong> <span id="detalleCliente"></span></p>
                <p><strong>DNI:</strong> <span id="detalleDni"></span></p>
                <p><strong>Monto:</strong> <span id="detalleMonto"></span></p>
                <p><strong>Plazo:</strong> <span id="detallePlazo"></span></p>
                <p><strong>Interés:</strong> <span id="detalleInteres"></span></p>
                <p><strong>Estado:</strong> <span id="detalleEstado"></span></p>
                <p><strong>Fecha:</strong> <span id="detalleFecha"></span></p>
                <p><strong>Motivo:</strong> <span id="detalleMotivo"></span></p>
            </div>
        </div>
    </div>
</div>

<script>
    function abrirDetalleCredito(solicitud, cliente, dni, monto, plazo, interes, estado, fecha, motivo) {
        document.getElementById("detalleSolicitud").innerText = solicitud;
        document.getElementById("detalleCliente").innerText = cliente;
        document.getElementById("detalleDni").innerText = dni;
        document.getElementById("detalleMonto").innerText = monto;
        document.getElementById("detallePlazo").innerText = plazo;
        document.getElementById("detalleInteres").innerText = interes;
        document.getElementById("detalleEstado").innerText = estado;
        document.getElementById("detalleFecha").innerText = fecha;
        document.getElementById("detalleMotivo").innerText = motivo || "No especificado";

        new bootstrap.Modal(document.getElementById("modalDetalleCredito")).show();
    }
</script>