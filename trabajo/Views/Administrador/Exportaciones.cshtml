		}

	.export-bottom-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-top: 22px;
	}

	.bottom-card {
		background: white;
		border-radius: 16px;
		padding: 22px;
		box-shadow: 0 10px 30px rgba(70, 35, 120, .08);
	}

		.bottom-card h4 {
			font-weight: 900;
			color: #241033;
			margin-bottom: 18px;
		}

	.mini-chart {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.donut-simple {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		background: conic-gradient( #7c3aed 0 33%, #22c55e 33% 66%, #f59e0b 66% 100% );
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

		.donut-simple::before {
			content: "";
			position: absolute;
			width: 68px;
			height: 68px;
			background: #fff;
			border-radius: 50%;
			z-index: 1;
		}

		.donut-simple strong {
			position: absolute;
			top: 38px;
			left: 50%;
			transform: translateX(-50%);
			z-index: 2;
			font-size: 26px;
			font-weight: 900;
			color: #241033;
			line-height: 1;
		}

		.donut-simple span {
			position: absolute;
			top: 68px;
			left: 50%;
			transform: translateX(-50%);
			z-index: 2;
			font-size: 12px;
			font-weight: 700;
			color: #8b7b9c;
		}

