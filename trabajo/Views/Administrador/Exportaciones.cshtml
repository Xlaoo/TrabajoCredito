</style>
<script>
	document.addEventListener("DOMContentLoaded", function () {
		const filas = document.querySelectorAll(".fila-exportacion");
		const filasPorPagina = 5;
		let paginaActual = 1;

		const totalFilas = filas.length;
		const totalPaginas = Math.ceil(totalFilas / filasPorPagina);

		const paginationText = document.getElementById("paginationText");
		const pageNumbers = document.getElementById("pageNumbers");
		const prevPage = document.getElementById("prevPage");
		const nextPage = document.getElementById("nextPage");

		function mostrarPagina(pagina) {
			paginaActual = pagina;

			const inicio = (pagina - 1) * filasPorPagina;
			const fin = inicio + filasPorPagina;

			filas.forEach((fila, index) => {
				fila.style.display = index >= inicio && index < fin ? "" : "none";
			});

			const desde = totalFilas === 0 ? 0 : inicio + 1;
			const hasta = Math.min(fin, totalFilas);

			paginationText.textContent = `Mostrando ${desde} a ${hasta} de ${totalFilas} exportaciones`;

			renderBotones();
		}

		function renderBotones() {
			pageNumbers.innerHTML = "";

			for (let i = 1; i <= totalPaginas; i++) {
				const btn = document.createElement("button");
				btn.textContent = i;

				if (i === paginaActual) {
					btn.classList.add("active");
				}

				btn.addEventListener("click", function () {
					mostrarPagina(i);
				});

				pageNumbers.appendChild(btn);
			}

			prevPage.disabled = paginaActual === 1;
			nextPage.disabled = paginaActual === totalPaginas || totalPaginas === 0;
		}

		prevPage.addEventListener("click", function () {
			if (paginaActual > 1) {
				mostrarPagina(paginaActual - 1);
			}
		});

		nextPage.addEventListener("click", function () {
			if (paginaActual < totalPaginas) {
				mostrarPagina(paginaActual + 1);
			}
		});

		mostrarPagina(1);
	});
</script>