@model List<trabajo.Models.ReporteGenerado>
@{
	Layout = "_LayoutAdministrador";
	ViewData["Title"] = "Exportaciones";
	ViewData["ActivePage"] = "Exportaciones";
	var total = Model.Count();
	var totalClientes = Model.Count(x => x.TipoReporte == "Clientes");
	var totalCreditos = Model.Count(x => x.TipoReporte == "Creditos");
	var totalPagos = Model.Count(x => x.TipoReporte == "Pagos");

	var totalExcel = Model.Count(x => x.Formato == "Excel");
	var totalPdf = Model.Count(x => x.Formato == "PDF");

	var completados = Model.Count(x => x.Estado == "Completado");
	var proceso = Model.Count(x => x.Estado == "En Proceso");
}

@section Styles {
	<link rel="stylesheet" href="~/css/administrador-css/exportaciones.css" asp-append-version="true" />
}

<div class="admin-page">
	<div class="admin-topbar">
		<div>
			<h2>Exportaciones</h2>
			<p>Genera y descarga reportes en diferentes formatos</p>
		</div>
		<div class="admin-user">
			<div class="avatar">
				<i class="fa-solid fa-user"></i>
			</div>
			<strong>@ViewBag.AdminNombre</strong>
			<span>@ViewBag.AdminCorreo</span>
		</div>
	</div>

	<div class="export-stats">
		<div class="export-card">
			<div class="icon purple"><i class="fa-regular fa-file-lines"></i></div>
			<p>Total Exportaciones</p>
			<h3>@Model.Count()</h3>
			<span>Reportes registrados</span>
		</div>

		<div class="export-card">
			<div class="icon green"><i class="fa-solid fa-check"></i></div>
			<p>Exportaciones Completadas</p>
			<h3>@Model.Count(x => x.Estado == "Completado")</h3>
			<span>Listas descargargadas</span>
		</div>

		<div class="export-card">
			<div class="icon orange"><i class="fa-regular fa-clock"></i></div>
			<p>En Proceso</p>
			<h3>@Model.Count(x => x.Estado == "En Proceso")</h3>
			<span>Pendientes de generar</span>
		</div>
	</div>
	<div class="export-actions">
		<a asp-controller="Administrador"
		   asp-action="GenerarReportes"
		   class="btn-generar-reporte">
			<i class="fa-solid fa-plus"></i>
			Crear nuevo reporte
		</a>
	</div>

	<form class="filter-box" method="get" asp-action="Exportaciones" asp-controller="Administrador">
		<div>
			<label>Fecha inicio</label>
			<input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" />
		</div>

		<div>
			<label>Fecha fin</label>
			<input type="date" name="fechaFin" value="@ViewBag.FechaFin" />
		</div>

		<div>
			<label>Tipo de Exportación</label>
			<select name="tipoExportacion">
				<option value="Todos" selected="@(ViewBag.TipoExportacion == "Todos")">Todos</option>
				<option value="Clientes" selected="@(ViewBag.TipoExportacion == "Clientes")">Clientes</option>
				<option value="Creditos" selected="@(ViewBag.TipoExportacion == "Creditos")">Créditos</option>
				<option value="Pagos" selected="@(ViewBag.TipoExportacion == "Pagos")">Pagos</option>
			</select>
		</div>

		<div>
			<label>Estado</label>
			<select name="estado">
				<option value="Todos" selected="@(ViewBag.Estado == "Todos")">Todos</option>
				<option value="Completado" selected="@(ViewBag.Estado == "Completado")">Completado</option>
				<option value="En Proceso" selected="@(ViewBag.Estado == "En Proceso")">En Proceso</option>
			</select>
		</div>
		<div>
			<label>Formato</label>
			<select name="formato">
				<option value="Todos" selected="@(ViewBag.Formato == "Todos")">Todos</option>
				<option value="Excel" selected="@(ViewBag.Formato == "Excel")">Excel</option>
				<option value="PDF" selected="@(ViewBag.Formato == "PDF")">PDF</option>
			</select>
		</div>

		<button type="submit" class="btn-search">
			<i class="fas fa-search"></i> Buscar
		</button>

		<a class="btn-clear" href="@Url.Action("Exportaciones", "Administrador")">
			<i class="fas fa-rotate-right"></i> Limpiar filtros
		</a>
	</form>

	<div class="table-box">
		<h4>Exportaciones recientes</h4>

		<table>
			<thead>
				<tr>
					<th>ID</th>
					<th>Tipo de Exportación</th>
					<th>Descripción</th>
					<th>Fecha Inicio</th>
					<th>Fecha Fin</th>
					<th>Estado Filtro</th>
					<th>Tipo Crédito</th>
					<th>Formato</th>
					<th>Solicitado por</th>
					<th>Fecha Solicitud</th>
					<th>Estado</th>
					<th>Descargar</th>
					<th>Acciones</th>
				</tr>
			</thead>
			<tbody id="tablaExportacionesBody">
				@{
					int index = 0;
				}
				@foreach (var item in Model)
				{
					var estadoClass = item.Estado == "Completado" ? "ok" : "process";

					var iconClass = item.TipoReporte switch
					{
						"Clientes" => "fa-users text-purple",
						"Creditos" => "fa-file-invoice-dollar text-green",
						"Pagos" => "fa-money-bill-wave text-orange",
						"Desempeno" => "fa-chart-bar text-blue",
						"Mora" => "fa-exclamation-triangle text-red",
						"Financiero" => "fa-briefcase text-teal",
						"Sucursal" => "fa-building text-brown",
						"TipoCredito" => "fa-chart-pie text-pink",
						"Periodo" => "fa-calendar-alt text-sky",
						"Actividad" => "fa-history text-indigo",
						"Exportaciones" => "fa-file-download text-emerald",
						"Personalizado" => "fa-cog text-gray",
						_ => "fa-file text-gray"
					};

					<tr class="fila-exportacion" data-index="@index">
						<td>EXP-@item.Id.ToString("D5")</td>
						<td><i class="fa-solid @iconClass"></i> @item.TipoReporte</td>
						<td>@item.Descripcion</td>
						<td>@item.FechaInicioReporte.ToString("dd/MM/yyyy")</td>
						<td>@item.FechaFinReporte.ToString("dd/MM/yyyy")</td>
						<td>@(string.IsNullOrWhiteSpace(item.EstadoFiltro) ? "Todos" : item.EstadoFiltro)</td>
						<td>@(string.IsNullOrWhiteSpace(item.TipoCreditoFiltro) ? "Todos" : item.TipoCreditoFiltro)</td>
						<td><span class="tag excel">@item.Formato</span></td>
						<td>@item.SolicitadoPor</td>
						<td>@item.FechaSolicitud.ToString("dd/MM/yyyy hh:mm tt")</td>
						<td><span class="status @estadoClass">@item.Estado</span></td>

						<td>
							@if (item.Estado == "En Proceso")
							{
								<a class="download" href="@Url.Action("DescargarExportacion", "Administrador", new { id = item.Id })">
									<i class="fa-solid fa-download"></i>
								</a>
							}
							else
							{
								<span class="download disabled">
									<i class="fa-solid fa-download"></i>
								</span>
							}
						</td>

						<td>
							<a class="delete"
							   href="@Url.Action("EliminarExportacion", "Administrador", new { id = item.Id })">
								<i class="fa-solid fa-trash"></i>
							</a>
						</td>
					</tr>

					index++;
				}
			</tbody>
		</table>
		<div class="pagination-box">
			<span id="paginationText"></span>

			<div class="pagination-buttons">
				<button type="button" id="prevPage">‹</button>
				<div id="pageNumbers"></div>
				<button type="button" id="nextPage">›</button>
			</div>
		</div>
	</div>
	<div class="export-bottom-grid">

		<div class="bottom-card">
			<h4>Exportaciones por Tipo</h4>

			<div class="mini-chart">
				<div class="donut-simple">
					<strong>@total</strong>
					<span>Total</span>
				</div>

				<div class="chart-legend">
					<div><span class="legend-dot purple-dot"></span> Clientes <strong>@totalClientes</strong></div>
					<div><span class="legend-dot green-dot"></span> Créditos <strong>@totalCreditos</strong></div>
					<div><span class="legend-dot orange-dot"></span> Pagos <strong>@totalPagos</strong></div>
				</div>
			</div>
		</div>

		<div class="bottom-card">
			<h4>Exportaciones por Formato</h4>

			<div class="mini-chart">
				<div class="donut-formato"
					 data-excel="@totalExcel"
					 data-total="@total">
					<strong>@total</strong>
					<span>Total</span>
				</div>

				<div class="chart-legend">
					<div><span class="legend-dot green-dot"></span> Excel <strong>@totalExcel</strong></div>
					<div><span class="legend-dot red-dot"></span> PDF <strong>@totalPdf</strong></div>
				</div>
			</div>
		</div>

		<div class="bottom-card">
			<h4>Actividad Reciente</h4>

			@foreach (var item in Model.OrderByDescending(x => x.FechaSolicitud).Take(3))
			{
				var icono = item.Estado == "Completado" ? "fa-check" : "fa-clock";
				var color = item.Estado == "Completado" ? "green-act" : "orange-act";

				<div class="recent-export">
					<div class="recent-icon @color">
						<i class="fa-solid @icono"></i>
					</div>
					<div>
						<strong>Exportación EXP-@item.Id.ToString("D5")</strong>
						<span>@item.TipoReporte - @item.Formato</span>
					</div>
					<small>@item.FechaSolicitud.ToString("hh:mm tt")</small>
				</div>
			}
		</div>

	</div>
</div>
<div id="exportacionesAdminDatos" class="d-none" data-total="@Model.Count()"></div>

@section Scripts {
	<script src="~/js/administrador-js/exportaciones.js" asp-append-version="true"></script>
}