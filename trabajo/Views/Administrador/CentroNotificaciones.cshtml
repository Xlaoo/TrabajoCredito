@model List<trabajo.Models.NotificacionAdmin>
@{
    Layout = "_LayoutAdministrador";
    ViewData["Title"] = "Centro de Notificaciones";
    ViewData["ActivePage"] = "CentroNotificaciones";
}

<div class="notif-page">
    @if (TempData["OkNotificacion"] != null)
    {
        <div class="alert-ok-notif">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["OkNotificacion"]
        </div>
    }

    @if (TempData["ErrorNotificacion"] != null)
    {
        <div class="alert-error-notif">
            <i class="fa-solid fa-circle-xmark"></i>
            @TempData["ErrorNotificacion"]
        </div>
    }

    <div class="notif-topbar">
        <div>
            <h2>Centro de Notificaciones</h2>
            <p>Gestiona y envía notificaciones y alertas a usuarios y clientes del sistema.</p>
        </div>

        <div class="notif-admin">
            <div class="notif-avatar">
                <i class="fa-solid fa-user"></i>
            </div>
            <div>
                <strong>@ViewBag.AdminNombre</strong>
                <span>@ViewBag.AdminCorreo</span>
            </div>
        </div>
    </div>

    <div class="notif-stats">
        <div class="notif-stat-card">
            <div class="stat-icon purple"><i class="fa-regular fa-bell"></i></div>
            <div>
                <p>Notificaciones Enviadas</p>
                <h3>@ViewBag.TotalNotificaciones</h3>
                <span>Este mes</span>
            </div>
        </div>

        <div class="notif-stat-card">
            <div class="stat-icon green"><i class="fa-solid fa-check"></i></div>
            <div>
                <p>Entregadas</p>
                <h3>@ViewBag.Entregadas</h3>
                <span>@ViewBag.PorcentajeEntregadas% entregadas</span>
            </div>
        </div>

        <div class="notif-stat-card">
            <div class="stat-icon orange"><i class="fa-regular fa-clock"></i></div>
            <div>
                <p>Programadas</p>
                <h3>@ViewBag.Programadas</h3>
                <span>Pendientes de envío</span>
            </div>
        </div>

        <div class="notif-stat-card">
            <div class="stat-icon red"><i class="fa-solid fa-xmark"></i></div>
            <div>
                <p>Fallidas</p>
                <h3>@ViewBag.Fallidas</h3>
                <span>No entregadas</span>
            </div>
        </div>
    </div>
    <div class="notif-card">
        <h4>Enviar Nueva Notificación</h4>

        <form method="post" asp-action="EnviarNotificacionAdmin" asp-controller="Administrador">
            <div class="notif-form-grid">

                <div>
                    <label>Enviar a</label>
                    <select name="rolDestino" id="rolDestino" onchange="cambiarDestinatarios()" required>
                        <option value="">Seleccione</option>
                        <option value="Cliente">Cliente</option>
                        <option value="Analista">Analista</option>
                    </select>
                </div>

                <div>
                    <label>Destinatario</label>
                    <select name="idUsuarioDestino" id="idUsuarioDestino" required>
                        <option value="">Seleccione primero el tipo</option>

                        @foreach (var c in ViewBag.Clientes)
                        {
                            <option class="opcion-cliente" value="@c.Id">@c.Nombre @c.Apellido</option>
                        }

                        @foreach (var a in ViewBag.Analistas)
                        {
                            <option class="opcion-analista" value="@a.Id">@a.Nombre @a.Apellido</option>
                        }
                    </select>
                </div>

                <input type="hidden" name="canal" value="Correo Electrónico" />

                <div>
                    <label>Canal</label>
                    <input type="text" value="Correo Electrónico" readonly />
                </div>

                <div>
                    <label>Asunto</label>
                    <select name="asunto" required>
                        <option value="">Seleccione plantilla</option>

                        @if (ViewBag.Plantillas != null && ViewBag.Plantillas.Count > 0)
                        {
                            foreach (var plantilla in ViewBag.Plantillas)
                            {
                                <option value="@plantilla.Asunto">@plantilla.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="message-box">
                    <label>Mensaje</label>
                    <textarea name="mensaje" required placeholder="Escribe el mensaje libre..."></textarea>
                </div>
            </div>

            <div class="notif-actions">
                <button type="submit" class="btn-send">
                    <i class="fa-solid fa-paper-plane"></i> Enviar Notificación
                </button>

                <button type="reset" class="btn-light">
                    <i class="fa-solid fa-rotate-left"></i> Limpiar
                </button>
            </div>
        </form>
    </div>


    <div class="notif-card">
        <div class="section-head">
            <h4>Plantillas de Notificaciones</h4>
            <button type="button" class="btn-new" onclick="abrirModalPlantilla()">
                <i class="fa-solid fa-plus"></i> Nueva Plantilla
            </button>
        </div>

        <div class="template-grid">
            @if (ViewBag.Plantillas != null && ViewBag.Plantillas.Count > 0)
            {
                foreach (var plantilla in ViewBag.Plantillas)
                {
                    <div class="template-card">
                        <div class="template-icon @plantilla.Color">
                            <i class="@plantilla.Icono"></i>
                        </div>

                        <h5>@plantilla.Nombre</h5>
                        <p>@plantilla.Descripcion</p>
                        <span>Canal: @plantilla.Canal</span>

                        <div class="template-actions template-actions-two">
                            <button type="button"
                                    onclick="abrirEditarPlantilla('@plantilla.Id_Plantilla', '@plantilla.Nombre', '@plantilla.Asunto', '@plantilla.Descripcion', '@plantilla.Mensaje', '@plantilla.Icono', '@plantilla.Color')">
                                <i class="fa-solid fa-pen"></i>
                            </button>

                            <form method="post" asp-action="EliminarPlantillaNotificacion" asp-controller="Administrador">
                                <input type="hidden" name="id" value="@plantilla.Id_Plantilla" />
                                <button type="submit" class="delete" onclick="return confirm('¿Seguro que deseas eliminar esta plantilla?')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-template">
                    <i class="fa-regular fa-folder-open"></i>
                    <h5>No tienes ninguna plantilla disponible</h5>
                    <p>Crea una nueva plantilla para usarla en tus notificaciones por correo.</p>
                </div>
            }
        </div>
    </div>

    <div class="notif-card">
        <h4>Historial de Notificaciones</h4>

        <table class="notif-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Asunto</th>
                    <th>Tipo</th>
                    <th>Enviado a</th>
                    <th>Canal</th>
                    <th>Fecha Envío</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>NTF-@item.Id_Notificacion.ToString("D5")</td>

                        <td>@item.Asunto</td>

                        <td>@item.TipoNotificacion</td>

                        <td>@item.Destinatario</td>

                        <td>@item.Canal</td>

                        <td>@item.FechaEnvio.ToString("dd/MM/yyyy hh:mm tt")</td>

                        <td>
                            @if (item.Estado == "Entregada")
                            {
                                <span class="status ok">Entregada</span>
                            }
                            else if (item.Estado == "Programada")
                            {
                                <span class="status">Programada</span>
                            }
                            else
                            {
                                <span class="status fail">Fallida</span>
                            }
                        </td>

                        <td>
                            <button type="button" class="view-btn"
                                    onclick="abrirDetalleNotificacion('@item.Id_Notificacion','@item.Asunto','@item.TipoNotificacion','@item.Destinatario','@item.Canal','@item.FechaEnvio.ToString("dd/MM/yyyy hh:mm tt")','@item.Estado','@item.Mensaje')">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </td>

                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
<div id="modalPlantilla" class="modal-plantilla">
    <div class="modal-plantilla-card">
        <div class="modal-plantilla-head">
            <h4>Nueva Plantilla</h4>
            <button type="button" onclick="cerrarModalPlantilla()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form method="post" asp-action="CrearPlantillaNotificacion" asp-controller="Administrador">
            <div class="modal-grid">
                <div>
                    <label>Nombre</label>
                    <input name="nombre" required placeholder="Ej: Recordatorio especial" />
                </div>

                <div>
                    <label>Asunto</label>
                    <input name="asunto" required placeholder="Ej: Recordatorio de pago - CrediPlus" />
                </div>

                <div>
                    <label>Icono</label>
                    <select name="icono">
                        <option value="fa-regular fa-bell">Campana</option>
                        <option value="fa-regular fa-credit-card">Pago</option>
                        <option value="fa-regular fa-calendar-check">Confirmación</option>
                        <option value="fa-regular fa-file-lines">Documento</option>
                        <option value="fa-solid fa-triangle-exclamation">Alerta</option>
                        <option value="fa-solid fa-bullhorn">Promoción</option>
                    </select>
                </div>

                <div>
                    <label>Color</label>
                    <select name="color">
                        <option value="purple">Morado</option>
                        <option value="green">Verde</option>
                        <option value="orange">Naranja</option>
                        <option value="blue">Azul</option>
                        <option value="red">Rojo</option>
                        <option value="teal">Turquesa</option>
                    </select>
                </div>

                <div class="modal-full">
                    <label>Descripción</label>
                    <input name="descripcion" required placeholder="Describe el uso de esta plantilla" />
                </div>

                <div class="modal-full">
                    <label>Mensaje</label>
                    <textarea name="mensaje" required placeholder="Escribe el mensaje base de la plantilla..."></textarea>
                </div>
            </div>

            <div class="notif-actions">
                <button type="submit" class="btn-send">
                    <i class="fa-solid fa-save"></i> Guardar Plantilla
                </button>

                <button type="button" class="btn-light" onclick="cerrarModalPlantilla()">
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</div>
<div id="modalEditarPlantilla" class="modal-plantilla">
    <div class="modal-plantilla-card">
        <div class="modal-plantilla-head">
            <h4>Editar Plantilla</h4>
            <button type="button" onclick="cerrarEditarPlantilla()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form method="post" asp-action="EditarPlantillaNotificacion" asp-controller="Administrador">
            <input type="hidden" name="id" id="editIdPlantilla" />

            <div class="modal-grid">
                <div>
                    <label>Nombre</label>
                    <input name="nombre" id="editNombre" required />
                </div>

                <div>
                    <label>Asunto</label>
                    <input name="asunto" id="editAsunto" required />
                </div>

                <div>
                    <label>Icono</label>
                    <select name="icono" id="editIcono">
                        <option value="fa-regular fa-bell">Campana</option>
                        <option value="fa-regular fa-credit-card">Pago</option>
                        <option value="fa-regular fa-calendar-check">Confirmación</option>
                        <option value="fa-regular fa-file-lines">Documento</option>
                        <option value="fa-solid fa-triangle-exclamation">Alerta</option>
                        <option value="fa-solid fa-bullhorn">Promoción</option>
                    </select>
                </div>

                <div>
                    <label>Color</label>
                    <select name="color" id="editColor">
                        <option value="purple">Morado</option>
                        <option value="green">Verde</option>
                        <option value="orange">Naranja</option>
                        <option value="blue">Azul</option>
                        <option value="red">Rojo</option>
                        <option value="teal">Turquesa</option>
                    </select>
                </div>

                <div class="modal-full">
                    <label>Descripción</label>
                    <input name="descripcion" id="editDescripcion" required />
                </div>

                <div class="modal-full">
                    <label>Mensaje</label>
                    <textarea name="mensaje" id="editMensaje" required></textarea>
                </div>
            </div>

            <div class="notif-actions">
                <button type="submit" class="btn-send">
                    <i class="fa-solid fa-save"></i> Actualizar Plantilla
                </button>

                <button type="button" class="btn-light" onclick="cerrarEditarPlantilla()">
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</div>
<div id="modalDetalleNotificacion" class="modal-plantilla">
    <div class="modal-plantilla-card">
        <div class="modal-plantilla-head">
            <h4>Detalle de Notificación</h4>
            <button type="button" onclick="cerrarDetalleNotificacion()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="detalle-grid">
            <p><strong>ID:</strong> <span id="detId"></span></p>
            <p><strong>Asunto:</strong> <span id="detAsunto"></span></p>
            <p><strong>Tipo:</strong> <span id="detTipo"></span></p>
            <p><strong>Enviado a:</strong> <span id="detDestino"></span></p>
            <p><strong>Canal:</strong> <span id="detCanal"></span></p>
            <p><strong>Fecha:</strong> <span id="detFecha"></span></p>
            <p><strong>Estado:</strong> <span id="detEstado"></span></p>
        </div>

        <div class="detalle-mensaje">
            <strong>Mensaje enviado</strong>
            <p id="detMensaje"></p>
        </div>
    </div>
</div>
<style>
    .notif-page {
        padding: 28px 34px;
        background: #faf7ff;
        min-height: 100vh;
    }

    .notif-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .notif-topbar h2 {
            font-size: 32px;
            font-weight: 900;
            color: #21112f;
            margin: 0;
        }

        .notif-topbar p {
            color: #8b7b9c;
            margin: 5px 0 0;
        }

    .notif-admin {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fff;
        padding: 10px 16px;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(70, 35, 120, .07);
    }

        .notif-admin span {
            display: block;
            color: #8b7b9c;
            font-size: 13px;
        }

    .notif-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #7c3aed;
        color: white;
        display: grid;
        place-items: center;
    }

    .notif-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 22px;
    }

    .notif-stat-card {
        background: white;
        border-radius: 18px;
        padding: 22px;
        display: flex;
        gap: 16px;
        align-items: center;
        box-shadow: 0 10px 30px rgba(70, 35, 120, .08);
    }

    .stat-icon, .template-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        font-size: 24px;
    }

    .notif-stat-card p {
        margin: 0;
        font-weight: 800;
        color: #6b5c7c;
    }

    .notif-stat-card h3 {
        margin: 4px 0;
        color: #281043;
        font-size: 30px;
        font-weight: 900;
    }

    .notif-stat-card span {
        color: #8f7da3;
        font-size: 13px;
    }

    .notif-card {
        background: white;
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 22px;
        box-shadow: 0 10px 30px rgba(70, 35, 120, .08);
    }

        .notif-card h4 {
            color: #241033;
            font-weight: 900;
            margin-bottom: 18px;
        }

    .notif-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1.5fr 2fr;
        gap: 18px;
        align-items: start;
    }

    .notif-card label {
        display: block;
        font-weight: 800;
        color: #6b5c7c;
        margin-bottom: 8px;
    }

    .notif-card input,
    .notif-card select,
    .notif-card textarea {
        width: 100%;
        border: 1px solid #eadff5;
        border-radius: 10px;
        padding: 11px 12px;
        outline: none;
        color: #4b3a5c;
    }

    .notif-card textarea {
        min-height: 95px;
        resize: none;
    }

    .notif-checks {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .notif-checks label {
            margin: 0;
            font-weight: 600;
        }

    .notif-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
        align-items: center;
    }

    .btn-send, .btn-new {
        background: #7c3aed;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 11px 18px;
        font-weight: 800;
    }

    .btn-light, .btn-template {
        background: white;
        color: #7b6a8e;
        border: 1px solid #eadff5;
        border-radius: 10px;
        padding: 11px 18px;
        font-weight: 800;
    }

    .btn-template {
        margin-left: auto;
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .template-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
    }

    .template-card {
        border: 1px solid #eee5f5;
        border-radius: 16px;
        padding: 18px;
    }

        .template-card h5 {
            font-weight: 900;
            color: #2b153f;
            margin: 12px 0 5px;
        }

        .template-card p,
        .template-card span {
            color: #8b7b9c;
            font-size: 13px;
        }

    .template-actions {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 14px;
    }

        .template-actions button,
        .view-btn {
            border: none;
            background: #f3ecff;
            color: #7c3aed;
            border-radius: 9px;
            padding: 9px;
        }

        .template-actions .delete {
            background: #ffe4e6;
            color: #ef4444;
        }

    .notif-table {
        width: 100%;
        border-collapse: collapse;
    }

        .notif-table th,
        .notif-table td {
            padding: 14px;
            border-bottom: 1px solid #f1eaf7;
            color: #39294a;
            font-weight: 600;
        }

        .notif-table th {
            color: #6f5e82;
            font-size: 13px;
        }

    .status {
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 800;
    }

        .status.ok {
            background: #dcfce7;
            color: #16a34a;
        }

        .status.fail {
            background: #ffe4e6;
            color: #ef4444;
        }

    .purple {
        background: #f0e7ff;
        color: #7c3aed;
    }

    .green {
        background: #dcfce7;
        color: #22c55e;
    }

    .orange {
        background: #fff1d6;
        color: #f59e0b;
    }

    .red {
        background: #ffe4e6;
        color: #ef4444;
    }

    .blue {
        background: #dbeafe;
        color: #2563eb;
    }

    .teal {
        background: #ccfbf1;
        color: #0f766e;
    }

    @@media (max-width: 1200px) {
        .notif-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .notif-form-grid,
        .template-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .modal-plantilla {
        position: fixed;
        inset: 0;
        background: rgba(31, 16, 48, .45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

        .modal-plantilla.show {
            display: flex;
        }

    .modal-plantilla-card {
        width: 720px;
        max-width: 95%;
        background: white;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 25px 70px rgba(40, 16, 67, .25);
    }

    .modal-plantilla-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .modal-plantilla-head h4 {
            margin: 0;
            color: #241033;
            font-weight: 900;
        }

        .modal-plantilla-head button {
            border: none;
            background: #f3ecff;
            color: #7c3aed;
            width: 38px;
            height: 38px;
            border-radius: 10px;
        }

    .modal-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .modal-full {
        grid-column: 1 / -1;
    }

    .empty-template {
        grid-column: 1 / -1;
        text-align: center;
        padding: 35px;
        border: 1px dashed #d8c7f0;
        border-radius: 16px;
        color: #7b6a8e;
        background: #fbf8ff;
    }

        .empty-template i {
            font-size: 34px;
            color: #7c3aed;
            margin-bottom: 10px;
        }

        .empty-template h5 {
            font-weight: 900;
            color: #2b153f;
        }

    .template-actions-two {
        grid-template-columns: repeat(2, 1fr);
    }

    .template-actions form {
        margin: 0;
    }

        .template-actions form button {
            width: 100%;
        }

    .modal-plantilla-card input,
    .modal-plantilla-card select,
    .modal-plantilla-card textarea {
        width: 100%;
        border: 1px solid #eadff5;
        border-radius: 12px;
        padding: 12px 14px;
        outline: none;
        color: #4b3a5c;
        font-weight: 600;
    }

    .modal-plantilla-card textarea {
        min-height: 110px;
        resize: none;
    }

    .modal-plantilla-card label {
        display: block;
        font-weight: 800;
        color: #4b315f;
        margin-bottom: 8px;
    }

    .detalle-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

        .detalle-grid p,
        .detalle-mensaje p {
            background: #faf7ff;
            border: 1px solid #eadff5;
            border-radius: 12px;
            padding: 12px;
            margin: 0;
            color: #4b3a5c;
        }

    .detalle-mensaje {
        margin-top: 16px;
    }

        .detalle-mensaje strong {
            display: block;
            margin-bottom: 8px;
            color: #241033;
        }

    .alert-ok-notif,
    .alert-error-notif {
        padding: 15px 18px;
        border-radius: 14px;
        margin-bottom: 18px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-ok-notif {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .alert-error-notif {
        background: #ffe4e6;
        color: #b91c1c;
        border: 1px solid #fecdd3;
    }
</style>
<script>
    function cambiarDestinatarios() {
        const rol = document.getElementById("rolDestino").value;
        const opcionesCliente = document.querySelectorAll(".opcion-cliente");
        const opcionesAnalista = document.querySelectorAll(".opcion-analista");
        const destino = document.getElementById("idUsuarioDestino");

        destino.value = "";

        opcionesCliente.forEach(x => x.style.display = rol === "Cliente" ? "block" : "none");
        opcionesAnalista.forEach(x => x.style.display = rol === "Analista" ? "block" : "none");
    }

    cambiarDestinatarios();
        function abrirModalPlantilla() {
        document.getElementById("modalPlantilla").classList.add("show");
    }

    function cerrarModalPlantilla() {
        document.getElementById("modalPlantilla").classList.remove("show");
    }
        function abrirEditarPlantilla(id, nombre, asunto, descripcion, mensaje, icono, color) {
        document.getElementById("editIdPlantilla").value = id;
        document.getElementById("editNombre").value = nombre;
        document.getElementById("editAsunto").value = asunto;
        document.getElementById("editDescripcion").value = descripcion;
        document.getElementById("editMensaje").value = mensaje;
        document.getElementById("editIcono").value = icono;
        document.getElementById("editColor").value = color;

        document.getElementById("modalEditarPlantilla").classList.add("show");
    }

    function cerrarEditarPlantilla() {
        document.getElementById("modalEditarPlantilla").classList.remove("show");
    }
        function abrirDetalleNotificacion(id, asunto, tipo, destino, canal, fecha, estado, mensaje) {
        document.getElementById("detId").textContent = "NTF-" + id.toString().padStart(5, "0");
        document.getElementById("detAsunto").textContent = asunto;
        document.getElementById("detTipo").textContent = tipo;
        document.getElementById("detDestino").textContent = destino;
        document.getElementById("detCanal").textContent = canal;
        document.getElementById("detFecha").textContent = fecha;
        document.getElementById("detEstado").textContent = estado;
        document.getElementById("detMensaje").textContent = mensaje;

        document.getElementById("modalDetalleNotificacion").classList.add("show");
    }

    function cerrarDetalleNotificacion() {
        document.getElementById("modalDetalleNotificacion").classList.remove("show");
    }
</script>