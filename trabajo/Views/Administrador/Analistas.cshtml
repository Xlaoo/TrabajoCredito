@model trabajo.Models.ViewModels.AdminAnalistaViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
    ViewData["Title"] = "Analistas";
    ViewData["ActivePage"] = "Analistas";

    bool sinAnalista = Model == null || Model.IdAnalista <= 0;

    string nombreAnalista = sinAnalista || string.IsNullOrWhiteSpace(Model?.NombreAnalista)
        ? "Sin analista asignado"
        : Model!.NombreAnalista.Trim();

    string inicialAnalista = string.IsNullOrWhiteSpace(nombreAnalista)
        ? "A"
        : nombreAnalista.Substring(0, 1).ToUpper();

    string estadoClase = !sinAnalista && Model!.EstadoActivo ? "activo" : "inactivo";
    string estadoTexto = !sinAnalista && Model!.EstadoActivo ? "Activo" : "Inactivo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/administrador-css/analistas.css" asp-append-version="true" />
}

<div class="analistas-page">

    <div class="analistas-topbar">
        <div class="analistas-topbar-title">
            Bienvenido Administrador
        </div>

        <div class="analistas-topbar-right">
            <div class="analistas-bell">
                <i class="far fa-bell"></i>
                <span class="analistas-bell-badge">0</span>
            </div>

            <div class="analistas-user-info">
                <strong>@(ViewBag.AdminNombre ?? "Administrador")</strong>
                <small>@(ViewBag.AdminCorreo ?? "admin@crediplus.com")</small>
            </div>

            <div class="analistas-avatar-admin">
                <i class="fas fa-user"></i>
            </div>
        </div>
    </div>

    <div class="analistas-header">
        <h1 class="analistas-title">Analista</h1>
        <p class="analistas-subtitle">Gestión del analista asignado y comunicación directa.</p>
    </div>

    @if (sinAnalista)
    {
        <div class="no-analista-box">
            <i class="fas fa-triangle-exclamation"></i>
            No existe un usuario con rol Analista registrado en la base de datos.
        </div>
    }
    <div class="analista-top-actions">
        <button type="button"
                class="analista-contact-btn btn-danger-analista"
                data-bs-toggle="modal"
                data-bs-target="#modalReemplazarAnalista"
                disabled="@(sinAnalista ? "disabled" : null)">
            <i class="fas fa-trash"></i>
            Eliminar Analista
        </button>
    </div>
    <div class="analista-main-card">
        <div class="analista-profile">
            <div class="analista-avatar">@inicialAnalista</div>

            <div class="analista-profile-info">
                <h2>@nombreAnalista</h2>
                <p>Analista de Riesgo asignado al módulo administrativo.</p>
                <div class="analista-profile-contact-info">
                    <span><i class="fas fa-id-card"></i> DNI: @(Model?.DniAnalista ?? "---")</span>
                    <span><i class="fas fa-envelope"></i> @(Model?.CorreoAnalista ?? "---")</span>
                    <span><i class="fas fa-phone"></i> @(Model?.CelularAnalista ?? "---")</span>
                </div>

                <div class="analista-status-row">
                    <span id="estadoAnalistaBadge" class="analista-status @estadoClase">
                        <i class="fas fa-circle"></i>
                        <span class="estado-texto">@estadoTexto</span>
                    </span>

                    <span id="ultimaConexionAnalista" class="analista-status-note">
                        Estado actualizado en tiempo real
                    </span>
                    <button type="button"
                            class="analista-contact-btn btn-outline-analista"
                            data-bs-toggle="modal"
                            data-bs-target="#modalPerfilAnalista"
                            disabled="@(sinAnalista ? "disabled" : null)">
                        <i class="fas fa-eye"></i>
                        Ver Perfil Completo
                    </button>
                    <button type="button"
                            class="analista-contact-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#modalChatAnalista"
                            disabled="@(sinAnalista ? "disabled" : null)">
                        <i class="fas fa-comments"></i>
                        Contactar
                    </button>
                </div>
            </div>
        </div>
        <div class="analista-summary-column">
            <div class="analista-summary-item">
                <div class="analista-stat-icon purple">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div>
                    <span class="analista-summary-label">Fecha Asignación</span>
                    <strong class="analista-summary-value date">@(Model == null ? "---" : Model.FechaAsignacion.ToString("dd/MM/yyyy"))</strong>
                </div>
            </div>

            <div class="analista-summary-item">
                <div class="analista-stat-icon purple">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <div>
                    <span class="analista-summary-label">Solicitudes Asignadas</span>
                    <strong class="analista-summary-value">@(Model?.SolicitudesAsignadas ?? 0)</strong>
                </div>
            </div>

            <div class="analista-summary-item">
                <div class="analista-stat-icon purple">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div>
                    <span class="analista-summary-label">Solicitudes Completadas</span>
                    <strong class="analista-summary-value">@(Model?.SolicitudesCompletadas ?? 0)</strong>
                    <small class="analista-summary-badge">@(Model?.TasaEfectividad ?? 0)% de efectividad</small>
                </div>
            </div>
        </div>
       
    </div>

    

    <div class="analistas-content-grid">
        <div class="analistas-panel">
            <div class="analistas-panel-header">
                <div>
                    <h3 class="analistas-panel-title">Actividad Reciente</h3>
                    <p class="analistas-panel-subtitle">Últimas acciones sobre solicitudes.</p>
                </div>
            </div>

            <div class="activity-list">
                @if (Model?.Actividades != null && Model.Actividades.Any())
                {
                    foreach (var actividad in Model.Actividades)
                    {
                        <div class="activity-item">
                            <div class="activity-icon">
                                <i class="@actividad.Icono"></i>
                            </div>

                            <div>
                                <h4>@actividad.Titulo</h4>
                                <p>@actividad.Descripcion</p>
                                <small>@actividad.Fecha.ToString("dd/MM/yyyy hh:mm tt")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="chat-empty">
                        <i class="fas fa-list-check"></i>
                        <strong>Sin actividad reciente</strong>
                        <span>No hay cambios registrados todavía.</span>
                    </div>
                }
            </div>
        </div>
        <div class="analistas-panel">
            <div class="analistas-panel-header">
                <div>
                    <h3 class="analistas-panel-title">Rendimiento del Analista</h3>
                    <p class="analistas-panel-subtitle">Resumen general de desempeño.</p>
                </div>
            </div>

            <div class="analistas-stats-grid two-cols">
                <div class="analista-stat-card">
                    <div class="analista-stat-top">
                        <div class="analista-stat-icon green"><i class="fas fa-check"></i></div>
                        <div>
                            <h4>Completadas</h4>
                            <p>Total finalizadas</p>
                        </div>
                    </div>
                    <h2>@(Model?.SolicitudesCompletadas ?? 0)</h2>
                </div>

                <div class="analista-stat-card">
                    <div class="analista-stat-top">
                        <div class="analista-stat-icon orange"><i class="fas fa-clock"></i></div>
                        <div>
                            <h4>En Proceso</h4>
                            <p>En evaluación</p>
                        </div>
                    </div>
                    <h2>@(Model?.SolicitudesEnProceso ?? 0)</h2>
                </div>

                <div class="analista-stat-card">
                    <div class="analista-stat-top">
                        <div class="analista-stat-icon purple"><i class="fas fa-hourglass-half"></i></div>
                        <div>
                            <h4>Pendientes</h4>
                            <p>Por revisar</p>
                        </div>
                    </div>
                    <h2>@(Model?.SolicitudesPendientes ?? 0)</h2>
                </div>

                <div class="analista-stat-card">
                    <div class="analista-stat-top">
                        <div class="analista-stat-icon blue"><i class="fas fa-bullseye"></i></div>
                        <div>
                            <h4>Efectividad</h4>
                            <p>Este mes</p>
                        </div>
                    </div>
                    <h2>@(Model?.TasaEfectividad ?? 0)%</h2>
                </div>
            </div>
        </div>
       
    </div>
   

</div>
<div class="modal fade" id="modalPerfilAnalista" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-curved">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-user"></i> Perfil Completo del Analista
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="analista-info-grid">
                    <div class="analista-info-item">
                        <span>Nombre completo</span>
                        <strong>@nombreAnalista</strong>
                    </div>

                    <div class="analista-info-item">
                        <span>DNI</span>
                        <strong>@(Model?.DniAnalista ?? "---")</strong>
                    </div>

                    <div class="analista-info-item">
                        <span>Celular</span>
                        <strong>@(Model?.CelularAnalista ?? "---")</strong>
                    </div>

                    <div class="analista-info-item">
                        <span>Correo</span>
                        <strong>@(Model?.CorreoAnalista ?? "---")</strong>
                    </div>

                    <div class="analista-info-item">
                        <span>Fecha de asignación</span>
                        <strong>@(Model == null ? "---" : Model.FechaAsignacion.ToString("dd/MM/yyyy"))</strong>
                    </div>

                    <div class="analista-info-item">
                        <span>Solicitudes asignadas</span>
                        <strong>@(Model?.SolicitudesAsignadas ?? 0)</strong>
                    </div>

                    <div class="analista-info-item">
                        <span>Solicitudes completadas</span>
                        <strong>@(Model?.SolicitudesCompletadas ?? 0)</strong>
                    </div>

                    <div class="analista-info-item">
                        <span>Efectividad</span>
                        <strong>@(Model?.TasaEfectividad ?? 0)%</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalChatAnalista" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content modal-curved-clip">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-comments"></i> Comunicación Directa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">
                <div class="analistas-panel chat-panel" id="panelChatAnalista">

                    <div class="analistas-panel-header">

                        <div>

                            <h3 class="analistas-panel-title">Chat con Analista</h3>

                            <p class="analistas-panel-subtitle">Mensajes en tiempo real Administrador ↔ Analista.</p>

                        </div>



                        <span id="chatEstadoAnalista" class="chat-status @estadoClase">

                            <i class="fas fa-wifi"></i>

                            <span class="chat-estado-texto">@estadoTexto</span>

                        </span>

                    </div>



                    <div class="chat-messages" id="chatMensajes">

                        @if (Model?.Mensajes != null && Model.Mensajes.Any())

                        {

                            foreach (var mensaje in Model.Mensajes)

                            {

                                var claseMensaje = mensaje.RemitenteRol == "Administrador" ? "admin" : "analista";



                                <div class="chat-message @claseMensaje">

                                    <div class="chat-bubble">@mensaje.Mensaje</div>

                                    <div class="chat-meta">

                                        @mensaje.RemitenteRol · @mensaje.FechaEnvio.ToString("dd/MM/yyyy hh:mm tt")

                                    </div>

                                </div>

                            }

                        }

                        else

                        {

                            <div class="chat-empty" id="chatVacio">

                                <i class="far fa-comments"></i>

                                <strong>Aún no hay mensajes</strong>

                                <span>Escribe el primer mensaje para iniciar la conversación.</span>

                            </div>

                        }

                    </div>



                    <form class="chat-form" id="formChatAnalista">

                        <input type="text"
                               id="mensajeInput"
                               autocomplete="off"
                               placeholder="Escribe un mensaje para el analista..."
                               disabled="@(sinAnalista ? "disabled" : null)" />



                        <button type="submit"
                                class="chat-send-btn"
                                id="btnEnviarMensaje"
                                disabled="@(sinAnalista ? "disabled" : null)">

                            <i class="fas fa-paper-plane"></i>

                        </button>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalReemplazarAnalista" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content modal-curved">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fas fa-trash"></i> Reemplazar Analista
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="alert alert-warning">
                    Para eliminar el analista actual, primero debes asignar otro analista.
                    Al reemplazarlo, se limpiará el chat anterior.
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <h5 class="fw-bold">Escoger cliente existente</h5>

                        <form asp-action="ReemplazarAnalistaExistente" asp-controller="Administrador" method="post">
                            <select name="idCliente" class="form-select mb-3" required>
                                <option value="">Seleccione un cliente</option>
                                @foreach (var cliente in ViewBag.ClientesDisponibles)
                                {
                                    <option value="@cliente.Id" disabled="@(cliente.TieneSolicitudActiva ? "disabled" : null)">
                                        @cliente.Nombre @cliente.Apellido - DNI: @cliente.Dni
                                        @(cliente.TieneSolicitudActiva ? " | Solicitud activa" : " | Sin solicitud")
                                    </option>
                                }
                            </select>

                            <button type="submit" class="btn btn-primary w-100">
                                Convertir cliente en analista
                            </button>
                        </form>
                    </div>

                    <div class="col-md-6">
                        <h5 class="fw-bold">Crear nuevo analista</h5>

                        <form asp-action="CrearReemplazarAnalista" asp-controller="Administrador" method="post">
                            <input name="nombre" class="form-control mb-2" placeholder="Nombre" required />
                            <input name="apellido" class="form-control mb-2" placeholder="Apellido" required />
                            <input name="dni" class="form-control mb-2" placeholder="DNI" required />
                            <input name="celular" class="form-control mb-2" placeholder="Celular" required />
                            <input name="clave" id="claveAnalistaNuevo" type="password" class="form-control mb-1" placeholder="Contraseña (mínimo 12 caracteres y símbolo)" required minlength="12" />
                            <small class="text-muted d-block mb-2 password-req-hint">
                                🔒 Requiere mínimo 12 caracteres, una mayúscula, una minúscula, un número y un símbolo especial (!@@#$%&*...).
                            </small>
                            <select name="genero" class="form-select mb-2" required>
                                <option value="">Seleccione género</option>
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                            </select>

                            <button type="submit" class="btn btn-success w-100">
                                Crear y asignar analista
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (ViewBag.SolicitudSoporte != null)
{
    var solicitud = ViewBag.SolicitudSoporte;
}

@if (ViewBag.SolicitudSoporte != null)
{
    <div class="modal fade show modal-show-backdrop"
         id="modalSolicitudSoporte"
         tabindex="-1">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-headset"></i>
                        Nueva Solicitud de Soporte
                    </h5>
                </div>

                <div class="modal-body">

                    <p><b>Asunto:</b></p>
                    <div class="form-control mb-3">
                        @ViewBag.SolicitudSoporte.Asunto
                    </div>

                    <p><b>Mensaje:</b></p>
                    <div class="form-control min-h-140">
                        @ViewBag.SolicitudSoporte.Mensaje
                    </div>

                    <br />

                    <small class="text-muted">
                        Enviado:
                        @ViewBag.SolicitudSoporte.FechaEnvio.ToString("dd/MM/yyyy hh:mm tt")
                    </small>

                </div>

                <div class="modal-footer">

                    <form asp-action="ConfirmarSolicitudSoporte"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@ViewBag.SolicitudSoporte.Id_Soporte" />

                        <button class="btn btn-success">
                            OK
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}
@if (TempData["ErrorAnalista"] != null)
{
    <div class="modal fade show modal-show-backdrop">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-error-box">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="fas fa-triangle-exclamation"></i> Error
                    </h5>
                </div>
                <div class="modal-body">
                    @TempData["ErrorAnalista"]
                </div>
                <div class="modal-footer">
                    <a href="@Url.Action("Analistas", "Administrador")" class="btn btn-danger">
                        OK
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<div id="analistasAdminDatos"
     class="d-none"
     data-id-admin="@(Model?.IdAdministrador ?? 0)"
     data-id-analista="@(Model?.IdAnalista ?? 0)"
     data-estado-url="@Url.Action("EstadoAnalista", "Administrador")">
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha384-mU1xC5yC2LldSW74Rj1Ax8wPiLw/28V5eh51uKJMlBbRVsOtUYd4xyzNsgIAJARB"
            crossorigin="anonymous"></script>
    <script src="~/js/administrador-js/analistas.js" asp-append-version="true"></script>
}
