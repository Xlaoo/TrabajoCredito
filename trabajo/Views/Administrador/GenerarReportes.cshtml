@{
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
    ViewData["Title"] = "Generar Reportes";
    ViewData["ActivePage"] = "GenerarReportes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/administrador-css/generar-reportes.css" asp-append-version="true" />
}

<!-- Cabecera -->
<div class="top-navbar-view">

    <div class="navbar-left">
        <span class="navbar-welcome">Bienvenido, @User.Identity?.Name</span>
    </div>

    <div class="navbar-right">
        <div class="navbar-notifications">
            <i class="far fa-bell"></i>
            <span class="badge-count">0</span>
        </div>
        <div class="navbar-user-box">
            <div class="profile-user-info">
                <span class="user-name">@User.Identity?.Name @User.FindFirst("Apellido")?.Value</span>
                <span class="user-email">@User.FindFirst("Correo")?.Value</span>
            </div>
            <i class="fas fa-chevron-down profile-chevron"></i>
        </div>
    </div>
</div>
<!-- Título de la vista -->
<div class="reportes-titulo reportes-titulo-top">
    <h1>Generar Reportes</h1>
    <p>Selecciona el tipo de reporte, configura los filtros y genera tu reporte</p>
</div>
@if (TempData["ErrorReporte"] != null)
{
    <div class="alert alert-danger gr-alert">
        <i class="fas fa-circle-exclamation"></i>
        @TempData["ErrorReporte"]
    </div>
}

@if (TempData["OkReporte"] != null)
{
    <div class="alert alert-success gr-alert">
        <i class="fas fa-check-circle"></i>
        @TempData["OkReporte"]
    </div>
}
<!-- Contenedor Punto 1 -->
<div class="gr-seccion">
    <!-- Paso 1: Tipo de Reporte -->
    <h2 class="gr-seccion-title">
        1. Selecciona el Tipo de Reporte
    </h2>

    <div class="gr-tipos-grid" id="gridTipos">

        <!-- Reporte de Clientes -->
        <div class="gr-tipo-card seleccionado" data-tipo="Clientes">
            <div class="gr-tipo-icono icon-grad-clientes">
                <i class="fas fa-users"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte de Clientes</span>
            <span class="gr-tipo-desc">Listado de clientes con información personal y estado actual</span>
            <input type="radio" name="tipoReporte" value="Clientes" class="gr-tipo-radio" checked />
        </div>

        <!-- Reporte de Créditos -->
        <div class="gr-tipo-card" data-tipo="Creditos">
            <div class="gr-tipo-icono icon-grad-creditos">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte de Créditos</span>
            <span class="gr-tipo-desc">Resumen de créditos por estado, tipo y periodo</span>
            <input type="radio" name="tipoReporte" value="Creditos" class="gr-tipo-radio" />
        </div>

        <!-- Reporte de Pagos -->
        <div class="gr-tipo-card" data-tipo="Pagos">
            <div class="gr-tipo-icono icon-grad-pagos">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte de Pagos</span>
            <span class="gr-tipo-desc">Historial de pagos recibidos y pendientes</span>
            <input type="radio" name="tipoReporte" value="Pagos" class="gr-tipo-radio" />
        </div>

        <!-- Reporte de Desempeño -->
        <div class="gr-tipo-card" data-tipo="Desempeno">
            <div class="gr-tipo-icono icon-grad-desempeno">
                <i class="fas fa-chart-bar"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte de Desempeño</span>
            <span class="gr-tipo-desc">Análisis de desempeño por analista y métricas clave</span>
            <input type="radio" name="tipoReporte" value="Desempeno" class="gr-tipo-radio" />
        </div>

        <!-- Reporte de Mora -->
        <div class="gr-tipo-card" data-tipo="Mora">
            <div class="gr-tipo-icono icon-grad-mora">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte de Mora</span>
            <span class="gr-tipo-desc">Clientes con pagos vencidos y análisis de morosidad</span>
            <input type="radio" name="tipoReporte" value="Mora" class="gr-tipo-radio" />
        </div>

        <!-- Reporte Financiero -->
        <div class="gr-tipo-card" data-tipo="Financiero">
            <div class="gr-tipo-icono icon-grad-financiero">
                <i class="fas fa-briefcase"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte Financiero</span>
            <span class="gr-tipo-desc">Resumen financiero de ingresos, egresos y utilidades</span>
            <input type="radio" name="tipoReporte" value="Financiero" class="gr-tipo-radio" />
        </div>

        <!-- Reporte por Sucursal -->
        <div class="gr-tipo-card" data-tipo="Sucursal">
            <div class="gr-tipo-icono icon-grad-sucursal">
                <i class="fas fa-building"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte por Sucursal</span>
            <span class="gr-tipo-desc">Rendimiento y operaciones por sucursal</span>
            <input type="radio" name="tipoReporte" value="Sucursal" class="gr-tipo-radio" />
        </div>

        <!-- Reporte por Tipo de Crédito -->
        <div class="gr-tipo-card" data-tipo="TipoCredito">
            <div class="gr-tipo-icono icon-grad-tipocredito">
                <i class="fas fa-chart-pie"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte por Tipo de Crédito</span>
            <span class="gr-tipo-desc">Distribución y análisis por tipo de crédito</span>
            <input type="radio" name="tipoReporte" value="TipoCredito" class="gr-tipo-radio" />
        </div>

        <!-- Reporte por Periodo -->
        <div class="gr-tipo-card" data-tipo="Periodo">
            <div class="gr-tipo-icono icon-grad-periodo">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte por Periodo</span>
            <span class="gr-tipo-desc">Resumen de operaciones por periodo específico</span>
            <input type="radio" name="tipoReporte" value="Periodo" class="gr-tipo-radio" />
        </div>

        <!-- Reporte de Actividad -->
        <div class="gr-tipo-card" data-tipo="Actividad">
            <div class="gr-tipo-icono icon-grad-actividad">
                <i class="fas fa-history"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte de Actividad</span>
            <span class="gr-tipo-desc">Registro de actividades y acciones del sistema</span>
            <input type="radio" name="tipoReporte" value="Actividad" class="gr-tipo-radio" />
        </div>

        <!-- Reporte de Exportaciones -->
        <div class="gr-tipo-card" data-tipo="Exportaciones">
            <div class="gr-tipo-icono icon-grad-exportaciones">
                <i class="fas fa-file-download"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte de Exportaciones</span>
            <span class="gr-tipo-desc">Historial de reportes generados y exportaciones</span>
            <input type="radio" name="tipoReporte" value="Exportaciones" class="gr-tipo-radio" />
        </div>

        <!-- Reporte Personalizado -->
        <div class="gr-tipo-card" data-tipo="Personalizado">
            <div class="gr-tipo-icono icon-grad-personalizado">
                <i class="fas fa-cog"></i>
            </div>
            <span class="gr-tipo-nombre">Reporte Personalizado</span>
            <span class="gr-tipo-desc">Crea reportes con campos y filtros personalizados</span>
            <input type="radio" name="tipoReporte" value="Personalizado" class="gr-tipo-radio" />
        </div>

    </div>

</div>
<!-- Contenedor Punto 2 -->
<div class="gr-seccion">
    <!-- Paso 2: Configurar Filtros -->
    <h2 class="gr-seccion-title">
        2. Configurar Filtros
    </h2>

    <form method="post" asp-action="GenerarReporte" asp-controller="Administrador">

        <input type="hidden" id="tipoReporteHidden" name="TipoReporte" value="Clientes" />

        <div class="gr-filtros-grid">

            <div class="gr-filtro-grupo">
                <label>Fecha Inicio</label>
                <input type="date" name="FechaInicio" class="gr-filtro-input"
                       value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("yyyy-MM-dd"))" />
            </div>

            <div class="gr-filtro-grupo">
                <label>Fecha Fin</label>
                <input type="date" name="FechaFin" class="gr-filtro-input"
                       value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)).ToString("yyyy-MM-dd"))" />
            </div>

            <div class="gr-filtro-grupo">
                <label>Estado</label>
                <select name="Estado" class="gr-filtro-input">
                    <option value="Todos">Todos</option>
                    <option value="Aprobado">Aprobado</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="En Evaluación">En Evaluación</option>
                    <option value="Rechazado">Rechazado</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
            </div>

            <div class="gr-filtro-grupo">
                <label>Tipo de Crédito</label>
                <select name="TipoCredito" class="gr-filtro-input">
                    <option value="Todos">Todos</option>
                    <option value="Estudios">Estudios</option>
                    <option value="Negocio">Negocio</option>
                    <option value="Salud">Salud</option>
                    <option value="Vivienda">Vivienda</option>
                    <option value="Emergencia">Emergencia</option>
                    <option value="Compra personal">Compra personal</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>

            <div class="gr-filtro-grupo">
                <label>Formato</label>
                <select name="Formato" class="gr-filtro-input" required>
                    <option value="Excel">Excel</option>
                    <option value="PDF">PDF</option>
                </select>
            </div>

        </div>

        <div class="gr-filtros-acciones gr-acciones-derecha">
            <div class="gr-acciones-btn-group">
                <button type="reset" class="btn-limpiar-filtros">
                    <i class="fas fa-times"></i> Limpiar Filtros
                </button>

                <button type="submit" class="btn-generar-reporte">
                    <i class="fas fa-file-alt"></i> Generar Reporte
                </button>
            </div>
        </div>

    </form>
</div>
<!-- Contenedor Punto 3 -->
<div class="gr-seccion">
    <div class="gr-recientes-header">
        <h2>3. Reportes Recientes</h2>
        <a asp-controller="Administrador"
           asp-action="Exportaciones"
           class="gr-link-todos">
            Ver todos los reportes →
        </a>
    </div>
    <!-- Solo contiene fechas preestablecidas-->
    <table class="gr-tabla">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tipo de Reporte</th>
                <th>Filtros Aplicados</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Estado Filtro</th>
                <th>Tipo Crédito</th>
                <th>Formato</th>
                <th>Fecha Generación</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reporte in ViewBag.ReportesRecientes)
            {
                <tr>

                    <td>
                        RPT-@reporte.Id.ToString("0000")
                    </td>

                    <td>

                        @{
                            string icono = "fa-file";
                            string claseColor = "personalizado";

                            switch ((string)reporte.TipoReporte)
                            {
                                case "Clientes":
                                    icono = "fa-users";
                                    claseColor = "clientes";
                                    break;

                                case "Creditos":
                                    icono = "fa-file-invoice-dollar";
                                    claseColor = "creditos";
                                    break;

                                case "Pagos":
                                    icono = "fa-dollar-sign";
                                    claseColor = "pagos";
                                    break;

                                case "Desempeno":
                                    icono = "fa-chart-bar";
                                    claseColor = "desempeno";
                                    break;

                                case "Mora":
                                    icono = "fa-exclamation-triangle";
                                    claseColor = "mora";
                                    break;

                                case "Financiero":
                                    icono = "fa-briefcase";
                                    claseColor = "financiero";
                                    break;

                                case "Sucursal":
                                    icono = "fa-building";
                                    claseColor = "sucursal";
                                    break;

                                case "TipoCredito":
                                    icono = "fa-chart-pie";
                                    claseColor = "tipocredito";
                                    break;

                                case "Periodo":
                                    icono = "fa-calendar-alt";
                                    claseColor = "periodo";
                                    break;

                                case "Actividad":
                                    icono = "fa-history";
                                    claseColor = "actividad";
                                    break;

                                case "Exportaciones":
                                    icono = "fa-file-download";
                                    claseColor = "exportaciones";
                                    break;

                                case "Personalizado":
                                    icono = "fa-cog";
                                    claseColor = "personalizado";
                                    break;
                            }
                        }

                        <span class="gr-tipo-icono-mini tipo-icon-@claseColor">
                            <i class="fas @icono"></i>
                        </span>

                        @reporte.TipoReporte

                    </td>

                    <td>
                        @reporte.Descripcion

                    </td>
                    <td>@reporte.FechaInicioReporte.ToString("dd/MM/yyyy")</td>
                    <td>@reporte.FechaFinReporte.ToString("dd/MM/yyyy")</td>
                    <td>@(string.IsNullOrWhiteSpace(reporte.EstadoFiltro) ? "Todos" : reporte.EstadoFiltro)</td>
                    <td>@(string.IsNullOrWhiteSpace(reporte.TipoCreditoFiltro) ? "Todos" : reporte.TipoCreditoFiltro)</td>

                    <td>

                        @if (reporte.Formato == "PDF")
                        {
                            <span class="gr-badge-formato gr-badge-pdf">
                                PDF
                            </span>
                        }
                        else
                        {
                            <span class="gr-badge-formato gr-badge-excel">
                                Excel
                            </span>
                        }

                    </td>

                    <td>
                        @reporte.FechaGeneracion.ToString("dd/MM/yyyy hh:mm tt")
                    </td>

                    <td>
                        <span class="gr-badge-estado">
                            @reporte.Estado
                        </span>
                    </td>

                    <td>

                        <a href="@Url.Action("DescargarExportacion", "Administrador", new { id = reporte.Id })"
                           class="gr-btn-accion gr-btn-descargar"
                           title="Descargar">
                            <i class="fas fa-download"></i>
                        </a>

                        <a href="@Url.Action("EliminarExportacion", "Administrador", new { id = reporte.Id })"
                           class="gr-btn-accion gr-btn-eliminar"
                           title="Eliminar">
                            <i class="fas fa-trash"></i>
                        </a>

                    </td>

                </tr>
            }
        </tbody>
    </table>

    @{
        int paginaActual = ViewBag.PaginaActual ?? 1;
        int totalPaginas = ViewBag.TotalPaginas ?? 1;
    }

    @if (totalPaginas > 1)
    {
        <div class="gr-paginacion">

            @if (paginaActual > 1)
            {
                <a class="gr-pag-btn"
                   href="@Url.Action("GenerarReportes", "Administrador", new { pagina = paginaActual - 1 })">
                    <i class="fas fa-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <a class="gr-pag-btn @(i == paginaActual ? "activo" : "")"
                   href="@Url.Action("GenerarReportes", "Administrador", new { pagina = i })">
                    @i
                </a>
            }

            @if (paginaActual < totalPaginas)
            {
                <a class="gr-pag-btn"
                   href="@Url.Action("GenerarReportes", "Administrador", new { pagina = paginaActual + 1 })">
                    <i class="fas fa-chevron-right"></i>
                </a>
            }

        </div>
    }

</div>

@section Scripts {
    <script src="~/js/administrador-js/generar-reportes.js" asp-append-version="true"></script>
}