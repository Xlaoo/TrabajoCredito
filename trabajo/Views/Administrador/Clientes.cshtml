@model trabajo.Models.ViewModels.AdminClientesViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
    ViewData["Title"] = "Clientes";
    ViewData["ActivePage"] = "Clientes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/administrador-css/clientes.css" asp-append-version="true" />
}

<div class="clientes-page">

    <div class="clientes-header">
        <div>
            <h1 class="clientes-title">Clientes</h1>
            <p class="clientes-subtitle">Gestiona y consulta la información de los clientes registrados.</p>
            @if (TempData["ErrorClientes"] != null)
            {
                <div class="alert alert-danger mt-3">
                    <i class="fas fa-triangle-exclamation"></i>
                    @TempData["ErrorClientes"]
                </div>
            }

            @if (TempData["ExitoClientes"] != null)
            {
                <div class="alert alert-success mt-3">
                    <i class="fas fa-check-circle"></i>
                    @TempData["ExitoClientes"]
                </div>
            }

        </div>
    </div>

    <div class="clientes-stats-grid">
        <div class="cliente-stat-card">
            <div class="cliente-stat-icon purple">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <p>Total Clientes</p>
                <h2>@Model.TotalClientes</h2>
            </div>
        </div>

        <div class="cliente-stat-card">
            <div class="cliente-stat-icon green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <p>Clientes Activos</p>
                <h2>@Model.ClientesActivos</h2>
            </div>
        </div>

        <div class="cliente-stat-card">
            <div class="cliente-stat-icon orange">
                <i class="fas fa-user-plus"></i>
            </div>
            <div>
                <p>Nuevos este mes</p>
                <h2>@Model.NuevosClientesEsteMes</h2>
            </div>
        </div>

        <div class="cliente-stat-card">
            <div class="cliente-stat-icon blue">
                <i class="fas fa-coins"></i>
            </div>
            <div>
                <p>Monto otorgado</p>
                <h2>S/ @Model.MontoTotalOtorgado.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <div class="clientes-card">
        <form method="get" asp-controller="Administrador" asp-action="Clientes" class="clientes-toolbar">
            <div class="clientes-search">
                <i class="fas fa-search"></i>
                <input type="text" name="buscar" value="@Model.Buscar" placeholder="Buscar por nombre, DNI, celular o correo..." />
            </div>

            <select name="estado" id="selectEstadoCliente">
                <option value="Todos" selected="@(Model.Estado == "Todos")">Todos</option>
                <option value="Activo" selected="@(Model.Estado == "Activo")">Activo</option>
                <option value="Inactivo" selected="@(Model.Estado == "Inactivo")">Inactivo</option>
            </select>

            <button type="submit" class="clientes-btn">
                <i class="fas fa-filter"></i> Filtrar
            </button>

            <a class="clientes-btn export" href="@Url.Action("ExportarClientesExcel", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado })">
                <i class="fas fa-file-excel"></i> Excel
            </a>

            <a class="clientes-btn export pdf" href="@Url.Action("ExportarClientesPdf", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado })">
                <i class="fas fa-file-pdf"></i> PDF
            </a>
        </form>

        <div class="clientes-table-wrapper">
            <table class="clientes-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>DNI</th>
                        <th>Celular</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th>Fecha Registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Clientes.Any())
                    {
                        foreach (var cliente in Model.Clientes)
                        {
                            <tr>
                                <td>#@cliente.NumeroFila.ToString("000")</td>
                                <td>
                                    <div class="cliente-info">
                                        <div class="cliente-avatar">@cliente.Iniciales</div>
                                        <div>
                                            <strong>@cliente.NombreCompleto</strong>
                                            <span>Cliente</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@cliente.Dni</td>
                                <td>@cliente.Celular</td>
                                <td>@cliente.Correo</td>
                                <td>
                                    @if (cliente.EstadoActivo)
                                    {
                                        <span class="estado-badge activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="estado-badge inactivo">Inactivo</span>
                                    }
                                </td>
                                <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="clientes-actions">
                                        <button type="button" class="action-btn"
                                                data-accion="detalle"
                                                data-nombre="@cliente.NombreCompleto"
                                                data-dni="@cliente.Dni"
                                                data-celular="@cliente.Celular"
                                                data-correo="@cliente.Correo"
                                                data-genero="@cliente.Genero"
                                                title="Ver detalle">
                                            <i class="far fa-eye"></i>
                                        </button>

                                        <button type="button" class="action-btn edit"
                                                data-accion="editar"
                                                data-id="@cliente.Id"
                                                data-nombre="@cliente.Nombre"
                                                data-apellido="@cliente.Apellido"
                                                data-dni="@cliente.Dni"
                                                data-celular="@cliente.Celular"
                                                data-correo="@cliente.Correo"
                                                data-genero="@cliente.Genero"
                                                data-activo="@cliente.EstadoActivo.ToString().ToLower()"
                                                title="Editar cliente">
                                            <i class="far fa-edit"></i>
                                        </button>

                                        <button type="button" class="action-btn delete"
                                                data-accion="eliminar"
                                                data-id="@cliente.Id"
                                                data-nombre="@cliente.NombreCompleto"
                                                title="Eliminar cliente">
                                            <i class="far fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="clientes-empty">No se encontraron clientes.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="clientes-footer-table">
            <span>Mostrando @Model.InicioRegistro a @Model.FinRegistro de @Model.TotalFiltrado clientes</span>

            <div class="clientes-pagination">
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <a class="page-btn @(i == Model.PaginaActual ? "active" : "")"
                       href="@Url.Action("Clientes", "Administrador", new { buscar = Model.Buscar, estado = Model.Estado, pagina = i })">
                        @i
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleCliente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content clientes-modal">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p><strong>Cliente:</strong> <span id="detalleNombre"></span></p>
                <p><strong>DNI:</strong> <span id="detalleDni"></span></p>
                <p><strong>Celular:</strong> <span id="detalleCelular"></span></p>
                <p><strong>Correo:</strong> <span id="detalleCorreo"></span></p>
                <p><strong>Género:</strong> <span id="detalleGenero"></span></p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditarCliente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-controller="Administrador" asp-action="EditarClienteAdmin" class="modal-content clientes-modal">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" id="editarId" />

            <div class="modal-header">
                <h5 class="modal-title">Editar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body clientes-form-grid">
                <input name="nombre" id="editarNombre" placeholder="Nombre" required />
                <input name="apellido" id="editarApellido" placeholder="Apellido" required />
                <input name="dni" id="editarDni" placeholder="DNI" maxlength="8" required />
                <input name="celular" id="editarCelular" placeholder="Celular" required />
                <input name="correo" id="editarCorreo" placeholder="Correo" type="email" required />

                <select name="genero" id="editarGenero">
                    <option value="">No especificado</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>
                </select>

                <select name="estadoActivo" id="editarEstadoActivo">
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="clientes-btn" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="clientes-btn primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalEliminarCliente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form id="formEliminarCliente" method="post" asp-controller="Administrador" asp-action="EliminarClienteAdmin" class="modal-content clientes-modal">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" id="eliminarId" />

            <div class="modal-header">
                <h5 class="modal-title">Eliminar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>¿Seguro que deseas eliminar al cliente <strong id="eliminarNombre"></strong>?</p>
                <div class="alert alert-danger mt-3">
                    Esta acción no se podrá deshacer.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="clientes-btn" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="clientes-btn danger">Eliminar</button>
            </div>
        </form>
    </div>
</div>
<div class="modal fade" id="modalMensajeCliente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content clientes-modal text-center p-4">
            <div id="mensajeIcono"></div>
            <h5 id="mensajeTitulo" class="mt-2"></h5>
            <p id="mensajeTexto" class="text-muted"></p>
            <button type="button" class="clientes-btn primary mx-auto" id="btnAceptarMensajeCliente" data-bs-dismiss="modal">
                Aceptar
            </button>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/administrador-js/clientes.js" asp-append-version="true"></script>
}