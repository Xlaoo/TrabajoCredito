<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CrediPlus</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/panel-roles.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="layout">

        <!-- SIDEBAR CLIENTE -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">🛡</div>
                <div>
                    <div class="brand-name">CrediPlus</div>
                    <div class="brand-role">@(User.Identity?.Name ?? "Cliente")</div>
                </div>
            </div>

            <nav class="menu">
                <div class="section-title">Principal</div>

                <a href="@Url.Action("SolicitarCredito", "Login")"
                   class="@(ViewData["ActivePage"]?.ToString() == "Inicio" ? "active" : "")">
                    <i class="fas fa-home"></i> Inicio
                </a>

                <div class="section-title">Mis Créditos</div>

                <a href="@Url.Action("FormularioPrestamo", "Login")"
                   class="@(ViewData["ActivePage"]?.ToString() == "SolicitarCredito" ? "active" : "")">
                    <i class="fas fa-plus-circle"></i> Solicitar Crédito
                </a>
                <a href="@Url.Action("MisSolicitudes", "Login")"
                   class="@(ViewData["ActivePage"]?.ToString() == "MisSolicitudes" ? "active" : "")">
                    <i class="fas fa-file-alt"></i> Mis Solicitudes
                </a>
                <a href="@Url.Action("PagosPendientes", "Login")"
                   class="@(ViewData["ActivePage"]?.ToString() == "PagosPendientes" ? "active" : "")">
                    <i class="fas fa-money-bill-wave"></i> Pagos Pendientes
                </a>
                <a href="@Url.Action("SimuladorCredito", "Login")"
                   class="@(ViewData["ActivePage"]?.ToString() == "SimuladorCredito" ? "active" : "")">
                    <i class="fas fa-calculator"></i> Simulador de Crédito
                </a>

                <div class="section-title">Soporte</div>

                <a href="@Url.Action("PreguntasFrecuentes", "Login")"
                   class="@(ViewData["ActivePage"]?.ToString() == "PreguntasFrecuentes" ? "active" : "")">
                    <i class="fas fa-question-circle"></i> Preguntas Frecuentes
                </a>

                <div class="section-title">Mi Cuenta</div>

                <a href="@Url.Action("PerfilPersonal", "Login")"
                   class="@(ViewData["ActivePage"]?.ToString() == "Perfil" ? "active" : "")">
                    <i class="fas fa-user"></i> Perfil
                </a>
                <a href="@Url.Action("CerrarSesion", "Login")" class="logout-link">
                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                </a>
            </nav>

            <div class="help-card">
                <i class="fas fa-headset help-icon"></i>
                <div>
                    <strong>¿Necesitas ayuda?</strong>
                    <span>Comunícate con soporte</span>
                </div>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="content">
            @RenderBody()
        </main>

    </div>
    <script>
        window.addEventListener("beforeunload", function () {
            if (navigator.sendBeacon) {
                navigator.sendBeacon("/Login/MarcarClienteInactivo");
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
